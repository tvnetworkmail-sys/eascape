[opnpc1,dwarf_city_barmaid_poor] @keldagrim_talk_barmaid;
[label,keldagrim_talk_barmaid]
// Transcript:Barmaid
~chatnpc("<p,neutral>Welcome to the Laughing Miner pub, human traveller.");
def_int $c1 = ~p_choice5("Who is that man walking around outside?", 1, "I'd like a beer please.", 2, "I'd like some food please.", 3, "I'd like a Kelda stout please.", 4, "I have to go.", 5);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Who is that man walking around outside?");
    ~chatnpc("<p,neutral>What man?");
    ~chatplayer("<p,neutral>I mean the dwarf, the one with the sign.");
    ~chatnpc("<p,neutral>Oh, him. Yes, we employ him to advertise our pub, he's the cheapest labour we could find. We don't have a lot of money to spare you know, we pay him in beer.");
    ~chatplayer("<p,neutral>But what's wrong with him?");
    ~chatnpc("<p,neutral>Well, he's drunk isn't he?");
    ~chatnpc("<p,neutral>I told you, he's cheap. He couldn't get any other work since the Red Axe fired him. Been drinking ever since.");
    ~chatplayer("<p,neutral>How did that happen?");
    ~chatnpc("<p,neutral>I'm not quite sure, I think he kept wearing the wrong coloured cap all the time. They don't much like it if you don't wear your red uniform into work.");
    ~chatplayer("<p,neutral>They fired him for that??");
    ~chatnpc("<p,neutral>The Red Axe will fire you for just about anything if they want to.");
    return;
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>I'd like a beer please.");
    ~chatnpc("<p,neutral>That'll be 2 gold coins.");
    def_int $c2 = ~p_choice2("Pay.", 1, "Don't pay.", 2);
    if ($c2 = 1) {
        if (~keldagrim_buy(beer, 2) = false) {
            ~chatplayer("<p,neutral>Sorry, I don't have 2 coins on me.");
            return;
        }
        ~chatnpc("<p,neutral>Thanks for your custom.");
        return;
    } else if ($c2 = 2) {
        ~chatplayer("<p,neutral>Sorry, I changed my mind.");
        return;
    }
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>I'd like some food please.");
    ~chatnpc("<p,neutral>I can make you a stew for 20 gold coins.");
    def_int $c3 = ~p_choice2("Pay.", 1, "Don't pay.", 2);
    if ($c3 = 1) {
        if (~keldagrim_buy(stew, 20) = false) {
            ~chatplayer("<p,neutral>Sorry, I don't have 20 coins on me.");
            return;
        }
        ~chatnpc("<p,neutral>Thanks for your custom.");
        return;
    } else if ($c3 = 2) {
        ~chatplayer("<p,neutral>Sorry, I changed my mind.");
        return;
    }
} else if ($c1 = 4) {
    ~ft_barmaid_stout; // EASCape: the lost Kelda stout in Forgettable Tale... (quest_forgettable_tale/ft_seeds.rs2)
    return;
} else if ($c1 = 5) {
    ~chatplayer("<p,neutral>I have to go.");
    return;
}

