// the King's Axe's barman: quest_forgettable_tale/ft_seeds.rs2 (Transcript:Barman (King's Axe Inn))
// no transcript in any source (ours)
[opnpc1,dwarf_city_library_assistant] ~chatnpc("<p,neutral>Please keep your voice down, this is a library.");

[proc,keldagrim_buy](namedobj $obj, int $cost)(boolean)
if (inv_total(inv, coins) < $cost) return(false);
if (inv_freespace(inv) = 0 & inv_total(inv, coins) ! $cost) {
    mes("You don't have enough inventory space."); // ours
    return(false);
}
inv_del(inv, coins, $cost);
inv_add(inv, $obj, 1);
return(true);
