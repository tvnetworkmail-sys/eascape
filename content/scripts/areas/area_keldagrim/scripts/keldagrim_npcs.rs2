[opnpc1,dwarf_city_old_dwarf2] @keldagrim_talk_haera;
[label,keldagrim_talk_haera]
// Transcript:Haera
~chatnpc("<p,neutral>What are you doing in our home?");
~chatplayer("<p,neutral>I just came to ask you a question.");
~chatnpc("<p,neutral>Hegir, why did you let this human into our home?");
~chatnpc_specific("Hegir", dwarf_city_old_dwarf1, "<p,neutral>I didn't let him in, he let himself in!");
~chatnpc("<p,neutral>Now what do you want, human? Speak up, speak up!");
~chatplayer("<p,neutral>I ehm, just wanted some information.");
~chatnpc("<p,neutral>Well go ask someone else instead of barging into people's homes!");
~chatnpc_specific("Hegir", dwarf_city_old_dwarf1, "<p,neutral>There's no need to be rude to the human, Haera dear.");
~chatnpc("<p,neutral>Now don't you dear me. I'll do whatever I please.");
~chatplayer("<p,neutral>I think this is my cue to leave...");
return;

[opnpc1,dwarf_city_old_dwarf1] @keldagrim_talk_hegir;
[label,keldagrim_talk_hegir]
// Transcript:Hegir
~chatplayer("<p,neutral>Hello, can I ask you a question?");
~chatnpc("<p,neutral>Oh yes, young fellow? Yes, what do you want?");
~chatnpc_specific("Haera", dwarf_city_old_dwarf2, "<p,neutral>Who's that you're talking to Hegir?");
~chatnpc("<p,neutral>Let me see, he appears to be a human of some sort.");
~chatnpc("<p,neutral>What was your name again, human?");
~chatplayer("<p,neutral><displayname>.");
~chatnpc("<p,neutral>It's <displayname>!");
~chatnpc_specific("Haera", dwarf_city_old_dwarf2, "<p,neutral>Well ask him what he wants then!");
~chatnpc("<p,neutral>What do you want, human?");
~chatplayer("<p,neutral>Errr... I don't know... A quest, maybe?");
~chatnpc("<p,neutral>He says he's looking for his quest!");
~chatnpc_specific("Haera", dwarf_city_old_dwarf2, "<p,neutral>What makes him think he lost his quest in here?");
~chatnpc("<p,neutral>What makes you think you lost your quest in here?");
~chatplayer("<p,neutral>No no, I mean, do you have a task of some sort for me?");
~chatnpc("<p,neutral>Now he says he wants a task!");
~chatnpc_specific("Haera", dwarf_city_old_dwarf2, "<p,neutral>Stop talking to that human and get back in here before I have a task for you!");
~chatnpc("<p,neutral>No need to talk to me like that, Haera.");
~chatnpc_specific("Haera", dwarf_city_old_dwarf2, "<p,neutral>I'll talk to you in whatever way I like!");
~chatplayer("<p,neutral>I think I hear someone calling my name in the distance...");
return;

[opnpc1,dwarf_city_gardener_dwarf] @keldagrim_talk_rind;
[label,keldagrim_talk_rind]
// Transcript:Rind the gardener
if (~ft_rind = true) return; // EASCape: Forgettable Tale... (quest_forgettable_tale/ft_brew.rs2)
~chatnpc("<p,neutral>Come to visit my garden then, have you, human?");
def_int $c1 = ~p_choice2("This is your garden?", 1, "Not really, no.", 2);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>This is your garden?");
    ~chatnpc("<p,neutral>No no, not quite. But I do look after it. It's the palace garden, you see. I keep it tidy, keep it living.");
    ~chatnpc("<p,neutral>It's hard to grow much on these hard rocks deep beneath these mountains, you know.");
    ~chatplayer("<p,neutral>I can imagine. Where do you get all your food from? Or even the soil for this garden?");
    ~chatnpc("<p,neutral>We can grow a little food underground, but most of it comes from the extensive steamcart network that runs beneath the earth.");
    ~chatnpc("<p,neutral>In the Era of Kings, many centuries ago, it was harder of course. Our steam technology was not developed as far yet and getting fresh supplies of food was always a problem.");
    ~chatnpc("<p,neutral>Oh, I'm not boring you, am I?");
    def_int $c2 = ~p_choice2("Not at all!", 1, "A little, yes.", 2);
    if ($c2 = 1) {
        ~chatplayer("<p,neutral>Not at all! Please, go on!");
        ~chatnpc("<p,neutral>Oh yes, as I was saying, it was difficult to make a decent living here. I'm afraid this garden was rather neglected during that time.");
        ~chatplayer("<p,neutral>Why did you dwarves stay so deep under ground, then? Why not simply go above ground?");
        ~chatnpc("<p,neutral>What, with the wars raging up there?");
        ~chatnpc("<p,neutral>We dwarves went underground a long time ago, see. For a while the city of Keldagrim was completely cut off from the rest of Gielinor simply waiting out the wars of the humans and the gods.");
        ~chatnpc("<p,neutral>This made it hard, though, to determine when the wars above the ground were over. Perhaps Keldagrim had remained hidden for far too long.");
        ~chatnpc("<p,neutral>Only when King Alvis heroically defended the city against an invasion of trolls did we dare to venture out and see how much the world had changed.");
        ~chatnpc("<p,neutral>Of course, after that...");
        ~chatnpc("<p,neutral>Ah well, enough history lessons I should say. I must really get back to my gardening.");
        ~chatplayer("<p,neutral>Thanks for the info!");
        return;
    } else if ($c2 = 2) {
        ~chatplayer("<p,neutral>A little, yes. I don't really know what all this has to do with anything.");
        ~chatnpc("<p,neutral>I suppose it doesn't, really, it's just the mumblings of an old dwarf.");
        return;
    }
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>Not really, no.");
    ~chatnpc("<p,neutral>Oh, alright then.");
    return;
}

