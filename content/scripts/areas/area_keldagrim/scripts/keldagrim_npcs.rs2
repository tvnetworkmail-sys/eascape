[opnpc1,dwarf_city_shop_cloth] @keldagrim_talk_agmundi;
[label,keldagrim_talk_agmundi]
// Transcript:Agmundi
~chatnpc("<p,neutral>Oh no, not another human... what do you want then?");
~chatplayer("<p,neutral>Oh, do you get humans here often?");
~chatnpc("<p,neutral>Not that often, no, but sometimes.");
~chatnpc("<p,neutral>Of course, since you people are too big for dwarven clothes, they typically don't stay very long.");
~chatplayer("<p,neutral>Why don't you make bigger clothes then?");
~chatnpc("<p,neutral>What'd be the point? Besides, I don't make these clothes myself.");
def_int $c1 = ~p_choice3("Who makes these clothes then?", 1, "I still want to buy your clothes.", 2, "So do you have any quests for me?", 3);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Who makes these clothes then?");
    ~chatnpc("<p,neutral>Oh, my sister, she lives in Keldagrim-East. Has a little stall on the other side of the Kelda.");
    ~chatnpc("<p,neutral>If she only worked a little harder, like me, she wouldn't have to live in the sewers of the city. Shame really.");
    ~chatplayer("<p,neutral>The sewers? Your sister lives in the sewers?");
    ~chatnpc("<p,neutral>Keldagrim-East, such a ghastly place. Not civil, polite and clean like we are in the West.");
    ~chatplayer("<p,neutral>Uh-huh.");
    return;
} else if ($c1 = 2) {
    ~openshop_activenpc;
    return;
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>So do you have any quests for me?");
    ~chatnpc("<p,neutral>Quests? Why would I have any quests?");
    ~chatplayer("<p,neutral>Oh, just anything to do would be fine.");
    ~chatnpc("<p,neutral>No, not right now... maybe I'll have something for you to do later, but nothing at the moment.");
    return;
}

