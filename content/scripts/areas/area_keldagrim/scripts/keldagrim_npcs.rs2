// EASCape: Keldagrim's people. Their words are the OSRS wiki's transcripts (Transcript:<name>,
// "Standard dialogue"), turned into script by our tool; where a transcript branches on a quest we
// don't have, the first branch is kept (ours). The shops are the cache's (all.inv) with the wiki's prices.

[opnpc1,dwarf_city_shop_weapons] @keldagrim_talk_santiri;
[label,keldagrim_talk_santiri]
if (%giantdwarf_quest >= ^gd_items & %giantdwarf_quest < ^gd_complete) @gd_santiri; // The Giant Dwarf
// Transcript:Santiri
~chatnpc("<p,neutral>Welcome, human, to the Quality Weapons Shop! Can I interest you in a purchase?");
def_int $c1 = ~p_choice2("Yes, I'm looking for some weapons.", 1, "No thanks.", 2);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Yes, I'm looking for some weapons.");
    ~openshop_activenpc;
    return;
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    return;
}

