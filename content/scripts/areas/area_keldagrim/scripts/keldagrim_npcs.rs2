[opnpc1,dwarf_city_shop_pickaxe] @keldagrim_talk_tati;
[label,keldagrim_talk_tati]
// Transcript:Tati
~chatnpc("<p,neutral>What'you want?");
def_int $c1 = ~p_choice3("Do you have any pickaxes?", 1, "Do you have any quests?", 2, "Nothing really.", 3);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Do you-");
    ~chatnpc("<p,neutral>What? Speak up, I can't hear you!");
    ~chatplayer("<p,neutral>Uhm... I'm just looking for some pickaxes! Do you have any?");
    ~chatnpc("<p,neutral>Do I have any pickaxes? Do I? Of course I do, this is a pickaxe shop, isn't it!");
    ~openshop_activenpc;
    return;
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>Do you-");
    ~chatnpc("<p,neutral>What? Stop mumbling!");
    ~chatplayer("<p,neutral>I want a quest!");
    ~chatnpc("<p,neutral>I don't have any lousy quests... I've got someone who's helping me already!");
    ~chatnpc("<p,neutral>Well, I say helping... he takes his merry time to do his chores, my son does.");
    ~chatplayer("<p,neutral>Then perhaps I can help in some way?");
    ~chatnpc("<p,neutral>Pfft, I doubt it... maybe when my son fouls up again, but not now.");
    return;
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>Nothing really.");
    ~chatnpc("<p,neutral>Then clear off!");
    return;
}

