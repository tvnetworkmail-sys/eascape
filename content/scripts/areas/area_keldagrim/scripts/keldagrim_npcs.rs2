        ~chatplayer("<p,neutral>Sorry, I don't seem to have any money on me.");
        ~chatnpc("<p,neutral>The bank is Keldagrim-West. Hurry back!");
    }
    return;
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>I'm looking for a drunken dwarf.");
    ~chatnpc("<p,neutral>Just go out in the streets, they can't be hard to find!");
    ~chatplayer("<p,neutral>No, a specific drunken dwarf, he keeps harassing me.");
    ~chatnpc("<p,neutral>That's still not very helpful. But let me see. There is one particularly drunken dwarf just to the northeast of here.");
    ~chatnpc("<p,neutral>He's scaring away my customers, he says there's something wrong with my kebabs. Quite annoying fellow.");
    ~chatplayer("<p,neutral>I don't think that's who I mean.");
    ~chatnpc("<p,neutral>Well, he does have a relative who wanders all over Gielinor. Comes back from time to time to buy more kebabs. Don't see him very often though.");
    ~chatplayer("<p,neutral>Do you think I'll have any chance of catching him here?");
    ~chatnpc("<p,neutral>I think he was back here quite recently, so I doubt he'll be back any time soon.");
    return;
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>Do you have any quests?");
    ~chatnpc("<p,neutral>Not really! I have a steady supply of meat coming in through the carts and I don't really need anything else!");
    return;
}

