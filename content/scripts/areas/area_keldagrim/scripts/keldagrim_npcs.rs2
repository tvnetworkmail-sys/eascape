[opnpc1,dwarf_city_dwarf_man7] @keldagrim_talk_myndill;
[label,keldagrim_talk_myndill]
// Transcript:Myndill
~chatnpc("<p,neutral>Hello there, human.");
def_int $c1 = ~p_choice3("Do you have any news?", 1, "Do you have any quests?", 2, "See you later!", 3);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Do you have any news?");
    ~chatnpc("<p,neutral>Well, I heard some human knocked over the statue of King Alvis recently. You know anything about that?");
    ~chatplayer("<p,neutral>Hey, it wasn't my fault! I was just travelling on the boat!");
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>Do you have any quests?");
    ~chatnpc("<p,neutral>Let me think for a moment...");
    ~chatnpc("<p,neutral>No, I have nothing that I could possible want doing. Try the shops or the market instead.");
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>See you later!");
    ~chatnpc("<p,neutral>Perhaps!");
    return;
}

[opnpc1,dwarf_city_dwarf_man10] @keldagrim_talk_odmar;
[label,keldagrim_talk_odmar]
// Transcript:Odmar
~chatnpc("<p,neutral>What to buy? What to buy?");
~chatnpc("<p,neutral>Oh, hello human.");
~chatplayer("<p,neutral>Anything I can help you with?");
~chatnpc("<p,neutral>Only if you can help me make a suggestion on what to buy.");
~chatplayer("<p,neutral>I smell a quest!");
~chatnpc("<p,neutral>No, not really. I just need some advice on what to buy, that's all.");
def_int $c1 = ~p_choice5("New clothes.", 1, "A warhammer.", 2, "A piece of rope.", 3, "An oversized hat.", 4, "Nothing.", 5);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>You should buy some new clothes. You can't go around town wearing what you're wearing.");
    ~chatnpc("<p,neutral>You're right, this is a little drab. I shouldn't really go around Keldagrim-West wearing this, should I?");
    ~chatnpc("<p,neutral>Of course I still don't know what colour I should get. I don't want to accidentally offend the wrong company of course.");
    ~chatplayer("<p,neutral>Never mind.");
    return;
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>You should get yourself a big mighty warhammer.");
    ~chatnpc("<p,neutral>I don't think so. The warhammer shop is run by the Red Axe. I'd rather stay out of there.");
    ~chatplayer("<p,neutral>You don't like the Red Axe?");
    ~chatnpc("<p,neutral>They're all a lot of bullies if you ask me.");
    ~chatplayer("<p,neutral>But I thought they left the city?");
    ~chatnpc("<p,neutral>They may have, but I still think that shopkeeper is in league with them, banners or no.");
    return;
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>Get yourself a long piece of rope.");
    ~chatnpc("<p,neutral>What would I do with a rope?");
    ~chatplayer("<p,neutral>I don't know. I generally find a rope useful while adventuring.");
    ~chatnpc("<p,neutral>I don't do a lot of adventuring to be honest.");
    return;
} else if ($c1 = 4) {
    ~chatplayer("<p,neutral>An oversized hat. In a ridiculous colour.");
    ~chatnpc("<p,neutral>No one is selling hats here, that's not a very helpful suggestion at all.");
    return;
} else if ($c1 = 5) {
    ~chatplayer("<p,neutral>Nothing. You should buy absolutely nothing.");
    ~chatnpc("<p,neutral>Now that's the best idea I've heard all day.");
    ~chatplayer("<p,neutral>I thought so! Now why don't you give me some of the money I saved you?");
    ~chatnpc("<p,neutral>No, I don't think so. I think I'd rather buy something with my money after all.");
    return;
}

