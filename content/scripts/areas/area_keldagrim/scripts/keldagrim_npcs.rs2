[opnpc1,dwarf_city_black_guard_supreme_leader] @keldagrim_talk_supreme;
[label,keldagrim_talk_supreme]
// Transcript:Supreme Commander
~chatnpc("<p,neutral>I hear you are the human that Veldaban has employed to help rebuild the statue. How is that going?");
~chatplayer("<p,neutral>How did you know about that?");
~chatnpc("<p,neutral>Veldaban is in my employ.");
def_int $c1 = ~p_choice3("Who are you?", 1, "What news have you?", 2, "I must go now.", 3);
if ($c1 = 1) {
    ~chatplayer("<p,neutral>Who are you?");
    ~chatnpc("<p,neutral>I am Bisi. I am the Supreme Commander of the Black Guard.");
    ~chatplayer("<p,neutral>I thought Veldaban was in command?");
    ~chatnpc("<p,neutral>Only of our regiment in Keldagrim, and a most honourable position it is as well.");
    ~chatnpc("<p,neutral>But the Black Guard has many regiments across the dwarven realm. All the Commanders of those regiments report to me.");
    ~chatplayer("<p,neutral>Oh yes, I helped Commander Lawgof once, in his fight against the goblins.");
    ~chatnpc("<p,neutral>That's good to hear.");
} else if ($c1 = 2) {
    ~chatplayer("<p,neutral>What news have you?");
    ~chatnpc("<p,neutral>Apart from the statue of King Alvis falling down, you mean? I don't know. There is something suspicious about the whole case.");
    ~chatplayer("<p,neutral>How do you mean?");
    ~chatnpc("<p,neutral>We've had several incidents recently. For a while we even closed off the city. And now this.");
} else if ($c1 = 3) {
    ~chatplayer("<p,neutral>I must go now.");
    ~chatnpc("<p,neutral>Then I bid you farewell, human.");
    return;
}

[opnpc1,dwarf_city_shop_sculpture] @keldagrim_talk_blasidar;
[label,keldagrim_talk_blasidar]
if (%giantdwarf_quest < ^gd_complete) @gd_blasidar; // The Giant Dwarf
// Transcript:Blasidar the sculptor
~chatnpc("<p,neutral>The new statue looks beautiful, don't you agree?");
~chatplayer("<p,neutral>Oh yes, quite.");
~chatnpc("<p,neutral>My finest piece of work, without a doubt.");
~chatplayer("<p,neutral>Say, I was wondering, did you do the statues down in the mines as well?");
~chatnpc("<p,neutral>What, out with the trolls?");
~chatnpc("<p,neutral>If only! But no, they've been there for many thousands of years, actually. Been there before dwarven recorded history.");
~chatplayer("<p,neutral>No no, I'm sure they weren't there before!");
~chatnpc("<p,neutral>Of course they were, don't be silly!");
~chatplayer("<p,neutral>Alright... my mistake then.");
return;

[opnpc1,dwarf_city_trader_referee] @keldagrim_talk_referee;
[label,keldagrim_talk_referee]
// Transcript:Trade Referee
switch_int (random(5)) {
    case 0 :
        ~chatnpc("<p,neutral>Talk to the secretaries, not to me!");
        return;
    case 1 :
        ~chatnpc("<p,neutral>Clear out!");
        return;
    case 2 :
        ~chatnpc("<p,neutral>Stay out of the octagon center!");
        return;
    case 3 :
