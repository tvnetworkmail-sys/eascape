// EASCape: Zahur's herbs (Nardah, 5 December 2005): each unidentified herb and what it is
// (skill_herblore/scripts/identifying/identify.rs2). The jungle herbs are left out: the OSRS wiki's
// Transcript:Zahur, "I'm not very good at cleaning jungle herbs".
[nardah_zahur_herbs]
inputtype=obj
outputtype=namedobj
default=null
val=unidentified_guam,guam_leaf
val=unidentified_marentill,marentill
val=unidentified_tarromin,tarromin
val=unidentified_harralander,harralander
val=unidentified_ranarr,ranarr_weed
val=unidentified_irit,irit_leaf
val=unidentified_avantoe,avantoe
val=unidentified_kwuarm,kwuarm
val=unidentified_cadantine,cadantine
val=unidentified_lantadyme,lantadyme
val=unidentified_dwarf_weed,dwarf_weed
val=unidentified_torstol,torstol
val=unidentified_toadflax,toadflax
val=unidentified_snapdragon,snapdragon

// the jungle herbs she turns away
[nardah_zahur_jungle]
inputtype=obj
outputtype=int
default=0
val=unidentified_snake_weed,1
val=unidentified_ardrigal,1
val=unidentified_sito_foil,1
val=unidentified_volencia_moss,1
val=unidentified_rogues_purse,1
