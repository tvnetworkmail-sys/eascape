// EASCape: the Rogues' Den maze (Rogues Den + Tweaks, 22 June 2005). All ours.

// you have talked to Brian O'Richard about the maze (OSRS wiki, Rogues' Den: you must talk to him
// before the first game; after that the doorway lets you straight in)
[roguesden_access]
scope=perm

// 1 while you are in the maze; kept over logging out so logging in puts you back in the lobby
[roguesden_state]
scope=perm

// how far you got, in percent (roguesden_maze.rs2, ~roguesden_progress), and bit flags:
// roguesden_flags 1 = past the first pendulum, 2 = reached the wall safe room
[roguesden_progress]
scope=perm

[roguesden_flags]
scope=perm

// where you were last tick, and the square you stopped on (the trap and obstacle checks)
[roguesden_last]
type=coord

[roguesden_stop]
type=coord

// the trap you last searched (its dangerous square) and until when (map_clock) it stays safe
[roguesden_disarm]
type=coord

[roguesden_disarm_end]

// a crusher just went off: the crushers leave you alone until this map_clock
[roguesden_crush_end]
