// EASCape: ours. The gear door's dials (questscroll_fluffs, the 2006 cache's dial puzzle) holding
// still at each quarter, and the cache's eight quarter turns (roguesden_interface_dial_*) with their
// last frame held, so a turned dial stays where it ends (an interface animation loops otherwise).
// Frames from the cache's own dial animations.

[roguesden_dial_n]
frame1=anim_17188

[roguesden_dial_e]
frame1=anim_17199

