// EASCape: the Warriors' Guild
// tokens earned at the activities, waiting to be claimed from the staff (Harrallak: "the staff will
// then enter this into a ledger as you play")
[wg_tokens]
scope=perm

// the best defender you've shown Kamfreena (0 none, 1 bronze .. 7 rune): the cyclopes she lets you
// fight drop the next one
[wg_defender]
scope=perm

// your animated armour: 0 none, 1-7 animated (bronze..rune), 11-17 kept by Shanomi after it went
// away unkilled or you left (Shanomi: "Not killed it was. Collected your armour I did.")
[wg_armour]
scope=perm
protect=no

// the catapult block you've chosen (1 stab, 2 crush, 3 slash, 4 magic)
[wg_block]

// how many kegs are on your head (Jimmy's challenge)
[wg_kegs]

// the map_clock you last hit a dummy, so one dummy can't be hit twice
[wg_dummy_hit]

// you're out of tokens in the cyclopes' room: the map_clock you're sent out at
[wg_cyclops_out]

// your hands are dusted with ground ashes (the next shot put)
[wg_dusted]

// your animated armour, while it's alive
[wg_armour_npc]
type=npc_uid

// in the cyclopes' room: the map_clock the next 10 tokens go
[wg_cyclops_next]
