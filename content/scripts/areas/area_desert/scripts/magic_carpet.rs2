// EASCape: Ali Morrisane's flying carpet fleet, from Void (content/area/kharidian_desert/RugMerchant.kt):
// the Rug Merchants, their stations, 200 coins a journey, and the routes the carpets fly
// (configs/magic_carpet.dbrow, Void's patrols). Uzer's merchant shows once The Golem is done (a
// multinpc in the 377 cache); Sophanem's and Menaphos's stay hidden until Icthlarin's Little Helper,
// which isn't in the game yet. The flight uses the 377 cache's carpet animations.

[opnpc1,magic_carpet_seller1] ~carpet_merchant("shantay_pass");
[opnpc1,magic_carpet_seller2] ~carpet_merchant("bedabin_camp");
[opnpc1,magic_carpet_seller4] ~carpet_merchant("north_pollnivneach");
[opnpc1,magic_carpet_seller3] ~carpet_merchant("south_pollnivneach");
[opnpc1,magic_carpet_seller8] ~carpet_merchant("nardah");
[opnpc1,magic_carpet_seller5_multi] ~carpet_merchant("uzer");

[proc,carpet_merchant](string $here)
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>Greetings, desert traveller. Do you require the services of Ali Morrisane's flying carpet fleet?");
switch_int (~p_choice2("Yes please.", 1, "No thanks.", 2)) {
    case 2 :
        ~chatplayer("<p,neutral>No thanks.");
        ~chatnpc("<p,neutral>Come back anytime.");
        return;
}
~chatplayer("<p,happy>Yes please.");
def_string $to = "";
if (compare($here, "shantay_pass") = 0) {
    ~chatnpc("<p,neutral>From here you can travel to the Bedabin camp or to the north of Pollnivneach.");
    if (%golem_a >= ^golem_complete) {
        switch_int (~p_choice4("I want to travel to Uzer.", 1, "I want to travel to the Bedabin camp.", 2, "I want to travel to Pollnivneach.", 3, "I don't want to travel to any of those places.", 4)) {
            case 1 : $to = "uzer";
            case 2 : $to = "bedabin_camp";
            case 3 : $to = "north_pollnivneach";
        }
    } else {
        switch_int (~p_choice3("I want to travel to the Bedabin camp.", 2, "I want to travel to Pollnivneach.", 3, "I don't want to travel to any of those places.", 4)) {
            case 2 : $to = "bedabin_camp";
            case 3 : $to = "north_pollnivneach";
        }
    }
} else if (compare($here, "south_pollnivneach") = 0) {
    ~chatnpc("<p,neutral>Travel to Menaphos and Sophanem from here would be possible, but for the strange goings on there. You can still travel from here to Nardah.");
    switch_int (~p_choice2("I want to travel to Nardah.", 1, "Actually, I've changed my mind.", 2)) {
        case 1 : $to = "nardah";
    }
} else if (compare($here, "nardah") = 0) {
    ~chatnpc("<p,neutral>The carpets here will take you to the south of Pollnivneach.");
    switch_int (~p_choice2("Let's go then.", 1, "I don't want to travel there.", 2)) {
        case 1 : $to = "south_pollnivneach";
    }
} else {
    ~chatnpc("<p,neutral>From here you can travel to the Shantay Pass.");
    switch_int (~p_choice2("Take me there.", 1, "I don't want to travel there.", 2)) {
        case 1 : $to = "shantay_pass";
    }
}
if (string_length($to) = 0) {
    ~chatnpc("<p,neutral>Fair enough, magic carpet travel isn't for everyone. Enjoy the walk.");
    return;
}
~chatnpc("<p,neutral>There is a fare for this service you know: it's 200 gold per journey.");
if (inv_total(inv, coins) < 200) {
    ~chatplayer("<p,sad>I don't have enough money with me.");
    ~chatnpc("<p,neutral>Looks like you're walking then.");
    return;
}
~chatplayer("<p,happy>Here you go.");
inv_del(inv, coins, 200);
~carpet_fly($here, $to);

[proc,carpet_fly](string $from, string $to)
db_find(carpet_route:from, $from);
def_dbrow $row = db_findnext;
def_dbrow $route = null;
while ($row ! null) {
    if (compare(db_getfield($row, carpet_route:to, 0), $to) = 0) {
        $route = $row;
    }
    $row = db_findnext;
}
if ($route = null) {
    mes("The carpets aren't flying that way today.");
    return;
}
if_close;
// the carpet is the 377 cache's "Magic carpet" item, wielded for the ride (its model is the
// carpet under you); your own weapon waits in eascape_carpet_hold
~carpet_hold_weapon;
inv_setslot(worn, ^wearpos_rhand, magic_carpet, 1);
buildappearance(worn);
anim(carpet_raise, 0);
p_delay(2);
~bas_set(carpet_sit_down, carpet_bank_left, carpet_sit_down, carpet_sit_down, carpet_bank_left, carpet_bank_right, null);
buildappearance(worn);
def_int $i = 0;
def_int $n = db_getfieldcount($route, carpet_route:point);
while ($i < $n) {
    ~carpet_glide(db_getfield($route, carpet_route:point, $i));
    $i = add($i, 1);
}
~carpet_glide(db_getfield($route, carpet_route:land, 0));
anim(carpet_land, 0);
p_delay(1);
~carpet_give_back_weapon;
~update_bas;
buildappearance(worn);

// smoothly over the ground to a point, two squares a tick, in legs of up to 8 squares (the
// carpet flies over anything); the old version jumped a square at a time, which looked like
// your model glitching up and down
[proc,carpet_glide](coord $dest)
while (coord ! $dest) {
    def_int $dx = calc(coordx($dest) - coordx(coord));
    def_int $dz = calc(coordz($dest) - coordz(coord));
    $dx = max(-8, min(8, $dx));
    $dz = max(-8, min(8, $dz));
    def_int $dist = max(abs($dx), abs($dz));
    def_int $dir = ^exact_north;
    if (abs($dx) >= abs($dz)) {
        if ($dx > 0) $dir = ^exact_east; else $dir = ^exact_west;
    } else if ($dz < 0) {
        $dir = ^exact_south;
    }
    def_int $ticks = divide(add($dist, 1), 2);
    p_exactmove(coord, movecoord(coord, $dx, 0, $dz), 0, multiply($ticks, 30), $dir);
    p_delay(sub($ticks, 1));
}

[proc,carpet_hold_weapon]
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon ! null & $weapon ! magic_carpet) {
    inv_movetoslot(worn, eascape_carpet_hold, ^wearpos_rhand, 0);
}

[proc,carpet_give_back_weapon]
if (inv_getobj(worn, ^wearpos_rhand) = magic_carpet) {
    inv_delslot(worn, ^wearpos_rhand);
}
if (inv_getobj(eascape_carpet_hold, 0) ! null) {
    if (inv_getobj(worn, ^wearpos_rhand) = null) {
        inv_movetoslot(eascape_carpet_hold, worn, 0, ^wearpos_rhand);
    } else {
        inv_moveitem(eascape_carpet_hold, inv, inv_getobj(eascape_carpet_hold, 0), inv_total(eascape_carpet_hold, inv_getobj(eascape_carpet_hold, 0)));
    }
}

// logging in after a ride was cut short
[proc,carpet_login]
if (inv_getobj(worn, ^wearpos_rhand) = magic_carpet | inv_getobj(eascape_carpet_hold, 0) ! null) {
    ~carpet_give_back_weapon;
    buildappearance(worn);
}
