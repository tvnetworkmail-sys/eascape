[opnpc1,barbarian] @barbarian_talk;
[opnpc1,fai_barbarian_1] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_2] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_3] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_4] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_5] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_6] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_7] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_8] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_10] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_11] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_12] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_13] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_14] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_female_1] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_female_2] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_female_3] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script
[opnpc1,fai_barbarian_female_4] @barbarian_talk; // EASCape: a copy of this character that had no Talk-to script

[label,barbarian_talk]

~chatplayer("<p,happy>Hello!");

switch_int(random(11)) {
    case 0 :
    ~chatnpc("<p,neutral>Hello!");
    case 1 :
    ~mesbox("The barbarian grunts.");
    case 2 :
    ~chatnpc("<p,happy>Good day, my dear fellow.");
    case 3 :
    ~chatnpc("<p,angry>Ugh!");
    case 4 :
    ~mesbox("The barbarian ignores you.");
    case 5 :
    ~chatnpc("<p,angry>Grr!");
    case 6 :
    ~chatnpc("<p,angry>Wanna fight?");
    npc_setmode(opplayer2);
    case 7 :
    ~chatnpc("<p,angry>I'm a little busy right now.|We're getting ready for our next barbarian raid!");
    case 8 :
    ~chatnpc("<p,angry>Go away!|This is our village!");
    case 9 :
    ~chatnpc("<p,quiz>Who are you?");
    ~chatplayer("<p,happy>I'm a bold adventurer!");
    ~chatnpc("<p,quiz>You don't look very strong...");
    case 10 :
    ~chatnpc("<p,quiz>Beer?");
}
