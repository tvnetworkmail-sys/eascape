[oploc1,dagexp_ladder33] ~climb_ladder(2_30_68_41_40, false);

// ---------------------------------------------------------------------------------------------
// The three round doors at the east end of the main cavern (2491,10130, 2491,10146 and
// 2491,10162). Each has two pressure pads in front of it, on its west side; in 2005 it opens only
// while a player stands on each pad, so it takes two (the wikis; a pet rock on a pad came in
// 2016). From behind (east of the doors) one opens by itself. Opening and how long it stays open
// (30 ticks) are 2009scape's (WaterBirthDungeonZone.java).
[oploc1,dagannoth_pressure_door] @wb_pressure_door;
[oploc1,dagannoth_pressure_door2] @wb_pressure_door;
[oploc1,dagannoth_pressure_door3] @wb_pressure_door;

[label,wb_pressure_door]
def_coord $door = loc_coord;
if (coordx(coord) < coordx($door)) {
    if (~wb_pad_held(movecoord($door, -1, 0, 0)) = false | ~wb_pad_held(movecoord($door, -1, 0, 2)) = false) {
        mes("You cannot see a way to open this door...");
        return;
    }
}
~sound_area(dagganoth_pressure_door_open, 0, $door, 10); // EASCape: the cache's pressure door sound
loc_change(loc_8962, ^wb_pressure_door_ticks);

// someone stands on the pad
[proc,wb_pad_held](coord $pad)(boolean)
if (coord = $pad) return(true);
huntall($pad, 0, ^vis_off);
while (.huntnext = true) {
    return(true);
}
return(false);
