// EASCape: the Waterbirth Island Dungeon's monsters that do more than fight (Waterbirth Island,
// 1 August 2005, and its expansion of 7 November 2005).

// ---------------------------------------------------------------------------------------------
// Door-supports. Three props hold shut the doors into the ladder room (2543,10143 west,
// 2545,10141 south, 2545,10145 north). One can't be knocked down from the path it blocks, only
// from behind it: from the ladder room, or with a ranged or magic attack from another path
// (2009scape WaterBirthDungeonZone.java's side rule; the message is Void's, DoorSupport.kt, and
// the wikis'). A rune thrownaxe's Chainhit bounces off one to the others in the ladder room's
// multiway area and knocks them all down (the wikis; skill_combat pvm_rune_thrownaxe.rs2 lets a
// bounce hit a support from any side). A knocked-down support takes its door's invisible block
// with it for 30 seconds (Void), then stands again.

// true if the active player is on the front of the active npc's support (the side it blocks)
[proc,wb_support_front]()(boolean)
def_int $x = coordx(coord);
def_int $z = coordz(coord);
def_int $sx = coordx(npc_coord);
def_int $sz = coordz(npc_coord);
if (npc_type = dagannoth_weak_door_north & $z > $sz) return(true);
if (npc_type = dagannoth_weak_door_west & $x < $sx) return(true);
if (npc_type = dagannoth_weak_door_south & $z < $sz) return(true);
return(false);

[proc,wb_door_support]()(boolean)
if (npc_type = dagannoth_weak_door_north | npc_type = dagannoth_weak_door_west | npc_type = dagannoth_weak_door_south) return(true);
return(false);

// from npc_is_attackable and npc_is_attackable_opt (skill_combat npc_combat.rs2)
[proc,wb_support_attackable]()(boolean)
if (~wb_support_front = true) {
    mes("This door does not seem to be openable from this side...");
    return(false);
}
return(true);

[ai_queue1,dagannoth_weak_door_north] npc_setmode(none); // it never fights back
[ai_queue1,dagannoth_weak_door_west] npc_setmode(none);
[ai_queue1,dagannoth_weak_door_south] npc_setmode(none);

[ai_queue3,dagannoth_weak_door_north] @wb_support_fall(dagannoth_weak_door_falling_north, dagannoth_weak_door_fallen_north);
[ai_queue3,dagannoth_weak_door_west] @wb_support_fall(dagannoth_weak_door_falling_west, dagannoth_weak_door_fallen_west);
[ai_queue3,dagannoth_weak_door_south] @wb_support_fall(dagannoth_weak_door_falling_south, dagannoth_weak_door_fallen_south);

// the support falls (the cache's "falling" npc plays the fall), lies there as the "fallen" one,
// and stands again when its time is up (npc_changetype reverts it)
[label,wb_support_fall](npc $falling, npc $fallen)
npc_setmode(none);
if (loc_find(npc_coord, dagcave_invisibleblocking) = true) {
    loc_del(^wb_support_down_ticks);
}
npc_changetype($falling, ^wb_support_down_ticks);
npc_delay(2);
npc_changetype($fallen, sub(^wb_support_down_ticks, 2));

// ---------------------------------------------------------------------------------------------
// Things that hide. Boulders are giant rock crabs and rocks are rock lobsters; when you come
// within 3 squares they show themselves and attack (Void GiantRockCrabs.kt and RockLobster.kt:
// hunt range 3, a 2-tick stand-up) and go back to hiding after 30 seconds out of a fight (Void).
// Each attack and each hit keeps it out another 30 seconds.

[ai_applayer2,giant_rockcrab_hidden] @wb_unhide(giant_rockcrab);
[ai_applayer2,giant_rockcrab_hidden_deeper] @wb_unhide(giant_rockcrab_deeper);
[ai_applayer2,dagannoth_rock_lobster_2x2_loc] @wb_unhide(dagannoth_rock_lobster_2x2);

[label,wb_unhide](npc $type)
def_player_uid $who = uid;
npc_setmode(none);
npc_changetype($type, ^wb_unhidden_ticks);
npc_delay(1); // Void: stand up, then attack
if (finduid($who) = false) return;
%npc_aggressive_player = uid;
~npc_set_attack_vars;
npc_setmode(opplayer2);

[ai_opplayer2,giant_rockcrab] @wb_unhidden_attack;
[ai_opplayer2,giant_rockcrab_deeper] @wb_unhidden_attack;
[ai_opplayer2,dagannoth_rock_lobster_2x2] @wb_unhidden_attack;
[ai_queue1,giant_rockcrab] @wb_unhidden_retaliate;
[ai_queue1,giant_rockcrab_deeper] @wb_unhidden_retaliate;
[ai_queue1,dagannoth_rock_lobster_2x2] @wb_unhidden_retaliate;

[label,wb_unhidden_attack]
// (a crab spawned as itself stays itself: npc_changetype to its own type just keeps it)
if (%npc_action_delay <= map_clock) npc_changetype(npc_type, ^wb_unhidden_ticks);
gosub(npc_default_attack);

[label,wb_unhidden_retaliate]
npc_changetype(npc_type, ^wb_unhidden_ticks);
gosub(npc_default_retaliate);

// ---------------------------------------------------------------------------------------------
// Eggs. Come within 3 squares and an egg opens, and two ticks later a dagannoth spawn comes out
// of it and attacks you; the egg stays open and the spawn lives for 5 minutes (Void
// DagannothEggHatch.kt; the 2-tick wait is 2009scape's).

[ai_applayer2,dungeon_dagganoth_egg1]
def_player_uid $who = uid;
npc_setmode(none);
npc_changetype(dungeon_dagganoth_egg2, ^wb_egg_open_ticks);
npc_delay(1);
npc_changetype(dungeon_dagganoth_egg3, sub(^wb_egg_open_ticks, 2));
npc_add(npc_coord, dagganoth_critter, ^wb_egg_open_ticks);
if (finduid($who) = false) return;
%npc_aggressive_player = uid;
~npc_set_attack_vars;
npc_setmode(opplayer2);

// ---------------------------------------------------------------------------------------------
// Monsters that attack from range (imported from Void, as tools/void/slayer.py writes them for
// the Slayer monsters it imports).
[ai_queue1,dungeon_dagganoth_magic_monster] ~npc_default_retaliate_ap;
[ai_opplayer2,dungeon_dagganoth_magic_monster] npc_setmode(applayer2);
[ai_applayer2,dungeon_dagganoth_magic_monster] ~eascape_npc_projattack(^magic_style);

[ai_queue1,dungeon_dagganoth_magic_monster_deeper] ~npc_default_retaliate_ap;
[ai_opplayer2,dungeon_dagganoth_magic_monster_deeper] npc_setmode(applayer2);
[ai_applayer2,dungeon_dagganoth_magic_monster_deeper] ~eascape_npc_projattack(^magic_style);

[ai_queue1,dagannoth_water_creature_1x1] ~npc_default_retaliate_ap;
[ai_opplayer2,dagannoth_water_creature_1x1] npc_setmode(applayer2);
[ai_applayer2,dagannoth_water_creature_1x1] ~wb_spinolyp_attack;

[ai_queue1,dagannoth_water_creature_1x12] ~npc_default_retaliate_ap;
[ai_opplayer2,dagannoth_water_creature_1x12] npc_setmode(applayer2);
[ai_applayer2,dagannoth_water_creature_1x12] ~wb_spinolyp_attack;

[ai_queue1,dagannoth_water_creature_1x13] ~npc_default_retaliate_ap;
[ai_opplayer2,dagannoth_water_creature_1x13] npc_setmode(applayer2);
[ai_applayer2,dagannoth_water_creature_1x13] ~wb_spinolyp_attack;

// the same for the secondary npc (the thrownaxe's bounce search, pvm_rune_thrownaxe.rs2)
[proc,.wb_door_support]()(boolean)
if (.npc_type = dagannoth_weak_door_north | .npc_type = dagannoth_weak_door_west | .npc_type = dagannoth_weak_door_south) return(true);
return(false);

[proc,wb_spinolyp](npc $type)(boolean)
if ($type = dagannoth_water_creature_1x1 | $type = dagannoth_water_creature_1x12 | $type = dagannoth_water_creature_1x13) return(true);
return(false);

[queue,spinolyp_attack_sound](int $ranged)
// EASCape (ours): one spinolyp attack sound per 4 ticks (one spinolyp attack cycle), so the
// pool's spinolyps firing on different ticks don't stack their sounds over each other
if (%spinolyp_sound_clock > map_clock) return;
%spinolyp_sound_clock = add(map_clock, 4);
// the cache's own spinolyp sounds: water_creature_attack for the magic attack,
// water_creature_spines for the ranged spines
if ($ranged = 1) {
    sound_synth(water_creature_spines, 1, 0);
} else {
    sound_synth(water_creature_attack, 1, 0);
}

// Spinolyps have two attacks (OSRS wiki, Spinolyp; Mod Ash 3 Sep 2015: "Both attacks roll the
// ranged accuracy against your ranged defence, but one deals magic damage and drains prayer"):
// - a Water Strike-looking magic attack: a successful hit drains 1 prayer point
// - a ranged attack like the ranged dagannoths' spines, which can poison
// Stats are the OSRS wiki's (all.npc): 100 hp, 10/10/10 melee, 1 magic, 100 ranged, no attack bonuses.
// Each hits up to 10 (eascape_maxhit), attack speed 4.
// Which attack is used each time is 50/50 (ours; no source gives the split). Protect from Magic
// blocks the magic one and Protect from Missiles the ranged one (ours: by the damage type).
[proc,wb_spinolyp_attack]
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
def_boolean $magic = false;
if (random(2) = 0) $magic = true;
def_int $attack_roll = ~npc_ranged_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^ranged_style);

npc_anim(npc_param(attack_anim), 0);
if ($magic = true) {
    queue(spinolyp_attack_sound, 0, 0);
} else {
    queue(spinolyp_attack_sound, 0, 1);
}
%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration;
if ($magic = true) {
    $duration = ~player_projectile(npc_coord, coord, uid, waterstrike_travel, 40, 36, 32, 15, 0, 11, 5);
} else {
    $duration = ~player_projectile(npc_coord, coord, uid, dagannoth_spine_spotanim_travel, 40, 36, 32, 15, 0, 11, 5);
}
if_close;
if (randominc($attack_roll) > randominc($defence_roll)) {
    def_int $damage = randominc(npc_param(eascape_maxhit));
    if ($magic = true) {
        if (~check_protect_prayer(^magic_style) = true) $damage = 0;
        spotanim_pl(waterstrike_impact, 92, $duration);
        // 2009scape SpinolypNPC: only a hit that does damage drains the prayer point
        if ($damage > 0) stat_sub(prayer, 1, 0);
    } else {
        if (~check_protect_prayer(^ranged_style) = true) $damage = 0;
        // 2009scape SpinolypNPC: a damaging ranged hit poisons 1 time in 20
        if ($damage > 0 & random(20) = 0) ~npc_poison_player;
    }
    anim(%com_defendanim, $duration);
    queue(combat_damage_player, calc($duration / 30), $damage);
} else {
    if ($magic = true) spotanim_pl(failedspell_impact, 92, $duration);
    anim(%com_defendanim, $duration);
    queue(combat_damage_player, calc($duration / 30), 0);
}
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;
