// EASCape: Jarvald, the ferryman between Rellekka and Waterbirth Island (Waterbirth Island,
// 1 August 2005). Dialogue from the RuneScape wiki's Transcript:Jarvald; the trip, the fare and
// where you land from 2009scape (JarvaldDialogue.kt): 1,000 coins each way out for an outerlander,
// free for a Fremennik, the ship lands at 2544,3759 on the island and 2620,3685 in Rellekka.
// In Rellekka he's viking_dagganoth_cave_ferryman_rellekka, which shows the "Travel" option
// once %dag_island_quick_travel is set (the cache's multinpc); that happens the first time you ask
// him "Can I come?".

[opnpc1,viking_dagganoth_cave_ferryman_rellekka] @wb_jarvald_rellekka;

[label,wb_jarvald_rellekka]
if (%viking = ^viking_complete) @wb_jarvald_fremennik;
~wb_jarvald("<p,neutral>What do you want from me outerlander? It is our policy not to associate with those not of our tribe.");
def_int $op = ~p_choice3_header("Where is your chieftain?", 1, "What Jarvald is doing.", 2, "Nothing", 3, "What would you like to ask about?");
if ($op = 1) {
    ~chatplayer("<p,angry>Where is your chieftain? I find it highly discriminatory to refuse to talk to someone on the grounds that they are not part of your tribe.");
    ~wb_jarvald("<p,neutral>I don't rightly understand your speech outerlander, but my loyalty is with Chieftain Brundt. He resides in our long hall; it is the large building over there, you should speak to him for he speaks for us all.");
    return;
}
if ($op = 3) {
    ~chatplayer("<p,neutral>Actually, I don't think I have anything to speak to you about...");
    return;
}
~chatplayer("<p,quiz>So what are you doing here?");
~wb_jarvald("<p,neutral>This should not concern you, outerlander. I am awaiting other Fremenniks to join me on an expedition to Waterbirth Island.");
@wb_jarvald_outerlander_options;

[label,wb_jarvald_outerlander_options]
def_int $op = ~p_choice4("Waterbirth Island?", 1, "Can I come?", 2, "Nice hat!", 3, "Ok, 'bye.", 4);
if ($op = 1) {
    ~wb_jarvald("<p,neutral>It is a small crescent-shaped island just north-west of here, outerlander. We have many legends about it, such as the tale of the broken sky, and the day of the green seas.");
    ~wb_jarvald("<p,neutral>The reason I am travelling there is more serious Fremennik business, however. I doubt an outerlander would be interested.");
    @wb_jarvald_outerlander_options;
}
if ($op = 2) {
    if (%dag_island_quick_travel = 0) {
        ~chatplayer("<p,happy>Hey, scary barbarian type guy, think I can join you on this expedition?");
        ~wb_jarvald("<p,shock>An outerlander join us on an honoured hunt???");
        ~wb_jarvald("<p,neutral>Well.... I guess... I might be able to allow you to join us, although it is a breach of many of our customs...");
        ~chatplayer("<p,happy>Oh, pleeeeease? I really LOVE killing stuff!");
        ~wb_jarvald("<p,neutral>Well... I remain unconvinced that it would be wise to allow an outerlander to join us in such dangerous battle, but your enthusiasm seems genuine enough...");
        ~wb_jarvald("<p,neutral>I will allow you to escort us, but you must pay me a sum of money first.");
        ~chatplayer("<p,shock>What? That's outrageous, why charge me money? And, uh, how much does it cost me?");
        ~wb_jarvald("<p,neutral>Ah, the outerlanders have stolen from my people for many years, in this way you can help my community with a small amount of money...");
        ~wb_jarvald("<p,neutral>Let us say... 1000 coins. Payable in advance, of course.");
        ~wb_jarvald("<p,neutral>For this I will take you to Waterbirth Island on my boat, and will bring you back here when you have had your fill of the hunt. Assuming you are still alive to wish to leave, of course.");
        %dag_island_quick_travel = 1;
    }
    @wb_jarvald_pay_trip;
}
if ($op = 3) {
    ~chatplayer("<p,happy>Hey, I have to say, that's a fine looking hat you are wearing there.");
    ~wb_jarvald("<p,neutral>It is actually a helm, outerlander, but the sentiment is appreciated nonetheless.");
    return;
}
~chatplayer("<p,happy>Wow, you Fremenniks sure know how to party. Well, see ya around.");

[label,wb_jarvald_pay_trip]
~wb_jarvald("<p,quiz>So do you have the 1000 coins for my service, and are you ready to leave now?");
if (~p_choice2("YES", 1, "NO", 2) = 2) {
    @wb_jarvald_decline;
}
if (inv_total(inv, coins) < 1000) {
    mes("You can not afford that.");
    ~wb_jarvald("<p,angry>Ah, outerlander... I go beyond my duty to allow you to accompany me, and you attempt to swindle me out of a reasonable fee? This is no way even for an outerlander to behave...");
    return;
}
inv_del(inv, coins, 1000);
@wb_jarvald_sail(true);

[label,wb_jarvald_decline]
~chatplayer("<p,neutral>No, actually I have some stuff to do here first.");
~wb_jarvald("<p,neutral>As you wish. Come and see me when your bloodlust needs sating.");

[label,wb_jarvald_fremennik]
~wb_jarvald("<p,happy>Greetings, <~get_viking_name>!");
if (compare(~get_viking_name, "Jarvald") = 0) {
    ~wb_jarvald("<p,happy>Ah, and what a glorious name that is! Worthy of only the finest warriors!");
    ~chatplayer("<p,happy>Heh. Yup, you're right there.");
}
~wb_jarvald("<p,quiz>So what brings you back to fair Rellekka? It has been too long since you have drunk in the long hall with us and sang of your battles!");
if (~p_choice2_header("What Jarvald is doing.", 1, "Nothing", 2, "What would you like to ask about?") = 2) {
    ~chatplayer("<p,neutral>Actually, I don't think I have anything to speak to you about...");
    return;
}
~chatplayer("<p,quiz>So what are you doing here?");
~wb_jarvald("<p,happy>You have not heard, <~get_viking_name>? I am leading an expedition to Waterbirth Island!");
@wb_jarvald_fremennik_options;

[label,wb_jarvald_fremennik_options]
def_int $op = ~p_choice4("Waterbirth Island?", 1, "Can I come?", 2, "Nice hat!", 3, "Ok, 'bye.", 4);
if ($op = 1) {
    ~wb_jarvald("<p,shock>You have not ever travelled to Waterbirth Island, <~get_viking_name>? I am surprised, it is a place of outstanding natural beauty.");
    ~wb_jarvald("<p,neutral>Or at least it used to be! But things have now changed...");
    ~chatplayer("<p,quiz>Changed? How do you mean, changed?");
    ~wb_jarvald("<p,neutral>It seems as though the sea-beasts known to us as the daggermouths have begun their hatching once again... And there may be others of their ilk there too.");
    ~chatplayer("<p,confused>Daggermouths?");
    ~wb_jarvald("<p,neutral>Aye, the daggermouths! The vile creatures lived near here once, but we had thought them all driven back to the ocean depths many moons past.");
    ~wb_jarvald("<p,neutral>I can only imagine a daggermouth queen has nested somewhere nearby, and spawned her foul brood under the sea once more, and some of them have migrated to fair Waterbirth Island.");
    ~chatplayer("<p,quiz>So you're scared they might attack Rellekka?");
    ~wb_jarvald("<p,laugh>Scared? Ha ha ha!");
    ~wb_jarvald("<p,happy>You wound us with your questioning, <~get_viking_name>!");
    ~wb_jarvald("<p,happy>We are glad the daggermouths have returned to these shores, for it means we will get the chance to hunt them once again as our ancestors did!");
    ~wb_jarvald("<p,happy>When treated in the correct manner, the creatures' remains can be used to make fine battleworthy armour!");
    @wb_jarvald_fremennik_options;
}
if ($op = 2) {
    ~chatplayer("<p,quiz>Can I come?");
    %dag_island_quick_travel = 1;
    ~wb_jarvald("<p,happy>Of course, <~get_viking_name>! Your presence is more than welcome on this cull! You wish to leave now?");
    if (~p_choice2("YES", 1, "NO", 2) = 2) {
        @wb_jarvald_decline;
    }
    @wb_jarvald_sail(true);
}
if ($op = 3) {
    ~chatplayer("<p,happy>Hey, I have to say, that's a fine looking hat you are wearing there.");
    ~wb_jarvald("<p,happy>Aye, that it is <~get_viking_name>! Skulgrimen fashioned it for me from the carcass of one of the monsters on Waterbirth Island after our last hunt!");
    ~wb_jarvald("<p,happy>I hope to kill enough creatures to fashion some fine armour as well when next we leave!");
    @wb_jarvald_fremennik_options;
}
~chatplayer("<p,happy>Wow, you Fremenniks sure know how to party. Well, see ya around.");

// "Travel" (Travel-Waterbirth in the transcript): straight to paying, or straight off for a Fremennik
[opnpc3,viking_dagganoth_cave_ferryman_rellekka] @wb_jarvald_rellekka_travel;

[label,wb_jarvald_rellekka_travel]
if (%viking = ^viking_complete) @wb_jarvald_sail(true);
@wb_jarvald_pay_trip;

// on the island
[opnpc1,viking_dagganoth_cave_waterbirth_island]
if (%viking = ^viking_complete) {
    ~chatnpc("<p,happy>Ah, <~get_viking_name>! Such glorious battle makes you feel glad of life, does it not?");
    ~chatnpc("<p,quiz>So what say you, stay here for the hunt, or return home to sweet Rellekka to feast and drink with your tribe?");
} else {
    ~chatnpc("<p,happy>Ah, you live yet, outerlander! Have you had your fill of the hunt and wish to return, or are you still feeling the joy of the cull?");
}
if (~p_choice2_header("Yes", 1, "No", 2, "Leave island?") = 2) {
    ~chatnpc("<p,laugh>Ha Ha Ha! A true huntsman at heart!");
    ~chatnpc("<p,happy>I myself have killed over a hundred of the daggermouths, and did not think it too many!");
    return;
}
~chatnpc("<p,happy>Then let us away; There will be death to bring here another day!");
@wb_jarvald_sail(false);

// "Travel" (Travel-Rellekka): straight back
[opnpc3,viking_dagganoth_cave_waterbirth_island] @wb_jarvald_sail(false);

// the screen fades out and in (the transcript); the fade is Eadgar's (quest_mm fade_out/fade_in)
[label,wb_jarvald_sail](boolean $to_island)
if_close;
if ($to_island = true) {
    mes("Leaving Rellekka for Waterbirth Island.");
} else {
    mes("Leaving Waterbirth Island for Rellekka.");
}
~fade_out;
p_delay(2);
if ($to_island = true) {
    p_telejump(^wb_island_landing);
} else {
    p_telejump(^wb_rellekka_landing);
}
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);
// the first time you land: Jarvald's warning about the cold (the transcript)
if ($to_island = true & %dagannoth_island_exposition_spam = 0) {
    %dagannoth_island_exposition_spam = 1;
    if (%viking = ^viking_complete) {
        ~chatnpc_specific("Jarvald", viking_dagganoth_cave_waterbirth_island, "<p,neutral>I would head straight for the cave and not tarry too long <~get_viking_name>, the cold winds on this island can cut right through you should you spend too long in them.");
    } else {
        ~chatnpc_specific("Jarvald", viking_dagganoth_cave_waterbirth_island, "<p,neutral>I suggest you head to the cave with some urgency outerlander, the cold air out here might be too much for the likes of you...");
    }
}

// in Rellekka he's the multinpc (viking_dagganoth_cave_ferryman_rellekka), which has no name or
// chathead of its own: the lines come from the one you see
[proc,wb_jarvald](string $text)
~chatnpc_specific("Jarvald", viking_dagganoth_cave_ferryman_island, $text);
