// EASCape: Waterbirth Island Dungeon drop tables, from Void (data/entity/npc/monster/wallasalki/wallasalki.drops.toml,
// animal/crab/crab.drops.toml, monster/rock/rock_lobster/rock_lobster.drops.toml) the way tools/void/slayer.py
// writes them (an item not in the 2006 game drops nothing). Kept here, not in eascape_void/void_drops.dbrow,
// so a re-run of the importer doesn't lose them. The sub-tables (herbs, seeds, talismans, gems) are Void's there.

[wb_drop_wallasalki]
table=eascape_drop
data=kind,0
data=roll,1
data=entry,bones,1,1,1,null,0
data=entry,null,0,0,1,wb_drop_wallasalki_secondary,128
data=entry,null,0,0,1,void_drop_medium_clue_scroll,128

