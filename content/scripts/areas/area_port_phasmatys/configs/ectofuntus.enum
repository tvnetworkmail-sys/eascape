// EASCape: bones the Ectofuntus bone grinder takes, and their pots of bonemeal (Void: bones.tables)
[ecto_bonemeal]
inputtype=obj
outputtype=namedobj
val=mm_skeleton_bones,pot_bonemeal_skeleton
val=bones,pot_bonemeal
val=bones_burnt,pot_bonemeal_burnt
val=bat_bones,pot_bonemeal_bat
val=wolf_bones,pot_bonemeal_wolf
val=mm_normal_monkey_bones,pot_bonemeal_normal_monkey
val=mm_small_zombie_monkey_bones,pot_bonemeal_small_zombie_monkey
val=mm_large_zombie_monkey_bones,pot_bonemeal_large_zombie_monkey
val=big_bones,pot_bonemeal_big
val=tbwt_jogre_bones,pot_bonemeal_jogre
val=mm_small_ninja_monkey_bones,pot_bonemeal_small_ninja_monkey
val=mm_medium_ninja_monkey_bones,pot_bonemeal_medium_ninja_monkey
val=mm_normal_gorilla_monkey_bones,pot_bonemeal_normal_gorilla_monkey
val=mm_bearded_gorilla_monkey_bones,pot_bonemeal_bearded_gorilla_monkey
val=tbwt_beast_bones,pot_bonemeal_beast
val=zogre_bones,pot_bonemeal_zogre
val=babydragon_bones,pot_bonemeal_babydragon
val=wyvern_bones,pot_bonemeal_wyvern
val=dragon_bones,pot_bonemeal_dragon
val=zogre_ancestral_bones_fayg,pot_bonemeal_ancestral_fayg
val=zogre_ancestral_bones_raurg,pot_bonemeal_ancestral_raurg
val=dagannoth_king_bones,pot_bonemeal_dagannoth
val=zogre_ancestral_bones_ourg,pot_bonemeal_ancestral_ourg

// worshipping with a pot of bonemeal: four times the bones' burying experience (Void: Ectofuntus.kt), in tenths
[ecto_bonemeal_xp]
inputtype=obj
outputtype=int
val=pot_bonemeal_skeleton,120
val=pot_bonemeal,180
val=pot_bonemeal_burnt,180
val=pot_bonemeal_bat,200
val=pot_bonemeal_wolf,180
val=pot_bonemeal_normal_monkey,200
val=pot_bonemeal_small_zombie_monkey,200
val=pot_bonemeal_large_zombie_monkey,200
val=pot_bonemeal_big,600
val=pot_bonemeal_jogre,600
val=pot_bonemeal_small_ninja_monkey,640
val=pot_bonemeal_medium_ninja_monkey,720
val=pot_bonemeal_normal_gorilla_monkey,720
val=pot_bonemeal_bearded_gorilla_monkey,800
val=pot_bonemeal_beast,1000
val=pot_bonemeal_zogre,900
val=pot_bonemeal_babydragon,1200
val=pot_bonemeal_wyvern,2000
val=pot_bonemeal_dragon,2880
val=pot_bonemeal_ancestral_fayg,3360
val=pot_bonemeal_ancestral_raurg,3840
val=pot_bonemeal_dagannoth,5000
val=pot_bonemeal_ancestral_ourg,5600
