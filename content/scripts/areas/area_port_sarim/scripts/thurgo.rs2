[opnpc1,thurgo]
if (~wom_letter(^wom_to_thurgo) = true) return; // the Wise Old Man's letter (area_draynor/wom_tasks.rs2)
if (~gd_thurgo_topic = true) @gd_thurgo; // The Giant Dwarf (quest_giant_dwarf/gd_items.rs2)
switch_int (%squire) {
    case ^squire_spoken_reldo : @thurgo_inquire;
    case ^squire_given_pie : @thurgo_special_sword_post_pie;
    case ^squire_spoken_thurgo, ^squire_looking_portrait, ^squire_looking_blurite, ^squire_complete : @thurgo_about_sword;
    case default :
        if (~gd_thurgo_hint = true) return; // The Giant Dwarf: what you're missing (ours)
        ~mesbox("Thurgo doesn't appear to be interested in talking.");
}
