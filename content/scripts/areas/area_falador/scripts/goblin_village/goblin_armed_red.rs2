[opnpc1,goblin_redarmour] @goblin_redarmour_talk;
[opnpc1,goblin_red_soldier_1] @goblin_redarmour_talk; // EASCape: a copy of this character that had no Talk-to script

[label,goblin_redarmour_talk]
~chatnpc("<p,goblinchat>Red armour best!");
switch_int(~p_choice2("Err ok.", 1, "Why is red best?", 2)) {
    case 1 :
        ~chatplayer("<p,confused>Err ok.");
    case 2 :
        ~chatplayer("<p,confused>Why is red best?");
        ~chatnpc("<p,goblinchat>Cos General Bentnoze says so,|and he bigger than me.");
}
