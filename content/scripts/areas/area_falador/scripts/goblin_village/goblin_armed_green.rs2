[opnpc1,goblin_greenarmour]
if (~hundred_goblins_helping = true) @hundred_village_goblin; // EASCape: Recipe for Disaster (hundred_goblins.rs2)
~chatnpc("<p,goblinchat>Green armour best.");
switch_int(~p_choice2("Err ok.", 1, "Why is green best?", 2)) {
    case 1 :
        ~chatplayer("<p,confused>Err ok.");
    case 2 :
        ~chatplayer("<p,confused>Why is green best?");
        ~chatnpc("<p,goblinchat>I forgot now,|but General Wartface says it is.|So it must be.");
}
