[opnpc1,general_wartface]
if (%lt_stage = ^lt_book_read) @lt_generals_start(general_wartface_talk); // The Lost Tribe
@general_wartface_talk;

[label,general_wartface_talk]
if (~hundred_goblins_helping = true) @hundred_goblin_generals; // EASCape: Recipe for Disaster (hundred_goblins.rs2)
switch_int (%goblinquest) {
    case 6 : @goblin_diplomacy_completed;
    case default : @goblin_diplomacy_greet_general_wartface;
}
