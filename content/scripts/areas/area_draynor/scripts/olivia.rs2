// EASCape: Olivia, the Draynor Seed Market (Seeds, Bankspace And Advisors, 6 June 2005). Her words
// are the OSRS wiki's Transcript:Olivia (2009scape's OliviaDialogue and Void's Olivia.kt say the
// same). Her shop is the cache's own (all.npc owned_shop seed_stall, sell 1200 / buy 600 / delta
// 30, the wiki's Draynor Seed Market numbers; stock from the cache's inv seed_stall).
// Stealing from her stalls (skill_thieving stealing_seed_stall) stops her trading with you for
// 10 minutes (the wiki's Olivia page), and she calls the market guards.

[opnpc1,seed_merchant]
if (getqueue(stolen_from_stall_seed) > 0) @olivia_thief;
~chatnpc("<p,happy>Would you like to trade in seeds?");
def_int $choice = ~p_choice3("Yes", 1, "No", 2, "Where do I get rarer seeds from?", 3);
if ($choice = 1) {
    ~openshop_activenpc;
} else if ($choice = 2) {
    ~chatplayer("<p,neutral>No, thanks.");
} else if ($choice = 3) {
    ~chatplayer("<p,quiz>Where do I get rarer seeds from?");
    ~chatnpc("<p,neutral>The Master Farmers usually carry a few rare seeds around with them, although I don't know if they'd want to part with them for any price to be honest.");
}

[opnpc3,seed_merchant]
if (getqueue(stolen_from_stall_seed) > 0) @olivia_thief;
~openshop_activenpc;

// Transcript:Olivia, overhead: "Interacting with her after stealing from her seed stalls recently"
[label,olivia_thief]
npc_say("You're the one who stole something from me!");
p_delay(1);
npc_say("Guards guards!");
npc_huntall(npc_coord, 5, 0);
while (npc_findnext = true) {
    if (npc_type = farming_market_guard & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
        ~npc_retaliate(0);
    }
}
