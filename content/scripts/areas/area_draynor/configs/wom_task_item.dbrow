data=hard,0

[wom_task_tin_ore]
table=wom_task_item
data=obj,tin_ore
data=intro,"I need a few lumps of tin ore."
data=hint,"You shouldn't have any trouble mining tin ore."
data=hard,0

[wom_task_ball_of_wool]
table=wom_task_item
data=obj,ball_of_wool
data=intro,"I saw an interesting bed in Karamja called a 'hammock'. It seemed to be made out of string, and I'd like some balls of wool so I can make my own."
data=hint,"You can buy shears from the general store east of here. Shear some sheep, then spin the wool into balls on the spinning wheel in Lumbridge Castle."
data=hard,1

[wom_task_bow_string]
table=wom_task_item
data=obj,bow_string
data=intro,"My shortbow's string is getting a bit worn out, so could you fetch me some bow strings?"
data=hint,"If you pick some flax, you can use the spinning wheel in Lumbridge Castle to spin it into bowstrings."
data=hard,1

