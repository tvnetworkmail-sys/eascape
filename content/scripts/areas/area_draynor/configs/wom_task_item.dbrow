// EASCape: the Wise Old Man's fetch tasks (Wise Old Man tasks: 3 to 15 of one item). Void's
// wise_old_man_items table: the items, what he says asking for them and where to get them (the
// OSRS wiki's Transcript:Wise Old Man has the same words), the skill level you need before he asks,
// and which are hard tasks (bigger rewards). Matched to our objs by id.

[wom_task_anchovies]
table=wom_task_item
data=obj,anchovies
data=intro,"I could do with some freshly cooked anchovies for a salad I'm planning."
data=hint,"Use a small fishing net to get anchovies from the sea south of here. Then cook them on a fire or range."
data=skill,fishing
data=level,15
data=hard,0

[wom_task_beer_glass]
table=wom_task_item
data=obj,beer_glass
data=intro,"My glassware got damaged when I moved here, so I need some new beer glasses."
data=hint,"If you get some seaweed and a bucket of sand, you'll be able to mix them at a furnace to make molten glass. Then use a glassblowing pipe to make beer glasses. Most of what you need can be found on Entrana."
data=hard,0

[wom_task_bones]
table=wom_task_item
data=obj,bones
data=intro,"My plans for today require some sets of bones, the normal-sized sort you get from goblins."
data=hint,"You'll find bones easily enough if you fight creatures."
data=hard,0

[wom_task_bronze_arrow]
table=wom_task_item
data=obj,bronze_arrow
data=intro,"I'm short of ammunition, so I could do with some bronze arrows. That way I can shoot at goblins through my window."
data=hint,"You can make them by chopping a log into arrowshafts and adding feathers to them, then smithing a bronze bar into arrowheads to complete the arrows."
data=hard,0

[wom_task_bronze_bar]
table=wom_task_item
data=obj,bronze_bar
data=intro,"I need some bronze bars."
data=hint,"Mine some copper ore and tin ore. The furnace in Lumbridge can smelt them into bars of bronze."
data=hard,0

[wom_task_bronze_dagger]
table=wom_task_item
data=obj,bronze_dagger
data=intro,"I need a few bronze daggers to keep the goblins at bay."
data=hint,"Try smelting some copper and tin ore to make bronze. Then hammer the bronze on an anvil to make daggers."
data=hard,0

[wom_task_bronze_axe]
table=wom_task_item
data=obj,bronze_axe
data=intro,"The head fell off my hatchet when I was chopping wood last week, so I need some more bronze hachets."
data=hint,"Try smelting some copper and tin ore to make bronze. Then hammer the bronze on an anvil to make hatchets."
data=hard,0

[wom_task_bronze_mace]
table=wom_task_item
data=obj,bronze_mace
data=intro,"I'd like some maces made of bronze."
data=hint,"Try smelting some copper and tin ore to make bronze. Then hammer the bronze on an anvil to make maces."
data=skill,smithing
data=level,2
data=hard,0

[wom_task_bronze_med_helm]
table=wom_task_item
data=obj,bronze_med_helm
data=intro,"I could do with some medium-sized helmets. I'd like bronze ones."
data=hint,"Try smelting some copper and tin ore to make bronze. Then hammer the bronze on an anvil to make helmets."
data=skill,smithing
data=level,3
data=hard,0

[wom_task_bronze_spear]
table=wom_task_item
data=obj,bronze_spear
data=intro,"I need some bronze spears."
data=hint,"If you kill some of those pesky goblins, you're bound to get some bronze spears."
data=skill,smithing
data=level,5
data=hard,0

[wom_task_bronze_sword]
table=wom_task_item
data=obj,bronze_sword
data=intro,"My weapons collection isn't all it used to be. Some short swords made of bronze would be much appreciated."
data=hint,"Try smelting some copper and tin ore to make bronze. Then hammer the bronze on an anvil to make short swords."
data=skill,smithing
data=level,5
data=hard,0

[wom_task_beer]
table=wom_task_item
data=obj,beer
data=intro,"Strange as it may seem, I want a lot of beer!"
data=hint,"There's a pub not far from here that will sell you plenty of that. Go west to Port Sarim."
data=hard,0

[wom_task_cadavaberries]
table=wom_task_item
data=obj,cadavaberries
data=intro,"I've found a use for cadava berries."
data=hint,"Just look around the woods south-west of Varrock."
data=hard,0

[wom_task_cooked_chicken]
table=wom_task_item
data=obj,cooked_chicken
data=intro,"I'm running short of food, so I'd like some cooked chickens."
data=hint,"You could try killing some chickens, then cooking their meat."
data=hard,0

[wom_task_cooked_meat]
table=wom_task_item
data=obj,cooked_meat
data=intro,"I'm a bit hungry. I'd like some cooked meat, not chicken or any sort of bird. And definitely not camel or rabbit either!"
data=hint,"Just cook some beef, rat or bear."
data=hard,0

[wom_task_copper_ore]
table=wom_task_item
data=obj,copper_ore
data=intro,"I need a few lumps of copper ore."
data=hint,"It should be easy enough for you to mine some copper ore."
data=hard,0

[wom_task_cow_hide]
table=wom_task_item
data=obj,cow_hide
data=intro,"I'd like a few cowhides."
data=hint,"If you slaughter some cows, you'll get cowhides easily enough."
data=hard,0

[wom_task_egg]
table=wom_task_item
data=obj,egg
data=intro,"I'm going to make an omelette, so I'll need some eggs."
data=hint,"Eggs are usually found where chickens are farmed."
data=hard,0

[wom_task_feather]
table=wom_task_item
data=obj,feather
data=intro,"I need a handful of feathers to stick in my beard."
data=hint,"The cheapest way to get feathers is to kill chickens."
data=hard,0

[wom_task_grain]
table=wom_task_item
data=obj,grain
data=intro,"I'd like a bit of grain."
data=hint,"There's a field full of it north of here."
data=hard,0

