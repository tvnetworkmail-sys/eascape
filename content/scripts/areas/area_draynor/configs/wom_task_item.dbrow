[wom_task_softclay]
table=wom_task_item
data=obj,softclay
data=intro,"I'll need some clay that's been softened so I can craft it."
data=hint,"If you mine some clay, you can use containers of water on it to soften it."
data=hard,0

[wom_task_leather_gloves]
table=wom_task_item
data=obj,leather_gloves
data=intro,"It's a bit nippy in this house, and my hands are cold. I need some leather gloves."
data=hint,"If you get the tanner in Al Kharid to turn some cowhides into leather, you'll be able to sew the gloves yourself. Buy a needle & thread from the crafting shop in Al Kharid."
data=hard,0

[wom_task_logs]
table=wom_task_item
data=obj,logs
data=intro,"This house is a bit cold, so I could do with some normal logs to burn."
data=hint,"I suggest you take a hatchet and chop down some standard trees."
data=hard,0

[wom_task_molten_glass]
table=wom_task_item
data=obj,molten_glass
data=intro,"Some chunks of molten glass would be the ideal patch for my cracked window."
data=hint,"Use a bucket of sand with some soda ash on a furnace."
data=hard,0

[wom_task_potato]
table=wom_task_item
data=obj,potato
data=intro,"I need some potatoes, if you'd be so kind."
data=hint,"There's a field of those north of Lumbridge."
data=hard,0

[wom_task_raw_rat_meat]
table=wom_task_item
data=obj,raw_rat_meat
data=intro,"I hear pet cats are getting popular these days. I'd like some raw rat in case I get one."
data=hint,"You should find some big rats south-east of here in the swamp."
data=hard,0

[wom_task_blankrune]
table=wom_task_item
data=obj,blankrune
data=intro,"I'd like to study the rune essence that the wizards have been talking about recently, so I need a few pieces."
data=hint,"Ask the Archmage in the tower south of here to teleport you to the Rune Essence mine. Then you can mine me some pieces."
data=hard,0
data=quest,^womq_rune_mysteries

[wom_task_shrimp]
table=wom_task_item
data=obj,shrimp
data=intro,"I could do with some freshly cooked shrimps for a salad I'm planning."
data=hint,"Use a small fishing net to get shrimps from the sea south of here. Then cook them on a fire or range."
data=hard,0

[wom_task_silk]
table=wom_task_item
data=obj,silk
data=intro,"My undergarments are getting a bit worn out. I'll be needing some sheets of silk to patch them."
data=hint,"There's a man in Al Kharid who sells it very cheaply. If you ever take any to Ardougne you'll get a good profit."
data=hard,0

[wom_task_leather]
table=wom_task_item
data=obj,leather
data=intro,"I'll be needing a few pieces of soft leather."
