// EASCape: the Icy Cavern between the Asgarnian Ice Dungeon and the skeletal wyverns' cave.
// Void has the pair (ice_dungeon_wyvern_cave_enter / _exit: "Enter" takes you through); the
// tiles are our 2006 map's: the dungeon side is north of the rock (by the danger sign), the
// wyverns' side south of it.
[oploc1,wyvern_snow_cave_entrance]
p_telejump(0_47_149_48_19);

[oploc1,wyvern_snow_cave_exit]
p_telejump(0_47_149_48_26);
