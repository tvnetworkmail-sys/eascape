[if_button,fairyrings_log:addheart26] ~fairy_rings_log_favourite(26, true);
[if_button,fairyrings_log:removeheart26] ~fairy_rings_log_favourite(26, false);
[if_button,fairyrings_log:button27] ~fairy_rings_log_pick(27);
[if_button,fairyrings_log:addheart27] ~fairy_rings_log_favourite(27, true);
[if_button,fairyrings_log:removeheart27] ~fairy_rings_log_favourite(27, false);
[if_button,fairyrings_log:button28] ~fairy_rings_log_pick(28);
[if_button,fairyrings_log:addheart28] ~fairy_rings_log_favourite(28, true);
