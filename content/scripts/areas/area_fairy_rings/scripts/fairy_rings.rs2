[if_button,fairyrings_log:button18] ~fairy_rings_log_pick(18);
[if_button,fairyrings_log:button19] ~fairy_rings_log_pick(19);
[if_button,fairyrings_log:button20] ~fairy_rings_log_pick(20);
[if_button,fairyrings_log:button21] ~fairy_rings_log_pick(21);
[if_button,fairyrings_log:button22] ~fairy_rings_log_pick(22);
[if_button,fairyrings_log:button23] ~fairy_rings_log_pick(23);
[if_button,fairyrings_log:button24] ~fairy_rings_log_pick(24);
[if_button,fairyrings_log:button25] ~fairy_rings_log_pick(25);
[if_button,fairyrings_log:button26] ~fairy_rings_log_pick(26);
[if_button,fairyrings_log:button27] ~fairy_rings_log_pick(27);
[if_button,fairyrings_log:button28] ~fairy_rings_log_pick(28);
[if_button,fairyrings_log:button29] ~fairy_rings_log_pick(29);
[if_button,fairyrings_log:button30] ~fairy_rings_log_pick(30);
[if_button,fairyrings_log:button31] ~fairy_rings_log_pick(31);
[if_button,fairyrings_log:button32] ~fairy_rings_log_pick(32);
[if_button,fairyrings_log:button33] ~fairy_rings_log_pick(33);
[if_button,fairyrings_log:button34] ~fairy_rings_log_pick(34);
[if_button,fairyrings_log:button35] ~fairy_rings_log_pick(35);
