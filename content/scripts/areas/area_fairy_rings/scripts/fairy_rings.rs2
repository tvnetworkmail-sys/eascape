// EASCape: the fairy ring network (Fairytale II). From the OSRS wiki (Fairy ring): the rings work
// once the Fairy Godfather has given you permission, while you wield a dramen staff ("The fairy
// rings only work for those who wield fairy magic."); a code with no ring, or the ring you are at,
// leaves you where you are ("Wow, fairy magic sure is useful, I hardly moved at all!"); the
// hideout is reached by dialling AIR, DLR, DJQ and AJS in that order; the right-click options are
// the OSRS ones (Zanaris, Configure, Last-destination). The code screen is the August 2007 cache's
// (fairyrings.if), its dials turning a quarter at a time clockwise, as in 2007 (one letter layer
// per quarter turn; the 2007 dial varbits count A, D, C, B). Void's code (FairyRing.kt): no
// permission ("You don't have permission to use that fairy ring.").
// Our choices: a code that needs a quest you haven't done also leaves you where you are; the
// travel log (fairyrings_log.if) lists the codes you have used, in code order; Last-destination
// with no code used yet says so.

// ---------------------------------------------------------------- the rings' options
[oploc1,_fairy_ring]
if (~fairy_rings_can_use = false) {
    return;
}
~fairy_rings_travel(loc_coord, ^fairyring_zanaris);
~fairy_rings_visited(~fairy_rings_index_of("BKS"));

[oploc2,_fairy_ring] ~fairy_rings_configure(loc_coord);
[oploc1,_fairy_ring_zanaris] ~fairy_rings_configure(loc_coord);

[oploc3,_fairy_ring] ~fairy_rings_last(loc_coord);
[oploc3,_fairy_ring_zanaris] ~fairy_rings_last(loc_coord);

[proc,fairy_rings_can_use]()(boolean)
if (%fairy2_queencure_quest < ^fairy2_rings_allowed & %fairyring_test_unlock = 0) {
    mes("You don't have permission to use that fairy ring.");
    return(false);
}
if (inv_total(worn, dramen_staff) = 0) {
    mes("The fairy rings only work for those who wield fairy magic.");
    return(false);
}
return(true);

[proc,fairy_rings_last](coord $ring)
if (~fairy_rings_can_use = false) {
    return;
}
if (%fairyring_last = 0) {
    mes("You haven't travelled by fairy ring yet.");
    return;
}
~fairy_rings_go($ring, calc(%fairyring_last - 1));

// ---------------------------------------------------------------- the code screen
[proc,fairy_rings_configure](coord $ring)
if (~fairy_rings_can_use = false) {
    return;
}
%fairyring_at = $ring;
~fairy_rings_show_dials;
~fairy_rings_fill_log;
if_openmain_side(fairyrings, fairyrings_log);

[if_button,fairyrings:turn1] ~fairy_rings_turn(1, 1);
[if_button,fairyrings:turn2] ~fairy_rings_turn(2, 1);
[if_button,fairyrings:turn3] ~fairy_rings_turn(3, 1);

[if_button,fairyrings:teleport]
if_close;
if (~fairy_rings_can_use = false) {
    return;
}
~fairy_rings_go(%fairyring_at, ~fairy_rings_dialled);

// the code on the dials (the dial varbits count A, D, C, B: letter = (4 - value) % 4)
[proc,fairy_rings_dialled]()(int)
return(calc(((4 - %fairyring_dial1) % 4) * 16 + ((4 - %fairyring_dial2) % 4) * 4 + (4 - %fairyring_dial3) % 4));

// Each dial shows its A, I or P layer turned by its varbit's quarters (the 2007 animations hold
// their last frame); the other three layers of each dial stay hidden.
[proc,fairy_rings_show_dials]
if_sethide(fairyrings:d1_b, true);
if_sethide(fairyrings:d1_c, true);
if_sethide(fairyrings:d1_d, true);
if_sethide(fairyrings:d2_j, true);
if_sethide(fairyrings:d2_k, true);
if_sethide(fairyrings:d2_l, true);
if_sethide(fairyrings:d3_q, true);
if_sethide(fairyrings:d3_r, true);
if_sethide(fairyrings:d3_s, true);
if_sethide(fairyrings:d1_a, false);
if_sethide(fairyrings:d2_i, false);
if_sethide(fairyrings:d3_p, false);
~fairy_rings_dial_anim(1, ~fairy_rings_still(%fairyring_dial1));
~fairy_rings_dial_anim(2, ~fairy_rings_still(%fairyring_dial2));
~fairy_rings_dial_anim(3, ~fairy_rings_still(%fairyring_dial3));

[proc,fairy_rings_still](int $quarters)(seq)
switch_int ($quarters) {
    case 1 : return(ft2_dial_at_1);
    case 2 : return(ft2_dial_at_2);
    case 3 : return(ft2_dial_at_3);
}
return(null);

// turn a dial $turns quarters clockwise (1 or 2; 3 is one anticlockwise), with the 2007 animation
[proc,fairy_rings_turn](int $dial, int $turns)
def_int $from = ~fairy_rings_dial_get($dial);
def_seq $anim = null;
switch_int (calc($turns % 4)) {
    case 1 : $anim = enum(int, seq, fairy_rings_dial_cw, $from);
    case 2 : $anim = enum(int, seq, fairy_rings_dial_cw2, $from);
    case 3 : $anim = enum(int, seq, fairy_rings_dial_acw, $from);
    case default : return;
}
~fairy_rings_dial_set($dial, calc(($from + $turns) % 4));
~fairy_rings_dial_anim($dial, $anim);

[proc,fairy_rings_dial_get](int $dial)(int)
switch_int ($dial) {
    case 1 : return(%fairyring_dial1);
    case 2 : return(%fairyring_dial2);
}
return(%fairyring_dial3);

[proc,fairy_rings_dial_set](int $dial, int $value)
switch_int ($dial) {
    case 1 : %fairyring_dial1 = $value;
    case 2 : %fairyring_dial2 = $value;
    case default : %fairyring_dial3 = $value;
}

// the wooden dial and its four toadstools turn together (null first, so it starts again)
[proc,fairy_rings_dial_anim](int $dial, seq $anim)
switch_int ($dial) {
    case 1 :
        ~fairy_rings_anim5(fairyrings:dial1, fairyrings:d1_a_1, fairyrings:d1_a_2, fairyrings:d1_a_3, fairyrings:d1_a_4, $anim);
    case 2 :
        ~fairy_rings_anim5(fairyrings:dial2, fairyrings:d2_i_1, fairyrings:d2_i_2, fairyrings:d2_i_3, fairyrings:d2_i_4, $anim);
    case default :
        ~fairy_rings_anim5(fairyrings:dial3, fairyrings:d3_p_1, fairyrings:d3_p_2, fairyrings:d3_p_3, fairyrings:d3_p_4, $anim);
}

[proc,fairy_rings_anim5](component $a, component $b, component $c, component $d, component $e, seq $anim)
if_setanim($a, null);
if_setanim($b, null);
if_setanim($c, null);
if_setanim($d, null);
if_setanim($e, null);
if ($anim = null) {
    return;
}
if_setanim($a, $anim);
if_setanim($b, $anim);
if_setanim($c, $anim);
if_setanim($d, $anim);
if_setanim($e, $anim);

// set the dials to a code (the travel log), turning each the shorter way
[proc,fairy_rings_set_dials](int $index)
~fairy_rings_turn(1, calc(((4 - $index / 16) % 4 - %fairyring_dial1 + 4) % 4));
~fairy_rings_turn(2, calc(((4 - ($index / 4) % 4) % 4 - %fairyring_dial2 + 4) % 4));
~fairy_rings_turn(3, calc(((4 - $index % 4) % 4 - %fairyring_dial3 + 4) % 4));

// ---------------------------------------------------------------- the travel log
// the codes you've used, in code order (favourites were taken out)
[proc,fairy_rings_log_code](int $slot)(int)
def_int $n = 0;
def_int $pass = 0;
while ($pass < 2) {
    def_int $i = 0;
    while ($i < 64) {
        if (~fairy_rings_has_visited($i) = true & ~fairy_rings_row($i) ! null) {
            if (($pass = 0 & ~fairy_rings_is_favourite($i) = true) | ($pass = 1 & ~fairy_rings_is_favourite($i) = false)) {
                if ($n = $slot) {
                    return($i);
                }
                $n = calc($n + 1);
            }
        }
        $i = calc($i + 1);
    }
    $pass = calc($pass + 1);
}
return(-1);

// one pass over the codes for each half of the list (favourites, then the rest), each row placed
// under the one before at its own height (fairy_rings_log.enum, fairyrings_log.if)
[proc,fairy_rings_fill_log]
def_int $slot = 0;
def_int $y = 1;
def_int $pass = 0;
while ($pass < 2) {
    def_int $i = 0;
    while ($i < 64 & $slot < 36) {
        if (~fairy_rings_has_visited($i) = true) {
            def_boolean $fav = ~fairy_rings_is_favourite($i);
            if (($pass = 0 & $fav = true) | ($pass = 1 & $fav = false)) {
                def_dbrow $row = ~fairy_rings_row($i);
                if ($row ! null) {
                    $y = calc($y + ~fairy_rings_log_slot($slot, $row, $fav, $y));
                    $slot = calc($slot + 1);
                }
            }
        }
        $i = calc($i + 1);
    }
    $pass = calc($pass + 1);
}
if ($slot = 0) {
    if_settext(fairyrings_log:empty, "No fairy ring codes used yet.");
} else {
    if_settext(fairyrings_log:empty, "");
}
while ($slot < 36) {
    if_sethide(enum(int, component, fairy_rings_log_slots, $slot), true);
    $slot = calc($slot + 1);
}

// the code, its place in one or two lines, its heart and its Select box; returns its height
[proc,fairy_rings_log_slot](int $slot, dbrow $row, boolean $fav, int $y)(int)
def_string $line2 = "";
def_int $height = 29;
def_boolean $two = false;
if (db_getfieldcount($row, fairy_ring_code:line2) > 0) {
    $line2 = db_getfield($row, fairy_ring_code:line2, 0);
    $height = 42;
    $two = true;
}
def_component $layer = enum(int, component, fairy_rings_log_slots, $slot);
if_setposition($layer, 0, $y);
if_sethide($layer, false);
if_settext(enum(int, component, fairy_rings_log_codes, $slot), db_getfield($row, fairy_ring_code:code, 0));
if_settext(enum(int, component, fairy_rings_log_line1s, $slot), db_getfield($row, fairy_ring_code:line1, 0));
if_settext(enum(int, component, fairy_rings_log_line2s, $slot), $line2);
if_sethide(enum(int, component, fairy_rings_log_shorts, $slot), $two);
if_sethide(enum(int, component, fairy_rings_log_talls, $slot), ~fairy_rings_not_bool($two));
// EASCape: no favourites (your call, 31 Oct 2026): the hearts stay hidden
if_sethide(enum(int, component, fairy_rings_log_adds, $slot), true);
if_sethide(enum(int, component, fairy_rings_log_removes, $slot), true);
return($height);

[proc,fairy_rings_not_bool](boolean $b)(boolean)
if ($b = true) {
    return(false);
}
return(true);

[proc,fairy_rings_log_pick](int $slot)
def_int $index = ~fairy_rings_log_code($slot);
if ($index ! -1) {
    ~fairy_rings_set_dials($index);
}

// up to ten favourites (OSRS wiki, Fairy ring)
[proc,fairy_rings_log_favourite](int $slot, boolean $add)
def_int $index = ~fairy_rings_log_code($slot);
if ($index = -1) {
    return;
}
if ($add = true) {
    if (calc(bitcount(%fairyring_fav1) + bitcount(%fairyring_fav2)) >= 10) {
        mes("You can only have ten favourite fairy ring codes.");
        return;
    }
    if ($index < 32) {
        %fairyring_fav1 = setbit(%fairyring_fav1, $index);
    } else {
        %fairyring_fav2 = setbit(%fairyring_fav2, calc($index - 32));
    }
} else if ($index < 32) {
    %fairyring_fav1 = clearbit(%fairyring_fav1, $index);
} else {
    %fairyring_fav2 = clearbit(%fairyring_fav2, calc($index - 32));
}
~fairy_rings_fill_log;

// EASCape: favourites are gone (your call, 31 Oct 2026), so the log is in code order; the saved
// bits are left alone
[proc,fairy_rings_is_favourite](int $index)(boolean)
return(false);
if ($index < 32) {
    if (testbit(%fairyring_fav1, $index) = ^true) {
        return(true);
    }
    return(false);
}
if (testbit(%fairyring_fav2, calc($index - 32)) = ^true) {
    return(true);
}
return(false);

[proc,fairy_rings_has_visited](int $index)(boolean)
if ($index < 32) {
    if (testbit(%fairyring_log1, $index) = ^true) {
        return(true);
    }
    return(false);
}
if (testbit(%fairyring_log2, calc($index - 32)) = ^true) {
    return(true);
}
return(false);

[proc,fairy_rings_visited](int $index)
if ($index < 0) {
    return;
}
if ($index < 32) {
    %fairyring_log1 = setbit(%fairyring_log1, $index);
} else {
    %fairyring_log2 = setbit(%fairyring_log2, calc($index - 32));
}

[proc,fairy_rings_row](int $index)(dbrow)
db_find(fairy_ring_code:index, $index);
return(db_findnext);

[proc,fairy_rings_index_of](string $code)(int)
def_int $i = 0;
while ($i < 64) {
    def_dbrow $row = ~fairy_rings_row($i);
    if ($row ! null) {
        if (compare(db_getfield($row, fairy_ring_code:code, 0), $code) = 0) {
            return($i);
        }
    }
    $i = calc($i + 1);
}
return(-1);

// ---------------------------------------------------------------- travelling
[proc,fairy_rings_go](coord $ring, int $index)
%fairyring_last = calc($index + 1);
def_dbrow $row = ~fairy_rings_row($index);
def_string $code = "";
if ($row ! null) {
    $code = db_getfield($row, fairy_ring_code:code, 0);
}
// the hideout: AIR, DLR, DJQ, AJS, one after the other
def_int $seq = %fairyring_seq;
%fairyring_seq = 0;
if (compare($code, "AIR") = 0) {
    %fairyring_seq = 1;
} else if ($seq = 1 & compare($code, "DLR") = 0) {
    %fairyring_seq = 2;
} else if ($seq = 2 & $index = ^fairyring_djq) {
    %fairyring_seq = 3;
} else if ($seq = 3 & compare($code, "AJS") = 0) {
    // Fairytale II's hideout, once you've worked out the way (quest_fairy2/fairy2_hideout.rs2)
    if (~fairy2_hideout_open = true) {
        ~fairy_rings_travel($ring, ^fairyring_hideout);
        ~fairy2_hideout_arrived;
        return;
    }
}
if ($row = null) {
    ~fairy_rings_stay($ring);
    return;
}
if (~fairy_rings_unlocked(db_getfield($row, fairy_ring_code:lock, 0)) = false) {
    ~fairy_rings_stay($ring);
    return;
}
def_coord $dest = db_getfield($row, fairy_ring_code:dest, 0);
// the Fisher King's realm: as the magic whistle takes you (quest_grail.rs2)
if (compare($code, "BJR") = 0 & %grail < ^grail_given_whistle) {
    $dest = movecoord($dest, 128, 0, 0);
}
if (distance($dest, $ring) < 3) {
    ~fairy_rings_stay($ring);
    return;
}
~fairy_rings_visited($index);
~fairy_rings_travel($ring, $dest);

[proc,fairy_rings_unlocked](int $lock)(boolean)
switch_int ($lock) {
    case 1 : if (%priestperil >= ^priestperil_complete) { return(true); }
    case 2 : if (%grail > ^grail_not_started) { return(true); }
    case 3 : if (%viking >= ^viking_complete) { return(true); }
    case default : return(true);
}
return(false);

[proc,fairy_rings_stay](coord $ring)
~fairy_rings_travel($ring, $ring);
say("Wow, fairy magic sure is useful, I hardly moved at all!");

// into the middle of the ring, the flowers, and out at the other ring
[proc,fairy_rings_travel](coord $ring, coord $dest)
if_close;
if (coord ! $ring) {
    facesquare($ring);
    p_exactmove(coord, $ring, 0, 30, ~fairy_rings_dir(coord, $ring));
    p_delay(0);
}
anim(human_fairy_vanish, 0);
spotanim_pl(fairy_flower_ring, 0, 0);
// the sound: 2009Scape (TeleportManager FAIRY_RING, Sounds.FT_FAIRY_TELEPORT_1098), our FT_fairy_teleport
sound_synth(FT_fairy_teleport, 1, 0);
p_delay(2);
p_telejump($dest);
anim(human_fairy_appear, 0);
p_delay(0);

[proc,fairy_rings_dir](coord $from, coord $to)(int)
if (coordz($to) > coordz($from)) {
    return(^exact_north);
}
if (coordz($to) < coordz($from)) {
    return(^exact_south);
}
if (coordx($to) > coordx($from)) {
    return(^exact_east);
}
return(^exact_west);
