// EASCape: the fairy ring codes. index is the code's place in the 64: the first letter's
// (A B C D = 0-3) x 16 + the second's (I J K L) x 4 + the third's (P Q R S).
[fairy_ring_code]
column=index,int,INDEXED,REQUIRED
column=code,string,REQUIRED
column=dest,coord,REQUIRED
column=name,string,REQUIRED
column=lock,int
