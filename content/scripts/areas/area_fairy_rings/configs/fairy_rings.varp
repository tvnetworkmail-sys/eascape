// EASCape: the codes you have used, for the travel log: bit n of fairyring_log1 is code n (0-31),
// of fairyring_log2 code 32 + n (fairy_rings.dbtable: index)
[fairyring_log1]
scope=perm

[fairyring_log2]
scope=perm

// the ring you opened the code screen at
[fairyring_at]
type=coord

// ::fairyrings (test command): the rings work without Fairytale II's permission
[fairyring_test_unlock]
scope=perm
