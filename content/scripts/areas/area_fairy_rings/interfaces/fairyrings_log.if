// EASCape: the fairy ring travel log (side panel), made by tools/fairytale2/ring_log_interface.py.
// The scripts fill the slots in code order with the codes you have used and hide the rest.

[title]
type=text
x=0
y=4
width=190
height=16
font=b12_full
center=yes
shadowed=yes
text=Travel log
colour=0xFF981F

[empty]
