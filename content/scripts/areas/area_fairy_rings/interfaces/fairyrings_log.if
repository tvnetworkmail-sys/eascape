// EASCape: the fairy ring travel log (side panel), made by tools/fairytale2/ring_log_interface.py.
// The scripts fill the slots (favourites first, then code order) and hide the rest.

[parchment]
type=graphic
x=0
y=0
width=190
height=261
graphic=eascape_parchment,0

[title]
type=text
x=0
y=6
width=190
height=16
font=b12_full
center=yes
text=Travel log
colour=0x3E2A12

[empty]
type=text
x=10
y=40
width=170
height=40
font=p11_full
text=No fairy ring codes used yet.
colour=0x3E2A12

[list]
type=layer
x=4
y=26
width=166
height=230
scroll=1372

