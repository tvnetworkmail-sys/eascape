// EASCape: the law and death rifts went to the nature altar and to Lumbridge; their places are
// Void's (abyss.teles.toml: law_rift, death_rift). As on Entrana, no weapons or armour into the
// law altar (the monks' own check); the message is ours.
[oploc1,abyss_exit_to_law]
if (~has_entrana_restricted_items = true) {
    mes("You can't take weapons or armour through to the Law altar.");
    return;
}
p_telejump(0_38_75_32_26);

