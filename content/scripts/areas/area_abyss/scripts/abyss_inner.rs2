// EASCape: only once Lost City is done (both wikis' Abyss pages: "cannot be accessed until the
// quest Lost City has been completed"); the message is ours
[oploc1,abyss_exit_to_cosmic]
if (%zanaris ! ^zanaris_complete) {
    mes("You need to have completed the Lost City quest to use this rift.");
    return;
}
p_telejump(0_33_75_30_36);

[oploc1,abyss_exit_to_chaos]
p_telejump(0_35_75_29_40);

[oploc1,abyss_exit_to_nature]
p_telejump(0_37_75_32_44);

// EASCape: the law and death rifts went to the nature altar and to Lumbridge; their places are
// Void's (abyss.teles.toml: law_rift, death_rift). Weapons and armour may go through the law rift;
// it's the temple's portal out to Entrana that won't take them (the RuneScape wiki's Abyss page;
// runecraft.rs2 [oploc1,_rc_exit_portal]).
[oploc1,abyss_exit_to_law]
p_telejump(0_38_75_32_26);

[oploc1,abyss_exit_to_death]
if (~me2_death_ok(false) = false) return; // EASCape: Mourning's End Part II (quest_mourning2/me2_npcs.rs2)
p_telejump(0_34_75_29_38);

[oploc1,abyss_exit_to_blood]
mes("A strange power blocks your exit.");

[oploc1,abyss_exit_to_soul]
mes("A strange power blocks your exit.");
