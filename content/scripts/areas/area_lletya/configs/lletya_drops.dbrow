// EASCape: the Lletya elf warriors and archers (mourning_guard_melee, _melee2, _range, _range2).
// Void's elf_warrior_drop_table (bones, the secondary roll, the hard clue at 1/128) with the
// Lletya roll of the OSRS wiki's Elf Warrior and the RS wiki's "Lletya drops": the Iorwerth
// camp's 1/128 blank crystal is replaced by Lletya's teleport crystal (1) at 1/128, and the
// crystal teleport seed (the tiny elf crystal Eluned re-enchants) is added at 25/128, which
// fills the table to 128.
[lletya_elf_drop_table]
table=eascape_drop
data=kind,0
data=roll,1
data=entry,bones,1,1,1,null,0
data=entry,null,0,0,1,lletya_elf_secondary,128
data=entry,null,0,0,1,void_drop_hard_clue_scroll,128

