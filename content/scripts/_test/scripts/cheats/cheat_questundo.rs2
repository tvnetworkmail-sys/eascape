// EASCape: ::~questundo <quest> resets every variable the quest uses (generated from the quest's own scripts),
// so it can be played again. Items and xp it gave stay. ::~questundo list names them.
[debugproc,questundo](string $name)
if (p_finduid(uid) = false) return;
if (compare($name, "list") = 0) {
    mes("agrith ahoy arena arthur ball biohazard blackarmgang chompybird");
    mes("cog cook creatureoffenkenstrain crest deal death demon desertrescue");
    mes("deserttreasure devious doric dragon druid druidspirit drunkmonk dwarfrock");
    mes("eadgar elemental_workshop elena elid fairy2 fairy_farmers feud fishingcompo");
    mes("fluffs forget fortress garden giantdwarf gobdip golem grail");
    mes("grandtree haunted hauntedmine hazeelcult hero hetty horror hunt");
    mes("ics_little ikov imp itexam itgronigen itwatchtower junglepotion legends");
    mes("lost_tribe makinghistory mcannon mdaughter misc mm mortton mourning");
    mes("mourning2 murder onesmallfavour priest priestperil prince ratcatch rd");
    mes("regicide romeojuliet routequest roving_elves runemysteries scorpcatcher seaslug sheep");
    mes("sheepherder squire tbwt tog totem tree troll troll_love");
    mes("twocats upass vampire viking wanted waterfall zanaris zogre");
    mes("zombiequeen");
    return;
}
if (compare($name, "agrith") = 0) {
    %agrith_quest = 0;
    mes("Shadow of the Storm reset.");
