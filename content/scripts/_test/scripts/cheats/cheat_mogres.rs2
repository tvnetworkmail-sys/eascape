// EASCape: test commands for Mogres, Lizards, Pet Fish, Potions and Potatoes! (24 October 2005).

// ::dairypack - the dairy churns and baked potatoes: Cooking up to 48 if it's lower (cheese at a
// churn), 3 buckets of milk, a pot of cream, a pat of butter, 2 potatoes and a cheese. Churns are
// in farm houses (one at 3226,3294, north of Lumbridge); potatoes bake on a range only.
[debugproc,dairypack]
if (p_finduid(uid) = false) return;
if (stat_base(cooking) < 48) stat_advance(cooking, calc(830140 - stat_xp(cooking))); // 83,014 xp
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(bucket_milk, 3));
$banked = calc($banked + ~questpack_give(pot_of_cream, 1));
$banked = calc($banked + ~questpack_give(pot_of_butter, 1));
$banked = calc($banked + ~questpack_give(potato, 2));
$banked = calc($banked + ~questpack_give(cheese, 1));
if ($banked > 0) mes("<tostring($banked)> of the items went to your bank (no room in your pack).");
mes("Churn: milk makes cream, butter or cheese (21/38/48 Cooking); cream makes butter or cheese; butter makes cheese.");
mes("Bake a potato on a range, add a pat of butter (39), then cheese (47).");

// ::fishpack - pet fish: Crafting up to 42 if it's lower (fishbowls), a glassblowing pipe,
// 2 molten glass, 2 seaweed, a guam leaf, a pestle and mortar and 20 coins. Blow a fishbowl, fill
// it at water, add seaweed, buy a tiny net from Harry (Catherby's fishing shop, the aquarium is
// by him at 2830,3442) and Fish-In the aquarium. Harry gives the empty fish food box.
[debugproc,fishpack]
if (p_finduid(uid) = false) return;
if (stat_base(crafting) < 42) stat_advance(crafting, calc(455290 - stat_xp(crafting))); // 45,529 xp
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(glassblowingpipe, 1));
$banked = calc($banked + ~questpack_give(molten_glass, 2));
$banked = calc($banked + ~questpack_give(seaweed, 2));
$banked = calc($banked + ~questpack_give(guam_leaf, 1));
$banked = calc($banked + ~questpack_give(pestle_and_mortar, 1));
$banked = calc($banked + ~questpack_give(coins, 20));
if ($banked > 0) mes("<tostring($banked)> of the items went to your bank (no room in your pack).");
mes("Glassblowing pipe on molten glass: Fishbowl. Fill it at water, add seaweed, then see Harry in Catherby for a tiny net.");

// ::skippypack - Skippy and the Mogres: a bucket of water, a bowl of nettle tea, a hangover cure
// and 2 fishing explosives (and Slayer up to 32 if it's lower, for the mogres).
[debugproc,skippypack]
if (p_finduid(uid) = false) return;
if (stat_base(slayer) < 32) stat_advance(slayer, calc(164560 - stat_xp(slayer))); // 16,456 xp
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(bucket_water, 1));
$banked = calc($banked + ~questpack_give(bowl_nettletea, 1));
$banked = calc($banked + ~questpack_give(hangover_cure, 1));
$banked = calc($banked + ~questpack_give(fishing_explosive, 2));
if ($banked > 0) mes("<tostring($banked)> of the items went to your bank (no room in your pack).");
mes("Sober-Up Skippy with the water (or use it on him), then give him the tea, then the cure. ::skippytele 1 / 2.");

// ::skippystage <n> - sets skippy_state: 0 drunk (not started), 1 damp (wants nettle tea),
// 2 hungover (wants the hangover cure), 3 sober (done: mogres can be lured and given as tasks)
[debugproc,skippystage](int $n)
if (p_finduid(uid) = false) return;
if ($n < 0 | $n > 3) {
    mes("::skippystage 0 drunk, 1 damp, 2 hungover, 3 sober (done).");
    return;
}
%skippy_state = $n;
mes("Skippy and the Mogres: stage <tostring($n)>.");

// ::skippytele <n> - 1 Skippy on the Rimmington coast, 2 Mudskipper Point by the ominous fishing
// spot and the forlorn boot
[debugproc,skippytele](int $n)
if (p_finduid(uid) = false) return;
if ($n = 1) p_telejump(0_46_49_40_58);
else if ($n = 2) p_telejump(0_46_48_40_43);
else mes("::skippytele 1 Skippy, 2 Mudskipper Point.");

// ::coachtele - the Gnome Coach at the Gnome Ball field (Tree Gnome Stronghold)
[debugproc,coachtele]
if (p_finduid(uid) = false) return;
p_telejump(0_37_54_37_41);
