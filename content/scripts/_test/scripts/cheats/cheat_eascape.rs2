[debugproc,farmgrow]
if (p_finduid(uid) = false) {
    return;
}
def_int $patch = 1;
def_int $grown = 0;
while ($patch <= ~farming_patch_count) {
    def_int $key = ~farming_state($patch);
    if ($key >= 1000 & ~farming_treelike(~farming_patch_type($patch)) = true & calc(($key / 100) % 10) < 4) {
        // trees and fruit trees: grown, waiting for their health check
        def_boolean $treeok = ~farming_set_state($patch, calc($key / 1000), 6, 0);
        $grown = calc($grown + 1);
    } else if ($key >= 1000 & calc($key / 1000) ! ^farming_crop_herb_dead & calc(($key / 100) % 10) < 4) {
        def_int $crop = calc($key / 1000);
        def_int $stage = calc($key % 100);
        while (~farming_harvestable($patch, ~farming_state($patch)) = false & $stage < 20) {
            if (~farming_set_state($patch, $crop, 1, calc($stage + 1)) = false) {
                def_boolean $ok = ~farming_set_state($patch, $crop, 5, 1);
            }
            $stage = calc($stage + 1);
        }
        $grown = calc($grown + 1);
    }
    $patch = calc($patch + 1);
}
mes("<tostring($grown)> patches grown.");

[debugproc,farmtick](int $count)
if (p_finduid(uid) = false) {
    return;
}
if ($count < 1) $count = 1;
if ($count > 128) $count = 128;
def_int $i = 1;
while ($i <= $count) {
    ~farming_grow(calc($i * 5));
    $i = calc($i + 1);
}
mes("<tostring($count)> growth ticks run.");

// ::fairytale1pack - the items Fairytale I needs (OSRS wiki's item list): secateurs, a spade, a
// ghostspeak amulet and a dramen staff, and once Malignius has named them the three random
// items for the Nature Spirit (run it again then). The Draynor skull comes from its grave.
[debugproc,fairytale1pack]
if (p_finduid(uid) = false) {
    return;
}
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(secateurs, 1));
$banked = calc($banked + ~questpack_give(spade, 1));
$banked = calc($banked + ~questpack_give(amulet_of_ghostspeak, 1));
$banked = calc($banked + ~questpack_give(dramen_staff, 1));
// once Malignius has named them: the three items for the Nature Spirit
if (%fairy_farmers_quest >= ^fairy1_grotto & %fairy_farmers_quest < ^fairy1_complete) {
    $banked = calc($banked + ~questpack_give(~fairy1_nature_item(%fairy_nature_item1), 1));
    $banked = calc($banked + ~questpack_give(~fairy1_nature_item(%fairy_nature_item2), 1));
    $banked = calc($banked + ~questpack_give(~fairy1_nature_item(%fairy_nature_item3), 1));
}
~questpack_done("A Fairy Tale Pt. 1", $banked);

// ::fairytale2pack - what Fairytale II needs you to bring (OSRS wiki's item list): a dramen staff,
// a vial of water and a pestle and mortar, and Nuff's certificate while the quest needs it (it's
// found on her shelves too)
[debugproc,fairytale2pack]
if (p_finduid(uid) = false) {
