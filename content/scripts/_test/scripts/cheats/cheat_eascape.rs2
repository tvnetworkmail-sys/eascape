[debugproc,farmgrow]
if (p_finduid(uid) = false) {
    return;
}
def_int $patch = 1;
def_int $grown = 0;
while ($patch <= ~farming_patch_count) {
    def_int $key = ~farming_state($patch);
    if ($key >= 1000 & calc($key / 1000) ! ^farming_crop_herb_dead & calc(($key / 100) % 10) < 4) {
        def_int $crop = calc($key / 1000);
        def_int $stage = calc($key % 100);
        while (~farming_harvestable($patch, ~farming_state($patch)) = false & $stage < 20) {
            if (~farming_set_state($patch, $crop, 1, calc($stage + 1)) = false) {
                def_boolean $ok = ~farming_set_state($patch, $crop, 5, 1);
            }
            $stage = calc($stage + 1);
        }
        $grown = calc($grown + 1);
    }
    $patch = calc($patch + 1);
}
mes("<tostring($grown)> patches grown.");

[debugproc,farmtick](int $count)
if (p_finduid(uid) = false) {
    return;
}
if ($count < 1) $count = 1;
if ($count > 128) $count = 128;
def_int $i = 1;
while ($i <= $count) {
    ~farming_grow(calc($i * 5));
    $i = calc($i + 1);
}
mes("<tostring($count)> growth ticks run.");
