}
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(dramen_staff, 1));
$banked = calc($banked + ~questpack_give(vial_water, 1));
$banked = calc($banked + ~questpack_give(pestle_and_mortar, 1));
if (%fairy2_queencure_quest >= ^fairy2_started & %fairy2_queencure_quest < ^fairy2_complete) {
    $banked = calc($banked + ~questpack_give(ft2_nuffs_certificate, 1));
}
~questpack_done("Fairytale II - Cure a Queen", $banked);

