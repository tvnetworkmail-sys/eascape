~update_questpoints;
~update_questlist;
mes("Quest marked complete: <$name>.");

// a reward the quest hands you: in your pack, or on the ground under you when it's full
[proc,questdone_give](namedobj $obj, int $count)
if (inv_freespace(inv) > 0 | (oc_stackable($obj) = true & inv_total(inv, $obj) > 0)) {
    inv_add(inv, $obj, $count);
    return;
}
obj_add(coord, $obj, $count, ^lootdrop_duration);
mes("Your pack is full: <oc_name($obj)> is on the ground.");

// Tourist Trap: two lots of 4,650 experience, as Irena asks (irena_xpreward)
[proc,questdone_pick4](string $a, stat $sa, string $b, stat $sb, string $c, stat $sc, string $d, stat $sd, int $xp)
def_stat $stat = $sa;
switch_int (~p_choice4($a, 1, $b, 2, $c, 3, $d, 4)) {
    case 2 : $stat = $sb;
    case 3 : $stat = $sc;
    case 4 : $stat = $sd;
}
stat_advance($stat, $xp);
mes("You advance your stat in <~stat_name($stat)>.");

// Legends' Quest: Sir Radimus's four lots of training, from his four skill menus (radimus_menu1-4)
[proc,questdone_legends_training]
def_int $left = 4;
while ($left > 0) {
    def_stat $stat = ~questdone_radimus_menu;
    stat_advance($stat, 76500);
    ~mesbox("You receive some training and increase experience to your <~stat_name($stat)>.");
    $left = calc($left - 1);
}

[proc,questdone_radimus_menu]()(stat)
def_int $menu = 1;
while (1 = 1) {
    if ($menu = 1) {
        switch_int (~p_choice4("* Attack *", 1, "* Defence *", 2, "* Strength *", 3, "--- Go to Skill Menu 2 ----", 4)) {
            case 1 : return(attack);
            case 2 : return(defence);
            case 3 : return(strength);
        }
    } else if ($menu = 2) {
        switch_int (~p_choice4("* Hitpoints *", 1, "* Prayer *", 2, "* Magic *", 3, "--- Go to Skill Menu 3 ----", 4)) {
            case 1 : return(hitpoints);
            case 2 : return(prayer);
            case 3 : return(magic);
        }
    } else if ($menu = 3) {
        switch_int (~p_choice4("* Woodcutting *", 1, "* Crafting *", 2, "* Smithing *", 3, "--- Go to Skill Menu 4 ----", 4)) {
            case 1 : return(woodcutting);
            case 2 : return(crafting);
            case 3 : return(smithing);
        }
    } else {
        switch_int (~p_choice4("* Herblore *", 1, "* Agility *", 2, "* Thieving *", 3, "--- Go to Skill Menu 1 ----", 4)) {
            case 1 : return(herblore);
            case 2 : return(agility);
            case 3 : return(thieving);
        }
    }
    $menu = calc($menu % 4 + 1);
}
return(attack);

