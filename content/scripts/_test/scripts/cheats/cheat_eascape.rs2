    if (%morttonquest = ^mortton_quest_complete) {
        mes("You've already done that quest.");
        return;
    }
    %morttonquest = ^mortton_quest_complete;
    queue(mortton_quest_complete, 0, 0);
} else if (compare($name, "regicide") = 0) {
    if (%regicide_quest = ^regicide_complete) {
        mes("You've already done that quest.");
        return;
    }
    %regicide_quest = ^regicide_complete;
    queue(quest_regicide_complete, 0, 0);
} else if (compare($name, "tbwt") = 0) {
    if (%tbwt_main = ^tbwt_complete) {
        mes("You've already done that quest.");
        return;
    }
    %tbwt_main = ^tbwt_complete;
    queue(tbwt_quest_complete, 0, 0);
} else if (compare($name, "viking") = 0 | compare($name, "fremennik") = 0) {
    if (%viking = ^viking_complete) {
        mes("You've already done that quest.");
        return;
    }
    %viking = ^viking_complete;
    queue(viking_quest_complete, 0, 0);
} else if (compare($name, "mm") = 0) {
    if (%mm_main = ^mm_complete) {
        mes("You've already done that quest.");
        return;
    }
    %mm_main = ^mm_complete;
    ~questdone_give(coins, 10000);
    ~questdone_give(diamond, 3);
    queue(mm_quest_complete, 0, 0);
} else if (compare($name, "misc") = 0) {
    if (%misc_quest = ^misc_complete) {
        mes("You've already done that quest.");
        return;
    }
    %misc_quest = ^misc_complete;
    queue(misc_quest_complete, 0, 0);
} else if (compare($name, "hauntedmine") = 0) {
    if (%hauntedmine = ^hauntedmine_complete) {
        mes("You've already done that quest.");
        return;
    }
    %hauntedmine = ^hauntedmine_complete;
    stat_advance(strength, 220000);
    ~questdone_give(crystalshard_necklace_unstrung, 1);
    ~send_quest_complete(questlist:hauntedmine, crystalshard_necklace, 250, 2, "You have completed the\\nHaunted Mine Quest!", "22,000 Strength XP|Salve amulet|Crystal outcrop shortcut");
} else if (compare($name, "routequest") = 0) {
    if (%routequest = ^routequest_complete) {
        mes("You've already done that quest.");
        return;
    }
    %routequest = ^routequest_complete;
    queue(routequest_complete, 0, 0);
} else if (compare($name, "fairytale1") = 0) {
    if (%fairy_farmers_quest = ^fairy1_complete) {
        mes("You've already done that quest.");
        return;
    }
    %fairy_farmers_quest = ^fairy1_complete;
    ~questdone_give(fairy_enchanted_secateurs, 1);
    queue(fairy1_complete, 0, 0);
} else if (compare($name, "fairytale2") = 0) {
    if (%fairy2_queencure_quest = ^fairy2_complete) {
        mes("You've already done that quest.");
        return;
    }
    %fairy2_queencure_quest = ^fairy2_complete;
    %fairyring_use = 1;
    %fairyring_permission = 2;
    %fairy_queen_check = 2;
    %fairy_godfather_check = 2;
    %fairy2_nuffvisible = 1;
    %fairynuff_cert_taken = 1;
} else {
    mes("No quest called <$name>. Try ::questdone list.");
    return;
}
~update_questpoints;
~update_questlist;
mes("Quest marked complete: <$name>.");

// a reward the quest hands you: in your pack, or the bank when it's full
[proc,questdone_give](namedobj $obj, int $count)
if (inv_freespace(inv) > 0 | (oc_stackable($obj) = true & inv_total(inv, $obj) > 0)) {
    inv_add(inv, $obj, $count);
    return;
}
inv_add(bank, $obj, $count);
mes("Your pack is full: <oc_name($obj)> went to your bank.");

// Tourist Trap: two lots of 4,650 experience, as Irena asks (irena_xpreward)
[proc,questdone_pick4](string $a, stat $sa, string $b, stat $sb, string $c, stat $sc, string $d, stat $sd, int $xp)
def_stat $stat = $sa;
switch_int (~p_choice4($a, 1, $b, 2, $c, 3, $d, 4)) {
    case 2 : $stat = $sb;
    case 3 : $stat = $sc;
    case 4 : $stat = $sd;
}
stat_advance($stat, $xp);
mes("You advance your stat in <~stat_name($stat)>.");

// Legends' Quest: Sir Radimus's four lots of training, from his four skill menus (radimus_menu1-4)
[proc,questdone_legends_training]
def_int $left = 4;
while ($left > 0) {
    def_stat $stat = ~questdone_radimus_menu;
    stat_advance($stat, 76500);
    ~mesbox("You receive some training and increase experience to your <~stat_name($stat)>.");
    $left = calc($left - 1);
}

[proc,questdone_radimus_menu]()(stat)
def_int $menu = 1;
while (1 = 1) {
    if ($menu = 1) {
        switch_int (~p_choice4("* Attack *", 1, "* Defence *", 2, "* Strength *", 3, "--- Go to Skill Menu 2 ----", 4)) {
            case 1 : return(attack);
            case 2 : return(defence);
            case 3 : return(strength);
        }
    } else if ($menu = 2) {
        switch_int (~p_choice4("* Hitpoints *", 1, "* Prayer *", 2, "* Magic *", 3, "--- Go to Skill Menu 3 ----", 4)) {
            case 1 : return(hitpoints);
            case 2 : return(prayer);
            case 3 : return(magic);
        }
    } else if ($menu = 3) {
        switch_int (~p_choice4("* Woodcutting *", 1, "* Crafting *", 2, "* Smithing *", 3, "--- Go to Skill Menu 4 ----", 4)) {
            case 1 : return(woodcutting);
            case 2 : return(crafting);
            case 3 : return(smithing);
        }
    } else {
        switch_int (~p_choice4("* Herblore *", 1, "* Agility *", 2, "* Thieving *", 3, "--- Go to Skill Menu 1 ----", 4)) {
            case 1 : return(herblore);
            case 2 : return(agility);
            case 3 : return(thieving);
        }
    }
    $menu = calc($menu % 4 + 1);
}
return(attack);

