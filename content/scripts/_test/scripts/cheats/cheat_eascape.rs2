// ::slayertask <monster> <count>: gives you that Slayer task (any master's list, no level or
// quest check) and that many left to kill. ::slayertask list shows the monster names.
[debugproc,slayertask](string $name, int $count)
if (p_finduid(uid) = false) {
    return;
}
if (compare($name, "list") = 0) {
    mes("monkey, goblin, rat, spider, bird, cow, scorpion, bat, wolf, zombie");
    mes("skeleton, ghost, bear, hillgiant, icegiant, firegiant, mossgiant");
    mes("troll, icewarrior, ogre, hobgoblin, dog, ghoul, greendragon");
    mes("bluedragon, reddragon, blackdragon, lesserdemon, greaterdemon");
    mes("blackdemon, hellhound, shadowwarrior, werewolf, vampire, dagannoth");
    mes("turoth, cavecrawler, banshee, crawlinghand, infernalmage");
    mes("aberrantspecter, abyssaldemon, basilisk, cockatrice, kurask, gargoyle");
    mes("pyrefiend, bloodveld, dustdevil, jelly, rockslug, nechryael, kalphite");
    mes("earthwarrior, otherworldlybeing, elf, dwarf, bronzedragon, irondragon");
    mes("steeldragon, wallbeast, caveslime, cavebug, shade, crocodile");
    mes("darkbeast, mogre, lizard, feverspider, harpiebugswarm, seasnake");
    mes("skeletalwyvern, killerwatt, mutatedzygomite, icefiend");
    return;
}
def_int $target = ~eascape_slayer_lookup(lowercase($name));
if ($target = null) {
    mes("No Slayer monster called <$name>. Type ::slayertask list for the names.");
    return;
}
if ($count < 1) {
    $count = 10;
}
%slayer_target = $target;
%slayer_count = $count;
mes("Your Slayer task is now <tostring($count)> <~slayer_taskname>.");

