// ---------------------------------------------------------------- Tai Bwo Wannai Clean-Up (9 Aug 2005)
// minigames/game_tbw_cleanup. ::tbwpack - the inputs: the four machetes, 3 of each opal/jade/red topaz
// (cut and uncut), a gout tuber, a spade, a rune pickaxe, 2,000 trading sticks, a needle and thread,
// 15 snakeskins and 2 snake hides (Ellis tans them, 15 coins each), the three tribal masks, a
// hammer and 8 bronze nails, a spider carcass, skewer sticks and arrow shafts, 4 of each thatch
// spar, an antipoison(4), a Relicym's balm(4), 5 sharks and 1,000 coins. It also marks Jungle
// Potion done (no rewards) so the villagers are back. Dense jungle needs 35 Woodcutting
// (::setstat woodcutting 35).
[debugproc,tbwpack]
if (p_finduid(uid) = false) return;
if (%junglepotion < ^junglepotion_complete) {
    %junglepotion = ^junglepotion_complete;
    ~tbw_villagers_return;
}
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(machette, 1));
$banked = calc($banked + ~questpack_give(machette_opal, 1));
$banked = calc($banked + ~questpack_give(machette_jade, 1));
$banked = calc($banked + ~questpack_give(machette_redtopaz, 1));
$banked = calc($banked + ~questpack_give(village_trade_sticks, 2000));
$banked = calc($banked + ~questpack_give(coins, 1000));
$banked = calc($banked + ~questpack_give(spade, 1));
$banked = calc($banked + ~questpack_give(rune_pickaxe, 1));
$banked = calc($banked + ~questpack_give(village_rare_tuber, 1));
$banked = calc($banked + ~questpack_give(uncut_opal, 3));
$banked = calc($banked + ~questpack_give(needle, 1));
$banked = calc($banked + ~questpack_give(thread, 5));
$banked = calc($banked + ~questpack_give(cert_village_snake_skin, 15));
$banked = calc($banked + ~questpack_give(village_snake_hide, 2));
$banked = calc($banked + ~questpack_give(hammer, 1));
$banked = calc($banked + ~questpack_give(nails_bronze, 8));
$banked = calc($banked + ~questpack_give(broodoomask_combat, 1));
$banked = calc($banked + ~questpack_give(village_spider_carcass, 1));
$banked = calc($banked + ~questpack_give(tbw_skewer_stick, 5));
$banked = calc($banked + ~questpack_give(arrow_shaft, 5));
$banked = calc($banked + ~questpack_give(thatching_spar_light, 4));
$banked = calc($banked + ~questpack_give(4doseantipoison, 1));
$banked = calc($banked + ~questpack_give(relicyms_balm4, 1));
$banked = calc($banked + ~questpack_give(shark, 3));
// the rest go straight to the bank
inv_add(bank, opal, 3);
inv_add(bank, uncut_jade, 3);
inv_add(bank, jade, 3);
inv_add(bank, uncut_red_topaz, 3);
inv_add(bank, red_topaz, 3);
inv_add(bank, village_rare_tuber, 2);
inv_add(bank, village_snake_skin, 15);
inv_add(bank, broodoomask_poison, 1);
inv_add(bank, broodoomask_disease, 1);
inv_add(bank, thatching_spar_med, 4);
inv_add(bank, thatching_spar_dense, 4);
inv_add(bank, nails_bronze, 16);
~questpack_done("Tai Bwo Wannai Clean-Up", $banked);
mes("The rest (more gems, tubers, masks, spars, unnoted snakeskins, nails) is in your bank. 15 snakeskins come noted.");
mes("::tbwtele 1 for Murcaily (start), ::tbwstage 4 to skip ahead, ::tbwfavour <n> for favour.");

// ::tbwtele <n> - 1 Murcaily and the hardwood grove doors, 2 Gabooty, 3 light jungle, 4 medium
// jungle, 5 dense jungle, 6 a rotten fence, 7 Safta Doc, 8 Rionasta, 9 inside the hardwood grove,
// 10 the wild jungle spiders, 11 the calquat patch, 12 Jiminua's store, 13 Ellis the tanner
[debugproc,tbwtele](int $n)
if (p_finduid(uid) = false) return;
def_coord $c = null;
switch_int ($n) {
    case 1 : $c = 0_43_48_63_11;
    case 2 : $c = 0_43_47_43_57;
    case 3 : $c = 0_43_47_18_53;
    case 4 : $c = 0_43_47_14_49;
    case 5 : $c = 0_43_48_19_3;
    case 6 : $c = 0_43_47_20_56;
    case 7 : $c = 0_43_48_38_28;
    case 8 : $c = 0_43_48_30_22;
    case 9 : $c = 0_44_48_6_11;
    case 10 : $c = 0_43_48_44_32;
    case 11 : $c = 0_43_48_41_29;
    case 12 : $c = 0_43_48_15_50;
    case 13 : $c = 0_51_49_12_57;
    case default :
        mes("::tbwtele 1-13: 1 Murcaily (grove doors), 2 Gabooty, 3 light jungle, 4 medium jungle, 5 dense jungle, 6 a rotten fence, 7 Safta Doc,");
        mes("8 Rionasta, 9 inside the hardwood grove, 10 wild jungle spiders, 11 the calquat patch, 12 Jiminua's store, 13 Ellis the tanner (Al Kharid).");
        return;
}
p_telejump(map_findsquare($c, 1, 3, ^map_findsquare_lineofwalk));

// ::tbwstage <n> - %cleanup_progress: 0 not started, 1 Murcaily has told you (you can hack and
// repair), 2 hacked some jungle, 3 repaired a fence (Murcaily gives the first sticks), 4 had them
// (every villager gives sticks). Every villager also gets sticks to give again, and Jungle Potion
// is marked done (no rewards).
[debugproc,tbwstage](int $n)
if (p_finduid(uid) = false) return;
if (%junglepotion < ^junglepotion_complete) {
    %junglepotion = ^junglepotion_complete;
}
%cleanup_progress = max(0, min(4, $n));
def_int $v = 1;
while ($v <= 10) {
    ~tbw_v_setstate($v, 1);
    $v = add($v, 1);
}
~tbw_favour_show;
mes("Tai Bwo Wannai Clean-Up stage <tostring(%cleanup_progress)>; every villager has sticks for you. Favour <tostring(%favour_percentage)>%.");

// ::tbwfavour <n> - sets your Tai Bwo Wannai favour to n per cent (0-100)
[debugproc,tbwfavour](int $n)
if (p_finduid(uid) = false) return;
%vill_comm_points = multiply(max(0, min(100, $n)), 10);
~tbw_favour_show;
mes("Tai Bwo Wannai favour: <tostring(%favour_percentage)>%.");

// ::tbwsticks <n> - gives you n trading sticks (0 takes them all away)
[debugproc,tbwsticks](int $n)
if (p_finduid(uid) = false) return;
if ($n <= 0) {
    if (inv_total(inv, village_trade_sticks) > 0) {
        inv_del(inv, village_trade_sticks, inv_total(inv, village_trade_sticks));
    }
    mes("Your trading sticks are gone.");
    return;
}
inv_add(inv, village_trade_sticks, $n);
mes("You get <tostring($n)> trading sticks.");

// ::tbwspawn <n> - what comes out of the jungle, next to you: 1 jungle spider, 2 tribesman, 3 bush
// snake, 4 large mosquito, 5 and 6 the two mosquito swarms, 7 white (food), 8 green (antipoison)
// and 9 yellow (Relicym's balm) broodoo victims
[debugproc,tbwspawn](int $n)
if (p_finduid(uid) = false) return;
if ($n < 1 | $n > 9) {
    mes("::tbwspawn 1-9: 1 jungle spider, 2 tribesman, 3 bush snake, 4 large mosquito, 5 swarm of 3, 6 swarm of 5,");
    mes("7 white broodoo victim (use food), 8 green (antipoison), 9 yellow (Relicym's balm).");
    return;
}
~tbw_spawn_event($n, coord);

// ---------------------------------------------------------------- Rogue Trader (miniquest_rogue_trader)
// ::rtpack - what Rogue Trader needs: 3 red dyes and 3 cowhides (Siamun), a lockpick (the small
// casket), 2,000 coins (the urchin, the carpets, the caskets). It also marks The Feud, Rune
// Mysteries and Icthlarin's Little Helper done (no rewards) if they aren't.
[debugproc,rtpack]
if (p_finduid(uid) = false) return;
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(reddye, 3));
$banked = calc($banked + ~questpack_give(cow_hide, 3));
$banked = calc($banked + ~questpack_give(lockpick, 1));
$banked = calc($banked + ~questpack_give(coins, 2000));
if (%feud_var < ^feud_complete) %feud_var = ^feud_complete;
if (%runemysteries ! ^runemysteries_complete) %runemysteries = ^runemysteries_complete;
if (%ics_little_var < ^ics_complete) %ics_little_var = ^ics_complete;
~update_questpoints;
~update_questlist;
~questpack_done("Rogue Trader", $banked);
mes("Ali Morrisane is in Al Kharid (::rttele 1). ::rtstage sets how far you are.");

// ::rtstage <n> - Rogue Trader (rogue_trader.constant): 0 not started (clears it all), 1 Ali has
// sent you to Aubury, the blackjack seller and Siamun, 2 Aubury agreed (Ali has the caskets),
// 3 the blackjack seller heard the proposal, 4 cunning plan (pay the urchin), 5 Siamun asked for
// materials, 6 every part done, Ali not told yet (tell him three times, then the discount),
// 7 all done (both rune shops, defensive blackjacks, Menaphite clothes, the carpet discount).
[debugproc,rtstage](int $n)
if (p_finduid(uid) = false) return;
if ($n < 0 | $n > 7) {
    mes("::rtstage 0-7: 0 reset, 1 sent out by Ali, 2 Aubury agreed, 3 blackjack proposal heard, 4 go to the urchin,");
    mes("5 Siamun asked for materials, 6 all three done (Ali not told), 7 finished.");
    return;
}
%roguetrader_var = 0;
%roguetrader_playing_sudoku = 0;
inv_clear(roguetrader_alim_runedump);
if ($n = 0) {
    mes("Rogue Trader: reset.");
    return;
}
%roguetrader_started = ^rt_intro_done;
%roguetrader_runes = ^rt_runes_aubury;
%roguetrader_blackjacks = ^rt_bj_told;
%roguetrader_clothes = ^rt_clothes_told;
if ($n >= 2) {
    %roguetrader_runes = ^rt_runes_deal;
    %roguetrader_justobt_runes = 1;
}
if ($n >= 3) %roguetrader_blackjacks = ^rt_bj_asked;
if ($n >= 4) %roguetrader_blackjacks = ^rt_bj_urchin;
if ($n >= 5) %roguetrader_clothes = ^rt_clothes_asked;
if ($n >= 6) {
    %roguetrader_runes = ^rt_runes_both;
    %roguetrader_justobt_runes = 0;
    %roguetrader_blackjacks = ^rt_bj_agreed;
    %roguetrader_justchanged_weapons = ^rt_bjline_defensive;
    %roguetrader_bjtold_ali = 0;
    %roguetrader_bj_urchingloat = 1;
    %roguetrader_clothes = ^rt_clothes_menaphite;
    %roguetrader_justchanged_garments = 1;
}
if ($n >= 7) {
    %roguetrader_bjtold_ali = 1;
    %roguetrader_justchanged_garments = 0;
    %roguetrader_cheapflights = 1;
    %roguetrader_started = ^rt_finished;
}
mes("Rogue Trader: stage <tostring($n)>.");

// ::rttele <n> - 1 Ali Morrisane (Al Kharid), 2 Aubury (Varrock), 3 the blackjack seller, 4 the
// street urchin (Pollnivneach), 5 Siamun (Sophanem), 6 the Shantay Pass carpets
[debugproc,rttele](int $n)
if (p_finduid(uid) = false) return;
def_coord $c = null;
switch_int ($n) {
    case 1 : $c = 0_51_50_40_11;
    case 2 : $c = 0_50_53_53_10;
    case 3 : $c = 0_52_46_23_25;
    case 4 : $c = 0_52_46_24_14;
    case 5 : $c = 0_51_43_51_34;
    case 6 : $c = 0_51_48_47_37;
    case default :
        mes("::rttele 1-6: 1 Ali Morrisane, 2 Aubury, 3 the blackjack seller, 4 the street urchin, 5 Siamun (Sophanem),");
        mes("6 the Shantay Pass carpets.");
        return;
}
p_telejump(map_findsquare($c, 1, 3, ^map_findsquare_lineofwalk));

// ::pittele <n> - TzHaar city and the Mage Arena entrance (Fight Pits 19 Sep 2005, TzHaar reworks
// and mage arena changes 26 Sep 2005): 1 TzHaar-Ket-Zuh (the bank), 2 TzHaar-Mej-Kah (outside the
// waiting room), 3 inside the waiting room by the viewing orb, 4 in the arena by the hot vent,
// 5 TzHaar-Hur-Tel (equipment), 6 TzHaar-Hur-Lek (ore and gems), 7 TzHaar-Mej-Roh (runes),
// 8 the Mage Arena's north tunnel outside the webs, 9 in the tunnel by the lever in, 10 inside
// the arena by the lever out
[debugproc,pittele](int $n)
if (p_finduid(uid) = false) return;
def_coord $c = null;
switch_int ($n) {
    case 1 : $c = 0_38_80_13_59;
    case 2 : $c = ^fightpit_outside;
    case 3 : $c = ^fightpit_wait_spot;
    case 4 : $c = 0_37_80_31_47;
    case 5 : $c = 0_38_80_46_25;
    case 6 : $c = 0_38_80_32_28;
    case 7 : $c = 0_38_80_30_6;
    case 8 : $c = 0_48_61_33_56;
    case 9 : $c = 0_48_61_33_52;
    case 10 : $c = 0_48_61_33_47;
    case default :
        mes("::pittele 1-10: 1 TzHaar-Ket-Zuh, 2 TzHaar-Mej-Kah, 3 the waiting room, 4 the arena by the vent,");
        mes("5 TzHaar-Hur-Tel, 6 TzHaar-Hur-Lek, 7 TzHaar-Mej-Roh, 8 Mage Arena tunnel (outside the webs),");
        mes("9 the tunnel by the lever in, 10 inside the arena by the lever out.");
        return;
}
if ($n >= 8 | $n = 3 | $n = 4) {
    p_telejump($c);
} else {
    p_telejump(map_findsquare($c, 0, 3, ^map_findsquare_lineofwalk));
}

// ::pitround - the Fight Pit's next round starts in 2 ticks (still needs two players: two in the
// waiting room, or one there and the champion in the arena)
[debugproc,pitround]
if (p_finduid(uid) = false) return;
if (npc_find(0_37_80_31_58, tzhaar_fightpit_master, 6, 0) = false) {
    mes("TzHaar-Mej-Kah isn't there.");
    return;
}
if (%npc_int2 = 1) {
    mes("A round is already on.");
    return;
}
%npc_int = sub(^fightpit_countdown, 2);
mes("The next round starts in 2 ticks if two can go in.");

// ::pitchamp - makes you the Fight Pit champion with 100 tokkul waiting (skull, name on the
// overlay and with TzHaar-Mej-Kah); go into the waiting room by the vent for the tokkul
[debugproc,pitchamp]
if (p_finduid(uid) = false) return;
if (npc_find(0_37_80_31_58, tzhaar_fightpit_master, 6, 0) = true) {
    %npc_aggressive_player = uid;
}
%tzhaar_fightpit_tokkul = add(%tzhaar_fightpit_tokkul, 100);
~headicon_add(^headicon_pits_champion);
softtimer(fightpit_champion, ^fightpit_skull_ticks);
mes("You're the Fight Pit champion, with <tostring(%tzhaar_fightpit_tokkul)> tokkul waiting.");

// ::enchant6pack - for Lvl-6 Enchant (TzHaar Fight Caves, 4 Oct 2005): 99 Magic if you're below,
// 80 earth, 80 fire and 4 cosmic runes (four casts), 2 onyx rings, 2 onyx amulets, an unstrung
// onyx amulet and an onyx necklace (both should be refused). Bank if the pack is full.
[debugproc,enchant6pack]
if (p_finduid(uid) = false) return;
if (stat_base(magic) < 99) {
    stat_advance(magic, 130344310);
}
inv_add(inv, earthrune, 80);
inv_add(inv, firerune, 80);
inv_add(inv, cosmicrune, 4);
~eascape_give(onyx_ring);
~eascape_give(onyx_ring);
~eascape_give(strung_onyx_amulet);
~eascape_give(strung_onyx_amulet);
~eascape_give(unstrung_onyx_amulet);
~eascape_give(onyx_necklace);
mes("Lvl-6 Enchant: cast it on the onyx rings and amulets (the unstrung amulet and necklace say no).");
