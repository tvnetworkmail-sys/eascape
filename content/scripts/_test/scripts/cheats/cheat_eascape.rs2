// every stat back to its normal level (hitpoints and prayer full, boosts and drains gone), full
// run energy, poison cured
[debugproc,restore]
if (p_finduid(uid) = false) {
    return;
}
~stat_reset_all;
healenergy(10000);
~clear_poison;
mes("Your stats are back to normal.");

// everything for Herblore in your bank: 1,000 of every herb, grimy and clean, every secondary
// ingredient, and 1,000 vials of water; a pestle and mortar in your pack. Your call, 19 Oct 2026.
[debugproc,herbset]
if (p_finduid(uid) = false) {
    return;
}
inv_add(bank, unidentified_guam, 1000);
inv_add(bank, unidentified_marentill, 1000);
inv_add(bank, unidentified_tarromin, 1000);
inv_add(bank, unidentified_harralander, 1000);
