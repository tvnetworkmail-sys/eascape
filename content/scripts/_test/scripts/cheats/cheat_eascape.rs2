// ::ft2song 1-3 - Fairytale II's music from the 2007 cache: We are the Fairies, Dimension X,
// All's Fairy in Love & War
[debugproc,ft2song](int $n)
if (p_finduid(uid) = false) {
    return;
}
switch_int ($n) {
    case 2 : midi_song("dimension x");
    case 3 : midi_song("alls fairy in love n war");
    case default : midi_song("we are the fairies");
}


// Fairytale II: next to the ring in each of the five places the 2007 map adds
// (1 hideout, 2 cosmic plane, 3 Gorak's plane, 4 Enchanted Valley, 5 Abyssal area)
[debugproc,ft2place](int $n)
if (p_finduid(uid) = false) {
    return;
}
switch_int ($n) {
    case 1 : p_teleport(0_36_69_24_9); mes("The Fairy Resistance hideout.");
    case 2 : p_teleport(0_32_75_27_47); mes("The cosmic entity's plane.");
    case 3 : p_teleport(0_47_83_30_35); mes("Gorak's plane.");
    case 4 : p_teleport(0_47_70_33_51); mes("The Enchanted Valley.");
    case 5 : p_teleport(0_47_76_51_10); mes("The Abyssal area.");
    case default : mes("::ft2place 1-5: 1 hideout, 2 cosmic plane, 3 Gorak's plane, 4 Enchanted Valley, 5 Abyssal area");
}

// Fairytale II: the fairy rings without the quest's permission, and a dramen staff to wield.
// ::fairyrings 2 also fills the travel log with every code; ::fairyrings 0 locks them again.
[debugproc,fairyrings](int $n)
if (p_finduid(uid) = false) {
    return;
}
if ($n = 0 & %fairyring_test_unlock = 1) {
    %fairyring_test_unlock = 0;
    mes("Fairy rings: back to Fairytale II's permission.");
    return;
}
%fairyring_test_unlock = 1;
if (inv_total(inv, dramen_staff) = 0 & inv_total(worn, dramen_staff) = 0) {
    inv_add(inv, dramen_staff, 1);
}
if ($n = 2) {
    %fairyring_log1 = -1;
    %fairyring_log2 = -1;
}
mes("Fairy rings: unlocked (wield the dramen staff).");

// ::abysspack - for the Abyss: a rune pickaxe and axe and a tinderbox for its obstacles, the four
