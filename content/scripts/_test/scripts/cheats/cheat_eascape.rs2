$banked = calc($banked + ~questpack_give(cert_iron_bar, 4));
$banked = calc($banked + ~questpack_give(cert_steel_bar, 4));
$banked = calc($banked + ~questpack_give(cert_silver_bar, 4));
$banked = calc($banked + ~questpack_give(cert_gold_bar, 4));
$banked = calc($banked + ~questpack_give(cert_mithril_bar, 4));
~questpack_done("The Giant Dwarf", $banked);

// ::gdstage <n> - sets The Giant Dwarf's stage (%giantdwarf_quest; giant_dwarf.constant: 10 crashed
// and arrested, 20 Veldaban agreed, 30 Blasidar's errands, 40 Riki has everything, 50 the
// Consortium, 60 promised your support, 100 complete). Riki, the statue and the errand flags follow;
// at 50 you also get 100 points with, and join, the Purple Pewter (::gdstage 50 then talk to its
// director); at 60 the Purple Pewter is the company you'll speak for. 0 resets everything.
[debugproc,gdstage](int $n)
if (p_finduid(uid) = false) return;
if ($n = 0) {
    %gd_flags = 0;
    %gd_points_a = 0;
    %gd_points_b = 0;
    %gd_chosen = 0;
    ~gd_task_clear;
    %giantdwarf_model_state = 0;
    %giantdwarf_current_company = 0;
    %giantdwarf_veldaban_introduced = 0;
    %giantdwarf_sculptor_introduced = 0;
    %giantdwarf_vermundi_givenbook = 0;
    %giantdwarf_pie_given = 0;
}
if ($n >= ^gd_veldaban) %giantdwarf_veldaban_introduced = 1;
if ($n >= ^gd_items) %giantdwarf_sculptor_introduced = 1;
if ($n < ^gd_items) %giantdwarf_model_state = 0;
if ($n >= ^gd_items_given) %giantdwarf_model_state = 7;
if ($n >= ^gd_consortium & ~gd_points(^gd_purple_pewter) < ^gd_join_at) {
    ~gd_setpoints(^gd_purple_pewter, ^gd_join_at);
}
if ($n >= ^gd_consortium & %giantdwarf_current_company = 0) %giantdwarf_current_company = ^gd_purple_pewter;
if ($n >= ^gd_support & %gd_chosen = 0) %gd_chosen = ^gd_purple_pewter;
~gd_set($n);
~send_quest_progress(questlist:giantdwarf, %giantdwarf_quest, ^gd_complete);
mes("The Giant Dwarf stage: <tostring($n)>");

// ::womtask <n> - gives you a Wise Old Man task (area_draynor/wom_tasks.rs2): 0 clears it, 1-7 a
// letter (1 Father Aereck, 2 the High Priest of Entrana, 3 Reldo, 4 Thurgo, 5 Father Lawrence,
// 6 Abbot Langley, 7 the Oracle; gives you the letter), 8 the thing under his bed, 9 fetch 3 bones
// (gives you the bones). Talk to him first once (%wom_met).
[debugproc,womtask](int $n)
if (p_finduid(uid) = false) return;
%wom_npc = ^wom_to_none;
%wom_fetch = null;
%wom_remaining = 0;
if ($n >= ^wom_to_aereck & $n <= ^wom_to_oracle) {
    %wom_npc = $n;
    inv_add(inv, wom_message, 1);
} else if ($n = ^wom_to_bed) {
    %wom_npc = ^wom_to_bed;
    %wom_remaining = 1;
} else if ($n = 9) {
    %wom_fetch = bones;
    %wom_remaining = 3;
    inv_add(inv, bones, 3);
}
mes("Wise Old Man task: <tostring($n)>");

// ::womjunk - puts some of the Wise Old Man's junk in your bank: his three books (always junk) and
// Imp Catcher's beads (junk once Imp Catcher is done)
[debugproc,womjunk]
if (p_finduid(uid) = false) return;
inv_add(bank, wom_book_1, 1);
inv_add(bank, wom_book_2, 1);
inv_add(bank, wom_chicken_book, 1);
inv_add(bank, red_bead, 1);
inv_add(bank, yellow_bead, 1);
mes("Banked the Wise Old Man's three books and two beads.");

// EASCape: plays The Giant Dwarf's opening film (up to the crash) without changing the quest
[debugproc,gdcrash]
if (p_finduid(uid) = false) return;
def_coord $back = coord;
~gd_crash_film;
~fade_out;
p_delay(2);
cam_reset;
p_telejump($back);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);

// ::rdstage <n> (test): the Rogues' Den maze. 0 takes you to Brian O'Richard and lets you in
// (as if you had talked to him); 1-12 start a game (you must carry and wear nothing, as the
// doorway wants; already in the maze it just moves you) and put you at: 1 the doorway, 2 the first
// contortion bars, 3 the first ledge,
// 4 the floor blades, 5 the mosaic tiles, 6 the grill room, 7 the gear door, 8 the flash powder
// and guards, 9 the last two pendulums, 10 the wall safes, 11 the spin blade corridors, 12 the
// room of death. Thieving and Agility are at your own levels there, so drains start from them.
[debugproc,rdstage](int $n)
if (p_finduid(uid) = false) return;
%roguesden_access = 1;
if ($n <= 0) {
    if (%roguesden_state = 1) ~roguesden_leave(^rd_silent);
    p_telejump(^roguesden_brian);
    mes("Rogues' Den: Brian O'Richard has let you into the maze.");
    return;
}
if (%roguesden_state ! 1 & ~roguesden_carrying = true) {
    mes("Bank or drop everything you carry and wear first: nothing goes into the maze.");
    return;
}
def_coord $to;
switch_int ($n) {
    case 1 : $to = 1_47_78_48_0;
    case 2 : $to = 1_47_78_42_5;
    case 3 : $to = 1_46_78_50_12;
    case 4 : $to = 1_46_78_25_26;
    case 5 : $to = 1_47_79_10_24;
    case 6 : $to = 1_47_79_22_23;
    case 7 : $to = 1_47_78_38_22;
    case 8 : $to = 1_47_79_1_7;
    case 9 : $to = 1_47_79_20_0;
    case 10 : $to = 1_47_78_10_55;
    case 11 : $to = 1_47_79_36_33;
    case default : $to = 1_46_79_48_11;
}
p_telejump($to);
p_delay(0);
if (%roguesden_state ! 1) ~roguesden_start;
%roguesden_last = coord;
%roguesden_flags = setbit(%roguesden_flags, 0);
~roguesden_progress(coord); // so leaving from here gives the part-experience (and the safe room's line) for here
mes("Rogues' Den: stage <tostring($n)>.");

// ::rdrivepack (test): Recruitment Drive needs no items, and Sir Tiffy only takes you with nothing
// in your pack and nothing worn, so everything you carry and wear goes to your bank. It also marks
// Black Knights' Fortress and Druidic Ritual done if they aren't (without their rewards), so Sir
// Amik will offer the quest.
[debugproc,rdrivepack]
if (p_finduid(uid) = false) return;
def_int $slot = 0;
def_obj $obj = null;
while ($slot < inv_size(inv)) {
    $obj = inv_getobj(inv, $slot);
    if ($obj ! null) inv_moveitem(inv, bank, $obj, inv_getnum(inv, $slot));
    $slot = calc($slot + 1);
}
$slot = 0;
while ($slot < inv_size(worn)) {
    $obj = inv_getobj(worn, $slot);
    if ($obj ! null) inv_moveitem(worn, bank, $obj, inv_getnum(worn, $slot));
    $slot = calc($slot + 1);
}
buildappearance(worn);
~update_all(null);
if (%spy < ^blackknight_complete) %spy = ^blackknight_complete;
if (%druidquest < ^druid_complete) %druidquest = ^druid_complete;
~update_questpoints;
mes("Recruitment Drive needs no items: your pack and worn items are in your bank. Sir Amik Varze (Falador castle, top of the west tower) starts it; Sir Tiffy Cashien is in Falador Park.");
mes("Sir Leye can only be beaten by a woman (2005): a makeover mage, or ::rdrivestage 21 to swap.");

// ::rdrivestage <n> (test): Recruitment Drive (quest_rd). 0 not started, 1 Sir Amik has sent you
// (talk to Sir Tiffy), 2 been to the grounds once (Sir Tiffy: "Back for another go"), 3 five rooms
// passed (talk to Sir Tiffy to finish), 4 done without the rewards. 11-17 takes you straight into
// that room (11 Sir Spishyus, 12 Lady Table, 13 Sir Kuam Ferentse, 14 Sir Tinley, 15 Sir Ren
// Itchood, 16 Miss Cheevers, 17 Ms. Hynn Terprett) as the first of a run, the other four random:
// bank everything first (::rdrivepack). 21 swaps your character between man and woman.
[debugproc,rdrivestage](int $n)
if (p_finduid(uid) = false) return;
if ($n = 21) {
    if (gender = 0) setgender(1);
    else setgender(0);
    buildappearance(worn);
    mes("Recruitment Drive: you are now a <text_gender("man", "woman")>.");
    return;
}
if ($n >= 11 & $n <= 17) {
    if (~rcd_carrying = true) {
        mes("Bank everything first: nothing goes into the training grounds (::rdrivepack).");
        return;
    }
    if (%rd_main ! ^rcd_started) %rd_main = ^rcd_started;
    ~rcd_end_run;
    ~rcd_shuffle;
    def_int $room = calc($n - 10);
    def_int $i = 0;
    def_int $first = ~rcd_room(0);
    // put the room asked for first, swapping it with the one that was (or with the first if it
    // wasn't picked)
    while ($i < ^rcd_tests) {
        if (~rcd_room($i) = $room) {
            %rcd_order = setbit_range_toint(%rcd_order, $first, calc($i * 3), calc($i * 3 + 2));
        }
        $i = calc($i + 1);
    }
    %rcd_order = setbit_range_toint(%rcd_order, $room, 0, 2);
    %rd_room1_initiated = 1;
    ~send_quest_progress(questlist:rd, %rd_main, ^rcd_complete);
    mes("Recruitment Drive: into room <tostring($room)>.");
    ~fade_out;
    p_delay(2);
    @rcd_enter;
}
~rcd_end_run;
%rd_room1_initiated = 0;
switch_int ($n) {
    case 0 : %rd_main = ^rcd_not_started;
    case 1 : %rd_main = ^rcd_started;
    case 2 :
        %rd_main = ^rcd_started;
        %rd_room1_initiated = 1;
    case 3 :
        %rd_main = ^rcd_started;
        %rd_room1_initiated = 1;
        %rd_room1_complete = 1;
        %rd_room2_complete = 1;
        %rd_room3_complete = 1;
        %rd_room4_complete = 1;
        %rd_room5_complete = 1;
    case 4 : %rd_main = ^rcd_complete;
    case default :
        mes("::rdrivestage 0-4, 11-17 (a room) or 21 (man/woman).");
        return;
}
if ($n = 0) %rd_male_at_start = 0;
if ($n >= 1 & $n <= 3 & gender = 0) %rd_male_at_start = 1;
~update_questpoints;
~send_quest_progress(questlist:rd, %rd_main, ^rcd_complete);
mes("Recruitment Drive stage: <tostring($n)>.");

// ::wbpack - for Waterbirth Island (areas/area_waterbirth): 12,000 coins (Jarvald's fare and a
// piece of armour), 20 rune thrownaxes (Chainhit knocks down all three door-supports), 5 sharks,
// 4 prayer potions, a strung lyre with a raw shark, a sea turtle and a manta ray (the lyre's
// teleports), 2 kegs of beer (Askeladden), a Fremennik helm (Bardur), and for each of the three
// armour makers a helm's part and a dagannoth hide.
[debugproc,wbpack]
if (p_finduid(uid) = false) return;
def_int $banked = 0;
$banked = calc($banked + ~questpack_give(coins, 12000));
$banked = calc($banked + ~questpack_give(rune_thrownaxe, 20));
$banked = calc($banked + ~questpack_give(shark, 5));
$banked = calc($banked + ~questpack_give(4doseprayerrestore, 4));
$banked = calc($banked + ~questpack_give(viking_strung_lyre, 1));
$banked = calc($banked + ~questpack_give(raw_shark, 1));
$banked = calc($banked + ~questpack_give(raw_seaturtle, 1));
$banked = calc($banked + ~questpack_give(raw_mantaray, 1));
$banked = calc($banked + ~questpack_give(keg_of_beer, 2));
$banked = calc($banked + ~questpack_give(viking_helmet, 1));
$banked = calc($banked + ~questpack_give(dagganoth_melee_head_part, 1));
$banked = calc($banked + ~questpack_give(dagganoth_range_head_part, 1));
$banked = calc($banked + ~questpack_give(dagganoth_mage_head_part, 1));
$banked = calc($banked + ~questpack_give(dagganoth_hide, 3));
~questpack_done("Waterbirth Island", $banked);
mes("Jarvald is on the north-western dock of Rellekka (::wbtele 1). The lyre's offerings need The Fremennik Trials done (::questdone viking).");

// ::wbtele <n> - to the places on Waterbirth Island: 1 Jarvald in Rellekka, 2 Jarvald on the island,
// 3 inside the cave, 4 the pressure doors (the middle one's pads), 5 the north path by its
// door-support, 6 the middle path by its door-support, 7 the ladder room, 8 Askeladden on the
// mountain, 9 the first of the lower levels, 10 Bardur, 11 the rock lobsters, 12 the ladder down to
// the Dagannoth Kings, 13 the Dagannoth Kings' lair, 14 Fossegrimen's altar (the lyre).
[debugproc,wbtele](int $n)
if (p_finduid(uid) = false) return;
def_coord $c = null;
switch_int ($n) {
    case 1 : $c = 0_40_57_60_35;
    case 2 : $c = ^wb_island_landing;
    case 3 : $c = ^wb_dungeon_entry;
    case 4 : $c = 0_38_158_58_34;
    case 5 : $c = 0_39_158_49_34;
    case 6 : $c = 0_39_158_45_31;
    case 7 : $c = ^wb_ladder_room;
    case 8 : $c = ^wb_mountain_top;
    case 9 : $c = ^wb_sublevel2;
    case 10 : $c = 1_28_68_56_40;
    case 11 : $c = 0_29_68_30_50;
    case 12 : $c = ^wb_kings_ladder_top;
    case 13 : $c = ^wb_kings_lair;
    case 14 : $c = 0_41_56_2_15;
    case default :
        mes("::wbtele 1-14: 1 Jarvald (Rellekka), 2 Jarvald (island), 3 the cave, 4 the pressure doors, 5 the north door-support, 6 the middle door-support, 7 the ladder room, 8 Askeladden, 9 the lower levels, 10 Bardur, 11 the rock lobsters, 12 the ladder to the kings, 13 the kings' lair, 14 Fossegrimen's altar.");
        return;
}
p_telejump($c);

// ::dkset - a 2006 Dagannoth Kings setup (ours: the choice of gear; every item is from our 2006
// cache). Worn: melee for Supreme (whip, dragon chain and legs, dragon square shield, berserker
// helm, fire cape). Pack: the ranged switch for Prime (crystal bow, black d'hide), the magic switch
// for Rex (Ahrim's robes, the ancient staff, 500 Blood Barrages of runes; the spellbook is set to Ancient Magicks),
// super attack/strength/defence, a ranging potion, 8 prayer potions, 5 sharks and a 4-charge
// enchanted lyre to get back to Rellekka. What you had is banked first.
[debugproc,dkset]
if (p_finduid(uid) = false) return;
~eascape_bank_everything(inv);
~eascape_bank_everything(worn);
inv_setslot(worn, ^wearpos_hat, dagganoth_melee_helm, 1);
inv_setslot(worn, ^wearpos_back, tzhaar_cape_fire, 1);
inv_setslot(worn, ^wearpos_front, amulet_of_glory_4, 1);
inv_setslot(worn, ^wearpos_rhand, abyssal_whip, 1);
inv_setslot(worn, ^wearpos_torso, dragon_chainbody, 1);
inv_setslot(worn, ^wearpos_lhand, dragon_sq_shield, 1);
inv_setslot(worn, ^wearpos_legs, dragon_platelegs, 1);
