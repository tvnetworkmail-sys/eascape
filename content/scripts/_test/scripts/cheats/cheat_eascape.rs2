$banked = calc($banked + ~questpack_give(tinderbox, 1));
$banked = calc($banked + ~questpack_give(airrune, 10));
$banked = calc($banked + ~questpack_give(lawrune, 10));
$banked = calc($banked + ~questpack_give(iron_bar, 1));
$banked = calc($banked + ~questpack_give(sapphire, 3));
$banked = calc($banked + ~questpack_give(redberry_pie, 1));
$banked = calc($banked + ~questpack_give(cert_clay, 5));
$banked = calc($banked + ~questpack_give(cert_copper_ore, 5));
