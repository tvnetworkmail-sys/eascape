// every stat back to its normal level (hitpoints and prayer full, boosts and drains gone), full
// run energy, poison cured
[debugproc,restore]
if (p_finduid(uid) = false) {
    return;
}
~stat_reset_all;
healenergy(10000);
~clear_poison;
mes("Your stats are back to normal.");

