} else if (compare($name, "legendsquest") = 0) {
    %legendsquest = ^legends_complete;
} else if (compare($name, "priestperil") = 0 | compare($name, "priest_in_peril") = 0) {
    %priestperil = ^priestperil_complete;
} else if (compare($name, "death_equiproom") = 0) {
    %death_equiproom = ^death_complete;
} else if (compare($name, "troll_quest") = 0) {
    %troll_quest = ^troll_complete;
} else if (compare($name, "troll_love") = 0) {
    %troll_love = ^troll_love_complete;
} else if (compare($name, "golem_a") = 0) {
    %golem_a = ^golem_complete;
} else if (compare($name, "deserttreasure") = 0) {
    %deserttreasure = ^deserttreasure_complete;
} else {
    mes("No quest called <$name>. Try ::questdone list.");
    return;
}
~update_questpoints;
~update_questlist;
mes("Quest marked complete: <$name>.");

