// EASCape test-mode commands. Typed without the ~ (::maxstats, ::barrowset); they only work
// while the server is in test mode, like every other cheat.

// every skill to 99, hitpoints and prayer topped up
[debugproc,maxstats]
if (p_finduid(uid) = false) {
    return;
}
// stat_advance takes tenths of xp: 130344310 = 13,034,431 xp, level 99
stat_advance(attack, 130344310);
stat_advance(defence, 130344310);
stat_advance(strength, 130344310);
stat_advance(hitpoints, 130344310);
stat_advance(ranged, 130344310);
stat_advance(prayer, 130344310);
stat_advance(magic, 130344310);
stat_advance(cooking, 130344310);
stat_advance(woodcutting, 130344310);
stat_advance(fletching, 130344310);
stat_advance(fishing, 130344310);
stat_advance(firemaking, 130344310);
stat_advance(crafting, 130344310);
stat_advance(smithing, 130344310);
stat_advance(mining, 130344310);
stat_advance(herblore, 130344310);
stat_advance(agility, 130344310);
stat_advance(thieving, 130344310);
stat_advance(slayer, 130344310);
stat_advance(farming, 130344310);
stat_advance(runecraft, 130344310);
stat_heal(hitpoints, 0, 100);
stat_heal(prayer, 0, 100);
mes("All your skills are now 99.");

// a Barrows magic setup. The OSRS wiki's Barrows/Strategies low-level magic loadout, keeping only
// items that existed in May 2006; where the wiki's item didn't exist yet, the next one in its
// list (or the nearest 2006 item) is used:
//   Berserker helm, Guthix cape (wiki: Guthix cloak), amulet of glory (wiki: amulet of air),
//   air battlestaff, Mystic robe top and bottom, rune kiteshield, Mystic gloves (wiki: combat
//   bracelet), rune boots, ring of dueling.
// Ranged switch for Ahrim: the wiki says to bring dragonhide armour and a ranged weapon for him
// (he's weakest to ranged). Black dragonhide is the best dragonhide in May 2006, and the magic
// shortbow with rune arrows the best bow and arrows; the arrows go in the ammo slot so they're
// ready when you switch.
// Everything you were wearing and carrying goes to your bank first.
[debugproc,barrowset]
if (p_finduid(uid) = false) {
    return;
}
~eascape_bank_everything(inv);
~eascape_bank_everything(worn);
inv_setslot(worn, ^wearpos_hat, viking_helmet_crush, 1);
inv_setslot(worn, ^wearpos_back, guthix_cape, 1);
inv_setslot(worn, ^wearpos_front, amulet_of_glory_4, 1);
inv_setslot(worn, ^wearpos_rhand, air_battlestaff, 1);
inv_setslot(worn, ^wearpos_torso, mystic_robe_top, 1);
inv_setslot(worn, ^wearpos_lhand, rune_kiteshield, 1);
inv_setslot(worn, ^wearpos_legs, mystic_robe_bottom, 1);
inv_setslot(worn, ^wearpos_hands, mystic_gloves, 1);
inv_setslot(worn, ^wearpos_feet, rune_armoured_boots, 1);
inv_setslot(worn, ^wearpos_ring, ring_of_dueling_8, 1);
inv_setslot(worn, ^wearpos_quiver, rune_arrow, 500);
~update_all(null);
// pack: the ranged switch for Ahrim, spade, restore potion, blood runes for Wind Wave (the staff
// gives the air runes), 13 prayer potions and 8 sharks
inv_add(inv, magic_shortbow, 1);
inv_add(inv, black_dragonhide_body, 1);
inv_add(inv, black_dragonhide_chaps, 1);
inv_add(inv, black_dragon_vambraces, 1);
inv_add(inv, spade, 1);
inv_add(inv, 4dosestatrestore, 1);
inv_add(inv, bloodrune, 1000);
inv_add(inv, 4doseprayerrestore, 13);
inv_add(inv, shark, 8);
// spares in the bank
inv_add(bank, 4doseprayerrestore, 100);
inv_add(bank, shark, 100);
inv_add(bank, 4dosestatrestore, 10);
inv_add(bank, bloodrune, 5000);
inv_add(bank, rune_arrow, 2000);
mes("Barrows set ready: magic gear on, supplies in your pack and 100 prayer potions in the bank.");
mes("Set Wind Wave to autocast on your staff's combat tab.");
mes("For Ahrim, wield the magic shortbow and wear the dragonhide in your pack.");

[proc,eascape_bank_everything](inv $inv)
def_int $slot = 0;
def_obj $obj;
while ($slot < inv_size($inv)) {
    $obj = inv_getobj($inv, $slot);
    if ($obj ! null) {
        inv_moveitem($inv, bank, $obj, inv_total($inv, $obj));
    }
    $slot = add($slot, 1);
}

// every Barrows piece (fresh) and 1000 bolt racks into your bank, plus a broken Dharok's helm,
// a Dharok's helm 50 and 100,000 coins in your pack to try Bob's repairs
[debugproc,barrowsgear]
if (p_finduid(uid) = false) {
    return;
}
def_int $i = 0;
while ($i < 24) {
    inv_add(bank, ~barrows_piece_obj($i), 1);
    $i = add($i, 1);
}
inv_add(bank, barrows_karil_ammo, 1000);
inv_add(inv, barrows_dharok_head_broken, 1);
inv_add(inv, barrows_dharok_head_50, 1);
inv_add(inv, coins, 100000);
mes("Every Barrows piece is in your bank. Use the helms in your pack on Bob in Lumbridge.");

// into the TzHaar Fight Cave starting at wave N (63 = TzTok-Jad), e.g. ::fightwave 63
[debugproc,fightwave](int $wave)
if (p_finduid(uid) = false) {
    return;
}
mes("Fight Cave: starting at wave <tostring(max(1, min($wave, ^fightcave_wave_jad)))>.");
~fightcave_enter(max(1, min($wave, ^fightcave_wave_jad)));

// every hit kills whatever you're fighting (melee, ranged and combat spells), until ::onehitoff
// or you log out
[debugproc,onehit]
if (p_finduid(uid) = false) {
    return;
}
%eascape_onehit = ^true;
mes("One-hit is on: everything you hit dies. ::onehitoff turns it off.");

[debugproc,onehitoff]
if (p_finduid(uid) = false) {
    return;
}
%eascape_onehit = ^false;
mes("One-hit is off: your hits are back to normal.");

// every quest that counts quest points, set to complete on your own account (::questdone list
// shows the names). Your call, 19 Oct 2026: for testing past quest locks. Built from
// count_questpoints in general/scripts/quests.rs2.
[debugproc,questdone](string $name)
if (p_finduid(uid) = false) {
    return;
}
if (compare($name, "list") = 0) {
    ~questdone_list;
    return;
}
if (compare($name, "runemysteries") = 0) {
    %runemysteries = ^runemysteries_complete;
} else if (compare($name, "doricquest") = 0) {
    %doricquest = ^doric_complete;
} else if (compare($name, "cookquest") = 0) {
    %cookquest = ^cook_complete;
} else if (compare($name, "rjquest") = 0) {
    %rjquest = ^romeojuliet_complete;
} else if (compare($name, "hetty") = 0) {
    %hetty = ^hetty_complete;
} else if (compare($name, "chompybird") = 0) {
    %chompybird = ^chompybird_complete;
} else if (compare($name, "prieststart") = 0) {
    %prieststart = ^priest_complete;
} else if (compare($name, "squire") = 0) {
    %squire = ^squire_complete;
} else if (compare($name, "imp") = 0) {
    %imp = ^imp_complete;
} else if (compare($name, "druidquest") = 0) {
    %druidquest = ^druid_complete;
} else if (compare($name, "druidspirit") = 0 | compare($name, "naturespirit") = 0) {
    %druidspirit = ^druidspirit_complete;
} else if (compare($name, "goblinquest") = 0) {
    %goblinquest = ^gobdip_complete;
} else if (compare($name, "sheep") = 0) {
    %sheep = ^sheep_complete;
} else if (compare($name, "fluffs") = 0) {
    %fluffs = ^fluffs_complete;
} else if (compare($name, "demonstart") = 0) {
    %demonstart = ^demon_complete;
} else if (compare($name, "princequest") = 0) {
    %princequest = ^prince_complete;
} else if (compare($name, "spy") = 0) {
    %spy = ^blackknight_complete;
} else if (compare($name, "haunted") = 0) {
    %haunted = ^haunted_complete;
} else if (compare($name, "hunt") = 0) {
    %hunt = ^hunt_complete;
} else if (compare($name, "drunkmonkquest") = 0) {
    %drunkmonkquest = ^drunkmonk_complete;
} else if (compare($name, "vampire") = 0) {
    %vampire = ^vampire_complete;
} else if (compare($name, "totemquest") = 0) {
    %totemquest = ^totem_complete;
} else if (compare($name, "fishingcompo") = 0) {
    %fishingcompo = ^fishingcompo_complete;
} else if (compare($name, "scorpcatcher") = 0) {
    %scorpcatcher = ^scorpcatcher_complete;
} else if (compare($name, "zanaris") = 0) {
    %zanaris = ^zanaris_complete;
} else if (compare($name, "elenaquest") = 0) {
    %elenaquest = ^elena_complete;
} else if (compare($name, "dragonquest") = 0) {
    %dragonquest = ^dragon_complete;
} else if (compare($name, "seaslugquest") = 0) {
    %seaslugquest = ^seaslug_complete;
} else if (compare($name, "arthur") = 0) {
    %arthur = ^arthur_complete;
} else if (compare($name, "treequest") = 0) {
    %treequest = ^tree_complete;
} else if (compare($name, "waterfall_quest") = 0) {
    %waterfall_quest = ^waterfall_complete;
} else if (compare($name, "grail") = 0) {
    %grail = ^grail_complete;
} else if (compare($name, "ballquest") = 0) {
    %ballquest = ^ball_complete;
} else if (compare($name, "murderquest") = 0) {
    %murderquest = ^murder_complete;
} else if (compare($name, "hazeelcultquest") = 0) {
    %hazeelcultquest = ^hazeelcult_complete;
} else if (compare($name, "heroquest") = 0) {
    %heroquest = ^hero_complete;
} else if (compare($name, "itgronigen") = 0) {
    %itgronigen = ^itgronigen_complete;
} else if (compare($name, "arenaquest") = 0) {
    %arenaquest = ^arena_complete;
} else if (compare($name, "junglepotion") = 0) {
    %junglepotion = ^junglepotion_complete;
} else if (compare($name, "ikov") = 0) {
    %ikov = ^ikov_completed_armadyl;
} else if (compare($name, "biohazard") = 0) {
    %biohazard = ^biohazard_complete;
} else if (compare($name, "sheepherderquest") = 0) {
    %sheepherderquest = ^sheepherder_complete;
} else if (compare($name, "mcannon") = 0) {
    %mcannon = ^mcannon_complete;
} else if (compare($name, "grandtree") = 0) {
    %grandtree = ^grandtree_complete;
} else if (compare($name, "upass") = 0) {
    %upass = ^upass_complete;
} else if (compare($name, "zombiequeen") = 0) {
    %zombiequeen = ^zombiequeen_complete;
} else if (compare($name, "crestquest") = 0) {
    %crestquest = ^crest_complete;
} else if (compare($name, "itexamlevel") = 0) {
    %itexamlevel = ^itexam_complete;
} else if (compare($name, "desertrescue") = 0) {
    %desertrescue = ^desertrescue_complete;
} else if (compare($name, "itwatchtower") = 0) {
    %itwatchtower = ^itwatchtower_complete;
} else if (compare($name, "legendsquest") = 0) {
    %legendsquest = ^legends_complete;
} else if (compare($name, "priestperil") = 0 | compare($name, "priest_in_peril") = 0) {
    %priestperil = ^priestperil_complete;
} else if (compare($name, "death_equiproom") = 0) {
    %death_equiproom = ^death_complete;
} else if (compare($name, "troll_quest") = 0) {
    %troll_quest = ^troll_complete;
} else if (compare($name, "troll_love") = 0) {
    %troll_love = ^troll_love_complete;
} else if (compare($name, "golem_a") = 0) {
    %golem_a = ^golem_complete;
} else {
    mes("No quest called <$name>. Try ::questdone list.");
    return;
}
~update_questpoints;
~update_questlist;
mes("Quest marked complete: <$name>.");

[proc,questdone_list]
mes("runemysteries, doricquest, cookquest, rjquest, hetty, chompybird, prieststart, squire");
mes("imp, druidquest, druidspirit, goblinquest, sheep, fluffs, demonstart, princequest");
mes("spy, haunted, hunt, drunkmonkquest, vampire, totemquest, fishingcompo, scorpcatcher");
mes("zanaris, elenaquest, dragonquest, seaslugquest, arthur, treequest, waterfall_quest, grail");
mes("ballquest, murderquest, hazeelcultquest, heroquest, itgronigen, arenaquest, junglepotion, ikov");
mes("biohazard, sheepherderquest, mcannon, grandtree, upass, zombiequeen, crestquest, itexamlevel");
mes("desertrescue, itwatchtower, legendsquest, priestperil, death_equiproom, troll_quest, troll_love, golem_a");

// every stat back to its normal level (hitpoints and prayer full, boosts and drains gone), full
// run energy, poison cured
[debugproc,restore]
if (p_finduid(uid) = false) {
    return;
}
~stat_reset_all;
healenergy(10000);
~clear_poison;
mes("Your stats are back to normal.");

