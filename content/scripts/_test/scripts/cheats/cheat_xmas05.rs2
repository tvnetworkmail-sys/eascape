~xmas05_wipe(win05_marionette_stage3_green);
~xmas05_wipe(win05_marionette_stage4_green);
mes("Christmas 2005 reset: nothing done, no event items.");

[proc,xmas05_wipe](obj $obj)
if (inv_total(inv, $obj) > 0) inv_del(inv, $obj, inv_total(inv, $obj));
if (inv_total(bank, $obj) > 0) inv_del(bank, $obj, inv_total(bank, $obj));
if (inv_total(worn, $obj) > 0) inv_del(worn, $obj, inv_total(worn, $obj));

// ::xmastele <n> - 1 Diango (Draynor market), 2 the trapdoor (north of him), 3 Rosie (the workshop),
// 4 the marionette floor, 5 the paint tables, 6 the decorations boxes, 7 the Hooded Stranger
// (Taverley members' gate), 8 the Varrock tree
[debugproc,xmastele](int $n)
if (p_finduid(uid) = false) return;
def_coord $to = null;
switch_int ($n) {
    case 1 : $to = ^xmas05_tele_diango;
    case 2 : $to = ^xmas05_draynor_out;
    case 3 : $to = ^xmas05_workshop_in;
    case 4 : $to = ^xmas05_tele_puppets;
    case 5 : $to = ^xmas05_tele_paint;
    case 6 : $to = ^xmas05_tele_decorations;
    case 7 : $to = movecoord(^xmas05_stranger_spot, 0, 0, 1);
    case 8 : $to = ^xmas05_tele_tree;
    case default :
        mes("::xmastele 1-8: 1 Diango, 2 trapdoor, 3 Rosie, 4 marionettes, 5 paint, 6 decorations, 7 stranger, 8 Varrock tree");
        return;
}
p_telejump(map_findsquare($to, 0, 2, ^map_findsquare_lineofwalk));
