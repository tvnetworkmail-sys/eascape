// EASCape: Keldagrim's market stalls, as 2009scape's Stall.java (6163 bakery and 6166 crafting at
// level 5, 6164 silver at 50, 6162 gems at 75: the same loot as the stalls they share it with);
// the dwarf clothes stall can't be stolen from (no source has it). The owners and the Black Guard
// watching, and the crafting stall's 16 xp and 24-tick respawn (2009scape's 12, doubled as ours),
// are ours.
[stealing_keldagrim_bakery]
table=stealing
data=loc,dwarf_market_bakery
data=owner,dwarf_city_shop_bakery
data=guard,dwarf_city_black_guard1
data=guard,dwarf_city_black_guard2
data=guard,dwarf_city_black_guard3
data=guard,dwarf_city_black_guard4
data=level,5
data=experience,160
data=respawn_ticks,8
data=loot,cake,1,1,13,a cake
data=loot,bread,1,1,5,some bread
data=loot,chocolate_slice,1,1,2,a chocolate slice
data=loot_total,20
data=stall,bakery stall

