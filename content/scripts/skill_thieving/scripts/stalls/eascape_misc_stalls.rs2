// EASCape: Miscellania and Etceteria market stalls (289), our stall system
[oploc2,misc_fish_market]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[queue,stolen_from_stall_miscfish]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^miscfish_stall_index);

[oploc2,misc_veg_market]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[queue,stolen_from_stall_miscveg]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^miscveg_stall_index);

[oploc2,etc_fish_market]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[queue,stolen_from_stall_etcfish]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^etcfish_stall_index);

[oploc2,etc_veg_market]
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

[queue,stolen_from_stall_etcveg]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^etcveg_stall_index);

// EASCape: Keldagrim's market stalls (stealing.dbrow)
[oploc2,dwarf_market_bakery] @attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);
[oploc2,dwarf_market_crafting] @attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);
[oploc2,dwarf_market_silver] @attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);
[oploc2,dwarf_market_gems] @attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);
[oploc2,dwarf_market_clothes] mes("The dwarves watch this stall too closely to steal from it."); // ours: no source lets you
