[opnpc3,viking_woman_indoors] @attempt_pick_viking_pocket(npc_type);

[label,attempt_pick_viking_pocket](npc $npc)
if(%viking < ^viking_complete) {
    mes("They are too suspicious of you for you to get close enough to steal from them.");
    npc_say("You stay away from me outerlander!");
    return;
}
@attempt_pick_pocket($npc);

// EASCape: these had a Pickpocket option and no script ("Nothing interesting happens"); Void
// pickpockets them as their kind (pickpocket.tables.toml: anja and hengel "human", cuffs, jeff,
// narf and rusty "human", paladin_2 "paladin", farmer_2 "farmer"). The Draynor jail guards, the
// Doric guard and the Burthorpe man aren't in Void's list: the cache's Pickpocket option, as guards and men (ours)
[opnpc3,farmer2] @attempt_pick_pocket(npc_type);
