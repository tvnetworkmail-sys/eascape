// EASCape: Bank PIN (19 September 2005). The PIN itself lives in the cache's varps: bankpin (perm:
// bankpin_true, bankpin_next, bankpin_status, bankpin_delay) and bankpin_1/bankpin_2 (this login only:
// the keypad's digits bankpin_a..j, bankpin_guess, bankpin_counter, bankpin_unlocked).
// ours: the cache has no varp for when a pending PIN (or a deletion) comes due, so this one holds
// date_minutes for that moment
[bankpin_time]
scope=perm

// ours: the entry screen's job (^bankpin_mode_*), the first of the two new-PIN entries, the
// "Do you really wish to do that?" box (^bankpin_confirm_*), what to open once the PIN is right
// (^bankpin_after_*), wrong tries and the map_clock tick the lockout ends; all for this login only
[bankpin_mode]
[bankpin_first]
[bankpin_confirm]
[bankpin_after]
[bankpin_tries]
[bankpin_lockout]
