[opheldu,potato_baked]
if (last_useitem = pot_of_butter) {
    @make_potato_butter;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,pot_of_butter]
if (last_useitem = potato_baked) {
    @make_potato_butter;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,potato_butter]
if (last_useitem = cheese) {
    @make_cheese_potato;
} else {
    ~displaymessage(^dm_default);
}

[label,make_potato_butter]
if (stat_base(cooking) < 39) {
    ~mesbox("You need a Cooking level of 39 to do make a Potato with butter.");
} else {
    inv_del(inv, potato_baked, 1);
    inv_del(inv, pot_of_butter, 1);
    inv_add(inv, potato_butter, 1);
    stat_advance(cooking, 400);
    mes("You add the butter to the potato."); // EASCape: Void cooking.recipes.toml
}

// EASCape: the level check was the wrong way round (only under 47 could make it); Void
// cooking.recipes.toml: 47 Cooking, 40 xp
[label,make_cheese_potato]
if (stat_base(cooking) < 47) {
    ~mesbox("You need a Cooking level of 47 to do make a Potato with butter and cheese.");
} else {
    inv_del(inv, potato_butter, 1);
    inv_del(inv, cheese, 1);
    inv_add(inv, potato_cheese, 1);
    stat_advance(cooking, 400);
    mes("You add the cheese to the potato."); // EASCape: Void cooking.recipes.toml
}

// EASCape: the potatoes had Eat in the cache but nothing to eat them by. Void cooking.items.toml
// heals: baked potato 4, with butter 14, with cheese 16; they eat as normal food.
[opheld1,potato_baked] @player_consume_item(consume_effect_stat, 2, 3);
[opheld1,potato_butter] @player_consume_item(consume_effect_stat, 2, 3);
[opheld1,potato_cheese] @player_consume_item(consume_effect_stat, 2, 3);
