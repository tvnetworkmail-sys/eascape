[opheldu,cooked_meat]
switch_obj (last_useitem) {
    case pie_shell : @make_uncooked_pie(last_slot);
    case bowl_chilli : ~topping_mix(cooked_meat, bowl_chilli, bowl_chilli+carne, null, 11, 250, true, "meat", "You chop up the meat and add it to the sauce in the bowl."); // EASCape: potato toppings (potato_toppings.rs2)
    case bowl_water : @make_incomplete_stew(last_slot);
    case stew1 : @make_uncooked_stew(last_slot, last_useslot);
    case bowl_empty : @no_water_stew_message;
    case default : @use_topping_on_pizza;
}

[opheldu,cooked_chicken]
switch_obj (last_useitem) {
    case pie_shell : @make_uncooked_pie(last_slot);
    case bowl_water : @make_incomplete_stew(last_slot);
    case stew1 : @make_uncooked_stew(last_slot, last_useslot);
    case bowl_empty : @no_water_stew_message;
    case default : @use_topping_on_pizza;
}
