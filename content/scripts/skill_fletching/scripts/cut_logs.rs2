// logs
[opheldu,_category_22]
switch_obj(last_useitem) {
    case knife : @fletch_log(last_item);
    case tinderbox : @light_logs_inv(last_slot);
    case default : ~displaymessage(^dm_default);
}

[label,fletch_log](obj $log)
if (map_members = ^false) {
    mes(^mes_members_fletching); // guess
    return;
}
db_find(fletch_bow_table:log, $log);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}
def_namedobj $obj1 = arrow_shaft;
def_int $shaft_count = db_getfield($data, fletch_bow_table:shafts, 0);
def_namedobj $obj2;
def_namedobj $obj3;
$obj2, $obj3 = db_getfield($data, fletch_bow_table:objchoices, 0);
def_namedobj $product;
def_int $amt;
// EASCape: the 2005 make menu (Make 1, 5, 10 and X), the cache's skillmulti2/3 (was the 2004
// multiobj screen, one at a time: your call, 8 Nov 2026)
if ($shaft_count < 1) {
    $product, $amt = ~skill_multi2_header("What would you like to make?",
        $obj2, 0, -2, 175, "\\n\\n\\n\\n<~string_removeright(oc_name($log), 5)> Short Bow",
        $obj3, 0, -2, 175, "\\n\\n\\n\\n<~string_removeright(oc_name($log), 5)> Long Bow"
    );
} else {
    $product, $amt = ~skill_multi3_header("What would you like to make?",
        $obj1, 175, "\\n\\n\\n\\nArrow Shafts",
        $obj2, 175, "\\n\\n\\n\\nShort Bow",
        $obj3, 175, "\\n\\n\\n\\nLong Bow"
    );
}
if ($product = null | $amt < 1) {
    return;
}
def_int $level = 1;
// default to shafts
def_int $count = 1;
// 5 xp a log for 15 shafts (2006Scape, 2009scape, the OSRS wiki); was 7.5
def_int $fletching_experience = 50;
def_string $message;
// 2005-osrs, rsc
if ($product = $obj2) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:shortbow, 0);
    $message = "You carefully cut the wood into a shortbow.";
} else if ($product = $obj3) {
    $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:longbow, 0);
    $message = "You carefully cut the wood into a longbow.";
} else {
    $message = "You carefully cut the wood into <tostring($shaft_count)> arrow shafts.";
    $count = $shaft_count;
    $fletching_experience = 50;
}
if (stat(fletching) < $level) {
    // osrs has a level 1 fail message for arrow shafts but i doubt 2004 used it
    ~doubleobjbox($log, $product, "You need a Fletching level of at least <tostring($level)> to make <~add_article(lowercase(oc_name($product)))>.", 200);
    return;
}
@fletch_log_cut($log, $product, $count, $fletching_experience, $message, $amt);

// EASCape: one cut every 3 ticks while you have logs, like the 2005 make menu's other skills
// (spinning); the knife animation is the cache's human_fletching
[label,fletch_log_cut](obj $log, namedobj $product, int $count, int $xp, string $message, int $amt)
if (inv_total(inv, $log) = 0 | inv_total(inv, knife) = 0) {
    return;
}
anim(human_fletching, 0);
weakqueue*(fletch_log_cut, 3)($log, $product, $count, $xp, $message, $amt);

[queue,fletch_log_cut](obj $log, namedobj $product, int $count, int $xp, string $message, int $amt)
if (inv_total(inv, $log) = 0) {
    return;
}
inv_del(inv, $log, 1);
mes($message);
stat_advance(fletching, $xp);
inv_add(inv, $product, $count);
$amt = sub($amt, 1);
if ($amt < 1) {
    return;
}
@fletch_log_cut($log, $product, $count, $xp, $message, $amt);
