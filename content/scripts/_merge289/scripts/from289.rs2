// from 289: general/scripts/quests.rs2
[proc,send_quest_complete2](component $component, namedobj $obj, int $objscale, int $questpoints, string $questmessage, string $rewardtext)
// Random quest complete jingle.
def_int $random = random(128);
if ($random < 32) {       // The least common music that plays when completing a quest.
    ~music_jingle("quest complete 3");
} else if ($random < 64) {// A less common music that plays when completing a quest.
    ~music_jingle("quest complete 2");
} else {                 // The most common music that plays when completing a quest.
    ~music_jingle("quest complete 1");
}
~update_questpoints;
split_init($rewardtext, 200, 5, q8_full);
if_settext(questscroll_death:com_3, $questmessage);
if_settext(questscroll_death:com_9, tostring($questpoints));
if_settext(questscroll_death:com_11, split_get(0, 0));
if_settext(questscroll_death:com_12, split_get(0, 1));
if_settext(questscroll_death:com_13, split_get(0, 2));
if_settext(questscroll_death:com_14, split_get(0, 3));
if_setobject(questscroll_death:com_4, $obj, $objscale);
if_openmain(questscroll_death);
// Update Quest Tab color
if_setcolour($component, ^green_rgb);
if_settab(questlist, ^tab_quest_journal);
switch_component ($component) {
    case questlist:troll_love : 
        mes("Congratulations! You've helped a lonely troll find love. Quest complete!");
    case default : 
        mes("Congratulations! Quest complete!");
}

// from 289: general/scripts/misc/inv_procs.rs2
[proc,inv_changeitem](inv $inv, obj $old, namedobj $new, int $slots)
def_int $i = 0;
while ($i < inv_size($inv)) {
    if ($slots < 1) return;
    if (inv_getobj($inv, $i) = $old) {
        inv_setslot($inv, $i, $new, inv_getnum($inv, $i));
        $slots = sub($slots, 1);
    }
    $i = add($i, 1);
}

// Replace a certain amount of an object in the inventory
// from 289: general/scripts/misc/coord_procs.rs2
[proc,setcoord_mapsquare](coord $coord, int $mapx, int $mapy, int $mapz)(coord)
def_int $relx = modulo(coordx($coord), 64);
def_int $relz = modulo(coordz($coord), 64);
return(movecoord(0_0_0_0_0, add(multiply($mapx, 64), $relx), $mapy, add(multiply($mapz, 64), $relz)));

// euclidean
// from 289: general/scripts/misc/coord_procs.rs2
[proc,centre_coord](coord $coord1, coord $coord2)(coord)
def_int $x = divide(add(coordx($coord1), coordx($coord2)), 2);
def_int $z = divide(add(coordz($coord1), coordz($coord2)), 2);
def_int $y = divide(add(coordy($coord1), coordy($coord2)), 2);
return(movecoord(0_0_0_0_0, $x, $y, $z));


// chooses the coord that the origin is facing
// from 289: general/scripts/misc/coord_procs.rs2
[proc,movedir_coord](coord $origin, coord $dest)(coord)
def_int $x = sub(coordx($dest), coordx($origin));
def_int $z = sub(coordz($dest), coordz($origin));

def_int $dirx = 0;
def_int $dirz = 0;

if ($x >= 1) $dirx = 1;
else if ($x <= -1) $dirx = -1;

if ($z >= 1) $dirz = 1;
else if ($z <= -1) $dirz = -1;

return(movecoord($origin, $dirx, 0, $dirz));

// doesnt include diagonals
// from 289: skill_firemaking/scripts/light_source.rs2
[proc,extinguish_light_sources]
def_int $i = 0;
def_obj $obj = null;
def_int $num = 0;
while ($i < inv_size(inv)) {
    $obj = inv_getobj(inv, $i);
    $num = inv_getnum(inv, $i);
    if ($obj ! null & oc_category($obj) = light_source_lit) {
        inv_delslot(inv, $i);
        if (oc_param($obj, next_obj_stage) ! null) inv_add(inv, oc_param($obj, next_obj_stage), $num);
    }
    $i = add($i, 1);
}

// from 289: npc/scripts/npc_walk.rs2
[proc,npc_forcerun](coord $dest)
npc_tele(~movedir_coord(npc_coord, $dest));

if (npc_coord = $dest | npc_range($dest) > 50) {
    world_delay(0);
    return;
}
npc_tele(~movedir_coord(npc_coord, $dest));
world_delay(0);
if (npc_coord = $dest | npc_range($dest) > 50) return;
~npc_forcerun($dest);

// from 289: music/scripts/music.rs2
[label,music_play](midi $song)
%currentsong = $song;
%musicstart = map_clock;
%musiclength = midi_length($song);
midi_song(%currentsong);

// from 289: interface_chat/scripts/chat.rs2
[proc,chatnpc_model_page](string $npc_name, int $chathead, int $page)
def_int $lines = split_linecount($page);
def_interface $interface = null;

if ($lines = 0) {
    // sanity check
    return;
} else if ($lines = 1) {
    $interface = npcchat1;
    if_setmodel(npcchat1:com_0, $chathead);
    if_setanim(npcchat1:com_0, split_getanim($page));
    if_settext(npcchat1:com_1, $npc_name);
    if_settext(npcchat1:com_2, split_get($page, 0));
} else if ($lines < 3) {
    $interface = npcchat2;
    if_setmodel(npcchat2:com_0, $chathead);
    if_setanim(npcchat2:com_0, split_getanim($page));
    if_settext(npcchat2:com_1, $npc_name);
    if_settext(npcchat2:com_2, split_get($page, 0));
    if_settext(npcchat2:com_3, split_get($page, 1));
} else if ($lines = 3) {
    $interface = npcchat3;
    if_setmodel(npcchat3:com_0, $chathead);
    if_setanim(npcchat3:com_0, split_getanim($page));
    if_settext(npcchat3:com_1, $npc_name);
    if_settext(npcchat3:com_2, split_get($page, 0));
    if_settext(npcchat3:com_3, split_get($page, 1));
    if_settext(npcchat3:com_4, split_get($page, 2));
} else if ($lines = 4) {
    $interface = npcchat4;
    if_setmodel(npcchat4:com_0, $chathead);
    if_setanim(npcchat4:com_0, split_getanim($page));
    if_settext(npcchat4:com_1, $npc_name);
    if_settext(npcchat4:com_2, split_get($page, 0));
    if_settext(npcchat4:com_3, split_get($page, 1));
    if_settext(npcchat4:com_4, split_get($page, 2));
    if_settext(npcchat4:com_5, split_get($page, 3));
}
if_openchat($interface);

// from 289: interface_chat/scripts/chat.rs2
[proc,chatnpc_model](string $npc_name, int $chathead, string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_model_page($npc_name, $chathead, $page);
    p_pausebutton;
    $page = calc($page + 1);
}

// from 289: interface_chat/scripts/chat.rs2
[proc,chatnpc_cutscene_page](string $npc_name, npc $npc, int $page)
def_int $lines = split_linecount($page);
def_interface $interface = null;
if ($lines = 0) {
    return;
} 
if ($lines < 3) {
    if_setnpchead(inter_213_274:com_0, $npc);
    if_setanim(inter_213_274:com_0, split_getanim($page));
    if_settext(inter_213_274:com_1, $npc_name);
    if_settext(inter_213_274:com_2, "");
    if_settext(inter_213_274:com_3, split_get($page, 0));
    if_settext(inter_213_274:com_4, split_get($page, 1));
    if_settext(inter_213_274:com_5, "");
} else if ($lines > 2) {
    if_setnpchead(inter_213_274:com_0, $npc);
    if_setanim(inter_213_274:com_0, split_getanim($page));
    if_settext(inter_213_274:com_1, $npc_name);
    if_settext(inter_213_274:com_2, split_get($page, 0));
    if_settext(inter_213_274:com_3, split_get($page, 1));
    if_settext(inter_213_274:com_4, split_get($page, 2));
    if_settext(inter_213_274:com_5, split_get($page, 3));
}
if_openchat(inter_213_274);

// from 289: interface_chat/scripts/chat.rs2
[proc,chatnc_cutscene](string $npc_name, npc $npc, string $string)
split_init($string, 380, 4, q8_full);
def_int $page = 0;
def_int $pagetotal = split_pagecount;
while ($page < $pagetotal) {
    ~chatnpc_cutscene_page($npc_name, $npc, $page);
    $page = calc($page + 1);
}
