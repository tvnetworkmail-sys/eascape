if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);
if_settabactive(^tab_friends);

// from 274: macro events/scripts/macro_events.rs2
[proc,macro_return_teleport]
if(%macro_event_target_coord = null | map_blocked(%macro_event_target_coord) = true) {
    mes("Whoops, you couldn't be returned to where you came from.");
    p_teleport(map_findsquare(0_50_50_21_18, 0, 2, ^map_findsquare_lineofwalk));
    return;
}
p_teleport(%macro_event_target_coord);

// from 274: music/scripts/music.rs2
[proc,music_jingle](midi $jingle)
// we only offset for music looping
// the client will handle playing the last song after this jingle ends
%musicstart = add(map_clock, midi_length($jingle));
midi_jingle($jingle);

// from 274: music/scripts/music.rs2
[proc,.music_jingle](midi $jingle)
.%musicstart = add(map_clock, midi_length($jingle));
.midi_jingle($jingle);




// from 274: minigames/game_trail/scripts/trail_clue_helper.rs2
[label,trail_clue_loc_interact](obj $clue)
if(oc_category($clue) = trail_clue_hard) @trail_clue_hard_loc_interact($clue);
if(oc_category($clue) = trail_clue_medium) @trail_clue_medium_loc_interact($clue);
else @trail_clue_easy_loc_interact($clue);

// from 274: minigames/game_trail/scripts/easy/trail_clue_easy.rs2
[label,trail_clue_easy_loc_interact](obj $clue)
~progress_clue_easy($clue, "You've found another clue scroll!");

// from 274: minigames/game_trail/scripts/hard/trail_clue_hard.rs2
[label,trail_clue_hard_loc_interact](obj $clue)
~progress_clue_hard($clue, "You've found another clue scroll!");

