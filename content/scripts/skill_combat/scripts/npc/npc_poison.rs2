// EASCape: npc poison runs on its own queue (19) every 30 ticks. It used the shared [ai_timer,_],
// and any monster with its own [ai_timer] (cows, imps, ducks, chickens, zombies, Barrows, Fight Cave,
// quest bosses...) replaced it and never took poison damage. Queue 19 has no other scripts.
// (npc_queue takes 1-19 here: engine QueueValid is 0-19)
[ai_queue19,_]
if (%npc_poison <= 0) return;
~npc_poison_timer;
if (%npc_poison > 0) npc_queue(19, 0, 30);

[proc,npc_poison_timer]
// damage npc
%npc_poison = sub(%npc_poison, 1);
if (%npc_poison > 0) {
    if (npc_stat(hitpoints) = 0) { // already dead
        return;
    }
    npc_damage(^hitmark_poison, divide(add(%npc_poison, 4), 5));
    // They died
    if (npc_stat(hitpoints) = 0){
        npc_queue(3, 0, 0);
    }
} else {
    ~npc_poison_clear;
    return;
}






[proc,npc_poison_clear]
%npc_poison = 0;


[proc,npc_poison_start](int $severity)
if (~npc_is_attackable() = false) {
    return;
}
if (map_members = ^false) {
    return;
}

if ($severity > %npc_poison) {
    if (%npc_poison <= 0) npc_queue(19, 0, 30);
    %npc_poison = $severity;
}
