// as the Controls tab's buttons (player_controls.rs2), one button that switches it
[proc,combat07_autoretaliate]
if_close;
if (p_finduid(uid) = true) {
    p_stopaction;
    if (%option_nodef = ^player_auto_retaliate_on) {
        %option_nodef = ^player_auto_retaliate_off;
    } else {
        %option_nodef = ^player_auto_retaliate_on;
    }
    return;
}
%option_nodef = %option_nodef; // resync varp
