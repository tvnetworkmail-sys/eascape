// EASCape: the dragon scimitar's special attack, Sever (Dragon Scimitar Change, 4 April 2005): 55%
// energy, a slash with more accuracy (Void: x1.15), normal damage. On a player it stops their
// protection prayers for 5 seconds (pvp_dragon_scimitar.rs2); it does nothing to monsters' (RS wiki:
// "the special attack will not disable monster protection prayers"). Animation, spotanim and sound
// are the 377 cache's sp_attack_dragon_scimitar, its trail and sever.
[label,pvm_dragon_scimitar_sa]
~set_sa_vars(oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy));
def_int $damage = 0;
def_int $maxhit = %com_maxhit;
def_int $damage_capped = 0;
def_int $attack_roll = scale(115, 100, ~player_attack_roll_specific(%damagetype));
def_int $defence_roll = ~npc_defence_roll_specific(^slash_style);
if(npc_type = tbwt_beast) $attack_roll = 0;
if (randominc($attack_roll) > randominc($defence_roll)) {
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    if(npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) {
        $damage = 0;
    }
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(sp_attack_dragon_scimitar, 0);
sound_synth(sever, 1, 0);
spotanim_pl(sp_attack_dragon_scimitar_trail_spotanim, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 1, 20); // delay npc this tick
}
