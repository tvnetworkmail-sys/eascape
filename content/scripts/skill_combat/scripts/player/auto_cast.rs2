[if_button,combat_staff_2:auto_choose] @open_autocast_interface;
[if_button,staff_spells:ssb0] @set_autocast_spell(^wind_strike);
[if_button,staff_spells:ssb1] @set_autocast_spell(^water_strike);
[if_button,staff_spells:ssb2] @set_autocast_spell(^earth_strike);
[if_button,staff_spells:ssb3] @set_autocast_spell(^fire_strike);
[if_button,staff_spells:ssb4] @set_autocast_spell(^wind_bolt);
[if_button,staff_spells:ssb5] @set_autocast_spell(^water_bolt);
[if_button,staff_spells:ssb6] @set_autocast_spell(^earth_bolt);
[if_button,staff_spells:ssb7] @set_autocast_spell(^fire_bolt);
[if_button,staff_spells:ssb8] @set_autocast_spell(^wind_blast);
[if_button,staff_spells:ssb9] @set_autocast_spell(^water_blast);
[if_button,staff_spells:ssb10] @set_autocast_spell(^earth_blast);
[if_button,staff_spells:ssb11] @set_autocast_spell(^fire_blast);
[if_button,staff_spells:ssb12] @set_autocast_spell(^wind_wave);
[if_button,staff_spells:ssb13] @set_autocast_spell(^water_wave);
[if_button,staff_spells:ssb14] @set_autocast_spell(^earth_wave);
[if_button,staff_spells:ssb15] @set_autocast_spell(^fire_wave);

[label,open_autocast_interface]
if_close;
if (p_finduid(uid) = false) { // cant open autocast interface if delayed
    return;
}
%autocast_set = 0;
// EASCape: the ancient staff on the Ancient Magicks shows their spells instead (the 377 interface
// that has the name questscroll_itgronigen is that "Select a Combat Spell" list)
if (inv_getobj(worn, ^wearpos_rhand) = staff_of_zaros & %alternate_spells = 1) {
    if_settab(questscroll_itgronigen, 0);
    return;
}
if_settab(staff_spells, 0);

[if_button,staff_spells:cancelspell]
if_close;
if (p_finduid(uid) = true) {
    ~initalltabs;
}

// todo: allow setting autocast to go through delays.
[label,set_autocast_spell](int $spell)
if_close;
if (p_finduid(uid) = true) {
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data) = false) {
        return;
    }
    // set auto cast varp
    %autocast_spell = $spell;
    // EASCape: choosing a spell switches autocast on straight away (the "Attack with" box still
    // switches it off and on again)
    %autocast_set = 1;
    if_settext(combat_staff_2:auto_spell, db_getfield($spell_data, magic_spell_table:name, 0));

    ~initalltabs;
}

[proc,player_autocast_enabled]()(boolean)
if (testbit(%autocast_set, 0) = ^true & %autocast_spell > 0) {
    return(true);
}
return(false);

[proc,player_autocast_reset]
%autocast_set = 0;
%autocast_spell = null;

[proc,.player_autocast_reset]
.%autocast_set = 0;
.%autocast_spell = null;

// EASCape: the Ancient Magicks' list (buttons in the interface's order)
[if_button,questscroll_itgronigen:com_6] if_close; if (p_finduid(uid) = true) ~initalltabs;
[if_button,questscroll_itgronigen:com_7] @set_autocast_spell(^ice_rush);
[if_button,questscroll_itgronigen:com_18] @set_autocast_spell(^ice_blitz);
[if_button,questscroll_itgronigen:com_29] @set_autocast_spell(^ice_burst);
[if_button,questscroll_itgronigen:com_40] @set_autocast_spell(^ice_barrage);
[if_button,questscroll_itgronigen:com_51] @set_autocast_spell(^blood_rush);
[if_button,questscroll_itgronigen:com_62] @set_autocast_spell(^blood_blitz);
[if_button,questscroll_itgronigen:com_71] @set_autocast_spell(^blood_burst);
[if_button,questscroll_itgronigen:com_82] @set_autocast_spell(^blood_barrage);
[if_button,questscroll_itgronigen:com_93] @set_autocast_spell(^smoke_rush);
[if_button,questscroll_itgronigen:com_106] @set_autocast_spell(^smoke_blitz);
[if_button,questscroll_itgronigen:com_119] @set_autocast_spell(^smoke_burst);
[if_button,questscroll_itgronigen:com_132] @set_autocast_spell(^smoke_barrage);
[if_button,questscroll_itgronigen:com_145] @set_autocast_spell(^shadow_rush);
[if_button,questscroll_itgronigen:com_158] @set_autocast_spell(^shadow_blitz);
[if_button,questscroll_itgronigen:com_171] @set_autocast_spell(^shadow_burst);
[if_button,questscroll_itgronigen:com_184] @set_autocast_spell(^shadow_barrage);

// a spell from the other book can't stay set when you change books
[proc,autocast_check_book]
def_boolean $ancient = false;
if (%autocast_spell >= ^smoke_rush & %autocast_spell <= ^ice_barrage) $ancient = true;
if (%autocast_spell > 0 & (($ancient = true & %alternate_spells = 0) | ($ancient = false & %alternate_spells = 1))) {
    ~player_autocast_reset;
}
