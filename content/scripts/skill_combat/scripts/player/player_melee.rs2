// begins combat
[label,player_melee_attack]
p_stopaction;
if (~npc_is_attackable() = false) {
    return;
}

if (%action_delay > map_clock) {
    p_opnpc(2); // it is guaranteed here that we are already within op distance
    return;
}

if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    return; // this means the npc is not avail to fight i.e dead
}

~barrows_degrade_check;
def_int $barrows_set = ~barrows_worn_set;
// check hit, give combat xp
def_int $damage = 0;
def_boolean $hit = ~player_npc_hit_roll(%damagetype);
if ($barrows_set = ^barrows_set_verac & random(4) = 0) {
    $hit = true; // Verac's set: this one goes through armour and Defence
}
if ($hit = true) {
    def_int $maxhit = %com_maxhit;
    if ($barrows_set = ^barrows_set_dharok) {
        $maxhit = ~barrows_dharok_maxhit($maxhit);
    }
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    if (npc_param(demonbane_vulnerable) = true & inv_total(worn, silverlight) > 0) {
        $maxhit = scale(160, 100, %com_maxhit);
    }
    if((npc_param(slayer_category) = ^slayer_kurask | npc_param(slayer_category) = ^slayer_turoth) & inv_total(worn, slayer_leafbladed_spear) = 0) {
        $maxhit = 0;
    }
    if (~fairy1_is_tanglefoot(npc_type) = true) { // EASCape: Fairytale I's magic secateurs (fairy1_grove.rs2)
        $maxhit = ~fairy1_tanglefoot_maxhit($maxhit);
    }
    $damage = randominc(min($maxhit, npc_param(max_dealt)));
    def_int $damage_capped = min($damage, npc_stat(hitpoints));
    // EASCape: Desert Treasure's Fareed knocks your weapon away without ice gloves
    ~dt_fareed_melee;
    // EASCape: Tz-Kek burns you for 1 when you hit it in melee (OSRS wiki, TzHaar Fight Cave)
    if (npc_type = tzhaar_fightcave_swarm_2a | npc_type = tzhaar_fightpit_swarm_2a) {
        ~damage_self(1);
    }
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
    if ($barrows_set = ^barrows_set_guthan & $damage_capped > 0 & random(4) = 0) {
        stat_heal(hitpoints, $damage_capped, 0);
        spotanim_npc(barrows_guthan_effect, 0, 0);
    }
}

def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon ! null) {
    def_int $poison_severity = oc_param($weapon, poison_severity);
    if ($damage > 0 & $poison_severity > 0 & random(4) = 0) { // 1/4 chance to poison
        // poison npc
        ~npc_poison_start($poison_severity);
    }
}

//mes("attackstyle: <tostring(%attackstyle)>, damagestyle: <tostring(%damagestyle)>, damage: <tostring($damage)>, damagetype: <tostring(%damagetype)>");
anim(%com_attackanim, 0);
sound_synth(%com_attacksound, 1, 0);
~npc_retaliate(0);
// EASCape test mode: ::onehit kills whatever you hit
if (%eascape_onehit = ^true) {
    $damage = npc_stat(hitpoints);
    npc_heropoints($damage); // so the kill still gets its drop
}
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20); 
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 1, 20); // delay npc this tick
}
// set the skill clock depending on the weapon attack rate
if ($weapon = null) {
    %action_delay = add(map_clock, 4);
} else {
    %action_delay = add(map_clock, oc_param($weapon, attackrate));
}

p_opnpc(2);
