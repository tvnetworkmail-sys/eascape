// EASCape: the 6 Sep 2005 prayer, wired as the others (protectfrommelee.rs2)
[if_button,prayer:prayer_smite]
if_close;
if (p_finduid(uid) = true) {
    @activate_prayer_smite;
}
%prayer17 = %prayer17;

[label,activate_prayer_smite]
p_clearpendingaction;
def_dbrow $data = ~get_prayer_data(^prayer_smite);
if ($data = null) {
    return;
}
if (%prayer17 = ^true) {
    %prayer17 = ^false;
    ~prayer_deactivate(^prayer_smite);
    return;
}
if (~prayer_checks($data) = false) {
    %prayer17 = ^false;
    return;
}
def_int $levelreq = db_getfield($data, prayers:level, 0);
if (stat_base(prayer) < $levelreq){
    %prayer17 = ^false;
    sound_synth(prayer_off, 1, 0);
    ~mesbox("You need a @dbl@Prayer level of <tostring($levelreq)> to use <db_getfield($data, prayers:name, 0)>.");
    return;
}
%prayer17 = ^true;
~prayer_activate($data);
