// EASCape: Farming's patches, generated by tools/farming/patches.py. Index, the patch loc, its
// varbit (the 377 cache's farming varbits, the same numbers as Void's) and type (1 allotment,
// 2 flower, 3 herb, 4 hops, 5 tree, 6 fruit tree, 7 bush, 8 cactus, 9 belladonna, 10 mushroom, 11 calquat, 12 spirit tree). Allotments 1-8 pair with flower patch 9 + (n - 1) / 2.

[proc,farming_patch_count]()(int)
return(39);

[proc,farming_patch_get](int $patch)(int)
switch_int ($patch) {
    case 1 : return(%varbit_708);
    case 2 : return(%varbit_709);
    case 3 : return(%varbit_710);
    case 4 : return(%varbit_711);
    case 5 : return(%varbit_712);
    case 6 : return(%varbit_713);
    case 7 : return(%varbit_714);
    case 8 : return(%varbit_715);
    case 9 : return(%varbit_728);
    case 10 : return(%varbit_729);
    case 11 : return(%varbit_730);
    case 12 : return(%varbit_731);
    case 13 : return(%varbit_780);
    case 14 : return(%varbit_781);
    case 15 : return(%varbit_782);
    case 16 : return(%varbit_783);
    case 17 : return(%varbit_716);
    case 18 : return(%varbit_717);
    case 19 : return(%varbit_718);
    case 20 : return(%varbit_719);
    case 21 : return(%varbit_700);
    case 22 : return(%varbit_701);
    case 23 : return(%varbit_702);
    case 24 : return(%varbit_703);
    case 25 : return(%varbit_704);
    case 26 : return(%varbit_705);
    case 27 : return(%varbit_706);
    case 28 : return(%varbit_707);
    case 29 : return(%varbit_732);
    case 30 : return(%varbit_733);
    case 31 : return(%varbit_734);
    case 32 : return(%varbit_735);
    case 33 : return(%varbit_744);
    case 34 : return(%varbit_748);
    case 35 : return(%varbit_746);
    case 36 : return(%varbit_726);
    case 37 : return(%varbit_720);
    case 38 : return(%varbit_722);
    case 39 : return(%varbit_724);
}
return(-1);

[proc,farming_patch_set](int $patch, int $value)
switch_int ($patch) {
    case 1 : %varbit_708 = $value;
    case 2 : %varbit_709 = $value;
    case 3 : %varbit_710 = $value;
    case 4 : %varbit_711 = $value;
    case 5 : %varbit_712 = $value;
    case 6 : %varbit_713 = $value;
    case 7 : %varbit_714 = $value;
    case 8 : %varbit_715 = $value;
    case 9 : %varbit_728 = $value;
    case 10 : %varbit_729 = $value;
    case 11 : %varbit_730 = $value;
    case 12 : %varbit_731 = $value;
    case 13 : %varbit_780 = $value;
    case 14 : %varbit_781 = $value;
    case 15 : %varbit_782 = $value;
    case 16 : %varbit_783 = $value;
    case 17 : %varbit_716 = $value;
    case 18 : %varbit_717 = $value;
    case 19 : %varbit_718 = $value;
    case 20 : %varbit_719 = $value;
    case 21 : %varbit_700 = $value;
    case 22 : %varbit_701 = $value;
    case 23 : %varbit_702 = $value;
    case 24 : %varbit_703 = $value;
    case 25 : %varbit_704 = $value;
    case 26 : %varbit_705 = $value;
    case 27 : %varbit_706 = $value;
    case 28 : %varbit_707 = $value;
    case 29 : %varbit_732 = $value;
    case 30 : %varbit_733 = $value;
    case 31 : %varbit_734 = $value;
    case 32 : %varbit_735 = $value;
    case 33 : %varbit_744 = $value;
    case 34 : %varbit_748 = $value;
    case 35 : %varbit_746 = $value;
    case 36 : %varbit_726 = $value;
    case 37 : %varbit_720 = $value;
    case 38 : %varbit_722 = $value;
    case 39 : %varbit_724 = $value;
}

[proc,farming_patch_type](int $patch)(int)
if ($patch <= 8) return(1);
if ($patch <= 12) return(2);
if ($patch <= 16) return(3);
if ($patch <= 20) return(4);
if ($patch <= 24) return(5);
if ($patch <= 28) return(6);
if ($patch <= 32) return(7);
if ($patch <= 36) return(calc($patch - 25));
return(12);

[oploc1,farming_veg_patch_1] ~farming_op1(1);
[oploc2,farming_veg_patch_1] ~farming_inspect(1);
[oploc4,farming_veg_patch_1] ~farming_guide;
