// EASCape: Farming step 2e: fruit baskets and vegetable sacks, after Void (Baskets.kt, Sack.kt):
// Fill an empty one with the first fruit (strawberries, oranges, bananas, apples, tomatoes) or
// vegetables (potatoes, onions, cabbages) you carry, up to 5 / 10; Fill tops one up; Remove-one
// takes one out. Void's messages. (Triggers generated with tools/farming/containers.py's names.)

[opheld1,basket_empty] ~farming_fill_empty(true);
[opheld1,sack_empty] ~farming_fill_empty(false);

[proc,farming_fill_empty](boolean $basket)
def_int $slot = last_slot;
def_namedobj $produce = null;
if ($basket = true) {
    if (inv_total(inv, strawberry) > 0) $produce = strawberry;
    else if (inv_total(inv, orange) > 0) $produce = orange;
    else if (inv_total(inv, banana) > 0) $produce = banana;
    else if (inv_total(inv, cooking_apple) > 0) $produce = cooking_apple;
    else if (inv_total(inv, tomato) > 0) $produce = tomato;
    if ($produce = null) {
        mes("You don't have any fruit with which to fill the basket.");
        return;
    }
} else {
    if (inv_total(inv, potato) > 0) $produce = potato;
    else if (inv_total(inv, onion) > 0) $produce = onion;
    else if (inv_total(inv, cabbage) > 0) $produce = cabbage;
    if ($produce = null) {
        mes("You don't have any potatoes, onions or cabbages.");
        return;
    }
}
inv_del(inv, $produce, 1);
inv_setslot(inv, $slot, enum(obj, namedobj, farming_cont_first, $produce), 1);
~farming_fill_more($slot);

// tops up the container in this slot from what you carry
[proc,farming_fill_more](int $slot)
def_obj $c = inv_getobj(inv, $slot);
def_namedobj $produce = enum(obj, namedobj, farming_cont_produce, $c);
def_namedobj $next = enum(obj, namedobj, farming_cont_next, $c);
while ($next ! null & inv_total(inv, $produce) > 0) {
    inv_del(inv, $produce, 1);
    inv_setslot(inv, $slot, $next, 1);
    $next = enum(obj, namedobj, farming_cont_next, $next);
}

[proc,farming_fill_partial]
def_obj $c = last_item;
if (enum(obj, namedobj, farming_cont_next, $c) = null) {
    def_string $name = lowercase(oc_name(enum(obj, namedobj, farming_cont_produce, $c)));
    if (compare($name, "cooking apple") = 0) $name = "apple";
    if (enum(obj, int, farming_cont_count, $c) = 10) mes("The <$name> sack is already full.");
    else mes("The <$name> basket is already full.");
    return;
}
~farming_fill_more(last_slot);

[proc,farming_remove_one]
def_obj $c = last_item;
def_int $slot = last_slot;
def_namedobj $produce = enum(obj, namedobj, farming_cont_produce, $c);
if ($produce = null) return;
if (inv_freespace(inv) = 0 & inv_total(inv, $produce) = 0) {
    mes("You don't have enough inventory space.");
    return;
}
inv_setslot(inv, $slot, enum(obj, namedobj, farming_cont_prev, $c), 1);
inv_add(inv, $produce, 1);
def_string $name = lowercase(oc_name($produce));
if (compare($name, "cooking apple") = 0) $name = "apple";
if (enum(obj, int, farming_cont_count, $c) > 0 & string_length(oc_debugname($c)) > 4 & compare(substring(oc_debugname($c), 0, 4), "sack") = 0) {
    mes("You take <~add_article($name)> out of the <$name> sack.");
} else {
    mes("You take <~add_article($name)> out of the <$name> basket.");
}

[opheld1,basket_strawberry_1] ~farming_fill_partial;
[opheld2,basket_strawberry_1] ~farming_remove_one;
[opheld1,basket_strawberry_2] ~farming_fill_partial;
