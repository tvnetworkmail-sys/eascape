val=maple_seed,You sow a maple tree seed in the plantpot. It needs watering before it will grow.
val=yew_seed,You sow a yew tree seed in the plantpot. It needs watering before it will grow.
val=magic_tree_seed,You sow a magic tree seed in the plantpot. It needs watering before it will grow.
val=spirit_tree_seed,You sow a spirit tree seed in the plantpot. It needs watering before it will grow.
val=apple_tree_seed,You sow a apple tree seed in the plantpot. It needs watering before it will grow.
val=banana_tree_seed,You sow a banana tree seed in the plantpot. It needs watering before it will grow.
val=orange_tree_seed,You sow a orange tree seed in the plantpot. It needs watering before it will grow.
val=curry_tree_seed,You sow a curry tree seed in the plantpot. It needs watering before it will grow.
val=pineapple_tree_seed,You sow a pineapple tree seed in the plantpot. It needs watering before it will grow.
val=papaya_tree_seed,You sow a papaya tree seed in the plantpot. It needs watering before it will grow.
val=palm_tree_seed,You sow a palm tree seed in the plantpot. It needs watering before it will grow.
val=calquat_tree_seed,You sow a calquat tree seed in the plantpot. It needs watering before it will grow.

