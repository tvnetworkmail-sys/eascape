val=papaya_tree_seed,plantpot_papaya_seed
val=palm_tree_seed,plantpot_palm_seed
val=calquat_tree_seed,plantpot_calquat_seed

[farming_sapling_sowmes]
inputtype=obj
outputtype=string
val=acorn,You sow a oak tree seed in the plantpot. It needs watering before it will grow.
