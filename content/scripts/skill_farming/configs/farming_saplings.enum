// potted_plants.recipes.toml and Farming.growSaplings)

[farming_sapling_sow]
inputtype=obj
outputtype=namedobj
default=null
val=acorn,plantpot_acorn
val=willow_seed,plantpot_willow_seed
val=maple_seed,plantpot_maple_seed
val=yew_seed,plantpot_yew_seed
val=magic_tree_seed,plantpot_magic_tree_seed
val=spirit_tree_seed,plantpot_spirit_tree_seed
