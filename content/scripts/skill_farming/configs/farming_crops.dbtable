// EASCape: Farming crops (tools/farming/convert.py, from Void's seed, produce and patch data).
[farming_crop]
column=index,int,INDEXED,REQUIRED
column=seed,obj,INDEXED,REQUIRED
column=produce,namedobj
column=name,string,REQUIRED
column=patchtype,int,REQUIRED
column=level,int,REQUIRED
column=plantxp,int,REQUIRED
column=harvestxp,int,REQUIRED
column=seeds,int,REQUIRED
column=chance,int,int,REQUIRED
column=disease,int,REQUIRED
column=stages,int,REQUIRED
// trees and fruit trees: the check-health experience (tenths)
column=checkxp,int
