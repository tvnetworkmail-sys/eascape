// EASCape: Farming
// the clock minute (date_minutes) the patches last grew up to
[farming_last]
scope=perm

// your growth tick offset + 1 (0 not chosen yet): ticks come up to 29 minutes off the clock's
// (wiki: "an offset of up to 30 minutes which is different per player, and persists")
[farming_offset]
scope=perm

// compost on the patches, two bits a patch (1 compost, 2 supercompost): patches 1-15, then 16-
[farming_compost_a]
scope=perm

[farming_compost_b]
scope=perm

// EASCape: step 2a: fruit trees whose health has been checked, a bit a patch (patch index - 1):
// a checked fruit tree grows fruit again once picked bare
[farming_claimed]
scope=perm

// patches 31 and up (step 2b)
[farming_compost_c]
scope=perm
