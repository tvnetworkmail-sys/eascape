// EASCape: skeletal wyvern drops from the OSRS wiki (Skeletal Wyvern, "Drops", 26 Oct 2026),
// replacing Void's. Every kill: wyvern bones. Then a pre-roll (granite legs, dragon platelegs,
// dragon plateskirt, 1/512 each); if none hits, the main table (out of 128).
// Left out, not in the 2006 game: adamant bolts (3/128), runite bolts (3/128) and the runite
// crossbow (u) (2/128) are kept as "nothing" so the other chances stay as the wiki has them;
// the brimstone key, elite clue and draconic visage tertiaries too.
// Our choices: the herb drop is three rolls on Void's herb table, and the rare drop table is
// Void's (the wiki's links to OSRS's own).
[eascape_drop_skeletal_wyvern]
table=eascape_drop
data=kind,0
data=roll,1
data=entry,wyvern_bones,1,1,1,null,0
data=entry,null,0,0,1,eascape_drop_skeletal_wyvern_preroll,512

[eascape_drop_skeletal_wyvern_preroll]
table=eascape_drop
data=kind,1
data=roll,512
data=entry,granite_legs,1,1,1,null,0
data=entry,dragon_platelegs,1,1,1,null,0
data=entry,dragon_plateskirt,1,1,1,null,0
data=entry,null,0,0,509,eascape_drop_skeletal_wyvern_main,128

