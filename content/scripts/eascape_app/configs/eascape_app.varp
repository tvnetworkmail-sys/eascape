// EASCape: the app's extras (only the EASCape app can switch them on; the web game never has them)
// on while the app's "EASCape Extras" plugin is on, for this login
[eascape_app_extras]

// the attack style you last had, given back when you log in with the extras on
[eascape_saved_com_mode]
scope=perm

// the spell you were autocasting when you put your staff away, set again when you wield one
[eascape_last_autocast]
scope=perm

// the app's Time Tracking (only while the app asks for it, ::appfarming): your farming growth
// offset (as farming_offset, +1; 0 while off) and the clock minute your patches last grew up to
// (farming_last), so the app knows when every growth tick comes, as the server does
[eascape_farming_offset]
transmit=yes

[eascape_farming_clock]
transmit=yes
