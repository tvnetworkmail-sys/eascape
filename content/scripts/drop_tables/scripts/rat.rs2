[ai_queue3,rat] @rat_death;
// EASCape: the four Rimmington house rats (the closest to Hetty) are their own type and dropped
// no tail; the OSRS wiki's Rat page gives every rat the tail during Witch's Potion
[ai_queue3,rat_indoors] @rat_death;

[label,rat_death]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// No default drop.

// Drop Rats Tail only as long as quest is active.
if (%hetty = ^hetty_started | %hetty = ^hetty_objects_given) {
    if (inv_total(inv, rats_tail) < 1 & inv_total(bank, rats_tail) < 1) { // Only drop if no rats tail found in inv or bank.
        obj_add(npc_coord, rats_tail, 1, ^lootdrop_duration);
    }
}
