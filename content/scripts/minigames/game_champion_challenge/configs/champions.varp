// EASCape: ours. The challenge itself lives in the 377 cache's own champions_defeated varp (now
// perm) and its varbits; this one remembers which champion Larxus has called up for you (1-10 in the
// cache's varbit order, 11 Leon D'Cour; 0 none). Like 2009scape's "championsarena:start" it is
// not kept over a logout.
[champ_arranged]
protect=no

// ours: the clock when Larxus last reminded you of a fight's rule, so that hits you take with
// auto-retaliate on don't bring him back every time (one reminder in 10 ticks; the others are
// refused without a word)
[champ_warned]
protect=no
