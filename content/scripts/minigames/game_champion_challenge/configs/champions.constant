// EASCape: the Champions' Challenge (12 December 2005). Squares are our 2006 map's, which is
// 2009scape's (ChampionChallengeListener.kt); Void's map is 8 squares further north.

// the champions in the cache's champions_defeated varbit order (bit = index - 1)
^champ_earthwarrior = 1
^champ_ghoul = 2
^champ_giant = 3
^champ_goblin = 4
^champ_hobgoblin = 5
^champ_imp = 6
^champ_jogre = 7
^champ_lesserdemon = 8
^champ_skeleton = 9
^champ_zombie = 10
^champ_leon = 11
// the ten lower champions' bits
^champ_lower_all = 1023

// the basement (its whole map square) and the arena west of the portcullis (2009scape: the
// portcullis at 3181,9758)
^champ_basement_sw = 0_49_152_0_0
^champ_basement_ne = 0_49_152_63_63
^champ_arena_sw = 0_49_152_0_0
^champ_arena_ne = 0_49_152_45_63
// 2009scape: the champion appears at 3170,9758; the statue's trapdoor lets you down at 3182,9758,
// the arena's ladder up at 3185,9758, the basement's ladder up at 3190,3356
^champ_spawn = 0_49_152_34_30
^champ_below_statue = 0_49_152_46_30
^champ_above_ladder = 0_49_152_49_30
^champ_guild_top = 0_49_52_54_28
// the guild's trapdoor down: Void's (one west, one south of the ladder up, on our map)
^champ_basement_arrive = 0_49_152_53_29
// ours: Larxus's square, for ::champtele
^champ_larxus = 0_49_152_51_30
