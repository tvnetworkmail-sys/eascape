// EASCape: Pest Control (18 Apr 2006). One island, one game at a time.
// 0 no game, 1 a game on the island
[pest_state]
type=int

// ticks since the game started
[pest_clock]
type=int

// ticks until the lander leaves (0: nobody aboard)
[pest_countdown]
type=int

// the Void Knight's hitpoints, for his glow
[pest_knight_hp]
type=int

// the portals destroyed (bits 1-4)
[pest_portals]
type=int

// pests on the island
[pest_count]
type=int
