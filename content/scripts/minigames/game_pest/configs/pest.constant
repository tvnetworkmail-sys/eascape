// EASCape: Pest Control (18 Apr 2006, minigames/game_pest)
// how many aboard before the lander leaves: ours (1, so it plays on a quiet world; 2009scape has 5)
^pest_min_players = 1
// once someone's aboard, the lander leaves a minute later (ours)
^pest_lander_wait = 100
// the ritual takes twenty minutes (2009scape: 2000 ticks; the squire)
^pest_game_ticks = 2000
// at first the most points you could have was 150 (the RuneScape wiki); 250 from 16 May 2006 (Update:
// Changes to Pest Control)
^pest_points_max = 250
// pests from each portal: 2009scape spawns them every 35 ticks
^pest_spawn_ticks = 35
^pest_max_pests = 60

// the outpost
^pest_lander_sw = 0_41_41_36_14
^pest_lander_ne = 0_41_41_39_19
^pest_lander_in = 0_41_41_37_15
^pest_leave = 0_41_41_33_15
^pest_lander_squire = 0_41_41_34_23

// the island (2009scape: offsets from 2624,2560)
^pest_island_sw = 0_41_40_0_0
^pest_island_ne = 0_41_40_63_63
^pest_island_land = 0_41_40_32_49
^pest_knight_coord = 0_41_40_32_32
^pest_squire_coord = 0_41_40_30_47
^pest_portal_w = 0_41_40_4_31
^pest_portal_e = 0_41_40_56_28
^pest_portal_se = 0_41_40_45_10
^pest_portal_sw = 0_41_40_21_9
^pest_loc_duration = 60000
// 25 to a game (24 Apr 2006)
^pest_max_players = 25
