// EASCape: Pest Control's pests (2009scape: monsters/PC*NPC). They go for the Void Knight; players
// near them they fight (Void's hunt). Ravagers break barricades and gates, splatters burst against
// them, spinners mend their portal, shifters jump to the knight.

[ai_timer,_pest_splatter] ~pest_ai;
[ai_timer,_pest_shifter] ~pest_ai;
[ai_timer,_pest_ravager] ~pest_ai;
[ai_timer,_pest_spinner] ~pest_ai;
[ai_timer,_pest_torcher] ~pest_ai;
[ai_timer,_pest_defiler] ~pest_ai;
[ai_timer,_pest_brawler] ~pest_ai;

[proc,pest_ai]
if (%pest_state ! 1) {
    npc_del;
    return;
}
if (npc_getmode = opplayer2 | npc_getmode = applayer2) return;
switch_category (npc_category) {
    case pest_spinner :
        ~pest_spinner_ai;
        return;
    case pest_ravager :
        if (~pest_ravager_ai = true) return;
    case pest_splatter :
        if (~pest_splatter_near = true) {
            ~pest_splatter_burst;
            return;
        }
}
if (npc_getmode = opnpc2 | npc_getmode = apnpc2) {
    if (npc_category = pest_shifter) ~pest_shifter_jump;
    return;
}
~pest_go_knight;

// after the Void Knight
[proc,pest_go_knight]
npc_huntall(npc_coord, 64, 0);
while (.npc_findnext = true) {
    if (.npc_type = pest_voidknight_control1) {
        if (npc_category = pest_torcher | npc_category = pest_defiler) npc_setmode(apnpc2);
        else npc_setmode(opnpc2);
        return;
    }
}

// ---------------------------------------------------------------- hitting the knight
[ai_opnpc2,_pest_splatter] ~pest_hit_knight;
[ai_opnpc2,_pest_shifter] ~pest_hit_knight;
[ai_opnpc2,_pest_ravager] ~pest_hit_knight;
[ai_opnpc2,_pest_brawler] ~pest_hit_knight;
[ai_apnpc2,_pest_torcher] ~pest_shoot_knight(torcher_fireball_launch_spotanim, torcher_fireball_travel_spotanim, torcher_fireball_impact_spotanim);
[ai_apnpc2,_pest_defiler] ~pest_shoot_knight(defiler_spike_launch_spotanim, defiler_spike_travel_spotanim, defiler_spike_impact_spotanim);

// the knight's defence: level 80 with +180 (2009scape npc_configs 3782), against the pest's attack
// with no bonus
[proc,pest_hit_knight]
if (.npc_type ! pest_voidknight_control1) {
    npc_setmode(null);
    return;
}
if (%npc_action_delay > map_clock) return;
%npc_action_delay = add(map_clock, npc_param(attackrate));
npc_anim(npc_param(attack_anim), 0);
if (npc_param(attack_sound) ! null) ~sound_area(npc_param(attack_sound), 0, npc_coord, 8);
def_int $damage = 0;
if (~pest_knight_hits(npc_stat(attack)) = true) $damage = randominc(npc_param(eascape_maxhit));
.npc_queue(2, $damage, 1);

[proc,pest_shoot_knight](spotanim $launch, spotanim $travel, spotanim $impact)
if (.npc_type ! pest_voidknight_control1) {
    npc_setmode(null);
    return;
}
if (%npc_action_delay > map_clock) return;
%npc_action_delay = add(map_clock, npc_param(attackrate));
npc_anim(npc_param(attack_anim), 0);
if (npc_param(attack_sound) ! null) ~sound_area(npc_param(attack_sound), 0, npc_coord, 8);
spotanim_npc($launch, 96, 0);
def_int $duration = ~npc_to_npc_projectile(.npc_uid, $travel, 40, 36, 52, 15, 11, 0, 5);
.spotanim_npc($impact, 96, $duration);
def_int $stat = npc_stat(ranged);
if (npc_category = pest_torcher) $stat = npc_stat(magic);
def_int $damage = 0;
if (~pest_knight_hits($stat) = true) $damage = randominc(npc_param(eascape_maxhit));
.npc_queue(2, $damage, calc($duration / 30));

[proc,pest_knight_hits](int $level)(boolean)
if (randominc(calc(($level + 9) * 64)) > randominc(calc((80 + 9) * (180 + 64)))) return(true);
return(false);

// ---------------------------------------------------------------- fighting players
// torchers and defilers shoot (2009scape: magic and ranged)
[ai_applayer2,_pest_defiler] ~npc_rangeattack;
[ai_applayer2,_pest_torcher] ~pest_torcher_attack;
[ai_queue1,_pest_defiler] gosub(npc_default_retaliate_ap);
[ai_queue1,_pest_torcher] gosub(npc_default_retaliate_ap);
[ai_opplayer2,_pest_defiler] npc_setmode(applayer2);
[ai_opplayer2,_pest_torcher] npc_setmode(applayer2);

// a torcher's fireball (2009scape: max hit a seventh of its level; we use Void's)
[proc,pest_torcher_attack]
if (%npc_action_delay > map_clock) {
    npc_setmode(applayer2);
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) return;
def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
npc_anim(torcher_attack, 0);
sound_synth(torcher_fire, 1, 0);
spotanim_npc(torcher_fireball_launch_spotanim, 96, 0);
%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(npc_coord, coord, uid, torcher_fireball_travel_spotanim, 40, 36, 52, 15, 0, 11, 5);
spotanim_pl(torcher_fireball_impact_spotanim, 96, $duration);
def_int $damage = 0;
if (randominc($attack_roll) > randominc($defence_roll)) $damage = randominc(npc_param(eascape_maxhit));
if (~check_protect_prayer(^magic_style) = true) $damage = 0;
anim(%com_defendanim, $duration);
queue(combat_damage_player, calc($duration / 30), $damage);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

// ---------------------------------------------------------------- dying
[ai_queue3,_pest_splatter]
%pest_count = max(sub(%pest_count, 1), 0);
~pest_splatter_burst;

[ai_queue3,_pest_shifter] @pest_died;
[ai_queue3,_pest_ravager] @pest_died;
[ai_queue3,_pest_spinner] @pest_died;
[ai_queue3,_pest_torcher] @pest_died;
[ai_queue3,_pest_defiler] @pest_died;
[ai_queue3,_pest_brawler] @pest_died;

[label,pest_died]
%pest_count = max(sub(%pest_count, 1), 0);
gosub(npc_death);

// ---------------------------------------------------------------- splatters
[proc,pest_splatter_near]()(boolean)
def_int $i = 0;
def_coord $c;
while ($i < enum_getoutputcount(pest_barriers)) {
    $c = enum(int, coord, pest_barriers, $i);
    if (distance($c, npc_coord) <= 1) {
        if (~pest_barrier_state($c) = 1) return(true);
    }
    $i = add($i, 1);
}
return(false);

// it bursts: everyone and everything next to it is hit, a third of its level at most (2009scape)
[proc,pest_splatter_burst]
def_coord $at = npc_coord;
def_int $max = calc(npc_param(eascape_maxhit) * 3);
npc_setmode(none);
npc_anim(splatter_death, 0);
spotanim_map(~pest_splatter_spot(npc_type), $at, 0, 0);
~sound_area(splatter_death, 0, $at, 8);
huntall($at, 1, 0);
while (huntnext = true) {
    queue(combat_damage_player, 1, randominc($max));
}
npc_huntall($at, 1, 0);
while (.npc_findnext = true) {
    if (.npc_uid ! npc_uid & ~pest_npc_of_game(.npc_category) = true & .npc_category ! pest_knight) .npc_queue(2, randominc($max), 1);
}
def_int $i = 0;
def_coord $c;
while ($i < enum_getoutputcount(pest_barriers)) {
    $c = enum(int, coord, pest_barriers, $i);
    if (distance($c, $at) <= 1) ~pest_barrier_hit_at($c);
    $i = add($i, 1);
}
npc_delay(1);
npc_del;

[proc,pest_splatter_spot](npc $type)(spotanim)
switch_npc ($type) {
    case pest_splatter_2 : return(splatter_exploding_spotanim2);
    case pest_splatter_3 : return(splatter_exploding_spotanim3);
    case pest_splatter_4 : return(splatter_exploding_spotanim4);
    case pest_splatter_5 : return(splatter_exploding_spotanim5);
}
return(splatter_exploding_spotanim1);

// ---------------------------------------------------------------- ravagers
// true while it's busy with a barricade or gate
[proc,pest_ravager_ai]()(boolean)
def_coord $t = %pest_target;
if ($t ! null) {
    if (~pest_barrier_state($t) ! 1) {
        %pest_target = null;
    } else if (distance($t, npc_coord) <= 1) {
        if (%npc_action_delay > map_clock) return(true);
        %npc_action_delay = add(map_clock, 5);
        npc_setmode(none);
        npc_facesquare($t);
        npc_anim(ravager_attack, 0);
        ~sound_area(ravager_attack, 0, npc_coord, 8);
        ~pest_barrier_hit_at($t);
        return(true);
    } else {
        npc_walk($t);
        return(true);
    }
}
// one near it, a third of the way across the screen (2009scape)
def_int $i = 0;
def_coord $c;
while ($i < enum_getoutputcount(pest_barriers)) {
    $c = enum(int, coord, pest_barriers, $i);
    if (distance($c, npc_coord) <= 5) {
        if (~pest_barrier_state($c) = 1) {
            %pest_target = $c;
            npc_setmode(none);
            npc_walk($c);
            return(true);
        }
    }
    $i = add($i, 1);
}
return(false);

// ---------------------------------------------------------------- spinners
// they stay by their portal and mend it, a tenth at a time (2009scape)
[proc,pest_spinner_ai]
if (random(10) >= 2) return;
def_coord $p = ~pest_portal_coord(%pest_portal);
if ($p = null) return;
if (testbit(%pest_portals, %pest_portal) = ^true) return;
if (distance(movecoord($p, 1, 0, 1), npc_coord) > 5) {
    npc_walk(movecoord($p, 1, 0, 1));
    return;
}
npc_huntall($p, 3, 0);
while (.npc_findnext = true) {
    if (.npc_category = pest_portal) {
        npc_facesquare(movecoord($p, 1, 0, 1));
        npc_anim(pest_spinner_repairing, 0);
        spotanim_npc(spinner_sparks_spotanim, 0, 0);
        .npc_queue(5, 0, 0);
        return;
    }
}

// its portal's gone: it bursts, and poisons whoever's next to it (2009scape: 5, then poison)
[ai_queue6,_pest_spinner]
def_coord $at = npc_coord;
npc_setmode(none);
npc_anim(spinner_death, 0);
huntall($at, 1, 0);
while (huntnext = true) {
    queue(combat_damage_player, 1, 5);
    queue(poison_player, 0, 6);
}
%pest_count = max(sub(%pest_count, 1), 0);
npc_delay(1);
npc_del;

// ---------------------------------------------------------------- shifters
// too far from the knight: it jumps to him (2009scape)
[proc,pest_shifter_jump]
if (distance(npc_coord, ^pest_knight_coord) <= 5) return;
def_coord $to = map_findsquare(^pest_knight_coord, 1, 2, ^map_findsquare_lineofwalk);
if ($to = ^pest_knight_coord) return;
spotanim_map(shifter_teleport_spotanim, npc_coord, 0, 0);
npc_tele($to);
npc_anim(pest_shifter_teleportattack, 0);
spotanim_map(shifter_teleport_spotanim, $to, 0, 0);
