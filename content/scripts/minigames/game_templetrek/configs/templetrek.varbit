// EASCape: Temple Trekking (ours), on tt_trek
// the follower (1 Fyiona Fray, 2 Dalcian Fang, 3 Jayene Kliyn, 4 Valantay Eppel, 5 Smiddi Ryak, 6 Rolayne Twickit)
[tt_follower]
basevar=tt_trek
startbit=0
endbit=2

// the route, 1-3
[tt_route]
basevar=tt_trek
startbit=3
endbit=4

// the event you're at, and how many there are on this trek
[tt_event]
basevar=tt_trek
startbit=5
endbit=7

[tt_events]
basevar=tt_trek
startbit=8
endbit=10

// what the event is (^tt_kind_ constants)
[tt_kind]
basevar=tt_trek
startbit=11
endbit=14

// monsters left, and killed, in a combat event
[tt_left]
basevar=tt_trek
startbit=15
endbit=18

[tt_killed]
basevar=tt_trek
startbit=19
endbit=22

// which arena: the map square (0-3 for 31, 34, 35, 36) and side, ^tt_arena_ constants
[tt_arena]
basevar=tt_trek
startbit=23
endbit=26

// the event is done (the way on is open)
[tt_done]
basevar=tt_trek
startbit=27
endbit=27
