[opheld1,trail_clue_hard_map001]
~full_trail_readclue_map(trail_map05);

// EASCape: these map clues had no map, so they read as a blank scroll (owner's report, 15 Nov
// 2026). The 377 cache's map interfaces matched by their drawings (OSRS wiki, Treasure Trails/Maps)
[opheld1,trail_clue_hard_map002] ~full_trail_readclue_map(inter_188); // Yanille, behind the anvil house
[opheld1,trail_clue_hard_map003] ~full_trail_readclue_map(inter_192); // West Ardougne's ruined houses
[opheld1,trail_clue_hard_map004] ~full_trail_readclue_map(inter_196); // crate by the Observatory
[opheld1,trail_clue_hard_map005] ~full_trail_readclue_map(inter_194); // crate in the Dark Warriors' Fortress

[opheld1,trail_clue_hard_riddle011]
~full_trail_readclue(oc_param(last_item,trail_desc));

[opheld1,_trail_clue_hard]
~full_trail_readclue(oc_param(last_item, trail_desc));

[opheld1,_trail_casket_hard] ~progress_clue_hard(last_item, "You've found another clue scroll!");

[proc,trail_clue_hard_complete]()(boolean)
if(~get_trail_progress >= ^trail_hard_maxsteps | (add(~get_trail_progress, 2) >= ^trail_hard_maxsteps & random(2) = 0)) {
    return (true);
}
return(false);

[proc,trail_clue_hard_getrandom]()(namedobj)
return(enum(int, namedobj, trail_hard_enum, random(enum_getoutputcount(trail_hard_enum))));

[proc,give_trail_puzzle](namedobj $puzzle, string $text)
inv_clear(trail_puzzleinv);
inv_add(inv, $puzzle, 1);
~objbox($puzzle, $text, 250, 0, divide(^objbox_height, 2));

[proc,progress_clue_hard](obj $current_clue, string $text)
~trail_clue_progress;
inv_del(inv, $current_clue, 1);
if(~trail_clue_hard_complete = true) {
    ~trail_clue_hard_reward;
} else {
    def_namedobj $new_clue = ~trail_clue_hard_getrandom;
    inv_add(inv, $new_clue, 1);
    ~objbox($new_clue, $text, 250, 0, divide(^objbox_height, 2));
}

[proc,trail_clue_hard_loc_interact](namedobj $clue)
~trail_clue_progress;
inv_del(inv, $clue, 1);
if(~trail_clue_hard_complete = true) {
    ~trail_clue_hard_reward;
} else {
    inv_add(inv, ~trail_clue_hard_getrandom, 1);
    ~objbox(trail_clue_hard_map001, "You've found another clue scroll!", 250, 0, divide(^objbox_height, 2));
}

// EASCape: hard steps where someone hands over a puzzle box and takes it back solved (Oziach's
// script, minus his own lines). Hamid, Heckel Funch, the gnome trainers, Captain Bleemadge and
// the Exam Centre examiners had no clue lines (OSRS wiki: Treasure Trails/Guide/Cryptic clues/Hard)
[label,trail_hard_puzzle_npc](namedobj $clue, namedobj $box, string $name)
if(inv_total(inv, $box) > 0) {
    if(~trail_puzzle_complete($box) = true) {
        ~chatnpc("<p,neutral>Well done, traveller.");
        inv_del(inv, $box, 1);
        ~progress_clue_hard($clue, "<$name> has given you another clue scroll!");
        return;
    }
    ~chatnpc("<p,neutral>That isn't right, keep trying.");
    return;
}
~chatnpc("<p,neutral>The solving of this puzzle could be the key to your treasure.");
~give_trail_puzzle($box, "<$name> has given you a puzzle box!");
