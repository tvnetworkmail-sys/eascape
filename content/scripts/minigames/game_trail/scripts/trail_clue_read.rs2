[proc,full_trail_readclue_map](interface $map)
if_openmain($map);

// EASCape: every text clue is shown on the clue scroll (trail_cluelong, eight centred lines), the
// shorter ones in its middle. The 377 interface that had the name trail_clue is a different one
// (Dr Foster's healing certificate), which is why short clues looked wrong.
[proc,full_trail_readclue](string $string)
split_init($string, 235, 8, q8_full);
def_int $lines = split_linecount(0);
if ($lines < 1 | $lines > 8) {
    mes("TRAIL DEBUG: Failed to get linecount for clue. <tostring($lines)>");
    return;
}
def_int $first = divide(sub(8, $lines), 2);
def_int $row = 0;
while ($row < 8) {
    def_string $text = "";
    if ($row >= $first & $row < add($first, $lines)) {
        $text = split_get(0, sub($row, $first));
    }
    ~trail_clue_row($row, $text);
    $row = add($row, 1);
}
if_openmain(trail_cluelong);

[proc,trail_clue_row](int $row, string $text)
switch_int ($row) {
    case 0 : if_settext(trail_cluelong:com_2, $text);
    case 1 : if_settext(trail_cluelong:com_3, $text);
    case 2 : if_settext(trail_cluelong:com_4, $text);
    case 3 : if_settext(trail_cluelong:com_5, $text);
    case 4 : if_settext(trail_cluelong:com_6, $text);
    case 5 : if_settext(trail_cluelong:com_7, $text);
    case 6 : if_settext(trail_cluelong:com_8, $text);
    case 7 : if_settext(trail_cluelong:com_9, $text);
}
