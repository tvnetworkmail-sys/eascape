// EASCape: what your Miscellania subjects collected, as OSRS's "Resources Collected" scroll (your
// screenshot, 31 Oct 2026): the scroll, its scroll bar and close knot are cut from it at its own
// size (tools/misc/parchment.py) and centred; the title, the items (9 to a row, 36 px apart, as
// in the screenshot) and the close button (over the knot) sit where they are in it

[bg]
type=graphic
x=68
y=24
width=376
height=285
graphic=eascape_parchment,0

[title]
type=text
x=85
y=40
width=200
height=16
font=q8_full
text=Resources Collected
colour=0x000000

[close]
type=text
x=412
y=32
width=22
height=22
buttontype=close
font=p11_full
text=
colour=0x000000

[inv]
type=inv
x=91
y=67
width=9
height=4
margin=4,6
