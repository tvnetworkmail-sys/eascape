// EASCape: what your Miscellania subjects collected, laid out like OSRS's "Resources Collected"
// scroll (your screenshot, 31 Oct 2026): the parchment is cut from it (tools/misc/parchment.py),
// the title, the items and the close button (over the scroll's own close knot) are ours;
// the items sit 9 to a row, 28 px apart, as in your OSRS screenshot (a negative margin, which
// the client now reads signed)

[bg]
type=graphic
x=106
y=53
width=300
height=228
graphic=eascape_parchment,0

[title]
type=text
x=119
y=63
width=200
height=16
font=q8_full
text=Resources Collected
colour=0x000000

[close]
type=text
x=374
y=61
width=22
height=20
buttontype=close
font=p11_full
text=
colour=0x000000

[inv]
type=inv
x=114
y=86
width=9
height=4
margin=-4,0
