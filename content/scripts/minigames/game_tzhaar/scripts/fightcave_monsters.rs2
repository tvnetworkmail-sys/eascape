// EASCape: how the Fight Cave's monsters fight.
//
// Max hits: OSRS wiki (TzHaar Fight Cave, TzTok-Jad); Tz-Kih and Tz-Kek's (not on the wiki)
// from 2006Scape (FightCaves.getMax). Effects:
// - Tz-Kih: each attack drains prayer by the damage + 1 (2006Scape).
// - Tz-Kek: hitting it in melee hurts you for 1 (OSRS wiki; in player_melee.rs2); when it dies
//   two small Tz-Kek come out of it, 2 squares either side (2006Scape).
// - Tok-Xil: melee next to you, spines from range. Ket-Zek: melee next to you, magic from range.
// - Yt-MejKot: heals itself and the monsters next to it that are below half health, by 1 to 8
//   (OSRS wiki; amount from 2006Scape), instead of attacking that turn.
// - TzTok-Jad: melee only next to you; otherwise magic (he rears up) or ranged (he slams his
//   feet), and the hit lands 3 ticks later, so you can still switch prayers. Max 97 melee and
//   ranged, 95 magic. Below 150 hitpoints four Yt-HurKot come and heal him; if they heal him to
//   full they come again the next time he drops below 150 (OSRS wiki).

[ai_opplayer2,tzhaar_fightcave_swarm_1a] ~fightcave_melee(4);
[ai_opplayer2,tzhaar_fightcave_swarm_2a] ~fightcave_melee(7);
[ai_opplayer2,tzhaar_fightcave_swarm_2spawn] ~fightcave_melee(4);
[ai_opplayer2,tzhaar_fightcave_swarm_4a] ~fightcave_mejkot;
[ai_opplayer2,tzhaar_fightcave_swarm_boss_cleric] ~fightcave_melee(14);
[ai_applayer2,tzhaar_fightcave_swarm_3a] ~fightcave_ranged(13, ^ranged_style, magmaquris_punch, tzhaar_spine_attack);
[ai_opplayer2,tzhaar_fightcave_swarm_3a] ~fightcave_ranged(13, ^ranged_style, magmaquris_punch, tzhaar_spine_attack);
[ai_applayer2,tzhaar_fightcave_swarm_5a] ~fightcave_ranged(54, ^magic_style, igniferum_attack, tzhaar_fire_launch_travel);
[ai_opplayer2,tzhaar_fightcave_swarm_5a] ~fightcave_ranged(54, ^magic_style, igniferum_attack, tzhaar_fire_launch_travel);
[ai_applayer2,tzhaar_fightcave_swarm_boss] ~fightcave_jad;
[ai_opplayer2,tzhaar_fightcave_swarm_boss] ~fightcave_jad;

[ai_queue1,tzhaar_fightcave_swarm_3a] ~npc_default_retaliate_ap;
[ai_queue1,tzhaar_fightcave_swarm_5a] ~npc_default_retaliate_ap;
[ai_queue1,tzhaar_fightcave_swarm_boss] ~npc_default_retaliate_ap;

// deaths
[ai_queue3,tzhaar_fightcave_swarm_1a] ~fightcave_death(0);
[ai_queue3,tzhaar_fightcave_swarm_2spawn] ~fightcave_death(0);
[ai_queue3,tzhaar_fightcave_swarm_3a] ~fightcave_death(0);
[ai_queue3,tzhaar_fightcave_swarm_4a] ~fightcave_death(0);
[ai_queue3,tzhaar_fightcave_swarm_5a] ~fightcave_death(0);
[ai_queue3,tzhaar_fightcave_swarm_2a] ~fightcave_kek_death;
[ai_queue3,tzhaar_fightcave_swarm_boss] ~fightcave_jad_death;
[ai_queue3,tzhaar_fightcave_swarm_boss_cleric] gosub(npc_death);

// Jad's damage: healers when he drops below 150
[ai_queue2,tzhaar_fightcave_swarm_boss]
~npc_default_damage(last_int);
~fightcave_jad_healers_check;

// leaving when the owner has gone (logged out, left the cave, started a new run)
[ai_timer,tzhaar_fightcave_swarm_1a] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_2a] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_2spawn] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_3a] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_4a] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_5a] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_boss] ~fightcave_npc_timer;
[ai_timer,tzhaar_fightcave_swarm_boss_cleric] ~fightcave_healer_timer;

[proc,fightcave_npc_timer]
npc_settimer(5);
if (~fightcave_owner_here = false) {
    npc_del;
}

[proc,fightcave_owner_here]()(boolean)
if (finduid(%npc_aggressive_player) = false) return(false);
if (%npc_int ! %fightcave_run) return(false);
if (~in_fightcave(coord) = false) return(false);
return(true);

// ---- attacks

[proc,fightcave_attack_ready]()(boolean)
if (%death = ^true) {
    npc_setmode(null);
    return(false);
}
if (%npc_action_delay > map_clock) return(false);
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return(false);
}
if (~npc_check_notcombat_self = false) return(false);
return(true);

[proc,fightcave_melee](int $maxhit)
if (~fightcave_attack_ready = false) return;
npc_anim(npc_param(attack_anim), 0);
~fightcave_attack_sound;
anim(%com_defendanim, 0);
def_int $damage = 0;
if (randominc(~npc_melee_attack_roll) > randominc(~player_defence_roll_specific(npc_param(damagetype)))) {
    $damage = randominc($maxhit);
}
if ((npc_type = tzhaar_fightcave_swarm_1a | npc_type = tzhaar_fightpit_swarm_1a) & stat(prayer) > 0) {
    stat_sub(prayer, add($damage, 1), 0);
}
~playerhit_n_melee(true, $damage, npc_param(attackrate));

[proc,fightcave_attack_sound]
if (npc_param(attack_sound) ! null) {
    sound_synth(npc_param(attack_sound), 1, 0);
}

// melee next to you, otherwise $style (ranged or magic) from range with a projectile
[proc,fightcave_ranged](int $maxhit, int $style, seq $melee_anim, spotanim $projectile)
if (~fightcave_attack_ready = false) return;
npc_setmode(applayer2);
if (npc_range(coord) <= 1) {
    npc_anim($melee_anim, 0);
    ~fightcave_attack_sound;
    def_int $damage = 0;
    if (randominc(~npc_melee_attack_roll) > randominc(~player_defence_roll_specific(^crush_style))) {
        $damage = randominc($maxhit);
    }
    ~playerhit_n_melee(true, $damage, npc_param(attackrate));
    return;
}
npc_anim(npc_param(attack_anim), 0);
if (npc_param(rangeattack_sound) ! null) {
    sound_synth(npc_param(rangeattack_sound), 1, 0);
}
%npc_action_delay = add(map_clock, npc_param(attackrate));
def_int $duration = ~player_projectile(npc_coord, coord, uid, $projectile, 60, 36, 32, 15, 0, 11, 5);
def_int $roll;
if ($style = ^magic_style) {
    $roll = ~npc_magic_attack_roll;
} else {
    $roll = ~npc_ranged_attack_roll;
}
def_int $damage = 0;
if (randominc($roll) > randominc(~player_defence_roll_specific($style))) {
    $damage = randominc($maxhit);
}
if (~check_protect_prayer($style) = true) {
    $damage = 0;
}
queue(combat_damage_player, calc($duration / 30), $damage);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

// Yt-MejKot: heal before hitting
[proc,fightcave_mejkot]
if (~fightcave_attack_ready = false) return;
if (~fightcave_mejkot_heal = true) {
    %npc_action_delay = add(map_clock, npc_param(attackrate));
    return;
}
~fightcave_melee(25);

[proc,fightcave_mejkot_heal]()(boolean)
def_npc_uid $self = npc_uid;
def_int $run = %npc_int;
def_boolean $healed = false;
npc_findallany(npc_coord, 1, 0);
while (npc_findnext = true & $healed = false) {
    if (%npc_int = $run & npc_stat(hitpoints) > 0 & npc_stat(hitpoints) < divide(npc_basestat(hitpoints), 2)) {
        npc_statheal(hitpoints, add(1, random(8)), 0);
        spotanim_npc(tzhaar_heal, 0, 0);
        $healed = true;
    }
}
if (npc_finduid($self) = true & $healed = true) {
    npc_anim(lizard_cleric_heal, 0);
}
return($healed);

// TzTok-Jad
[proc,fightcave_jad]
if (~fightcave_attack_ready = false) return;
npc_setmode(applayer2);
def_int $style;
if (npc_range(coord) <= 1) {
    $style = random(3); // 0 melee, 1 magic, 2 ranged
} else {
    $style = add(1, random(2));
}
%npc_action_delay = add(map_clock, npc_param(attackrate));
~npc_set_attack_vars;
if ($style = 0) {
    npc_anim(lordmagmus_attack, 0);
    def_int $damage = 0;
    if (randominc(~npc_melee_attack_roll) > randominc(~player_defence_roll_specific(^stab_style))) {
        $damage = randominc(97);
    }
    ~playerhit_n_melee(true, $damage, npc_param(attackrate));
    return;
}
// timing and sounds from Void (GregHib/void: TzTokJad.kt, tzhaar_fight_cave.combat/gfx.toml):
// the hit lands 5 ticks after he attacks (3 ticks, then 64 client cycles); the magic ball leaves
// after 86 client cycles and flies 8 per square beyond the first; Fire Wave's cast sound for
// magic, its impact sound when either lands
def_int $distance = max(0, sub(distance(npc_coord, coord), 1));
if ($style = 1) {
    npc_anim(lordmagmus_fire, 0);
    sound_synth(firewave_cast_and_fire, 1, 0);
    projanim_pl(npc_coord, uid, tzhaar_fire_spit_travel, 50, 36, 86, add(86, max(8, multiply($distance, 8))), 16, 11);
} else {
    npc_anim(lordmagmus_smash, 0);
}
npc_queue(4, $style, 5);

// the magic or ranged hit lands
[ai_queue4,tzhaar_fightcave_swarm_boss]
if (finduid(%npc_aggressive_player) = false) return;
if (~fightcave_owner_here = false) return;
def_int $style = last_int;
def_int $damage = 0;
if ($style = 1) {
    if (randominc(~npc_magic_attack_roll) > randominc(~player_defence_roll_specific(^magic_style))) {
        $damage = randominc(95);
    }
    if (~check_protect_prayer(^magic_style) = true) $damage = 0;
} else {
    spotanim_pl(tzhaar_rock_smash, 0, 0);
    if (randominc(~npc_ranged_attack_roll) > randominc(~player_defence_roll_specific(^ranged_style))) {
        $damage = randominc(97);
    }
    if (~check_protect_prayer(^ranged_style) = true) $damage = 0;
}
sound_synth(firewave_hit, 1, 0);
queue(combat_damage_player, 0, $damage);
queue*(playerhit_n_retaliate, 0)(npc_uid);

// ---- deaths

[proc,fightcave_death](int $more)
def_player_uid $owner = %npc_aggressive_player;
def_int $run = %npc_int;
gosub(npc_death);
if (finduid($owner) = true) {
    if (~fightcave_owner_still($owner, $run) = true) queue(fightcave_killed, 0, $more);
}

// the owner is online, in the cave, on the same run (read before the monster is gone)
[proc,fightcave_owner_still](player_uid $owner, int $run)(boolean)
if (finduid($owner) = false) return(false);
if (%fightcave_run ! $run) return(false);
return(~in_fightcave(coord));

// two small Tz-Kek come out
[proc,fightcave_kek_death]
def_coord $at = npc_coord;
def_player_uid $owner = %npc_aggressive_player;
def_int $run = %npc_int;
gosub(npc_death);
if (finduid($owner) = false) {
    return;
}
if (~fightcave_owner_still($owner, $run) = false) {
    return;
}
queue(fightcave_killed, 0, 2);
npc_add(map_findsquare(movecoord($at, 2, 0, 2), 0, 1, ^map_findsquare_lineofwalk), tzhaar_fightcave_swarm_2spawn, 12000);
~fightcave_npc_owner($owner, $run);
npc_add(map_findsquare(movecoord($at, -2, 0, -2), 0, 1, ^map_findsquare_lineofwalk), tzhaar_fightcave_swarm_2spawn, 12000);
~fightcave_npc_owner($owner, $run);

[proc,fightcave_jad_death]
def_player_uid $owner = %npc_aggressive_player;
def_int $run = %npc_int;
// the win is queued before his death animation, so nothing after it can stop it
if (finduid($owner) = true) {
    if (~fightcave_owner_still($owner, $run) = true) queue(fightcave_victory, 3, 0);
}
gosub(npc_death);

// ---- Jad's healers (Void, TzhaarFightCave.kt): when Jad drops below half his hitpoints, enough
// Yt-HurKot come to make four (counting any still alive); they only come again after he's been
// healed back to full. %npc_int2 on Jad: 0 they may come, 1 they've come since he was last full.

[proc,fightcave_jad_healers_check]
if (npc_stat(hitpoints) <= 0 | npc_stat(hitpoints) >= divide(npc_basestat(hitpoints), 2)) return;
if (%npc_int2 = 1) return;
%npc_int2 = 1;
def_npc_uid $jad = npc_uid;
def_player_uid $owner = %npc_aggressive_player;
def_int $run = %npc_int;
def_int $alive = 0;
npc_findallany(^fightcave_centre, 40, 0);
while (npc_findnext = true) {
    if (npc_type = tzhaar_fightcave_swarm_boss_cleric & %npc_aggressive_player = $owner & npc_stat(hitpoints) > 0) {
        $alive = add($alive, 1);
    }
}
// 2006Scape's healer spots
def_int $i = $alive;
while ($i < 4) {
    npc_add(~fightcave_healer_spot($i), tzhaar_fightcave_swarm_boss_cleric, 12000);
    ~fightcave_npc_owner($owner, $run);
    $i = add($i, 1);
}
if (npc_finduid($jad) = false) {
    return;
}

[proc,fightcave_healer_spot](int $i)(coord)
switch_int ($i) {
    case 0 : return(0_37_79_22_45);
    case 1 : return(0_37_79_23_21);
    case 2 : return(0_37_79_43_28);
    case default : return(0_37_79_30_35);
}

// Yt-HurKot (Void, TzHaarHealers.kt): they walk to Jad; once within 4 squares of him, every 4
// ticks they heal him by 5 (Void's 50 on its x10 hitpoints) while he's hurt, with the heal
// animation, the heal graphic on Jad and the self-heal sound. Hit one and it fights you instead.
// They leave once he's gone.
[proc,fightcave_healer_timer]
npc_settimer(1);
if (~fightcave_owner_here = false) {
    npc_del;
    return;
}
if (npc_getmode = opplayer2) {
    return; // fighting you
}
def_npc_uid $self = npc_uid;
def_coord $here = npc_coord;
if (npc_find($here, tzhaar_fightcave_swarm_boss, 40, 0) = false) {
    if (npc_finduid($self) = true) npc_del;
    return;
}
def_coord $jad = npc_coord;
def_coord $centre = movecoord($jad, 2, 0, 2); // Jad is 5 squares across
// squares from Jad's edge
def_int $dx = max(0, max(sub(coordx($jad), coordx($here)), sub(coordx($here), add(coordx($jad), 4))));
def_int $dz = max(0, max(sub(coordz($jad), coordz($here)), sub(coordz($here), add(coordz($jad), 4))));
if (npc_finduid($self) = false) {
    return;
}
if (max($dx, $dz) > 4) {
    npc_walk($centre);
    return;
}
npc_facesquare($centre);
// every 4 ticks (%npc_int2 on the healer counts them)
%npc_int2 = add(%npc_int2, 1);
if (%npc_int2 < 4) {
    return;
}
%npc_int2 = 0;
if (npc_find($here, tzhaar_fightcave_swarm_boss, 40, 0) = false) {
    return;
}
if (npc_stat(hitpoints) > 0 & npc_stat(hitpoints) < npc_basestat(hitpoints)) {
    npc_statheal(hitpoints, 5, 0);
    spotanim_npc(tzhaar_heal, 0, 0);
    // (no heal sound: the 2006 client plays one sound at a time, and four healers' sounds
    // would drown out Jad's attacks)
    if (npc_stat(hitpoints) >= npc_basestat(hitpoints)) {
        %npc_int2 = 0; // healed to full: they may come again
    }
    if (npc_finduid($self) = true) {
        npc_anim(lizard_cleric_heal, 0);
    }
}
