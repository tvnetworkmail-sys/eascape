// EASCape: TzHaar Fight Cave (released 4 October 2005) and Fight Pit (19 September 2005),
// both in the game on 2 May 2006 (OSRS wiki). Coordinates are 2006Scape's (FightCaves.java,
// FightPits.java, PlayerAssistant.java), turned into map squares; all fall on the 2006 maps
// (fight cave 37_79, Fight Pit 37_80, the city 38_80).

// --- Fight Cave
// where you start (next to the cave's exit) and where you come out in the city
^fightcave_start = 0_37_79_45_61
^fightcave_city = 0_38_80_6_48
// the cave map square
^fightcave_sw = 0_37_79_0_0
^fightcave_ne = 0_37_79_63_63
^fightcave_centre = 0_37_79_32_32
// TzTok-Jad
^fightcave_wave_jad = 63
// ticks before the first wave and between waves (2006Scape: 16 and 15)
^fightcave_first_delay = 16
^fightcave_wave_delay = 15
// Jad's healers come when he drops below 150 hitpoints, four of them (OSRS wiki, TzTok-Jad)
^fightcave_healer_hp = 150
// tokkul for a completed run (OSRS wiki: 8,032 with the fire cape)
^fightcave_tokkul_jad = 8032

// --- Fight Pit
// the waiting room (2006Scape inPitsWait) and the arena south of it
^fightpit_wait_sw = 0_37_80_26_49
^fightpit_wait_ne = 0_37_80_36_55
^fightpit_arena_sw = 0_37_80_0_0
^fightpit_arena_ne = 0_37_80_63_47
// where you stand when you come back from the arena, and outside the waiting room
^fightpit_wait_spot = 0_37_80_31_50
^fightpit_outside = 0_37_80_31_57
// a round starts with everyone in the arena in this square (2006Scape: x 2392-2404, y 5139-5151)
^fightpit_start_sw = 0_37_80_24_19
// ticks before a round starts once two or more are waiting (2006Scape: 80)
^fightpit_countdown = 80
// monsters join a round that runs on: Tz-Kih at 1:30, Tz-Kek at 3:30, Tok-Xil at 5:30 (OSRS
// wiki; the 2006 game data has only these three for the pit), in ticks
^fightpit_kih_at = 150
^fightpit_kek_at = 350
^fightpit_xil_at = 550
// the champion's red skull lasts an hour (OSRS wiki)
^fightpit_skull_ticks = 6000
