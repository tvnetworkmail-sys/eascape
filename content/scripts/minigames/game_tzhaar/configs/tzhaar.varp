// EASCape: the TzHaar Fight Cave (server-only)

// the wave you're on (1-63), 0 when you're not in the cave; kept so logging out mid-run
// carries on at the same wave
[fightcave_wave]
scope=perm

// counts up every time you go in, so monsters from an earlier run know to leave
[fightcave_run]
scope=perm

// monsters of this wave still to kill
[fightcave_left]

// Jad's healers: 0 not yet, 1 out, 2 out and allowed to come again (they healed him to full)
[fightcave_healers]

// which of the 15 spawn rotations this run uses (Void: picked when you go in)
[fightcave_rotation]
scope=perm
