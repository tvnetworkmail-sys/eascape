//Todo: Dialogue is all from osrs

[label,boardgames_runesquares]
~chatplayer("<p,confused>Runesquares?");
~chatnpc("<p,happy>Yes, you take it in turns to add a line with the goal of|making squares. Everytime you make a square you|take another turn.");
@boardgames_questions;

[label,boardgames_runeversi]
~chatplayer("<p,confused>Runeversi?");
~chatnpc("<p,happy>Yep, the aim is to have more of your runes on the|board than your opponent. You can take your|opponents pieces by trapping them between your own.");
@boardgames_questions;
