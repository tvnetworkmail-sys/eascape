// Tai Bwo Wannai Clean-Up (9 August 2005): skewer sticks, spiders on sticks, the gout tuber,
// snakeskin and the broodoo shields' wield levels.

// --------------------------------------------------------------------------- skewer sticks
// a machete on a thatch spar gives 3-6 skewer sticks (the OSRS wiki)

[opheldu,thatching_spar_light] @tbw_spar_use(last_useitem, last_item, last_slot);
[opheldu,thatching_spar_med] @tbw_spar_use(last_useitem, last_item, last_slot);
[opheldu,thatching_spar_dense] @tbw_spar_use(last_useitem, last_item, last_slot);
[opheldu,machette] @tbw_spar_use(last_item, last_useitem, last_useslot);
[opheldu,machette_opal] @tbw_spar_use(last_item, last_useitem, last_useslot);
[opheldu,machette_jade] @tbw_spar_use(last_item, last_useitem, last_useslot);
[opheldu,machette_redtopaz] @tbw_spar_use(last_item, last_useitem, last_useslot);

[label,tbw_spar_use](obj $machete, obj $spar, int $spar_slot)
if ($spar ! thatching_spar_light & $spar ! thatching_spar_med & $spar ! thatching_spar_dense) {
    ~displaymessage(^dm_default);
    return;
}
def_seq $anim;
switch_obj ($machete) {
    case machette : $anim = tbw_cleanup_player_prepare_wood;
    case machette_opal : $anim = tbw_cleanup_player_prepare_wood_opal;
    case machette_jade : $anim = tbw_cleanup_player_prepare_wood_jade;
    case machette_redtopaz : $anim = tbw_cleanup_player_prepare_wood_redtopaz;
    case default :
        ~displaymessage(^dm_default);
        return;
}
if (inv_total(inv, tbw_skewer_stick) = 0 & inv_freespace(inv) < 1 & inv_total(inv, $spar) > 1) {
    mes("You don't have enough inventory space."); // ours
    return;
}
anim($anim, 0);
inv_delslot(inv, $spar_slot);
def_int $count = add(3, random(4));
inv_add(inv, tbw_skewer_stick, $count);
mes("You cut the thatch spar into <tostring($count)> skewer sticks."); // ours

// ------------------------------------------------------------------------- spider on a stick
// a spider carcass on a skewer stick, or on an arrow shaft (Mamma Bufetta); cooked at 16 Cooking
// (tbw_cleanup.dbrow); eating it heals 7-10 and gives the stick back (the OSRS wiki)

[opheldu,village_spider_carcass]
switch_obj (last_useitem) {
    case tbw_skewer_stick : @tbw_skewer(last_slot, last_useslot, tbw_spider_on_stick_raw);
    case arrow_shaft : @tbw_skewer(last_slot, last_useslot, tbw_spider_on_shaft_raw);
    case default : ~displaymessage(^dm_default);
}
[opheldu,tbw_skewer_stick]
if (last_useitem = village_spider_carcass) @tbw_skewer(last_useslot, last_slot, tbw_spider_on_stick_raw);
~displaymessage(^dm_default);

[label,tbw_skewer](int $carcass_slot, int $stick_slot, namedobj $product)
def_obj $stick = inv_getobj(inv, $stick_slot);
anim(tbw_cleanup_player_spider_on_stick, 0);
sound_synth(TBCU_spider_stick, 1, 0);
inv_delslot(inv, $carcass_slot);
inv_del(inv, $stick, 1);
inv_add(inv, $product, 1);
if ($stick = arrow_shaft) {
    mes("You pierce the spider carcass with the arrow shaft."); // ours
} else {
    mes("You pierce the spider carcass with the skewer stick."); // ours
}

[opheld1,tbw_spider_on_stick_cooked] @player_consume_item(tbw_consume_spider, 2, 3);
[opheld1,tbw_spider_on_shaft_cooked] @player_consume_item(tbw_consume_spider, 2, 3);

[label,tbw_consume_spider]
def_obj $food = last_item;
inv_delslot(inv, last_slot);
if ($food = tbw_spider_on_stick_cooked) {
    inv_setslot(inv, last_slot, tbw_skewer_stick, 1);
}
anim(human_eat, 0);
sound_synth(eat, 1, 0);
mes("You eat the spider. Mmmm, crunchy!");
stat_heal(hitpoints, add(7, random(4)), 0);

// ---------------------------------------------------------------------------------- gout tuber
// the run-energy food: heals 12 and gives back 50% run energy, with this message (the OSRS wiki)

[opheld1,village_rare_tuber] @player_consume_item(tbw_consume_tuber, 2, 3);

[label,tbw_consume_tuber]
inv_delslot(inv, last_slot);
anim(human_eat, 0);
sound_synth(eat, 1, 0);
mes("You eat the tuber. Hmmm, peculiar taste! It heals some run energy.");
healenergy(5000);
mes("It heals some health anyway.");
stat_heal(hitpoints, 12, 0);

// ------------------------------------------------------------------------------- snakeskin
// a needle on snakeskin: boots, vambraces, bandana, chaps or body (tbw_cleanup.dbrow); thread as
// for leather. Ours: the five-item make menu (Make 1, 5, 10, X), like dragonhide.

[opheldu,village_snake_skin]
if (last_useitem = needle) @tbw_snakeskin_menu;
~displaymessage(^dm_default);

[label,tbw_snakeskin_menu]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
if (inv_total(inv, thread) < 1) {
    ~objbox(thread, "You need some thread to make anything out of leather.", 250, 0, divide(^objbox_height, 2));
    return;
}
def_namedobj $product;
def_int $count;
$product, $count = ~skill_multi5_header("What would you like to make?",
    snakeskin_body, 0, -5, 175, "\\n\\n\\n\\nBody",
    snakeskin_chaps, 0, -5, 175, "\\n\\n\\n\\nChaps",
    snakeskin_bandana, 0, -5, 175, "\\n\\n\\n\\nBandana",
    snakeskin_boots, 0, -5, 175, "\\n\\n\\n\\nBoots",
    snakeskin_vambraces, 0, -5, 175, "\\n\\n\\n\\nVamb"
);
if ($product = null | $count < 1) {
    return;
}
// Make 1, 5, 10 and X make that many, one every 3 ticks, like the dragonhide menu (was one a click)
if (~craft_leather_once($product) = false) return;
if ($count > 1) weakqueue*(craft_leather_x, 3)($product, sub($count, 1));

// tanning: Ellis (Al Kharid) tans snake hide for 15 coins (2006Scape's tanner; the 2006 tanning
// screen has no snakeskin, so ours: use the hide on him)
[label,tbw_tan_snake_hide]
def_int $hides = inv_total(inv, village_snake_hide);
if ($hides < 1) {
    mes("You don't have any snake hides to tan."); // ours
    return;
}
def_int $count = min($hides, divide(inv_total(inv, coins), 15));
if ($count < 1) {
    mes("You haven't got enough coins to pay for snakeskin."); // ours
    return;
}
inv_del(inv, coins, multiply($count, 15));
inv_del(inv, village_snake_hide, $count);
inv_add(inv, village_snake_skin, $count);
if ($count = 1) {
    mes("The tanner tans your snake hide."); // ours
} else {
    mes("The tanner tans <tostring($count)> snake hides for you."); // ours
}

// ---------------------------------------------------------------------- broodoo shield levels
// 25 Defence and 25 Magic (the OSRS wiki)

