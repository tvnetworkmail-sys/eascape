// Tai Bwo Wannai Clean-Up (9 August 2005). See scripts/tbw_favour.rs2 for where each comes from.

// %cleanup_progress (the cache's varbit on tai_bwo_cleanup): ours, the order the wiki gives
^tbw_progress_none = 0
^tbw_progress_told = 1
^tbw_progress_hacked = 2
^tbw_progress_fenced = 3
^tbw_progress_sticks = 4

// favour is kept in tenths of a per cent in %vill_comm_points (0-1000)
^tbw_favour_max = 1000

// the village and the jungle round it: its four map squares
^tbw_area_lo = 0_43_47_0_0
^tbw_area_hi = 3_44_48_63_63

// the hardwood grove: the doors (2817,3083-3084) are on the west edge of their squares
^tbw_grove_lo = 0_44_48_1_6
^tbw_grove_hi = 0_44_48_13_18

// ours: how long hacked jungle takes to grow back (no source gives it)
^tbw_jungle_regrow = 100
// the RS wiki: a repaired fence rots again after about 16 minutes
^tbw_fence_decay = 1600
// ours: how long a revealed gout tuber plant or gem rock stays if nobody takes it
^tbw_event_loc_duration = 500
// ours: how long a creature from the jungle stays; broodoo victims 50 minutes (Mod Ash)
^tbw_npc_duration = 1000
^tbw_broodoo_duration = 5000

// ours: the most favour one villager turns into sticks at once (10%), and how much more each
// piece of villager clothing worn adds (2%); a full set doubles it
^tbw_claim_base = 100
^tbw_claim_per_piece = 20
// Mod Ash: a villager's stick cooldown has six steps, one every 300 ticks
^tbw_cooldown_step = 300
^tbw_cooldown_full = 7

// Rionasta's fee per item
^tbw_parcel_fee = 10
// Murcaily's fee for the hardwood grove
^tbw_grove_fee = 100
