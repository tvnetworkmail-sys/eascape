// EASCape: how worn each Barrows piece is inside its current stage (0-249 points, 8 bits each).
// One counter per brother and piece: counter = (set - 1) * 4 + piece, three counters per varp
// (bits 0-7, 8-15, 16-23).
[barrows_wear_0]
scope=perm

[barrows_wear_1]
scope=perm

[barrows_wear_2]
scope=perm

[barrows_wear_3]
scope=perm

[barrows_wear_4]
scope=perm

[barrows_wear_5]
scope=perm

[barrows_wear_6]
scope=perm

[barrows_wear_7]
scope=perm

// map_clock when the next point of wear is due
[barrows_wear_next]
