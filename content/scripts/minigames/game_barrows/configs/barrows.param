// EASCape: Barrows equipment. Every Barrows piece, fresh to broken, carries these.

// which brother's set: 1 Ahrim, 2 Dharok, 3 Guthan, 4 Karil, 5 Torag, 6 Verac (0 = not Barrows)
[barrows_set]
type=int
default=0

// 0 helm, 1 weapon, 2 body, 3 legs
[barrows_piece]
type=int
default=0

// 0 fresh (never used), 1 = 100, 2 = 75, 3 = 50, 4 = 25, 5 = broken
[barrows_stage]
type=int
default=0

// the piece it turns into at the next stage
[barrows_degrade_next]
type=namedobj
default=null

// the fresh piece Bob gives back
[barrows_repaired]
type=namedobj
default=null

// Bob's price per point of wear (out of 1000): helm 60, weapon 100, body 90, legs 80 (OSRS wiki, Barrows equipment)
[barrows_repair_rate]
type=int
default=0
