// EASCape: Barrows (released 9 May 2005, so it was in the game on 2 May 2006)

// brother index: the same order as the barrows_killed_* varbits (bits 0-5 of %barrows_kills)
^barrows_ahrim = 0
^barrows_dharok = 1
^barrows_guthan = 2
^barrows_karil = 3
^barrows_torag = 4
^barrows_verac = 5

// our own bits in %barrows (the 2006 client only reads bits 6-25 and 29-31 of it)
^barrows_bit_tunnel_start = 0
^barrows_bit_tunnel_end = 2
^barrows_bit_looted = 3
^barrows_bit_puzzle_solved = 4
^barrows_bit_set_up = 5
^barrows_bit_answer_start = 26
^barrows_bit_answer_end = 28

// reward potential cap for the monster combat levels (OSRS wiki, Chest (Barrows))
^barrows_rp_cap = 1000
