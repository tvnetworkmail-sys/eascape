// EASCape: Barrows (released 9 May 2005, so it was in the game on 2 May 2006)

// brother index: the same order as the barrows_killed_* varbits (bits 0-5 of %barrows_kills)
^barrows_ahrim = 0
^barrows_dharok = 1
^barrows_guthan = 2
^barrows_karil = 3
^barrows_torag = 4
^barrows_verac = 5

// our own bits in %barrows (the 2006 client only reads bits 6-25 and 29-31 of it)
^barrows_bit_tunnel_start = 0
^barrows_bit_tunnel_end = 2
^barrows_bit_looted = 3
^barrows_bit_puzzle_solved = 4
^barrows_bit_set_up = 5
^barrows_bit_answer_start = 26
^barrows_bit_answer_end = 28

// reward potential cap for the monster combat levels (OSRS wiki, Chest (Barrows))
^barrows_rp_cap = 1000

// Barrows equipment: the barrows_set param on each piece (brother index + 1)
^barrows_set_ahrim = 1
^barrows_set_dharok = 2
^barrows_set_guthan = 3
^barrows_set_karil = 4
^barrows_set_torag = 5
^barrows_set_verac = 6
^barrows_stage_broken = 5
// 1000 points from fresh to broken (15 hours in combat), 250 for each of 100, 75, 50 and 25
^barrows_wear_per_stage = 250
// a point every 90 ticks in combat (OSRS wiki, Barrows equipment)
^barrows_wear_ticks = 90
