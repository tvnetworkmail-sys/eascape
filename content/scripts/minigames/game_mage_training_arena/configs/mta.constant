// EASCape: the Mage Training Arena (4 January 2006). Tiles: Void (data/minigame/mage_training_arena,
// mage_training_arena.tables.toml and .areas.toml), the same map squares as the 377 cache's.

// the entrance hall, where a death or a log out in a room brings you (Void MageTrainingArena.lobby)
^mta_lobby = 0_52_51_35_38

// the rooms (^mta_room_*), as ~mta_room gives them
^mta_room_none = 0
^mta_room_tele = 1
^mta_room_alch = 2
^mta_room_ench = 3
^mta_room_grave = 4

// the portals in the entrance hall bring you here, the exit portals back to here (Void mta_rooms)
^mta_alch_enter = 2_52_150_38_23
^mta_alch_exit = 0_52_51_35_56
^mta_ench_enter = 0_52_150_35_49
^mta_ench_exit = 0_52_51_33_54
^mta_grave_enter = 1_52_150_35_39
^mta_grave_exit = 0_52_51_37_54
^mta_tele_exit = 0_52_51_35_52

// the magic level each portal wants (Void mta_rooms: the room's spell)
^mta_tele_level = 33
^mta_alch_level = 21
^mta_ench_level = 7
^mta_grave_level = 15

// the most points each room's count holds (Void PizazzPoints.limits, the size of the cache's varbits)
^mta_tele_max = 8191
^mta_alch_max = 8191
^mta_ench_max = 32767
^mta_grave_max = 16383

// the progress hat's tiers (Void PizazzHat.tier: over 300 and over 600 points in all)
^mta_hat2_points = 300
^mta_hat3_points = 600

// ---------------------------------------------------------------- the Telekinetic Theatre
^mta_mazes = 10
// solve this many mazes in a row for the bonus (Void TelekineticTheatre.win)
^mta_maze_streak = 5

// ---------------------------------------------------------------- the Alchemists' Playground
// the items change every 70 ticks (Void mta_alchemist.interval; 2006Scape Alchemy.java: 71)
^mta_alch_interval = 70
// you can't deposit this many coins at a time (Void eject_amount; 2006Scape: 12,000)
^mta_alch_eject = 12000
// the most you take back out (the guardians' words: "not more than 1000 coins")
^mta_alch_reward_cap = 1000

// ---------------------------------------------------------------- the Enchanting Chamber
// the bonus shape changes every 40 ticks (Void mta_enchanting.bonus_interval)
^mta_ench_interval = 40
^mta_ench_orbs_per_reward = 20
^mta_ench_shapes_per_reward = 10

// ---------------------------------------------------------------- the Creature Graveyard
// bones fall every 10 ticks for 2 hitpoints (Void mta_graveyard: interval 10, hit 20 in tenths)
^mta_grave_interval = 10
^mta_grave_hit = 2
^mta_grave_fruit_per_reward = 16
// 500 in tenths: 50 Magic experience for each reward (Void)
^mta_grave_xp = 500
// the most points a death takes (Void death_penalty)
^mta_grave_death_penalty = 10
