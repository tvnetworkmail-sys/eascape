// EASCape: the Mage Training Arena (ours: Void keeps the same things in its own vars).

// talked to the Entrance Guardian and given a progress hat
[mta_started]
scope=perm

// the four rooms' Pizazz Points
[mta_tele_points]
scope=perm
[mta_alch_points]
scope=perm
[mta_ench_points]
scope=perm
[mta_grave_points]
scope=perm

// bought Bones to Peaches from the Rewards Guardian
[mta_peaches]
scope=perm

// the Telekinetic Theatre: the maze you're on (1-10), the mazes solved (a bit each), and how many
// in a row since you came through the portal
[mta_maze]
scope=perm
[mta_mazes_solved]
scope=perm
[mta_maze_streak]
scope=perm
// observing the maze (the camera is moved)
[mta_camera]
scope=temp

// the Alchemists' Playground: the coins you take out when you leave (10 for each point)
[mta_alch_reward]
scope=perm

// the Enchanting Chamber: shapes enchanted towards the next points, orbs towards the next reward
[mta_ench_converted]
scope=perm
[mta_ench_orbs]
scope=perm

// the Creature Graveyard: fruit towards the next reward
[mta_grave_fruit]
scope=perm

// where your guardian statue is (Telekinetic Theatre)
[mta_statue_at]
type=coord
scope=temp

// a spell on the statue or a shape can't be cast again before this tick
[mta_cast_clock]
scope=temp

// the room you're in (^mta_room_*), to know which you left
[mta_room_in]
scope=temp

// the maze's guardian is freed (Telekinetic Theatre)
[mta_maze_freed]
scope=temp
