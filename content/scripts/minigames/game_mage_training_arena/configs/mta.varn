// EASCape: the Mage Training Arena's guardians keep their room's state (ours).

// the Alchemy Guardian: how far the items have moved round the cupboards (0-7), which item costs no
// runes (1-5, 0 none), and each item's worth (the order of ~mta_alch_item)
[mta_alch_rot]
[mta_alch_free]
[mta_alch_value1]
[mta_alch_value2]
[mta_alch_value3]
[mta_alch_value4]
[mta_alch_value5]

// the Enchantment Guardian: the bonus shape (1 cube, 2 cylinder, 3 pentamid, 4 icosahedron)
[mta_ench_bonus]
