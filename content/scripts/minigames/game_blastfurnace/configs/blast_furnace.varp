// EASCape: ours. These are written by the room's softtimer, hence protect=no.

// EASCape: ours. Where your ore is on the conveyor belt: 0 none, 1-4 the four squares from the top
// of the belt to the melting pot (2009scape BFBeltOre: 1942,4966 down to 1942,4963). What is on it
// is in blast_furnace_inv.
[bf_belt]
scope=perm
protect=no

// EASCape: ours. The ore riding the belt for you to see (the cache's blast_furnace_<ore> npcs).
[bf_belt_npc]
type=npc_uid
protect=no

// EASCape: ours. When the foreman's ten minutes run out (map_clock); lost when you log out (RS wiki).
[bf_fee_end]
protect=no

// EASCape: ours. 1 while you're reading the temperature gauge.
[bf_gauge]
protect=no

// EASCape: ours. The last tick you got the token Smithing xp for someone else's bars.
[bf_xp_clock]
protect=no

// EASCape: ours. When your pumping or pedalling animation runs out (map_clock).
[bf_anim_end]
protect=no

// EASCape: ours. Where you stood while the foreman showed you the Blast Furnace Plan (an overlay,
// which closing the chat doesn't close); null when it isn't up.
[bf_plan]
type=coord
protect=no
