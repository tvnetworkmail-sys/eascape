// EASCape: ours. The Blast Furnace, one per world (2009scape BlastState / BlastFurnace: one
// furnace shared by everyone in the room).
[bf_clock]
type=int

[bf_ticks]
type=int

[bf_coke]
type=int

[bf_stove_temp]
type=int

[bf_furnace_temp]
type=int

// bits: ^bf_pot_pipe, ^bf_pump_pipe, ^bf_drive_belt, ^bf_cogs
[bf_broken]
type=int

// what the locs show now (so they change only when something has)
[bf_broken_shown]
type=int

[bf_stove_look]
type=int

[bf_belt_turning]
type=int

[bf_pumper]
type=player_uid

[bf_pump_clock]
type=int

[bf_pedaler]
type=player_uid

[bf_pedal_clock]
type=int

// bits: ^bf_hide_pump, ^bf_hide_pedals (the loc is gone while someone works it)
[bf_hidden]
type=int

// the last tick someone's ore moved down the belt, and someone had ore on it
[bf_belt_moved]
type=int

[bf_belt_waiting]
type=int

// the last tick bars were smelted, and how many players had theirs smelted then
[bf_smelt_clock]
type=int

[bf_smelt_count]
type=int

// the last tick someone threw a bucket of water on the bar dispenser
[bf_cool_clock]
type=int
