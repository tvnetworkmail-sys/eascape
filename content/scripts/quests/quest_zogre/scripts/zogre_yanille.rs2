// EASCape: Zogre Flesh Eaters - Yanille: Sithik Ints and his room, Zavistic Rarve's quest talk and his
// bell, and the Dragon Inn's bartender. Words from Void (content/area/kandarin/yanille/SithikInts.kt,
// ZavisticRarve.kt, BartenderDragonInn.kt). Sithik is the 2007 cache's bed loc (zogre_sithik_bed_entity:
// a man, an ogre once %thzfe_sithik_transformed is 1, a man again at 2). Ours is marked.

[proc,sithik_head]()(npc)
if (%thzfe_sithik_transformed = 1) return(zogre_sithik_ogre);
return(zogre_sithik_man);

[proc,sithik](string $text)
~chatnpc_specific("Sithik Ints", ~sithik_head, $text);

// ---------------------------------------------------------------- Sithik
[oploc1,zogre_sithik_bed_entity]
def_int $s = %zogre;
if ($s = ^zogre_barricade | $s = ^zogre_sithik) {
    if (%thzfe_prismsearch = 4) {
        ~sithik("<p,angry>Hey...who gave you permission to come in here!");
        ~chatplayer("<p,neutral>Zavistic Rarve said that I could come and talk to you and ask you a few questions.");
        ~sithik("<p,confused>Oh, Zavistic...why...why would he send you to me?");
        @sithik_questions;
    }
    if (%thzfe_prismsearch = 5) @sithik_what_now;
}
if ($s = ^zogre_potion) {
    if (%thzfe_sithik_transformed >= 1) {
        ~sithik("<p,shock>Arghhhh..what's happened to me...you beast!");
        ~chatplayer("<p,angry>It's your own fault, you shouldn't have lied about your involvement with the undead Ogres at Jiggig. The potion will wear off once you've told the truth!");
        ~sithik("<p,sad>Ok, ok, I admit it, I got Brentle Vahn to cast the spell to put an end to those awful Ogres...they're just disgusting creatures...");
        ~chatplayer("<p,neutral>Ok, that's a start...now I want some answers.");
        @sithik_answers;
    }
    @sithik_what_now;
}
if ($s = ^zogre_permanent) {
    ~sithik("<p,shock>Arghhhh..what do you want now...you've turned me into a beast!");
    ~chatplayer("<p,angry>I've got some questions for you...and you'd better answer them well or else!");
    ~sithik("<p,shock>Ok, ok, I'll tell you anything, just turn me back into a human again!");
    @sithik_answers;
}
if ($s >= ^zogre_given_key) {
    ~sithik("<p,neutral>Oh, so you're back then, come to gloat have you?");
    ~chatplayer("<p,neutral>Nope, I've just come to ask you a couple of questions.");
    switch_int (~p_choice3("How do I get rid of the undead ogres?", 1, "How do I get rid of the disease?", 2, "Sorry, I have to go.", 3)) {
        case 1 : @sithik_ogres;
        case 2 : @sithik_disease;
        case 3 : @sithik_leave;
    }
    return;
}
~sithik("<p,angry>Hey...who gave you permission to come in here! Get out, get out I say.");
~chatplayer("<p,neutral>Alright, alright...keep your night cap on.");

[label,sithik_what_now]
~sithik("<p,angry>What do you want now?");
~chatplayer("<p,neutral>Hey there's no need to be rude!");
~sithik("<p,angry>What do you expect when you just go snooping around a person's place against their express permission.");
switch_int (~p_choice3("What do you do?", 1, "Why do you spend most of your time in bed?", 2, "Ok, thanks.", 3)) {
    case 1 : @sithik_what_do;
    case 2 :
        ~chatplayer("<p,quiz>Why do you spend most of your time in bed?");
        ~sithik("<p,sad>I'm actually quite old and not so very well and I'd like to get over this illness I have, then I'll return to my very serious and important studies.");
        @sithik_questions;
    case 3 : ~chatplayer("<p,neutral>Ok, thanks.");
}

[label,sithik_questions]
switch_int (~p_choice4("Do you know anything about the undead ogres at Jiggig?", 1, "What do you do?", 2, "Do you mind if I look around?", 3, "Ok, thanks.", 4)) {
    case 1 :
        ~chatplayer("<p,quiz>Do you know anything about the undead ogres at Jiggig?");
        ~sithik("<p,neutral>Er...undead ogres...no, sorry, no idea what you're talking about there.");
        ~chatplayer("<p,neutral>Hmm, is that right...");
        ~sithik("<p,neutral>Well, yes, yes it is. If I knew something, I'd tell you.");
        ~sithik("<p,happy>Anyway, dead ogres you say? How strange? That must be a strange sight?");
        ~chatplayer("<p,neutral>Very well, if you don't know anything about it, you won't mind if I look around then?");
        @sithik_look_around;
    case 2 : @sithik_what_do;
    case 3 :
        ~chatplayer("<p,quiz>Do you mind if I look around?");
        if (%thzfe_prismsearch = 5) {
            ~sithik("<p,angry>I've already told you that I do! But you'll probably just ignore me again!");
            ~chatplayer("<p,neutral>Quite right!");
            return;
        }
        @sithik_look_around;
    case 4 : ~chatplayer("<p,neutral>Ok, thanks.");
}

[label,sithik_what_do]
~chatplayer("<p,quiz>What do you do?");
~sithik("<p,neutral>I'm a scholarly student of the magical arts. When I was younger I used to be an adventurer, probably just like yourself. But I lost interest in the constant fighting, looting and gaining abilities.");
~sithik("<p,neutral>Instead I decided to focus my attention and time to study the purer form of the lost arts.");
~chatplayer("<p,quiz>The lost arts? What are they?");
~sithik("<p,neutral>Ignorant people call them the 'dark arts'. I'm talking about Necromancy, the power to bring the dead back to life - the power of the gods! Surely the most awesome power known to man.");
~chatplayer("<p,neutral>Hmm, well I guess I must be an ignorant person then, because bringing the dead back to life sounds very unnatural.");
@sithik_questions;

[label,sithik_look_around]
%thzfe_prismsearch = 5;
~sithik("<p,angry>Well, err....well, actually yes I do mind...it's my place and I don't want strangers going through my things.");
~chatplayer("<p,neutral>Well, I'm going to have a look around anyway, if you're not involved in this whole thing, you won't have anything to hide.");
~sithik("<p,angry>Why, if I was a few years younger I'd give you a good hiding!");
~chatplayer("<p,neutral>I'm sure!");
@sithik_questions;

[label,sithik_answers]
switch_int (~p_choice4("How do I remove the effects of the spell from the area?", 1, "How do I get rid of the undead ogres?", 2, "How do I get rid of the disease?", 3, "Sorry, I have to go.", 4)) {
    case 1 :
        ~chatplayer("<p,quiz>How do I remove the effects of the spell from the area? The ogres want to get their ceremonial dance area back and can't do that with undead walking all over it.");
        if (%zogre >= ^zogre_permanent) {
            ~sithik("<p,neutral>Haven't I told you this already? You can't remove the spell, it's permanent, it will last forever, the only option you have is to move the ceremonial area.");
        } else {
            ~sithik("<p,sad>Unfortunately you can't. The spell is permanent, it will last forever, the only option you have is to move the ceremonial area.");
            %zogre = ^zogre_permanent;
        }
        ~chatplayer("<p,angry>You're an evil man and I'm going to make you pay for this...you can stay like that forever as far as I'm concerned.");
        ~sithik("<p,sad>No...no, let me try to make amends...please I can help you. Just don't leave me like this.");
        @sithik_answers;
    case 2 : @sithik_ogres;
    case 3 : @sithik_disease;
    case 4 : @sithik_leave;
}

[label,sithik_leave]
~chatplayer("<p,neutral>Sorry, I have to go.");
~sithik("<p,shock>But...you can't just leave me here like this!");

[label,sithik_ogres]
~chatplayer("<p,quiz>How do I get rid of the undead ogres?");
if (%thzfe_makebrutalarrow = 1) {
    ~sithik("<p,shock>Haven't I already explained this to you once before?");
    ~chatplayer("<p,neutral>Humour me!");
}
~sithik("<p,happy>Ok, similar spells have been cast before and the only way to deal with the resulting creatures is to cordon off the area and not go in there again.");
~sithik("<p,neutral>The undead creatures usually manifest some sort of disease so it's best to attack them from a distance with a ranged weapon.");
~sithik("<p,sad>Normal missiles like arrows and darts do very little damage to them because they're designed to destroy internal organs. This is a waste of time with undead creatures like undead ogres.");
~chatplayer("<p,quiz>Yeah, clearly so what should we use?");
%thzfe_makebrutalarrow = 1;
~sithik("<p,sad>From my research it looks like a flat ended arrow was designed called a 'Brutal arrow'. This does large amounts of crushing damage to the creature. You can make them by using larger arrows.");
~sithik("<p,neutral>I think some Ogre hunters make them. But instead of adding an arrow tip, you hammer a large nail into the end of the shaft.");
if (%zogre >= ^zogre_given_key) return;
@sithik_answers;

[label,sithik_disease]
~chatplayer("<p,quiz>How do I get rid of the disease?");
if (%thzfe_makecuredisease = 1) {
    ~sithik("<p,shock>Haven't I already explained this disease thing to you once before?");
    if (%thzfe_sithik_transformed = 2) {
        ~chatplayer("<p,angry>Just tell me again or else I'll turn you back into an ogre!");
    } else {
        ~chatplayer("<p,angry>Just tell me again or else I'll never turn you back into a human!");
    }
    ~sithik("<p,shock>No...noo...please, I'll tell you.");
}
%thzfe_makecuredisease = 1;
~sithik("<p,sad>My research shows that two jungle based herbs can be used, one is found near river tributaries and looks like a vine, the other is found in caves and grows on the wall.");
~sithik("<p,neutral>It's quite well camouflaged so it's unlikely that you'll find it.");
~chatplayer("<p,neutral>We'll see about that!");
if (%zogre >= ^zogre_given_key) return;
@sithik_answers;

// things shown to Sithik (Void)
[oplocu,zogre_sithik_bed_entity]
switch_obj (last_useitem) {
    case zogre_necrobook :
        ~chatplayer("<p,happy>Aha! A necromantic book! What's this doing here then?");
        ~objbox(zogre_necrobook, "You show the Necromantic book to Sithik.", 250, 0, 0);
        ~sithik("<p,confused>Oh..I'm not quite sure actually...where did you find that then?");
        ~chatplayer("<p,angry>I found it in this cupboard! What do you have to say for yourself?");
        ~sithik("<p,neutral>Oh yes, that's right...I remember now. It's for my research, there's nothing really dangerous about it, unless it falls into the wrong hands. I'm sure it's pretty safe with me.");
        ~chatplayer("<p,neutral>Hmmm, likely story!");
    case zogre_hambook :
        ~chatplayer("<p,quiz>What's this then?");
        ~objbox(zogre_hambook, "You show the HAM book to Sithik.", 250, 0, 0);
        ~sithik("<p,neutral>What do you mean? It's a book by the respected HAM leader Johanhus Ulsbrecht, that man speaks for a lot of people who are unhappy with the current state of affairs.");
        ~sithik("<p,angry>Can you honestly tell me that you've not had to fight for your life against the odd monster or two?");
        ~chatplayer("<p,neutral>Hmm, that may be true, but I don't universally hate all monsters, whereas I have a sneaking suspicion that you do...and ogres in particular!");
        ~sithik("<p,angry>Hmm, that's an interesting theory, care to back it up with any facts?");
    case papyrus : @sithik_sketch;
    case zogre_portrait_book :
        ~chatplayer("<p,neutral>Oh, so explain this then?");
        ~objbox(zogre_portrait_book, "You show the book on portraiture to Sithik.", 250, 0, 0);
        ~sithik("<p,happy>It's my hobby...I'm interested in portraiture, but all art in general. It's fun, you should try it.");
        ~chatplayer("<p,quiz>How do I do it...");
        ~sithik("<p,neutral>Well...you could start by reading the book!");
    case zogre_sithik_portrait_bad :
        ~chatplayer("<p,quiz>Here you go, what do you think?");
        ~objbox(zogre_sithik_portrait_bad, "You show the sketch...", 250, 0, 0);
        ~sithik("<p,happy>Hmmm, well it's an interesting interpretation, but not really classic realist representation is it? It's not my favourite, but I like the 'truth' of the work...well done.");
    case zogre_sithik_portrait_good :
        ~chatplayer("<p,quiz>Here you go, what do you think?");
        ~objbox(zogre_sithik_portrait_good, "You show the portrait to Sithik.", 250, 0, 0);
        ~sithik("<p,happy>Hmmm, well it's not the most flattering of portraits, but I like the 'honesty' of the work...well done.");
    case zogre_ogre_trans_potion :
        ~chatplayer("<p,happy>Here, try some of this potion, it'll make you feel better!");
        ~sithik("<p,shock>Err, yuck....no way am I taking any potions or medication off you...I don't trust you!");
    case zogre_sithik_portrait_signed :
        ~chatplayer("<p,happy>Hey, what do you think of this? I'm going to show it to Zavistic and you're going to be in trouble!");
        ~objbox(zogre_sithik_portrait_signed, "You show the portrait to Sithik.", 250, 0, 0);
        ~sithik("<p,neutral>Hmmm, well, I've got quite a common looking face, I'm often mistaken for other wizards, you know, when I'm wearing my wizard's hat, robes and staff. There's a lot of us around here you know.");
        ~chatplayer("<p,angry>I don't think so! This is a signed picture of you, someone recognised you, you're in deep trouble!");
        ~sithik("<p,neutral>Ok, I'll pay you to keep this secret - how much do you want for the picture?");
        ~chatplayer("<p,angry>You can't buy me Sithik!");
        ~sithik("<p,neutral>Ok, let's say two million...two million to keep quiet and give me the picture.");
        ~objbox(coins, "Sithik shows you a chest brimming over with coins...", 250, 0, 0);
        ~chatplayer("<p,confused>Oh...erm...well, that is a lot of money actually...er....");
        ~sithik("<p,happy>Yes, and you deserve it, you're very clever! Now, take the money...");
        if (~p_choice2("No, I won't take the money, I'm going to bring you to justice!", 1, "Ok, I'll shut up for two million!", 2) = 1) {
            ~chatplayer("<p,angry>No, I won't take the money, I'm going to bring you to justice!");
            ~sithik("<p,angry>Oh well, suit yourself! I wasn't going to give you the money anyway! No one will believe some crazy adventurer and an Inn keep.");
        } else {
            ~chatplayer("<p,happy>Ok, I'll shut up for two million!");
            ~sithik("<p,happy>Ha! Ha! You believed me! I'm not going to give you all my money! No one will believe a crazy adventurer and a local Inn keep!");
            ~chatplayer("<p,angry>You're a mean and cruel man Sithik, a mean and cruel man!");
        }
    case zogre_dragon_tankard :
        ~chatplayer("<p,quiz>What about this then? Guess where I found this?");
        ~objbox(zogre_dragon_tankard, "You show the tankard to Sithik.", 250, 0, 0);
        ~sithik("<p,angry>You probably found it at the local brewhouse! It doesn't take a genius to figure that one out.");
        ~chatplayer("<p,happy>Aha! But I found this in an old ogre tomb! I suspect it's a clue which will lead me to the suspect.");
        ~sithik("<p,neutral>Hmmm, well that eliminates all the local people who don't actually drink at the 'Dragon Inn'. When do you think you'll start questioning the remaining population of Yanille?");
    case zogre_black_prism :
        ~chatplayer("<p,quiz>Hey, what's this then, can you explain it?!");
        ~objbox(zogre_black_prism, "You show the black prism to Sithik.", 250, 0, 0);
        ~sithik("<p,angry>Err..it looks sort of familiar, did you steal it from me? Come to think of it, you have the appearance of a common thief!");
        ~chatplayer("<p,neutral>I found it in a place called Jiggig where some undead ogres happen to be wandering around.");
        ~sithik("<p,neutral>Oh, nothing to do with me then, never seen it in my life before!");
    case zogre_necromantic_page :
        ~chatplayer("<p,quiz>Have you ever seen anything like this before?");
        ~objbox(zogre_necromantic_page, "You show the torn page to Sithik.", 250, 0, 0);
        ~sithik("<p,angry>It's probably a piece of rubbish someone threw away...what does it say, I can't read it?");
        ~chatplayer("<p,neutral>You should be able to read it, it's been torn from a book on necromancy and you're meant to be a specialist in the subject.");
        ~sithik("<p,neutral>Oh, no..., not really a specialist, just a hobby of mine really. Hardly know anything about it, but it does seem interesting...");
    case default : ~displaymessage(^dm_default);
}

// Void: papyrus and charcoal; a good likeness one time in three (the OSRS wiki: Crafting helps;
// ours: a good one once in three, better with Crafting, 1 in 2 from 40)
[label,sithik_sketch]
if (%zogre >= ^zogre_potion) {
    mes("You have already created Sithik's portrait, you don't need another one.");
    return;
}
if (inv_total(inv, charcoal) = 0) {
    ~mesbox("You have no charcoal with which to sketch this subject.");
    return;
}
~sithik("<p,happy>Oh lovely! You're making my portrait! Let me see it afterwards!");
~mesbox("You begin sketching the irritable Sithik.");
anim(human_mapping, 0);
p_delay(2);
inv_del(inv, papyrus, 1);
def_namedobj $portrait = zogre_sithik_portrait_bad;
def_int $odds = 3;
if (stat(crafting) >= 40) $odds = 2;
if (random($odds) = 0) $portrait = zogre_sithik_portrait_good;
inv_add(inv, $portrait, 1);
~objbox($portrait, "You get a portrait of Sithik.", 250, 0, 0);

// ---------------------------------------------------------------- Sithik's furniture
[proc,sithik_may_snoop]()(boolean)
if (%zogre >= ^zogre_sithik) {
    mes("You search but find nothing of significance.");
    return(false);
}
if (%thzfe_prismsearch < 5) {
    ~sithik("<p,angry>Hey! What do you think you're doing?");
    ~chatplayer("<p,shock>Erk! I'd better not start rifling through peoples things without permission.");
    return(false);
}
return(true);

[oploc1,sithiks_drawers]
if (~sithik_may_snoop = false) return;
def_boolean $papyrus = false;
def_boolean $charcoal = false;
def_boolean $book = false;
if (inv_total(inv, papyrus) > 0) $papyrus = true;
if (inv_total(inv, charcoal) > 0) $charcoal = true;
if (inv_total(inv, zogre_portrait_book) > 0) $book = true;
def_int $need = 0;
if ($papyrus = false) $need = calc($need + 1);
if ($charcoal = false) $need = calc($need + 1);
if ($book = false) $need = calc($need + 1);
if ($need = 0) {
    mes("You find nothing in the drawers.");
    return;
}
if (inv_freespace(inv) < $need) {
    ~mesbox("You see some items in the drawer, but you need <tostring($need)> free inventory spaces to take them.");
    return;
}
if ($papyrus = false & $charcoal = false) {
    inv_add(inv, charcoal, 1);
    inv_add(inv, papyrus, 1);
    ~doubleobjbox(charcoal, papyrus, "You find some charcoal and papyrus.", 250);
} else if ($papyrus = false) {
    inv_add(inv, papyrus, 1);
    ~objbox(papyrus, "You find some papyrus.", 250, 0, 0);
} else if ($charcoal = false) {
    inv_add(inv, charcoal, 1);
    ~objbox(charcoal, "You find some charcoal.", 250, 0, 0);
}
if ($book = false) {
    inv_add(inv, zogre_portrait_book, 1);
    if ($need = 1) {
        ~objbox(zogre_portrait_book, "You find a book on portraiture.", 250, 0, 0);
    } else {
        ~objbox(zogre_portrait_book, "You also find a book on portraiture.", 250, 0, 0);
    }
}

[oploc1,sithiks_cupboard]
if (~sithik_may_snoop = false) return;
if (inv_total(inv, zogre_necrobook) > 0) {
    ~mesbox("You search the cupboard but find nothing.");
    return;
}
~zogre_give(zogre_necrobook);
~objbox(zogre_necrobook, "You find a book on Necromancy.", 250, 0, 0);

[oploc1,sithiks_wardrobe]
if (~sithik_may_snoop = false) return;
if (inv_total(inv, zogre_hambook) > 0) {
    ~mesbox("You search the wardrobe but find nothing.");
    return;
}
~zogre_give(zogre_hambook);
~objbox(zogre_hambook, "You find a book on Philosophy written by the 'Human's Against Monsters' leader, Johanhus Albrect.", 250, 0, 0);

// ---------------------------------------------------------------- Sithik's tea
[opobj3,zogre_cup_of_tea_sithix]
~sithik("<p,angry>Hey! What do you think you're doing? Leave my tea alone!");

[opobju,zogre_cup_of_tea_sithix]
if (last_useitem ! zogre_ogre_trans_potion | %zogre ! ^zogre_sithik) {
    ~displaymessage(^dm_default);
    return;
}
p_arrivedelay;
%zogre = ^zogre_potion;
anim(human_pickuptable, 0);
inv_del(inv, zogre_ogre_trans_potion, 1);
~zogre_give(empty_dye_bottle);
p_delay(2);
~objbox(zogre_ogre_trans_potion, "You pour some of the potion into the cup. Zavistic said it may take some time to have an effect.", 250, 0, 0);

// Void: the potion takes hold once you climb back up to Sithik's room (ladders.rs2 calls this)
[proc,zogre_sithik_ladder]
if (%zogre = ^zogre_potion & %thzfe_sithik_transformed = 0) %thzfe_sithik_transformed = 1;

// ---------------------------------------------------------------- Zavistic Rarve
[oploc1,zogre_outdoor_bell]
loc_anim(zogre_bell_ring);
if (npc_find(coord, zogre_human_zavistic_rarve, 10, 0) = false) {
    npc_add(0_40_48_38_15, zogre_human_zavistic_rarve, 200);
}
if (%zogre < ^zogre_sithik & %thzfe_prismsearch < 4) {
    ~chatnpc("<p,angry>What are you doing ringing that bell?! Don't you think some of us have work to do?");
    ~chatplayer("<p,neutral>But I was told to ring the bell if I wanted some attention.");
    ~chatnpc("<p,neutral>Well...anyway...we're very busy here, hurry up what do you want?");
} else {
    ~chatnpc("<p,neutral>What are you doing...Oh, it's you...sorry...didn't realise...what can I do for you?");
}
@zavistic_menu;

// called from area_yanille/zavistic_rarve.rs2's Talk-to
[label,zavistic_menu]
if (%zogre >= ^zogre_barricade) @zavistic_zogre;
~zavistic_guild_menu;

[label,zavistic_zogre]
def_int $s = %zogre;
if ($s >= ^zogre_permanent) {
    ~chatnpc("<p,neutral>Don't you worry about Sithik, he's not likely to be moving from his bed for a long time. When he eventually does get better, he's going to be sent before a disciplinary tribunal, then we'll sort out what's what.");
    ~chatplayer("<p,happy>Thanks for your help with all of this.");
    ~chatnpc("<p,happy>Ooohh, no thanks required. It's I who should be thanking you my friend...your investigative mind has shown how vigilant we really should be for this type of evil use of the magical arts.");
    ~zavistic_guild_menu;
    return;
}
if ($s = ^zogre_sithik | $s = ^zogre_potion) {
    ~chatnpc("<p,quiz>Have you used that potion yet?");
    if ($s = ^zogre_potion) {
        ~chatplayer("<p,neutral>Yes, I have in fact. I poured it into his tea.");
        ~chatnpc("<p,neutral>Ok, that's good, that should work. Pop back in a little while to see Sithik and start questioning him.");
        ~zavistic_guild_menu;
        return;
    }
    if (inv_total(inv, zogre_ogre_trans_potion) > 0) {
        ~chatplayer("<p,quiz>No, not yet, what was I supposed to do again?");
        ~chatnpc("<p,neutral>Try to use the potion on Sithik somehow, he should undergo an interesting transformation, though you'll probably want to leave the house in case there are any side effects. Then go back and question Sithik and tell");
        ~chatnpc("<p,neutral>him the effects won't wear off until he tells the truth. In fact, that's not exactly true, but I'm sure it'll be an extra incentive to get him to be honest.");
        ~zavistic_guild_menu;
        return;
    }
    ~chatplayer("<p,sad>Well, actually, I've lost it, could I have another one please?");
    ~chatnpc("<p,neutral>Sure, but don't lose it this time.");
    ~zogre_give(zogre_ogre_trans_potion);
    ~objbox(zogre_ogre_trans_potion, "Zavistic hands you a bottle of strange potion.", 250, 0, 0);
    return;
}
if (%thzfe_prismsearch >= 4) @zavistic_investigation;
if (inv_total(inv, zogre_black_prism) > 0 & inv_total(inv, zogre_necromantic_page) > 0) {
    ~chatplayer("<p,neutral>There's some undead ogre activity over at Jiggig, I've found some clues, I wondered if you'd have a look at them.");
    @zavistic_both_clues;
}
if (inv_total(inv, zogre_black_prism) > 0) {
    ~chatplayer("<p,neutral>There's some undead ogre activity over at 'Jiggig', and the ogres have asked me to look into it. I think I've found a clue and I wonder if you could take a look at it for me?");
    @zavistic_prism;
}
if (inv_total(inv, zogre_necromantic_page) > 0) {
    ~chatplayer("<p,neutral>There's some undead ogre activity over at Jiggig, I've found a clue that you may be able to help with.");
    @zavistic_page;
}
~zavistic_guild_menu;

[label,zavistic_investigation]
def_int $items = 0;
if (inv_total(inv, zogre_necrobook) > 0) $items = calc($items + 1);
if (inv_total(inv, zogre_hambook) > 0) $items = calc($items + 1);
if (inv_total(inv, zogre_dragon_tankard) > 0) $items = calc($items + 1);
if (inv_total(inv, zogre_sithik_portrait_signed) > 0) $items = calc($items + 1);
def_string $show = "I have some items that I'd like you to look at.";
if ($items = 1) $show = "I have an item that I'd like you to look at.";
def_int $r_show = 0;
def_int $r_help = 0;
if ($items > 0) $r_show = 3;
if ($items = 0 & %thzfe_prismsearch = 5) $r_help = 3;
def_string $third = $show;
if ($r_help = 3) $third = "Can you help me?";
def_int $r_third = $r_show;
if ($r_help = 3) $r_third = 3;
switch_int (~p_choice_some5("What did you say I should do?", 1, "Where is Sithik?", 2, $third, $r_third, "I want to ask about the Magic Guild.", 4, "Sorry, I have to go.", 5)) {
    case 1 :
        ~chatplayer("<p,quiz>What did you say I should do?");
        ~chatnpc("<p,neutral>You should go and have a chat with Sithik Ints, he's in that house just to the north. He's a lodger and has a room upstairs. Just tell him that I sent you to see him. He should be fine once you've mentioned my name.");
        @zavistic_investigation;
    case 2 :
        ~chatplayer("<p,quiz>Where is Sithik?");
        ~chatnpc("<p,neutral>He's in that house just to the north, less than a few seconds walk away. He's a lodger and has a room upstairs...he's not very well though.");
        @zavistic_investigation;
    case 3 :
        if ($items > 0) {
            ~chatplayer("<p,neutral><$show>");
            @zavistic_all_evidence;
        }
        ~chatplayer("<p,quiz>Can you help me?");
        ~chatnpc("<p,neutral>I'm happy to help as much as I can but you have to remember that I'm quite busy. If you find any more clues about what happened at Jiggig, I'll consider them with an open mind - that's as much as I can offer.");
        @zavistic_investigation;
    case 4 :
        ~chatplayer("<p,quiz>I want to ask about the Magic Guild.");
        ~chatnpc("<p,neutral>Sure, go ahead, ask away.");
        ~zavistic_guild_menu;
    case 5 : ~chatplayer("<p,neutral>Sorry, I have to go.");
}

[label,zavistic_all_evidence]
if (inv_total(inv, zogre_necrobook) > 0) {
    ~objbox(zogre_necrobook, "You show the Necromancy book to Zavistic.", 250, 0, 0);
    ~zavistic_necrobook;
}
if (inv_total(inv, zogre_hambook) > 0) {
    ~objbox(zogre_hambook, "You show the HAM book to Zavistic.", 250, 0, 0);
    ~zavistic_hambook;
}
if (inv_total(inv, zogre_dragon_tankard) > 0) {
    ~objbox(zogre_dragon_tankard, "You show the dragon Inn Tankard to Zavistic.", 250, 0, 0);
    ~zavistic_tankard;
}
if (inv_total(inv, zogre_sithik_portrait_signed) > 0) {
    ~objbox(zogre_sithik_portrait_signed, "You show the signed portrait of Sithik to Zavistic.", 250, 0, 0);
    ~zavistic_signed;
}

[label,zavistic_prism]
~objbox(zogre_black_prism, "You show the black prism to the aged wizard.", 250, 0, 0);
if (%thzfe_prismsearch >= 4) {
    ~chatnpc("<p,neutral>Yes, you've already showed me that, bring it to me when you've resolved the problems at Jiggig and I'll see what I can do.");
    return;
}
~chatnpc("<p,neutral>Hmmm, well this is an uncommon spell component. On it's own it's useless, but with certain necromantic spells it can be very powerful. Did you find anything else there?");
if (inv_total(inv, zogre_dragon_tankard) > 0) {
    ~objbox(zogre_dragon_tankard, "You show the tankard to Zavistic.", 250, 0, 0);
    ~chatplayer("<p,neutral>Well, I found this...");
    ~chatnpc("<p,neutral>Hmmm, no, that's not really associated with this to be honest. Did you find anything else there?");
}
~chatplayer("<p,neutral>Not really.");
~chatnpc("<p,neutral>I don't know what to say then, there isn't enough to go on with the clues you've shown me so far. I'd suggest going back to search a bit more, but you may just be wasting your time?");
~chatnpc("<p,neutral>Hmm, but this prism does seem to have some magical protection. Once you've finished with this item, bring it back to me would you? I may have a reward for you!");
~chatplayer("<p,neutral>Sure...I mean, I'll try if I remember.");

[label,zavistic_page]
~objbox(zogre_necromantic_page, "You show the necromantic half page to the aged wizard.", 250, 0, 0);
~chatnpc("<p,neutral>Hmm, this is a half torn spell page, it requires another spell component to be effective. Did you find anything else there?");
if (inv_total(inv, zogre_black_prism) > 0) @zavistic_both_clues;
if (inv_total(inv, zogre_dragon_tankard) > 0) {
    ~objbox(zogre_dragon_tankard, "You show the tankard to Zavistic.", 250, 0, 0);
    ~chatplayer("<p,neutral>Well, I found this...");
    ~chatnpc("<p,neutral>Hmmm, no, that's not really associated with this to be honest. Did you find anything else there?");
}
~chatplayer("<p,neutral>Not really.");
~chatnpc("<p,neutral>I don't know what to say then, there isn't enough to go on with the clues you've shown me so far. I'd suggest going back to search a bit more, but you may just be wasting your time?");

[label,zavistic_both_clues]
~doubleobjbox(zogre_black_prism, zogre_necromantic_page, "You show the prism and the necromantic half page to the aged wizard.", 250);
~chatnpc("<p,happy>Hmmm, now this is interesting! Where did you get these from?");
~chatplayer("<p,neutral>I got them from a nearby Ogre tomb, it's recently been infested with zombie ogres and I'm trying to work out what happened there.");
~chatnpc("<p,sad>This is very troubling <displayname>, very troubling indeed. While it's permitted for learned members of our order to research the 'dark arts', it's absolutely forbidden to make use of such magic.");
~chatplayer("<p,quiz>Do you have any leads on people that I might talk to regarding this?");
%thzfe_prismsearch = 4;
~chatnpc("<p,neutral>Well a wizard by the name of 'Sithik Ints' was doing some research in this area. He may know something about it. He's lodged at that guest house to the North, though he's ill and isn't able to leave his room.");
~chatnpc("<p,neutral>Why not go and talk to him, poke around a bit and see if anything comes up. Let me know how you get on. However, I doubt that 'Sithik' had anything to do with it.");
~chatnpc("<p,neutral>There's a severe penalty for using the 'dark arts'. If you find any evidence to the contrary, please bring it to me.");
~chatnpc("<p,neutral>Hmm, that black prism seems to have some magical protection. Once you've finished with this item, bring it back to me would you. I may have a reward for you.");

[proc,zavistic_seen_before]
~chatnpc("<p,neutral>Yeah, you've shown me this before...if this is all the evidence you have?");
~chatplayer("<p,neutral>Please just look at it again...");
~chatnpc("<p,neutral>Ok, let me look then.");

[proc,zavistic_tankard]
~chatplayer("<p,neutral>This is the tankard I found on the remains of Brentle Vahn!");
if (%thzfe_innkeepermugshown = 1) ~zavistic_seen_before;
%thzfe_innkeepermugshown = 1;
~chatnpc("<p,neutral>That doesn't mean anything in itself, you could have gotten that from anywhere. Even from the Dragon Inn tavern! There isn't anything to link Brentle Vahn with Sithik Ints.");

[proc,zavistic_necrobook]
~chatplayer("<p,neutral>I have this necromancy book as evidence that Sithik is involved with the undead ogres at Jiggig.");
if (%thzfe_shownnecrobook = 1) ~zavistic_seen_before;
~chatnpc("<p,neutral>Ok, so he's researching necromancy...it doesn't mean anything in itself.");
~chatplayer("<p,neutral>Yes, but if you look, you can see that there is a half torn page which matches the page I found at Jiggig.");
%thzfe_shownnecrobook = 1;
~chatnpc("<p,neutral>Hmm, yes, but someone could have stolen that from him and then gone and cast it without his permission or to try and deliberately implicate him.");

[proc,zavistic_hambook]
~chatplayer("<p,neutral>Look, this book proves that Sithik hates all monsters and most likely Ogres with a passion.");
if (%thzfe_shownhambook = 1) ~zavistic_seen_before;
%thzfe_shownhambook = 1;
~chatnpc("<p,neutral>So what, hating monsters isn't a crime in itself...although I suppose that it does give a motive if Sithik was involved. On its own, it's not enough evidence though.");

[proc,zavistic_signed]
~chatplayer("<p,neutral>This is a portrait of Sithik, signed by the landlord of the Dragon Inn saying that he saw Sithik and Brentle Vahn together.");
if (%thzfe_shownsignedportrait = 1) ~zavistic_seen_before;
%thzfe_shownsignedportrait = 1;
~chatnpc("<p,neutral>Hmmm, well that is interesting.");
if (%thzfe_shownnecrobook = 0 | %zogre ! ^zogre_barricade) return;
~chatnpc("<p,neutral>And I'm starting to think that Sithik may be involved. Here, take this potion and give some to Sithik. It'll bring on a change which should solicit some answers - tell him the effects won't revert until he's told the truth.");
%zogre = ^zogre_sithik;
inv_del(inv, zogre_necrobook, inv_total(inv, zogre_necrobook));
inv_del(inv, zogre_necromantic_page, inv_total(inv, zogre_necromantic_page));
inv_del(inv, zogre_dragon_tankard, inv_total(inv, zogre_dragon_tankard));
inv_del(inv, zogre_sithik_portrait_signed, inv_total(inv, zogre_sithik_portrait_signed));
inv_del(inv, zogre_hambook, inv_total(inv, zogre_hambook));
~zogre_give(zogre_ogre_trans_potion);
~objbox(zogre_ogre_trans_potion, "Zavistic hands you a strange looking potion bottle and takes all the evidence you've accumulated so far.", 250, 0, 0);

// things shown to Zavistic (Void)
[opnpcu,zogre_human_zavistic_rarve]
switch_obj (last_useitem) {
    case zogre_black_prism :
        ~chatplayer("<p,neutral>I found this black prism at Jiggig where the undead ogre activity was happening?");
        @zavistic_prism;
    case zogre_necromantic_page :
        ~chatplayer("<p,neutral>I think I've found a clue from the Jiggig area where the undead ogre activity is happening.");
        @zavistic_page;
    case zogre_dragon_tankard :
        ~objbox(zogre_dragon_tankard, "You show the dragon Inn Tankard to Zavistic.", 250, 0, 0);
        ~zavistic_tankard;
    case zogre_necrobook :
        ~objbox(zogre_necrobook, "You show the Necromancy book to Zavistic.", 250, 0, 0);
        ~zavistic_necrobook;
    case zogre_hambook :
        ~objbox(zogre_hambook, "You show the HAM book to Zavistic.", 250, 0, 0);
        ~zavistic_hambook;
    case zogre_sithik_portrait_signed :
        ~objbox(zogre_sithik_portrait_signed, "You show the signed portrait of Sithik to Zavistic.", 250, 0, 0);
        ~zavistic_signed;
    case zogre_sithik_portrait_good :
        ~objbox(zogre_sithik_portrait_good, "You show the portrait of Sithik to Zavistic.", 250, 0, 0);
        ~chatnpc("<p,neutral>Hmm, great...but I already know what he looks like!");
    case zogre_sithik_portrait_bad :
        ~chatplayer("<p,happy>Look, I made a portrait of Sithik.");
        ~objbox(zogre_sithik_portrait_bad, "You show the sketch...", 250, 0, 0);
        ~chatnpc("<p,confused>Who the demonikin is that? Is it meant to be a portrait of Sithik, it doesn't look anything like him!");
    case default : ~displaymessage(^dm_default);
}

// ---------------------------------------------------------------- the Dragon Inn's bartender (Void)
[proc,zogre_bartender_item]()(boolean)
switch_obj (last_useitem) {
    case zogre_dragon_tankard :
        ~objbox(zogre_dragon_tankard, "You show the tankard to the Inn Keeper.", 250, 0, 0);
        if (%thzfe_showntankard = 1) {
            ~chatplayer("<p,happy>Hello again. Can you tell me what you know about this tankard again please?");
            ~chatnpc("<p,neutral>Oh yes, Brentle's tankard. Yeah, you've shown me this already. It belonged to Brentle Vahn, he was quite a common customer, though I've not seen him in a while.");
            ~chatnpc("<p,neutral>He was talking to some shifty looking wizard the other day. I don't know his name, but I'd recognise him if I saw him.");
            return(true);
        }
        ~chatplayer("<p,neutral>Hello there, I found this tankard in an ogre tomb cavern. It has the emblem of this Inn on it and I wondered if you knew anything about it?");
        %thzfe_showntankard = 1;
        ~chatnpc("<p,neutral>Oh yes, this is Brentle's mug...I'm surprised he left it just lying around down some cave. He's quite protective of it.");
        ~chatplayer("<p,quiz>Brentle you say? So you knew him then?");
        ~chatnpc("<p,neutral>Yeah, this belongs to 'Brentle Vahn', he's quite a common customer, though I've not seen him in a while.");
        ~chatnpc("<p,neutral>He was talking to some shifty looking wizard the other day. I don't know his name, but I'd recognise him if I saw him.");
        ~chatplayer("<p,sad>Hmm, I'm sorry to tell you this, but Brentle Vahn is dead - I believe he was murdered.");
        ~chatnpc("<p,shock>Noooo! I'm shocked...");
        ~chatnpc("<p,neutral>...but not surprised. He was a good customer...but I knew he would sell his sword arm and do many a dark deed if paid enough.");
        ~chatnpc("<p,sad>If you need help bringing the culprit to justice, you let me know.");
        return(true);
    case zogre_sithik_portrait_bad :
        ~objbox(zogre_sithik_portrait_bad, "You show the sketch to the Inn keeper.", 250, 0, 0);
        ~chatnpc("<p,happy>Who's that? I mean, I guess it's a picture of a person isn't it? Sorry...you've got me? And before you ask, you're not putting it up on my wall!");
        ~chatplayer("<p,neutral>It's a portrait of Sithik Ints...don't you recognise him?");
        ~chatnpc("<p,neutral>I'm sorry, I really am, but I just don't see it...can you make a better picture?");
        ~chatplayer("<p,sad>I'll try...");
        return(true);
    case zogre_sithik_portrait_good :
        ~objbox(zogre_sithik_portrait_good, "You show the portrait to the Inn keeper.", 250, 0, 0);
        if (%thzfe_innkeeperportraitshown = 1) {
            ~chatnpc("<p,neutral>Yeah, I recognise that Geezer, he was talking to one of my customers the other day.");
            return(true);
        }
        ~chatnpc("<p,neutral>Yeah, that's the guy who was talking to Brentle Vahn the other day! Look at those eyes, never a more shifty looking pair will you ever see!");
        ~chatplayer("<p,neutral>Hmm, you've just identified the man who I think sent Brentle Vahn to his death.");
        ~chatplayer("<p,neutral>I'm trying to bring him to justice with the Wizards' Guild grand secretary. Do you think you could sign this portrait to say that he was talking to Brentle Vahn.");
        ~chatnpc("<p,happy>I can and I will!");
        npc_anim(human_mapping, 0);
        inv_del(inv, zogre_sithik_portrait_good, 1);
        inv_add(inv, zogre_sithik_portrait_signed, 1);
        %thzfe_innkeeperportraitshown = 1;
        ~objbox(zogre_sithik_portrait_signed, "The Dragon Inn bartender signs the portrait.", 250, 0, 0);
        ~chatplayer("<p,happy>Many thanks for your help, it's really very good of you.");
        ~chatnpc("<p,neutral>Not at all, just doing my part.");
        return(true);
}
return(false);
