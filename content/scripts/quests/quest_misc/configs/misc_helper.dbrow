[questhelper_step_misc_1]
table=questhelper_step
data=id,45001
data=section,0
data=text,Travel to Miscellania. You can take a boat from Rellekka. You can also use Fairy Rings to teleport there with the code CIP If you've unlocked them.
data=npc,viking_sailor
data=coord,0_41_57_5_45

[questhelper_step_misc_2]
table=questhelper_step
data=id,45002
data=section,0
