// EASCape: ours, for In Aid of the Myreque (quest_myreque2), in the free bits of the cache's
// myreque2_extravar (bits 0-9 are the cache's own varbits)

// you've been inside Ivandis' tomb
[myq2_entered_tomb]
basevar=myreque2_extravar
startbit=10
endbit=10

// Ivan's hitpoints on the escort
[myq2_ivan_hp]
basevar=myreque2_extravar
startbit=14
endbit=18

// the escort's swamp you're in: 1 route 1 (through Canifis), 2 route 2; 3 Ivan left you
[myq2_route]
basevar=myreque2_extravar
startbit=19
endbit=20

// the juvinates still to kill on the escort
[myq2_juves_left]
basevar=myreque2_extravar
startbit=21
endbit=23

// the fight in the general store: 1 fighting, 2 Gadderanks down, 3 his juvinates gone too
[myq2_fight]
basevar=myreque2_extravar
startbit=24
endbit=25

// you found the plaster fragment and the dusty scroll in the cellar's rubble
[myq2_found_plaster]
basevar=myreque2_extravar
startbit=26
endbit=26

[myq2_found_scroll]
basevar=myreque2_extravar
startbit=27
endbit=27
