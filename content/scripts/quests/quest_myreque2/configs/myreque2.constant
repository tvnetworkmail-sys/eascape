// EASCape: In Aid of the Myreque (quest_myreque2), the update of 22 March 2006.
// %myreque_2_quest is the cache's varbit (bits 0-8 of myreque2_multivar, the quest's own varp
// 705). Void (in_aid_of_the_myreque.varbits.toml) gives 20 for started and 430 for completed;
// the stages between are ours.
^myq2_not_started = 0
^myq2_started = 20             // Veliaf sent you to Burgh de Rott
^myq2_chest = 30               // you put food in the chest at the gate; the townsfolk let you in
^myq2_told_inn = 40            // a villager told you about the inn's cellar
^myq2_basement_done = 60       // the last of the rubble cleared from the cellar
^myq2_fix_store = 70           // a villager asked you to fix the general store
^myq2_store_fixed = 80         // the roof and wall mended (Aurel's to talk to)
^myq2_crate = 90               // Aurel gave you the stock crate
^myq2_fix_bank = 100           // the crate handed in; the bank's next
^myq2_banker = 110             // Cornelius is the banker
^myq2_tithe = 120              // the furnace lit; Gadderanks' blood tithe in the general store
^myq2_tithe_won = 130          // Gadderanks told you the vampyres' weaknesses before he died
^myq2_hollows = 140            // Veliaf went back to the Hollows
^myq2_escort = 150             // Veliaf asked you to take Ivan to Paterdomus
^myq2_ivan_safe = 160          // Ivan's at the temple
^myq2_key = 170                // Drezel gave you the library key
^myq2_rod = 180                // you've read The Sleeping Seven (the tomb and the rod)
^myq2_complete = 430

^myq2_questpoints = 2

// the rubble in the inn's cellar: how many piles, and the find after so many are cleared (ours)
^myq2_rubble_piles = 15
^myq2_find_rubbish1 = 4
^myq2_find_plaster = 6
^myq2_find_rubbish2 = 9
^myq2_find_scroll = 12

// Ivan on the escort (ours: the wikis give no numbers for him)
^myq2_ivan_hp = 25
^myq2_ivan_food_max = 15

// ---------------------------------------------------------------- places
^myq2_gate_outside = 0_54_50_28_45      // north of the gate (3484,3245)
^myq2_gate_inside = 0_54_50_28_43       // (3484,3243)
^myq2_inn_trapdoor_top = 0_54_50_35_31  // beside the inn's trapdoor (3491,3231)
^myq2_cellar_rubble = 1_54_150_34_31    // the cellar, still full of rubble (the cache's run-down copy of it, level 1)
^myq2_cellar_base = 0_54_150_34_31      // the cellar once the Myreque have moved in
^myq2_store_ladder_foot = 0_54_50_57_37 // (3513,3237)
^myq2_store_roof = 2_54_50_57_39        // (3513,3239)
^myq2_store_door = 0_54_50_50_39        // outside the general store (3506,3239)
^myq2_store_inside = 0_54_50_59_41      // (3515,3241)
^myq2_library = 2_53_154_21_11          // Paterdomus' secret library (3413,9867)
^myq2_library_top = 0_53_154_50_42     // beside the trapdoor by the keyhole in the temple crypt (3442,9898)
^myq2_tomb_inside = 2_54_153_5_29       // Ivandis' tomb, by its way out (3461,9821)
^myq2_tomb_outside = 0_54_153_29_40     // the Hollows' tunnel, by the boards (3485,9832)
^myq2_temple_arrive = 0_53_54_31_29     // the end of the escort: by Paterdomus (3423,3485)
^myq2_escort_quit = 0_54_54_16_40       // out of the swamp, near Canifis (3472,3496)

