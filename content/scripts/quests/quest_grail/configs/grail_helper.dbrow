[questhelper_step_grail_17]
table=questhelper_step
data=id,30017
data=section,3
data=text,Kill the Black Knight Titan with Excalibur. Melee is recommended as it has high Ranged and Magic defence. (You only need to deal the killing blow with excalibur!)
data=npc,black_knight_titan
data=item,magic_whistle,2

[questhelper_step_grail_18]
table=questhelper_step
data=id,30018
data=section,3
data=text,Talk to the fisherman by the river. After talking to him walk West to the castle.
data=npc,grail_fisherman
data=coord,0_43_73_46_34
data=option,Any idea how to get into the castle?

[questhelper_step_grail_19]
table=questhelper_step
data=id,30019
data=section,3
data=text,"Pickup the grail bell outside of the castle. If it's not there, return to the fisherman and finish the conversation."
data=coord,0_43_73_10_22
data=option,Any idea how to get into the castle?
data=item,grail_bell,1

