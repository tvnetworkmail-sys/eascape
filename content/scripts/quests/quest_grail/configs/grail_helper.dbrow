[questhelper_step_grail_15]
table=questhelper_step
data=id,30015
data=section,3
data=text,"Go retrieve Excalibur from your bank. If you do not own Excalibur, you can retrieve it from the Lady of the Lake in Taverley for 500 coins."
data=item,magic_whistle,2

