[questhelper_step_fairy1_1]
table=questhelper_step
data=id,102001
data=section,0
data=text,Talk to Martin in the Draynor Market.
data=npc,martin_the_master_farmer
data=coord,0_48_50_6_58
data=option,Anything I can help with?

[questhelper_step_fairy1_2]
table=questhelper_step
data=id,102002
data=section,0
data=text,"Talk to 5 gardeners, then return to Martin in Draynor Village. The recommended 5 are Frizzy in Port Sarim, Elstan north west of Draynor, Heskel in Falador Park, Treznor south of Varrock Castle and Dreven south of Varrock, next to the Champions' Guild."
data=npc,frizzy_skernip
data=npc,elstan
data=npc,farming_gardener_tree_2
data=npc,farming_gardener_tree_3
data=npc,farming_gardener_bush_1
data=coord,0_47_50_49_59
data=option,Are you a member of the Group of Advanced Gardeners?

