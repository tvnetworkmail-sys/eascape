// The items Malignius Mortifer may ask you to bring the Nature Spirit, in the OSRS wiki's order
// (Fairytale I - Growing Pains, "Blessed secateurs"). fairy_nature_item1-3 hold three in a row:
// 0 is the first (RuneLite's Quest Helper saw 8, 9, 10 for proboscis, jangerberries and potato
// cactus, the wiki's 9th to 11th).
[fairy1_nature_items]
inputtype=int
outputtype=namedobj
val=0,white_berries
val=1,mortmyrepear
val=2,mortmyrebuddingstem
val=3,mortmyremushroom
val=4,nature_talisman
val=5,avantoe
val=6,irit_leaf
val=7,blue_dragon_scale
val=8,mosquito_proboscis
val=9,jangerberries
val=10,cactus_potato
val=11,crushed_gemstone
val=12,snapdragon
val=13,bucket_supercompost
val=14,volencia_moss
val=15,babydragon_bones
val=16,uncut_diamond
val=17,raw_cave_eel
val=18,edible_seaweed
val=19,oystershell
val=20,charcoal
val=21,red_vine_worm
val=22,snail_corpse3
val=23,red_spiders_eggs
val=24,mort_slimey_eel
val=25,grapes
val=26,uncut_ruby
val=27,tbwt_jogre_bones
val=28,king_worm
val=29,snape_grass
val=30,lime
