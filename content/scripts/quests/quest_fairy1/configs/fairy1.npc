// Frizzy Skernip, the gnome gardener who looks after the spirit tree patch in Port Sarim. He came
// in July 2006 (Lunar Diplomacy), a little after our cache, but his patch is already on our map;
// he is from the August 2007 cache (build 468, npc 4560), whose definition uses the same models
// and chathead as our cache's unnamed gnome "Gardener" (npc_2328). The 2007 recolours don't fit
// our older copy of the body model, so he keeps npc_2328's colours (our choice).
[frizzy_skernip]
name=Frizzy Skernip
desc=Perhaps this gardener might look after your crops for you.
model1=npc_2328
model2=npc_leprechaun
model3=npc_gnometrainer
recol1s=416
recol1d=13699
recol2s=384
recol2d=11584
recol3s=352
recol3d=10528
recol4s=13728
recol4d=6274
walkanim=midget_walk
readyanim=midget_ready
vislevel=hide
op1=Talk-to
head1=obj_pickpocket_guide_gnome
