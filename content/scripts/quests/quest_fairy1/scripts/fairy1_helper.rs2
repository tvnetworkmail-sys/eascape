// Quest Helper: which step of A Fairy Tale Pt. 1 you're on (fairy1_helper.dbrow), from
// %fairy_farmers_quest, your items and where you are (RuneLite's FairytaleI.java).
[proc,questhelper_fairy1]()(int)
def_int $s = %fairy_farmers_quest;
def_boolean $zanaris = inzone(0_37_68_0_1, 0_38_69_63_63, coord);
switch_int ($s) {
    case ^fairy1_not_started : return(1);
    case ^fairy1_gardeners :
        if (~fairy1_gardeners_asked >= ^fairy1_gardeners_needed) return(7);
        // Quest Helper's five, one at a time, skipping any you've asked (fairy1_gardener_bit)
        if (testbit(%fairy_gardeners, 20) = ^false) return(2); // Frizzy Skernip
        if (testbit(%fairy_gardeners, 0) = ^false) return(3); // Elstan
        if (testbit(%fairy_gardeners, 17) = ^false) return(4); // Heskel
        if (testbit(%fairy_gardeners, 18) = ^false) return(5); // Treznor
        return(6); // Dreven
    case ^fairy1_godfather :
        if ($zanaris = true) return(9);
        return(8);
    case ^fairy1_nuff :
        if ($zanaris = true) return(10);
        return(8);
    case ^fairy1_zandar : return(11);
    case ^fairy1_malignius :
        if (~obj_gettotal(fairy_skull) > 0) return(13);
        if (testbit(%fairy_gardeners, ^fairy1_malignius_asked) = ^false) return(13);
        return(12);
    case ^fairy1_grotto :
        if (inzone(1_53_152_43_5, 1_53_152_56_18, coord) = true) return(15);
        return(14);
    case ^fairy1_tanglefoot :
        if (inzone(0_37_68_0_1, 0_37_68_30_47, coord) = true) return(18);
        if ($zanaris = true) return(17);
        return(16);
    case ^fairy1_return :
        if ($zanaris = true) return(19);
        return(16);
}
return(0);
