[proc,qh_druidspirit_c1]()(boolean)
if (inzone(0_53_152_43_5, 0_53_152_56_18, coord) = true) return(true);
return(false);

[proc,qh_druidspirit_c2]()(boolean)
if (npc_find(coord, filliman_tarlock_ns, 15, 0) = true) return(true);
return(false);

[proc,qh_druidspirit_c3]()(boolean)
if (~qh_druidspirit_c1 = false) return(false);
if (~qh_druidspirit_c2 = false) return(false);
return(true);

[proc,qh_druidspirit_c4]()(boolean)
if (npc_find(coord, ghast_vis, 15, 0) = true) return(true);
return(false);

[proc,qh_druidspirit_c5]()(boolean)
if (calc(inv_total(inv, druid_pouch) + inv_total(worn, druid_pouch)) >= 1) return(true);
return(false);

[proc,qh_druidspirit_c6]()(boolean)
if (npc_find(coord, filliman_tarlock_spirit, 15, 0) = true) return(true);
return(false);

[proc,qh_druidspirit_c7]()(boolean)
if (~qh_druidspirit_c1 = false) return(false);
if (~qh_druidspirit_c6 = false) return(false);
return(true);

[proc,qh_druidspirit_c8]()(boolean)
if (inzone(0_53_52_48_7, 0_53_52_48_7, coord) = true) return(true);
return(false);

[proc,qh_druidspirit_c9]()(boolean)
if (calc(inv_total(inv, mortmyremushroom) + inv_total(worn, mortmyremushroom)) >= 1) return(true);
return(false);

[proc,qh_druidspirit_c10]()(boolean)
if (inzone(0_53_154_10_24, 0_53_154_51_51, coord) = true) return(true);
return(false);

[proc,qh_druidspirit_c11]()(boolean)
if (calc(inv_total(inv, filliman_journal) + inv_total(worn, filliman_journal)) >= 1) return(true);
return(false);

[proc,qh_druidspirit_c12]()(boolean)
if (~qh_druidspirit_c11 = false) return(false);
if (~qh_druidspirit_c6 = false) return(false);
return(true);

[proc,qh_druidspirit_c13]()(boolean)
if (calc(inv_total(inv, mirror) + inv_total(worn, mirror)) >= 1) return(true);
return(false);

[proc,qh_druidspirit_c14]()(boolean)
if (~qh_druidspirit_c13 = false) return(false);
if (~qh_druidspirit_c6 = false) return(false);
return(true);
