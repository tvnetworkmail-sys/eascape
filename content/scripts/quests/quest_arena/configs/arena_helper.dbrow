[questhelper_step_arena_1]
table=questhelper_step
data=id,9001
data=section,0
data=text,"Talk to Lady Servil, west-southwest of the Monastery south of Ardougne."
data=coord,0_40_49_5_63
data=option,Yes.

[questhelper_step_arena_2]
table=questhelper_step
data=id,9002
data=section,0
data=text,Search the chest to the east for some Khazard armour.
data=loc,arena_guard_chest_shut
data=coord,0_40_49_53_53

[questhelper_step_arena_3]
table=questhelper_step
data=id,9003
data=section,0
data=text,"Equip Khazard armour, talk to the Khazard Guard in the southeast of the prison."
data=npc,arena_guard2
data=coord,0_40_49_55_7

[questhelper_step_arena_4]
table=questhelper_step
data=id,9004
data=section,0
data=text,Buy Khali brew from the nearby bar to the west for 5 coins.
data=npc,khazard_barman
data=coord,0_40_49_7_4
data=option,I'd like a Khali Brew please.
data=item,coins,5

[questhelper_step_arena_5]
table=questhelper_step
data=id,9005
data=section,0
data=text,Take the brew back to the Khazard Guard.
data=npc,arena_guard2
data=coord,0_40_49_55_7
data=item,khali_brew,1

[questhelper_step_arena_6]
table=questhelper_step
data=id,9006
data=section,1
data=text,Get another set of keys from the Khazard Guard
data=npc,arena_guard2
data=coord,0_40_49_55_7

[questhelper_step_arena_7]
table=questhelper_step
data=id,9007
data=section,1
data=text,"Get ready to fight the monsters (all safespottable), starting with Khazard Ogre (level 63). Use the keys on Sammy's cell door to free him."
data=loc,arena_jeremydoor
data=coord,0_40_49_57_31
data=item,khazard_cellkeys,1

[questhelper_step_arena_8]
table=questhelper_step
data=id,9008
data=section,1
data=text,Kill the Ogre. You can lure it behind a skeleton to safespot it.
data=npc,arena_ogre
data=coord,0_40_49_41_27

[questhelper_step_arena_9]
table=questhelper_step
data=id,9009
data=section,1
data=text,"Talk to Sammy, then fight the ogre."
data=coord,0_40_49_42_17

[questhelper_step_arena_10]
table=questhelper_step
data=id,9010
data=section,1
data=text,Talk to Hengrad.
data=npc,hengrad
data=coord,0_40_49_39_7

[questhelper_step_arena_11]
table=questhelper_step
data=id,9011
data=section,1
data=text,Talk to General Khazard.
data=coord,0_40_49_45_17

[questhelper_step_arena_12]
table=questhelper_step
data=id,9012
data=section,1
data=text,Kill the Scorpion. You can lure it behind a skeleton to safespot it.
data=npc,arena_scorpion
data=coord,0_40_49_41_27

[questhelper_step_arena_13]
table=questhelper_step
data=id,9013
data=section,1
data=text,"Talk to Sammy, then fight the scorpion."
data=coord,0_40_49_42_17

[questhelper_step_arena_14]
table=questhelper_step
data=id,9014
data=section,1
data=text,"Kill Bouncer. You can lure it behind a skeleton to safespot it. Warning: After Bouncer is killed, you will be unable to re-enter the arena."
data=npc,arena_bouncer
data=coord,0_40_49_41_27

[questhelper_step_arena_15]
table=questhelper_step
data=id,9015
data=section,1
data=text,"Talk to Sammy, then fight Bouncer."
data=coord,0_40_49_42_17

[questhelper_step_arena_16]
table=questhelper_step
data=id,9016
data=section,2
data=text,Exit the arena (can ignore General Khazard). Warning: You will be unable to re-enter the arena.
data=loc,fightarena_door2
data=coord,0_40_49_46_16
data=option,Yes.

[questhelper_step_arena_17]
table=questhelper_step
data=id,9017
data=section,2
data=text,Go back to Lady Servil to end the quest.
data=coord,0_40_49_5_63
