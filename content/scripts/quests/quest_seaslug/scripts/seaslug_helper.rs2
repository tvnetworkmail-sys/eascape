[proc,qh_seaslug_c1]()(boolean)
if (inzone(0_43_51_8_7, 0_43_51_43_29, coord) = true) return(true);
return(false);

[proc,qh_seaslug_c2]()(boolean)
if (inzone(1_43_51_8_7, 1_43_51_43_29, coord) = true) return(true);
return(false);

[proc,qh_seaslug_c3]()(boolean)
if (calc(inv_total(inv, torch_lit) + inv_total(worn, torch_lit)) >= 1) return(true);
return(false);

[proc,qh_seaslug_c4]()(boolean)
if (calc(inv_total(inv, torch_unlit) + inv_total(worn, torch_unlit)) >= 1) return(true);
return(false);

[proc,qh_seaslug_c5]()(boolean)
if (calc(inv_total(inv, dry_sticks) + inv_total(worn, dry_sticks)) >= 1) return(true);
return(false);

[proc,qh_seaslug_c6]()(boolean)
if (~qh_seaslug_c4 = false) return(false);
if (~qh_seaslug_c5 = false) return(false);
return(true);

[proc,qh_seaslug_c7]()(boolean)
if (calc(inv_total(inv, broken_glass) + inv_total(worn, broken_glass)) >= 1) return(true);
return(false);

[proc,qh_seaslug_c8]()(boolean)
if (calc(inv_total(inv, damp_sticks) + inv_total(worn, damp_sticks)) >= 1) return(true);
return(false);

[proc,qh_seaslug_c9]()(boolean)
if (~qh_seaslug_c4 = false) return(false);
if (~qh_seaslug_c7 = false) return(false);
if (~qh_seaslug_c8 = false) return(false);
return(true);

[proc,qh_seaslug_c10]()(boolean)
if (~qh_seaslug_c4 = false) return(false);
if (~qh_seaslug_c7 = false) return(false);
return(true);

[proc,qh_seaslug_c11]()(boolean)
if (inzone(1_43_51_8_7, 1_43_51_43_29, coord) = true | inzone(0_43_51_8_7, 0_43_51_43_29, coord) = true) return(true);
return(false);

[proc,qh_seaslug_c12]()(boolean)
if (inzone(0_43_51_35_48, 0_43_51_50_63, coord) = true) return(true);
return(false);
