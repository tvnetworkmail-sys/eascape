[questhelper_step_desertrescue_1]
table=questhelper_step
data=id,701
data=section,0
data=text,Talk to Irena by the Shantay Pass and offer to find her daughter Ana.
data=npc,irena
data=coord,0_51_48_39_41
data=option,What's the matter?
data=option,Is there a reward if I get her back?
data=option,"Okay Irena, calm down. I'll get your daughter back for you."

[questhelper_step_desertrescue_2]
table=questhelper_step
data=id,702
data=section,0
data=text,Go south into the desert and talk to the Mercenary Captain outside the mining camp.
data=npc,desertminingcaptain
data=coord,0_51_47_6_21

[questhelper_step_desertrescue_3]
table=questhelper_step
data=id,703
data=section,0
data=text,Kill the Mercenary Captain (level 47) for his metal key.
data=npc,desertminingcaptain
data=coord,0_51_47_6_21

[questhelper_step_desertrescue_4]
table=questhelper_step
data=id,704
data=section,0
data=text,Take off all armour and weapons and open the camp gate with the metal key.
data=loc,miningcampgateclosedl
data=coord,0_51_47_9_21
data=item,metal_key,1

[questhelper_step_desertrescue_5]
table=questhelper_step
data=id,705
data=section,1
data=text,Talk to the male slave in the camp and offer to undo his chains.
data=npc,mining_slave_male
data=coord,0_51_47_38_22
data=option,I've just arrived.
data=option,"Oh yes, that sounds interesting."
data=option,What's that then?
data=option,I can try to undo them for you.
data=option,It's funny you should say that...
data=option,"Yeah, okay, let's give it a go."

[questhelper_step_desertrescue_6]
table=questhelper_step
data=id,706
data=section,1
data=text,Talk to the slave again to pick the lock on his chains.
data=npc,mining_slave_male
data=coord,0_51_47_38_22
data=option,"Yeah, okay, let's give it a go."
data=option,Yeah I'll give it another go.

[questhelper_step_desertrescue_7]
table=questhelper_step
data=id,707
data=section,1
data=text,"With your desert shirt, robe and boots, talk to the slave and trade clothes with him."
data=npc,mining_slave_male
data=coord,0_51_47_38_22
data=option,"Yes, I'll trade."
data=item,desert_shirt,1
data=item,desert_robe,1
data=item,desert_boots,1

[questhelper_step_desertrescue_8]
table=questhelper_step
data=id,708
data=section,1
data=text,"Wear the slave's shirt, robe and boots and go through the mine doors in the north-east of the camp."
data=loc,thttmineentrancel
data=coord,0_51_47_37_28

[questhelper_step_desertrescue_9]
table=questhelper_step
data=id,709
data=section,1
data=text,Talk to the guard in the mine and ask to mine somewhere else.
data=npc,desertminingmercenary2
data=coord,0_51_147_15_6
data=option,I'd like to mine in a different area.
data=option,"Yes sir, you're quite right sir."

[questhelper_step_desertrescue_10]
table=questhelper_step
data=id,710
data=section,1
data=text,Leave the mine by the doors.
data=loc,thttmineexitl
data=coord,0_51_147_14_18

[questhelper_step_desertrescue_11]
table=questhelper_step
data=id,711
data=section,2
data=text,"Talk to Al Shabim in the Bedabin Camp, north-west of the mining camp, about a pineapple."
data=npc,al_shabim
data=coord,0_49_47_35_17
data=option,I am looking for a pineapple.
data=option,"Yes, I'm interested."

[questhelper_step_desertrescue_12]
table=questhelper_step
data=id,712
data=section,2
data=text,Climb the ladder in the camp's north building and search Captain Siad's bookcase.
data=loc,capt_siad_bookcase
data=coord,1_51_47_20_24

[questhelper_step_desertrescue_13]
table=questhelper_step
data=id,713
data=section,2
data=text,Talk to Captain Siad about sailing to distract him.
data=npc,capt_siad
data=coord,1_51_47_27_24
data=option,I wanted to have a chat?
data=option,You seem to have a lot of books!
data=option,"So, you're interested in sailing?"
data=option,I could tell by the cut of your jib.

[questhelper_step_desertrescue_14]
table=questhelper_step
data=id,714
data=section,2
data=text,"While he is distracted, use the Bedobin copy key on his chest."
data=loc,captain_siads_chest_closed
data=coord,1_51_47_28_25
data=item,thbedobinkey,1

[questhelper_step_desertrescue_15]
table=questhelper_step
data=id,715
data=section,2
data=text,Show the plans to Al Shabim in the Bedabin Camp (bring the bronze bar and feathers).
data=npc,al_shabim
data=coord,0_49_47_35_17
data=option,"Yes, I'm very interested."
data=option,"Yes, I'm kind of curious."
data=item,thcaptplans,1
data=item,bronze_bar,1
data=item,feather,10

[questhelper_step_desertrescue_16]
table=questhelper_step
data=id,716
data=section,2
data=text,Talk to the Bedabin guard by the big tent to be let in.
data=npc,bedabin_guard
data=coord,0_49_47_34_37
data=item,thcaptplans,1

[questhelper_step_desertrescue_17]
table=questhelper_step
data=id,717
data=section,2
data=text,Use the bronze bar on the anvil in the tent (you need a hammer).
data=loc,experimental_anvil
data=coord,0_49_47_35_40
data=item,bronze_bar,1
data=item,hammer,1

[questhelper_step_desertrescue_18]
table=questhelper_step
data=id,718
data=section,2
data=text,Use the feathers on the prototype dart tip (it can take a few tries).
data=coord,0_49_47_35_40
data=item,thprotodarttip,1
data=item,feather,10

[questhelper_step_desertrescue_19]
table=questhelper_step
data=id,719
data=section,2
data=text,Give the prototype dart to Al Shabim.
data=npc,al_shabim
data=coord,0_49_47_35_17
data=item,thprotodart,1

[questhelper_step_desertrescue_20]
table=questhelper_step
data=id,720
data=section,2
data=text,"Back in the mine, give the Tenti pineapple to the guard."
data=npc,desertminingmercenary2
data=coord,0_51_147_15_6
data=item,tentipineapple,1

[questhelper_step_desertrescue_21]
table=questhelper_step
data=id,721
data=section,3
data=text,Take an empty barrel from near the mine cart.
data=loc,thminebarrel_empty
data=coord,0_51_147_39_7

[questhelper_step_desertrescue_22]
table=questhelper_step
data=id,722
data=section,3
data=text,Squeeze into the mine cart to get deeper into the mine.
data=loc,touristtrap_minecart
data=coord,0_51_147_39_9
data=item,thminebarrel_empty,1

[questhelper_step_desertrescue_23]
table=questhelper_step
data=id,723
data=section,3
data=text,Find Ana in the deep mine and use the empty barrel on her.
data=npc,ana
data=coord,0_51_147_38_58
data=item,thminebarrel_empty,1

[questhelper_step_desertrescue_24]
table=questhelper_step
data=id,724
data=section,3
data=text,Use the barrel with Ana in it on the mine cart.
data=loc,touristtrap_minecart
data=coord,0_51_147_54_22
data=item,thanainabarrel,1

[questhelper_step_desertrescue_25]
table=questhelper_step
data=id,725
data=section,3
data=text,Squeeze into the mine cart to go back.
data=loc,touristtrap_minecart
data=coord,0_51_147_54_22

[questhelper_step_desertrescue_26]
table=questhelper_step
data=id,726
data=section,3
data=text,Search the barrels by the mine cart for Ana.
data=loc,thminebarrel_empty
data=coord,0_51_147_39_7

[questhelper_step_desertrescue_27]
table=questhelper_step
data=id,727
data=section,3
data=text,Use Ana's barrel on the lift and get the guard to send it up.
data=loc,ropepullthingy2
data=coord,0_51_147_28_15
data=item,thanainabarrel,1

[questhelper_step_desertrescue_28]
table=questhelper_step
data=id,728
data=section,3
data=text,Leave the mine and operate the lift winch in the camp.
data=loc,ropepullthingy
data=coord,0_51_47_15_9

[questhelper_step_desertrescue_29]
table=questhelper_step
data=id,729
data=section,3
data=text,Search the barrel by the lift for Ana.
data=loc,thminebarrel_full
data=coord,0_51_47_14_9

[questhelper_step_desertrescue_30]
table=questhelper_step
data=id,730
data=section,3
data=text,Use Ana's barrel on the mine cart in the camp.
data=loc,loc_2682
data=coord,0_51_47_23_15
data=item,thanainabarrel,1

[questhelper_step_desertrescue_31]
table=questhelper_step
data=id,731
data=section,3
data=text,Talk to the mine cart driver and get him to take you out (or pay him 100 coins).
data=npc,mining_cart_driver
data=coord,0_51_47_23_14
data=option,"You can't leave me here, I'll get killed!"
data=option,A hundred it is!

[questhelper_step_desertrescue_32]
table=questhelper_step
data=id,732
data=section,3
data=text,Get on the mine cart.
data=loc,loc_2682
data=coord,0_51_47_23_15
data=option,"Yes, I'll get on."

[questhelper_step_desertrescue_33]
table=questhelper_step
data=id,733
data=section,3
data=text,Take Ana (in her barrel) to Irena by the Shantay Pass.
data=npc,irena
data=coord,0_51_48_39_41
data=item,thanainabarrel,1

[questhelper_step_desertrescue_34]
table=questhelper_step
data=id,734
data=section,3
data=text,Talk to Irena to pick your two experience rewards.
data=npc,irena
data=coord,0_51_48_39_41

[questhelper_step_desertrescue_35]
table=questhelper_step
data=id,735
data=section,4
data=text,You've been caught and thrown in a cell: search the window to bend its bars and climb out.
data=loc,cell_escape_window
data=coord,0_51_47_20_24

[questhelper_step_desertrescue_36]
table=questhelper_step
data=id,736
data=section,4
data=text,You've been thrown in the mine's cell: mine 15 rocks and give them to the guard at the gate.
data=loc,undergroundcellgatel
data=coord,0_51_147_28_27
