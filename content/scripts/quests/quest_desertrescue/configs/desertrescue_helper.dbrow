data=name,The Tourist Trap
data=journal,Tourist Trap
data=difficulty,Intermediate
data=start,"Talk to Irena by the Shantay Pass, south of Al Kharid."
data=required,desert_shirt,1
data=required,desert_robe,1
data=required,desert_boots,1
data=required,bronze_bar,1
data=required,hammer,1
data=required,feather,10
data=recommended,coins,100
data=skill,Level 10 Fletching
data=skill,Level 20 Smithing
data=skill,Waterskins for the desert
data=skill,No armour or weapons inside the mining camp
