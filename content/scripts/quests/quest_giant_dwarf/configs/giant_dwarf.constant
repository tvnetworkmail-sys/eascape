// The Giant Dwarf: its stage is the cache's own %giantdwarf_quest (varbit 571 on giantdwarf_main,
// which the all.varp entry keeps). The stage values are ours (no source numbers them); the steps are
// the OSRS wiki's walkthrough and transcript.
^gd_not_started = 0
^gd_arrested = 10
^gd_veldaban = 20
^gd_items = 30
^gd_items_given = 40
^gd_consortium = 50
^gd_support = 60
^gd_complete = 100
^gd_questpoints = 2

// %gd_flags bits (ours)
^gdf_vermundi = 0
^gdf_librarian_clothes = 1
^gdf_machine_loaded = 2
^gdf_machine_lit = 3
^gdf_saro = 4
^gdf_dromund = 5
^gdf_santiri = 6
^gdf_librarian_imcando = 7
^gdf_reldo = 8
^gdf_thurgo_fixed = 9
^gdf_ham_bonus = 10
^gdf_meeting_notes = 11

// the companies, numbered as the cache's statue heads are (dwarf_stat_head_company1-7, loc ids
// 7033-7039, which the OSRS wiki's Giant Dwarf (statue) page names in this order)
^gd_purple_pewter = 1
^gd_yellow_fortune = 2
^gd_blue_opal = 3
^gd_green_gemstone = 4
^gd_white_chisel = 5
^gd_silver_cog = 6
^gd_brown_engine = 7
// ours: the head multiloc has no entry this high, so the statue has no head while it is rebuilt
^gd_no_head = 15

// the Consortium's points (the OSRS wiki: 20 for each secretary errand, 12 for each director
// errand, -2 for failing or turning one down; the director at 75, joining at 100)
^gd_secretary_points = 20
^gd_director_points = 12
^gd_fail_points = 2
^gd_director_at = 75
^gd_join_at = 100
// ours: below this the secretaries and directors use their "zero or few tasks" words
^gd_few_points = 40

// ours: 1 keeps the 2005 rules (the Brown Engine takes only men, the Yellow Fortune only women,
// the OSRS wiki's "before 9 November 2022" transcript); 0 lets anyone join either
^gd_2005_company_rules = 1
