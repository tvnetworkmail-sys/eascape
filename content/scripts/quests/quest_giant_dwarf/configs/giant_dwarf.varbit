// EASCape: ours. The Consortium points, 7 bits each (up to 127).
[gd_points_1]
basevar=gd_points_a
startbit=0
endbit=6

[gd_points_2]
basevar=gd_points_a
startbit=7
endbit=13

[gd_points_3]
basevar=gd_points_a
startbit=14
endbit=20

[gd_points_4]
basevar=gd_points_a
startbit=21
endbit=27

[gd_points_5]
basevar=gd_points_b
startbit=0
endbit=6

[gd_points_6]
basevar=gd_points_b
startbit=7
endbit=13

[gd_points_7]
basevar=gd_points_b
startbit=14
endbit=20

// EASCape: ours. The errand: 1-8 the ores and clay, 9-14 the bars (gd_consortium.rs2)
[gd_task_item]
basevar=gd_task
startbit=0
endbit=4

[gd_task_count]
basevar=gd_task
startbit=5
endbit=7

[gd_task_company]
basevar=gd_task
startbit=8
endbit=11

[gd_task_director]
basevar=gd_task
startbit=12
endbit=12
