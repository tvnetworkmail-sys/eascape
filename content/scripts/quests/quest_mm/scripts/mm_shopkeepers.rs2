[opnpc3,mm_daga]
if(~mm_wearing_greegree = false) {
    ~aa_summon_guards(^true);
    if(inv_total(worn, mm_amulet_of_monkey_speak) = 0) {
        ~mm_monkeyspeak;
    } else {
        ~chatnpc("<p,neutral>Guards! Guards! Remove this human!");
    }
    return;
}
~mm_daga_shop;

// EASCape: once Monkey Madness is done, Daga's stock has the dragon scimitar (4, restocking);
// before that it isn't on sale (OSRS wiki, Daga's Scimitar Smithy: "0 stock" until then).
// mm_scimitar_shop2 is Lost City's second stock; nothing opened it before.
[proc,mm_daga_shop]
if (%mm_main >= ^mm_complete) {
    ~openshop(mm_scimitar_shop2, npc_param(shop_buy_multiplier), npc_param(shop_sell_multiplier), npc_param(shop_delta), npc_param(shop_title));
    return;
}
~openshop_activenpc;

