// EASCape: Quest Helper for Underground Pass, converted from RuneLite's Quest Helper (undergroundpass, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC CAVEGUIDE_VIS not matched
//   NPC CAVEWITCHCAT_VIS not matched
//   NPC DOOMION_VIS not matched
//   NPC HOLTHION_VIS not matched
//   NPC IBANMONK_VIS not matched
//   NPC KALRAG_VIS not matched
//   NPC KINGLATHAS_VIS not matched
//   NPC OTHAINIAN_VIS not matched
//   NPC UPASS_PALADIN1_VIS not matched
//   NPC UPASS_PALADIN2_VIS not matched
//   NPC UPASS_PALADIN3_VIS not matched

[proc,questhelper_upass]()(int)
def_int $v = %upass;
if ($v > 0) {
    return(0); // done
}
return(1);
