[proc,questhelper_prince]()(int)
def_int $v = %princequest;
if ($v > 100) {
    return(0); // done
}
if ($v >= 100) {
    return(14);
}
if ($v >= 50) {
    if (~qh_prince_c6 = true) {
        return(13);
    }
    if (~qh_prince_c4 = true) {
        return(12);
    }
    if (~qh_prince_c7 = true) {
        return(9);
    }
    if (~qh_prince_c1 = true) {
        return(5);
    }
    if (~qh_prince_c8 = true) {
        return(4);
    }
    return(3);
}
if ($v >= 40) {
    if (~qh_prince_c4 = true) {
        return(11);
    }
    if (~qh_prince_c7 = true) {
        return(9);
    }
