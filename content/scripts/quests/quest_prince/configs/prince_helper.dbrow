[questhelper_guide_prince]
table=questhelper_guide
data=guide,^qh_prince
data=key,prince
data=name,Prince Ali Rescue
data=journal,The Rescue Of Prince Ali
data=section,Starting off
data=section,Make a blonde wig
data=section,Make paste
data=section,Make a key print
data=section,Make the key
data=section,Return with the items
data=section,Free Ali
data=section,Return to Al Kharid

[questhelper_step_prince_1]
table=questhelper_step
data=id,50001
data=section,0
data=text,Talk to Hassan in the Al Kharid Palace.
data=npc,hassan
data=coord,0_51_49_34_27
data=option,Is there anything I can help you with?
data=option,Yes.

[questhelper_step_prince_2]
table=questhelper_step
data=id,50002
data=section,0
data=text,Talk to Osman north of the Al Kharid Palace.
data=npc,osman
data=coord,0_51_49_22_44

[questhelper_step_prince_3]
table=questhelper_step
data=id,50003
data=section,1
data=text,Have Ned in Draynor Village make you a wig from 3 balls of wool. He can also sell you a rope for 15 coins via dialogue (or bought from his shop for 18 coins) or 4 balls of wool.
data=npc,ned
data=coord,0_48_50_25_57
data=option,Could you make other things apart from rope?
data=option,How about some sort of wig?
data=option,I have them here. Please make me a wig.
data=item,ball_of_wool,3

[questhelper_step_prince_4]
table=questhelper_step
data=id,50004
data=section,1
data=text,Dye the wig with yellow dye. Buy a yellow dye with two onions and 5 coins if you still need it from Aggie in Draynor Village.
data=item,yellowdye,1
data=item,plainwig,1

[questhelper_step_prince_5]
table=questhelper_step
data=id,50005
data=section,2
data=text,Talk to Aggie in Draynor Village to get some paste.
data=coord,0_48_50_14_57
data=option,Can you make skin paste?
data=option,Yes please. Mix me some skin paste.
data=item,redberries,1
data=item,ashes,1
data=item,pot_flour,1
data=item,bucket_water,1

[questhelper_step_prince_6]
table=questhelper_step
data=id,50006
data=section,3
data=text,"Talk to Keli in the jail east of Draynor Village. If you've already made the key print, open the quest journal to re-sync."
data=coord,0_48_50_55_44
data=option,Heard of you? You're famous in Gielinor!
data=option,What's your latest plan then?
data=option,How do you know someone won't try to free him?
data=option,Could I see the key please?
data=option,Could I touch the key for a moment please?
data=item,softclay,1

[questhelper_step_prince_7]
table=questhelper_step
data=id,50007
data=section,4
data=text,Use the key print on any furnace with a bronze bar in your inventory to make a key.
data=coord,0_50_50_27_56
data=item,bronze_bar,1

[questhelper_step_prince_8]
table=questhelper_step
data=id,50008
data=section,5
data=text,Talk to Leela east of Draynor Village.
data=npc,leela
data=coord,0_48_50_41_62
data=item,beer,3
data=item,blondwig,1
data=item,skinpaste,1
data=item,rope,1
data=item,pink_skirt,1

[questhelper_step_prince_9]
table=questhelper_step
data=id,50009
data=section,5
data=text,Talk to Leela east of Draynor Village for another key. It'll cost 15gp.
data=npc,leela
data=coord,0_48_50_41_62

[questhelper_step_prince_10]
table=questhelper_step
data=id,50010
data=section,6
data=text,Bring everything to the jail and give Joe there three beers.
data=coord,0_48_50_52_45
data=option,I have some beer here. Fancy one?
data=item,beer,3
data=item,princeskey,1
data=item,blondwig,1
data=item,skinpaste,1
data=item,rope,1
data=item,pink_skirt,1

[questhelper_step_prince_11]
table=questhelper_step
data=id,50011
data=section,6
data=text,Use rope on Keli.
data=coord,0_48_50_55_44
data=item,rope,1

[questhelper_step_prince_12]
table=questhelper_step
data=id,50012
data=section,6
data=text,Use the key on the prison door. If Lady Keli respawned you'll need to tie her up again.
data=loc,alidoor
data=coord,0_48_50_51_43
data=item,princeskey,1
data=item,blondwig,1
data=item,skinpaste,1
data=item,pink_skirt,1

[questhelper_step_prince_13]
table=questhelper_step
data=id,50013
data=section,6
data=text,Talk to Prince Ali and free him.
data=coord,0_48_50_51_40
data=item,princeskey,1
data=item,blondwig,1
data=item,skinpaste,1
data=item,pink_skirt,1

[questhelper_step_prince_14]
table=questhelper_step
data=id,50014
data=section,7
data=text,Return to Hassan in the Al Kharid Palace to complete the quest.
data=npc,hassan
data=coord,0_51_49_34_27
