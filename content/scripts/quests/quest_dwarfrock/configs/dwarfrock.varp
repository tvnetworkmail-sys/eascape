// EASCape: which of Rolad's three book pages you have found, bits 0-2 (dwarfrock_step1.rs2)
[bar_pages]
scope=perm

// EASCape: the schematic puzzle (dwarfrock_schematic.rs2): each overlay's rotation (2 bits each),
// its offset (4 bits x, 4 bits y each, stored +7), and the Select (bits 0-2) and Show (bits 3-5)
// ticks, bit 6 once laid out
[bar_schem_rot]
scope=perm

[bar_schem_pos]
scope=perm

[bar_schem_flags]
scope=perm
