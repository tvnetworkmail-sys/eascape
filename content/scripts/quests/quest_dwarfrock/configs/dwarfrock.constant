// Between a Rock...: the stages of %dwarfrock_quest (varbit, bits 0-7 of varp dwarfrock_main).
// The cache's Dondakan multinpc changes at 0-100 in tens and 110 (quest done); the meaning of each
// value below is ours.
^bar_not_started = 0
^bar_started = 10
^bar_find_rolad = 20
^bar_find_pages = 30
^bar_have_book = 40
^bar_read_book = 50
^bar_need_material = 60
^bar_find_schematics = 70
^bar_inside = 80
^bar_avatar_dead = 90
^bar_complete = 110
^bar_questpoints = 2
