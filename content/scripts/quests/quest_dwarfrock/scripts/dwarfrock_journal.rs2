// EASCape: Between a Rock...'s journal. Ours: no source has its journal text, so these lines say
// what the OSRS wiki's walkthrough has you do next.
[if_button,questlist:dwarfrock]
def_int $s = %dwarfrock_quest;
if ($s = ^bar_not_started) {
    ~quest_journal("Between a Rock...", "@dbl@I can start this quest by talking to @dre@Dondakan the Dwarf@dbl@ in|@dbl@the mines south of @dre@Keldagrim@dbl@, across the river from the|@dre@Dwarven Ferryman@dbl@.|@dbl@I will need to have completed @dre@Dwarf Cannon@dbl@ and @dre@Fishing|@dre@Contest@dbl@, and have level @dre@30 Defence@dbl@, @dre@40 Mining@dbl@ and|@dre@50 Smithing@dbl@.");
    return;
}
def_string $t = "@str@Dondakan has been trying to break open an impenetrable|@str@rock, and asked me to find out more about it.||";
def_string $next;
if ($s = ^bar_started) {
    $next = "@dbl@I should ask around in @dre@Keldagrim@dbl@; the @dre@librarian@dbl@ knows a lot.";
} else if ($s = ^bar_find_rolad) {
    $next = "@dbl@The @dre@Dwarven Engineer@dbl@ says @dre@Rolad@dbl@, a scholar, is with the Black|@dbl@Guard at @dre@Ice Mountain@dbl@.";
} else if ($s = ^bar_find_pages) {
    $next = "@dbl@Rolad lost three pages of a book about the rock in the|@dre@Dwarven Mine@dbl@ below Ice Mountain. I have found @dre@<tostring(~bar_pages_held)>@dbl@ of them.";
} else if ($s = ^bar_have_book) {
    $t = append($t, "@str@Rolad put his book back together for me.||");
    $next = "@dbl@I should read the @dre@dwarven lore@dbl@ book.";
} else if ($s = ^bar_read_book) {
    $t = append($t, "@str@Rolad put his book back together for me, and I read it.||");
    $next = "@dbl@I should tell @dre@Dondakan@dbl@ what I've learned.";
} else {
    $t = append($t, "@str@Rolad's book told of a demonic spirit inside the rock, and|@str@that the rock is lined with gold.||");
    if ($s >= ^bar_complete) {
        $t = append($t, "@str@Dondakan fired me into the rock, where I defeated the avatar|@str@of the Arzinian Being of Bordanzan.||");
        $next = "@red@QUEST COMPLETE!";
    } else if ($s = ^bar_avatar_dead) {
        $t = append($t, "@str@Inside the rock I defeated the Arzinian Avatar.||");
        $next = "@dbl@I should tell @dre@Dondakan@dbl@.";
    } else if ($s = ^bar_inside) {
        $t = append($t, "@str@Dondakan fired me into the rock. It is full of gold, and a|@str@spirit lives there.||");
        $next = "@dbl@I should go back in with my gold helmet on, mine some @dre@gold@dbl@|@dbl@(5 or more, better 15) and face the Being inside the flames|@dbl@at the centre before the helmet gets too heavy.";
    } else if ($s = ^bar_find_schematics) {
        $t = append($t, "@str@A golden cannonball passed right through the rock.||");
        $next = "@dbl@Dondakan wants to fire me through it. I need the @dre@schematics@dbl@|@dbl@to change his cannon (dwarven engineers might have parts, and|@dre@Rolad@dbl@ once worked on the cannon) and a @dre@gold helmet@dbl@ made|@dbl@from 3 gold bars.";
    } else {
        $next = "@dbl@Dondakan needs a new material for his cannonballs. Perhaps|@dre@gold@dbl@ would work, since the rock is lined with it.";
    }
}
~quest_journal("Between a Rock...", append($t, $next));
