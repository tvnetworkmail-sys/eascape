// EASCape: Quest Helper for Hazeel Cult, converted from RuneLite's Quest Helper (hazeelcult, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC ALOMONE_HAZEEL_CULTIST_1OP not matched
//   NPC ALOMONE_HAZEEL_CULTIST_2OP not matched
//   NPC CLIVET_HAZEEL_CULTIST_VIS not matched
//   NPC SIR_CERIL_CARNILLEAN_VIS not matched
//   VarbitRequirement ('field', ('name', 'VarbitID'), 'HAZEELCULT_CLIVET_LOCATION') not in our game
//   VarbitRequirement ('field', ('name', 'VarbitID'), 'HAZEELCULT_POISON_SUCCESS') not in our game
//   field not carried over

[proc,questhelper_hazeelcult]()(int)
def_int $v = %hazeelcultquest;
if ($v > 7) {
    return(0); // done
}
if ($v >= 7) {
    return(-1); // ('name', 'hazeelSteps')
}
if ($v >= 6) {
    return(-1); // ('name', 'hazeelSteps')
}
if ($v >= 5) {
    if (~qh_hazeelcult_c3 = true) {
        return(20);
    }
    if (~qh_hazeelcult_c5 = true) {
        return(24);
    }
    return(25);
}
if ($v >= 4) {
    if (~qh_hazeelcult_c6 = true) {
        if (~qh_hazeelcult_c5 = true) {
            return(16);
        }
        if (~qh_hazeelcult_c4 = true) {
            return(17);
        }
        return(18);
    }
    if (~qh_hazeelcult_c4 = true) {
        return(19);
    }
    return(2);
}
if ($v >= 3) {
    if (~qh_hazeelcult_c4 = true) {
        return(3);
    }
    return(2);
}
if ($v >= 2) {
    if (~qh_hazeelcult_c4 = true) {
        return(3);
    }
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);

[proc,qh_hazeelcult_c1]()(boolean)
if (inzone(0_40_151_40_2, 0_40_151_55_29, coord) = true) return(true);
return(false);

[proc,qh_hazeelcult_c2]()(boolean)
if (calc(inv_total(inv, mark_of_hazeel) + inv_total(worn, mark_of_hazeel)) >= 1) return(true);
return(false);

[proc,qh_hazeelcult_c3]()(boolean)
if (~qh_hazeelcult_c1 = false) return(false);
if (~qh_hazeelcult_c2 = false) return(false);
return(true);

[proc,qh_hazeelcult_c4]()(boolean)
if (inzone(0_40_151_5_15, 0_40_151_11_21, coord) = true) return(true);
return(false);

[proc,qh_hazeelcult_c5]()(boolean)
if (inzone(0_39_151_39_28, 0_39_151_54_39, coord) = true) return(true);
return(false);

[proc,qh_hazeelcult_c6]()(boolean)
if (calc(inv_total(inv, poison) + inv_total(worn, poison)) >= 1) return(true);
return(false);
