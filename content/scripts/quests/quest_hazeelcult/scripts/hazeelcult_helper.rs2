[proc,qh_hazeelcult_c1]()(boolean)
if (inzone(0_40_151_40_2, 0_40_151_55_29, coord) = true) return(true);
return(false);

[proc,qh_hazeelcult_c2]()(boolean)
if (calc(inv_total(inv, hazeel_scroll) + inv_total(worn, hazeel_scroll)) >= 1) return(true);
return(false);

[proc,qh_hazeelcult_c3]()(boolean)
if (~qh_hazeelcult_c2 = true) return(true);
return(false);

