data=id,34001
data=section,0
data=text,Talk to Ceril Carnillean in the south west of East Ardougne.
data=coord,0_40_51_9_11
data=option,What's wrong?
data=option,Yes.

[questhelper_step_hazeelcult_2]
table=questhelper_step
data=id,34002
data=section,0
data=text,Enter the cave south east of the Clock Tower entrance.
data=loc,hazeelcultcave
data=coord,0_40_50_27_35

[questhelper_step_hazeelcult_3]
table=questhelper_step
data=id,34003
data=section,0
data=text,Talk to Clivet. You can choose to either side with him or with the Carnilleans.
data=coord,0_40_151_9_18
data=option,"Alright, I've made my decision."
data=option,"Actually, I have no questions."
data=option,I have no more questions.
data=option,What do you mean?

