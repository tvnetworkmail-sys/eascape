// EASCape: Quest Helper for Sheep Shearer, converted from RuneLite's Quest Helper (sheepshearer, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC SHEEPUNSHEERED3G not matched

[proc,questhelper_sheep]()(int)
def_int $v = %sheep;
if ($v > 0) {
    return(0); // done
}
if ($v >= 0) {
    return(1);
}
return(1);
