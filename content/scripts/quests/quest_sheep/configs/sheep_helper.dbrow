[questhelper_guide_sheep]
table=questhelper_guide
data=guide,^qh_sheep
data=key,sheep
data=name,Sheep Shearer
data=journal,Sheep Shearer
data=section,Bring Fred Some Wool

[questhelper_step_sheep_1]
table=questhelper_step
data=id,57001
data=section,0
data=text,Talk to Fred the Farmer north of Lumbridge to start the quest. Bring 20 balls of wool to autocomplete the quest.
data=npc,fred_the_farmer
data=coord,0_49_51_54_9
data=option,I'm looking for a quest.
data=option,"Yes, okay. I can do that."
data=option,Yes.

[questhelper_step_sheep_2]
table=questhelper_step
data=id,57002
data=section,0
data=text,Pickup the shears in Fred's house.
data=coord,0_49_51_54_9

[questhelper_step_sheep_3]
table=questhelper_step
data=id,57003
data=section,0
data=text,Shear sheep in the nearby field.
data=npc,sheepunsheered3
data=npc,sheepunsheered
data=coord,0_50_51_1_4

[questhelper_step_sheep_4]
table=questhelper_step
data=id,57004
data=section,0
data=text,Climb the staircase in the Lumbridge Castle to spin the wool in your inventory into balls of wool.
data=coord,0_50_50_4_7

[questhelper_step_sheep_5]
table=questhelper_step
data=id,57005
data=section,0
data=text,Spin your wool into balls.
data=loc,spinningwheel
data=coord,1_50_50_9_12

[questhelper_step_sheep_6]
table=questhelper_step
data=id,57006
data=section,0
data=text,Climb down the staircase.
data=coord,1_50_50_4_7
data=option,Climb down the stairs.

[questhelper_step_sheep_7]
table=questhelper_step
data=id,57007
data=section,0
data=text,"Bring Fred the Farmer north of Lumbridge your balls of wool (UNNOTED) to progress the quest. If you only have some of the balls needed, you can still deposit them with him."
data=npc,fred_the_farmer
data=coord,0_49_51_54_9
data=option,I need to talk to you about shearing these sheep!
