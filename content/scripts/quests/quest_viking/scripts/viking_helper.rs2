// EASCape: Quest Helper for The Fremennik Trials, converted from RuneLite's Quest Helper (thefremenniktrials, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC VIKING_ASKELLADEN_NOROCKOP not matched
//   NPC VIKING_ASKELLADEN_ROCKOP not matched
//   NPC VIKING_BRUNDT_CHILD not matched
//   RuneliteRequirement not carried over

[proc,questhelper_viking]()(int)
def_int $v = %viking;
if ($v > 8) {
    return(0); // done
}
if ($v >= 8) {
    return(106);
}
if ($v >= 7) {
    return(112);
}
if ($v >= 6) {
    return(112);
}
if ($v >= 5) {
    return(112);
}
if ($v >= 4) {
    return(112);
}
if ($v >= 3) {
    return(112);
}
if ($v >= 2) {
    return(112);
}
if ($v >= 1) {
    return(112);
}
if ($v >= 0) {
    return(1);
}
return(1);
