// EASCape: Ghosts Ahoy. The 377 cache keeps the quest's own state in varbits of ahoy_varbits_1
// (made perm in all.varp); these are Void's other vars (ghosts_ahoy.vars.toml).
// the toy boat's flag colours as dyed (1 red, 2 yellow, 3 blue, 4 orange, 5 green, 6 purple)
[ahoy_toy_top]
scope=perm
[ahoy_toy_skull]
scope=perm
[ahoy_toy_bottom]
scope=perm
// the shipwreck mast's flag colours, chosen when the old crone gives you the toy boat
[ahoy_mast_top]
scope=perm
[ahoy_mast_skull]
scope=perm
[ahoy_mast_bottom]
scope=perm
// Runedraw with Robin, for this game only
[ahoy_rd_held]
[ahoy_rd_pturn]
[ahoy_rd_psum]
[ahoy_rd_rturn]
[ahoy_rd_rsum]
// 0 still playing (or resigned), 1 lost, 2 won
[ahoy_rd_outcome]
// the ghost villager asked last, so you can't ask the same one twice in a row
[ahoy_last_villager]
type=npc_uid
