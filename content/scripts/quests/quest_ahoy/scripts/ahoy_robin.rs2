// EASCape: Ghosts Ahoy, Robin, Master Bowman, and Runedraw. Ported from Void (GregHib/void:
// content/quest/member/ghosts_ahoy/Robin.kt), its words and order, on the 377 cache's
// ahoy_runedraw interface: your runes com_8-17 and score com_28 on the left, Robin's com_18-27
// and com_30 on the right, the turn texts com_29 / com_31, Draw com_6 (layer com_32) and Hold
// com_7 (layer com_33). %ahoy_subquest_bow: 1 asked, 2 played, +1 for each game you win (Robin
// doesn't pay), at 6 he signs, 7 signed, 8 given to Ak-Haranu.
// Ours: Void shows Robin's verdict when you close the game; here you talk to him again.

[opnpcu,ahoy_robin]
~chatnpc("<p,angry>Go away peasant, why would I want that?");

[opnpc1,ahoy_robin]
def_int $stage = %ahoy_subquest_bow;
if (inv_total(inv, ahoy_bedsheet) > 0) {
    ~chatplayer("<p,neutral>I've brought you a clean bedsheet, Robin.");
    inv_del(inv, ahoy_bedsheet, 1);
    ~chatnpc("<p,neutral>Well it's about time. Run along now, I need some Robin time.");
    return;
}
if ($stage = 0) {
    ~chatplayer("<p,neutral>It's nice to see another human face around here.");
    ~chatnpc("<p,neutral>Leave me be, peasant - I am relaxing.");
    ~chatplayer("<p,neutral>Well, that's nice!");
    ~chatnpc("<p,neutral>Do you know who I am?");
    ~chatplayer("<p,bored>I'm sorry, I haven't had the privilege.");
    ~chatnpc("<p,neutral>I, peasant, am Robin, Master Bowman. I am very famous you know.");
    ~chatplayer("<p,neutral>Oh, Robin, Master Bowman, I see.");
    ~chatnpc("<p,neutral>So have you heard of me?");
    ~chatplayer("<p,neutral>No.");
    ~chatnpc("<p,neutral>Would you do me a favour? I appear to have run out of bed linen. Can you run along to the innkeeper and get me a clean bedsheet?");
    switch_int (~p_choice2("Anything for a famous person such as yourself.", 1, "Go and get it yourself.", 2)) {
        case 1 :
            ~chatplayer("<p,neutral>Anything for a famous person such as yourself.");
            ~chatnpc("<p,neutral>Now that sounds more like it. Run along now, get me my sheet.");
        case 2 :
            ~chatplayer("<p,neutral>Go and get it yourself.");
            ~chatnpc("<p,neutral>Oh charming. You just can't get the staff these days.");
    }
    return;
}
if ($stage = 1) {
    if (inv_total(inv, oak_longbow) > 0) {
        ~chatplayer("<p,quiz>Would you sign this oak longbow for me?");
        ~chatnpc("<p,neutral>I'm sorry, I don't sign autographs.");
        ~chatnpc("<p,neutral>While you're here, though, why don't you have a game of Runedraw with me? If you've got 25 gold pieces I've got a bag of runes we can use.");
    } else {
        ~chatnpc("<p,neutral>Hey you, why don't you have a game of Runedraw with me? If you've got 25 gold pieces I've got a bag of runes we can use.");
    }
    @ahoy_rd_options(false);
}
if ($stage >= 7) {
    if ($stage = 7 & ~obj_gettotal(oak_longbow_signed) = 0 & inv_total(inv, oak_longbow) > 0) {
        ~chatplayer("<p,neutral>I need you to sign another longbow.");
        ~chatnpc("<p,neutral>Oh, okay - just keep your promise not to tell the ghosts anything.");
        inv_del(inv, oak_longbow, 1);
        inv_add(inv, oak_longbow_signed, 1);
        ~objbox(oak_longbow_signed, "Robin signs another oak longbow for you.", 250, 0, 0);
    } else {
        ~chatplayer("<p,neutral>So, still here then?");
        ~chatnpc("<p,neutral>Do you want another game of Runedraw?");
        ~chatplayer("<p,angry>No!");
    }
    return;
}
@ahoy_rd_result;

[label,ahoy_rd_options](boolean $debt)
def_string $no = "No, that doesn't sound fun.";
if ($debt = true) $no = "No, you didn't pay up the last time you lost.";
switch_int (~p_choice3("Yes, I'll give you a game.", 1, "How do you play Runedraw?", 2, $no, 3)) {
    case 1 :
        ~chatplayer("<p,neutral>Yes, I'll give you a game.");
        if (inv_total(inv, coins) < 25) {
            ~chatplayer("<p,sad>I don't have enough money on me for a game of Runedraw at the moment.");
            return;
        }
        if (%ahoy_subquest_bow = 1) %ahoy_subquest_bow = 2;
        inv_del(inv, coins, 25);
        ~ahoy_rd_start;
    case 2 :
        ~chatplayer("<p,quiz>How do you play Runedraw?");
        ~chatnpc("<p,neutral>Two players take turns to draw a rune from a bag, which contains ten runes in total. Each rune has a different value: an air rune is worth one point, up to a Nature rune which is worth nine points.");
        ~chatnpc("<p,neutral>If a player draws the Death rune then the game is over, and they have lost.");
        ~chatnpc("<p,neutral>A player can choose to hold if they wish and not draw any more runes, but this runs the risk of the other player drawing more runes until they have a greater points total and win.");
    case 3 :
        if ($debt = true) {
            ~chatplayer("<p,angry>No, you didn't pay up the last time you lost.");
        } else {
            ~chatplayer("<p,neutral>No, that doesn't sound fun.");
        }
}

[label,ahoy_rd_result]
def_int $stage = %ahoy_subquest_bow;
if ($stage = 6) {
    ~chatplayer("<p,angry>I've had enough of you not paying up - you owe me 100 gold coins. I'm going to tell the ghosts what you're doing.");
    ~chatnpc("<p,neutral>Please don't do that!!! They will suck the life from my bones!!!");
    ~chatplayer("<p,neutral>How about you signing my longbow then?");
    if (inv_total(inv, oak_longbow) > 0) {
        ~chatnpc("<p,neutral>Yes, anything!!!");
        inv_del(inv, oak_longbow, 1);
        inv_add(inv, oak_longbow_signed, 1);
        ~objbox(oak_longbow_signed, "Robin signs the oak longbow for you.", 250, 0, 0);
        %ahoy_subquest_bow = 7;
    } else {
        ~chatnpc("<p,neutral>I'll certainly sign your longbow, if you bring me one!!");
    }
    return;
}
def_boolean $debt = false;
if ($stage > 2) $debt = true;
if (%ahoy_rd_outcome = 0) {
    %ahoy_rd_outcome = 1;
    mes("Your resignation from the game of Runedraw has been treated as a loss.");
    ~chatplayer("<p,neutral>Oh, I give up.");
    ~chatnpc("<p,neutral>How about another game?");
    @ahoy_rd_options($debt);
}
if (%ahoy_rd_outcome = 1) {
    if ($stage <= 2) {
        ~chatplayer("<p,neutral>Well done, you beat me.");
    } else {
        ~chatplayer("<p,neutral>Well done, you beat me. But you still owe me <tostring(multiply(sub($stage, 2), 25))> gold pieces.");
    }
    if ($stage = 2) {
        ~chatnpc("<p,neutral>How about another game?");
    } else {
        ~chatnpc("<p,neutral>Err ... how about another game? We can settle up after we've finished playing.");
    }
    @ahoy_rd_options(false);
}
~chatplayer("<p,quiz>So are you going to pay up then? You owe me <tostring(multiply(sub($stage, 2), 25))> gold coins!");
~chatnpc("<p,neutral>How about another game? I'll pay you back with the winnings.");
~chatplayer("<p,quiz>What if you lose again?");
~chatnpc("<p,neutral>Er ... we'll deal with that when we come to it.");
@ahoy_rd_options($debt);

// ---------------------------------------------------------------- the game
[proc,ahoy_rd_start]
%ahoy_rd_held = 0;
%ahoy_rd_pturn = 0;
%ahoy_rd_psum = 0;
%ahoy_rd_rturn = 0;
%ahoy_rd_rsum = 0;
%ahoy_rd_outcome = 0;
def_int $i = 1;
while ($i <= 10) {
    if_sethide(~ahoy_rd_slot(0, $i), true);
    if_sethide(~ahoy_rd_slot(1, $i), true);
    $i = add($i, 1);
}
if_settext(ahoy_runedraw:com_28, "");
if_settext(ahoy_runedraw:com_29, "Your turn");
if_settext(ahoy_runedraw:com_30, "");
if_settext(ahoy_runedraw:com_31, "");
~ahoy_rd_buttons(true);
if_openmain(ahoy_runedraw);

[proc,ahoy_rd_buttons](boolean $show)
def_boolean $hide = true;
if ($show = true) $hide = false;
if_sethide(ahoy_runedraw:com_32, $hide);
if_sethide(ahoy_runedraw:com_33, $hide);

// $side 0 you, 1 Robin; $turn 1-10
[proc,ahoy_rd_slot](int $side, int $turn)(component)
if ($side = 0) {
    switch_int ($turn) {
        case 1 : return(ahoy_runedraw:com_8);
        case 2 : return(ahoy_runedraw:com_9);
        case 3 : return(ahoy_runedraw:com_10);
        case 4 : return(ahoy_runedraw:com_11);
        case 5 : return(ahoy_runedraw:com_12);
        case 6 : return(ahoy_runedraw:com_13);
        case 7 : return(ahoy_runedraw:com_14);
        case 8 : return(ahoy_runedraw:com_15);
        case 9 : return(ahoy_runedraw:com_16);
        case default : return(ahoy_runedraw:com_17);
    }
}
switch_int ($turn) {
    case 1 : return(ahoy_runedraw:com_18);
    case 2 : return(ahoy_runedraw:com_19);
    case 3 : return(ahoy_runedraw:com_20);
    case 4 : return(ahoy_runedraw:com_21);
    case 5 : return(ahoy_runedraw:com_22);
    case 6 : return(ahoy_runedraw:com_23);
    case 7 : return(ahoy_runedraw:com_24);
    case 8 : return(ahoy_runedraw:com_25);
    case 9 : return(ahoy_runedraw:com_26);
    case default : return(ahoy_runedraw:com_27);
}

// roll 0-9: air (1 point) ... nature (9 points), 9 the death rune
[proc,ahoy_rd_rune](int $roll)(namedobj)
switch_int ($roll) {
    case 0 : return(airrune);
    case 1 : return(mindrune);
    case 2 : return(waterrune);
    case 3 : return(earthrune);
    case 4 : return(firerune);
    case 5 : return(bodyrune);
    case 6 : return(cosmicrune);
    case 7 : return(chaosrune);
    case 8 : return(naturerune);
}
return(deathrune);

[proc,ahoy_rd_show](int $side, int $turn, int $roll)
def_component $com = ~ahoy_rd_slot($side, $turn);
if_setobject($com, ~ahoy_rd_rune($roll), 80);
if_sethide($com, false);

[if_button,ahoy_runedraw:com_6]
if (%ahoy_rd_outcome ! 0) return;
def_int $turn = %ahoy_rd_pturn;
def_int $roll = random(10);
if ($turn = 9) $roll = 9;
if ($roll ! 9) %ahoy_rd_psum = add(%ahoy_rd_psum, add($roll, 1));
~ahoy_rd_show(0, add($turn, 1), $roll);
%ahoy_rd_pturn = add($turn, 1);
~ahoy_rd_buttons(false);
if ($roll = 9) {
    ~ahoy_rd_lose;
    return;
}
if_settext(ahoy_runedraw:com_28, tostring(%ahoy_rd_psum));
if_settext(ahoy_runedraw:com_29, "");
if_settext(ahoy_runedraw:com_31, "Thinking...");
queue(ahoy_rd_robin, 4, 0);

[if_button,ahoy_runedraw:com_7]
if (%ahoy_rd_outcome ! 0) return;
%ahoy_rd_held = 1;
%ahoy_rd_pturn = add(%ahoy_rd_pturn, 1);
if_settext(ahoy_runedraw:com_29, "HELD");
if_settext(ahoy_runedraw:com_31, "Thinking...");
~ahoy_rd_buttons(false);
queue(ahoy_rd_robin, 4, 0);

[queue,ahoy_rd_robin]
if (%ahoy_rd_outcome ! 0) return;
def_int $turn = %ahoy_rd_rturn;
def_int $roll = random(10);
if (%ahoy_rd_pturn = 9) $roll = 9;
if ($roll ! 9) %ahoy_rd_rsum = add(%ahoy_rd_rsum, add($roll, 1));
~ahoy_rd_show(1, add($turn, 1), $roll);
%ahoy_rd_rturn = add($turn, 1);
if_settext(ahoy_runedraw:com_30, tostring(%ahoy_rd_rsum));
if (add($turn, 1) = 10) {
    if (%ahoy_rd_psum > %ahoy_rd_rsum) {
        ~ahoy_rd_win;
    } else {
        ~ahoy_rd_lose;
    }
    return;
}
if ($roll = 9) {
    ~ahoy_rd_win;
    return;
}
if (%ahoy_rd_held = 1) {
    if (%ahoy_rd_psum < %ahoy_rd_rsum) {
        ~ahoy_rd_lose;
        return;
    }
    %ahoy_rd_pturn = add(%ahoy_rd_pturn, 1);
    queue(ahoy_rd_robin, 4, 0);
    return;
}
~ahoy_rd_buttons(true);
if_settext(ahoy_runedraw:com_31, "");
if_settext(ahoy_runedraw:com_29, "Your turn");

[proc,ahoy_rd_win]
if_settext(ahoy_runedraw:com_31, "");
if_settext(ahoy_runedraw:com_29, "You win!");
~ahoy_rd_buttons(false);
%ahoy_subquest_bow = add(%ahoy_subquest_bow, 1);
%ahoy_rd_outcome = 2;
mes("You've won the game of Runedraw!");

[proc,ahoy_rd_lose]
if_settext(ahoy_runedraw:com_31, "");
if_settext(ahoy_runedraw:com_29, "You lose!");
~ahoy_rd_buttons(false);
%ahoy_rd_outcome = 1;
mes("You've lost the game of Runedraw.");
