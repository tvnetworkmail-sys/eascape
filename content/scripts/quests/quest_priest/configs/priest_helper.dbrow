[questhelper_step_priest_1]
table=questhelper_step
data=id,49001
data=section,0
data=text,Talk to Father Aereck in the Lumbridge Church.
data=npc,father_aereck
data=coord,0_50_50_43_6
data=option,I'm looking for a quest!
data=option,Yes.

[questhelper_step_priest_2]
table=questhelper_step
data=id,49002
data=section,1
data=text,"Talk to Father Urhney, west of the Lumbridge Swamp."
data=npc,father_urhney
data=coord,0_49_49_11_39
data=option,Father Aereck sent me to talk to you.
data=option,He's got a ghost haunting his graveyard.

[questhelper_step_priest_3]
table=questhelper_step
data=id,49003
data=section,2
data=text,Open the coffin in the Lumbridge Graveyard to spawn the ghost.
data=loc,shutghostcoffin
data=coord,0_50_49_50_57

[questhelper_step_priest_4]
table=questhelper_step
data=id,49004
data=section,2
