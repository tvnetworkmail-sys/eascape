data=coord,0_50_49_50_57

[questhelper_step_priest_5]
table=questhelper_step
data=id,49005
data=section,2
data=text,Speak to the Ghost that appears whilst wearing your Ghostspeak Amulet.
data=npc,ghostx
data=coord,0_50_49_50_59
data=option,"Yep, now tell me what the problem is."
data=option,"Yep, clever aren't I?."
data=option,"Yes, ok. Do you know WHY you're a ghost?"
data=option,"Yes, ok. Do you know why you're a ghost?"

[questhelper_step_priest_6]
table=questhelper_step
data=id,49006
data=section,3
data=text,"Enter the Wizards' Tower basement, south of Draynor village."
data=loc,wizards_tower_laddertop
data=coord,0_48_49_32_26

[questhelper_step_priest_7]
table=questhelper_step
data=id,49007
data=section,3
data=text,"Search the Altar. A skeleton (level 13) will appear and attack you, but you can just run away."
data=loc,restless_ghost_altar
data=coord,0_48_149_48_31

[questhelper_step_priest_8]
table=questhelper_step
