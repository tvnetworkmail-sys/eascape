// EASCape: Mountain Daughter's journal. Ours: no source has its journal text, so these lines say
// what the OSRS wiki's quick guide has you do next.
[if_button,questlist:mdaughter]
def_int $s = %mdaughter_quest_var;
if ($s = ^md_not_started) {
    ~quest_journal("Mountain Daughter", "@dbl@I can start this quest by talking to @dre@Hamal the Chieftain@dbl@ in|@dbl@the @dre@Mountain Camp@dbl@ east of Rellekka. A @dre@rope@dbl@ will get me into|@dbl@the camp.|@dbl@I will need level @dre@20 Agility@dbl@ and be able to defeat a|@dre@level 70 monster@dbl@.");
    return;
}
def_string $t = "@str@Hamal the Chieftain's daughter has gone missing, and he|@str@let me search for her.||";
def_string $next;
if ($s = ^md_started) {
    $next = "@dbl@I should look for her by the @dre@pool@dbl@ beyond the camp, where @dre@Ragnar@dbl@,|@dbl@her fiance, waits. Mud from the pond south of Hamal's tent|@dbl@might help me climb the @dre@tall tree@dbl@, and a @dre@pole@dbl@ and a @dre@plank@dbl@|@dbl@get me across the water.";
} else {
    $t = append($t, "@str@I heard the voice of his daughter Asleif at the shining|@str@pool. She is dead.||");
    if ($s >= ^md_tasks_done) {
        $t = append($t, "@str@I brought her people and Rellekka closer together, and|@str@found them a new supply of food.||");
        if ($s >= ^md_complete) {
            $t = append($t, "@str@I found the Kendal, a man in a bearsuit who killed her, and|@str@buried her on the island under a cairn.||");
            $next = "@red@QUEST COMPLETE!";
        } else if ($s >= ^md_burial) {
            $t = append($t, "@str@I found the Kendal, a man in a bearsuit who killed her, and|@str@showed Hamal her body.||");
            $next = "@dbl@I should bury her on the island in the pool with one of her|@dbl@possessions (@dre@Ragnar@dbl@ may have one), then build a cairn of|@dre@5 muddy rocks@dbl@ on top.";
        } else if ($s >= ^md_kendal_dead) {
            $t = append($t, "@str@I found the Kendal, a man in a bearsuit who killed her, in a|@str@cave north of the pool, and killed him.||");
            $next = "@dbl@I should take her @dre@corpse@dbl@ to @dre@Hamal@dbl@.";
        } else if ($s >= ^md_seek_killer) {
            $next = "@dbl@Asleif wants me to convince her father she is dead. She was|@dbl@attacked by the lake and dragged off; the path east along the|@dbl@north of the pool leads to a cave behind some dead trees.";
        } else {
            $next = "@dbl@I should tell @dre@Asleif@dbl@ at the shining pool.";
        }
    } else {
        $next = "@dbl@Asleif asked me to bring her people and @dre@Rellekka@dbl@ closer|@dbl@together, and to find them a new supply of @dre@food@dbl@.||";
        def_int $r = %mdaughter_relations_var;
        if (%mdaughter_hamal_relations_done = 1) {
            $next = append($next, "@str@Svidi has spoken to Brundt, and Hamal is pleased.|");
        } else if (%mdaughter_brundt_done = 1 & $r >= 50) {
            $next = append($next, "@dbl@Svidi has gone to Rellekka. I should tell @dre@Hamal@dbl@.|");
        } else if (%mdaughter_brundt_done = 1) {
            $next = append($next, "@dbl@I should take Brundt's @dre@safety guarantee@dbl@ to @dre@Svidi@dbl@.|");
        } else if ($r >= 30) {
            $next = append($next, "@dbl@Brundt wants the mountain tribe's @dre@ancient rock@dbl@ back.|");
        } else if ($r >= 20) {
            $next = append($next, "@dbl@Svidi wants a guarantee of safe passage from @dre@Brundt@dbl@.|");
        } else if ($r >= 10) {
            $next = append($next, "@dbl@Hamal's representative @dre@Svidi@dbl@ is somewhere between|@dbl@Rellekka and Keldagrim.|");
        } else {
            $next = append($next, "@dbl@I should ask @dre@Hamal@dbl@ about the people of Rellekka.|");
        }
        def_int $f = %mdaughter_food_var;
        if ($f >= 3) {
            $next = append($next, "@str@Hamal has the seed of the White Pearl.");
        } else if ($f = 2) {
            $next = append($next, "@dbl@Jokul spoke of the @dre@White Pearl@dbl@, a fruit that grows in the|@dbl@mountains. I'll need gloves for its thorns.");
        } else {
            $next = append($next, "@dbl@I should ask @dre@Hamal@dbl@ and @dre@Jokul@dbl@ about food.");
        }
    }
}
~quest_journal("Mountain Daughter", append($t, $next));
