// Fairytale II - Cure a Queen in Zanaris: Fairy Nuff's ransacked room and her certificate, the
// rune temple sign, the Fairy Godfather (permission for the fairy rings, his contract, and his
// pocket), the Co-ordinator, Fairy Fixit, and showing the certificate around. Lines from the OSRS
// wiki's quest transcript; Fairy Fixit's is the transcript's too. Ours where marked. The steps
// are RuneLite's Quest Helper (FairytaleII.java) and the wiki's walkthrough.

[proc,fairy2_godfather_says](string $text)
~chatnpc_specific("Fairy Godfather", ft2_fairy_godfather, $text);

// ---------------------------------------------------------------- Nuff's room
// The room's scenery is the 2007 cache's multilocs (fairy2.loc), so the triggers are on them: the
// broken certificate on the floor (ft2_loc_16315, there while fairynuff_cert_taken is 1), the
// shelves and workbenches (ransacked from stage 20).
[oploc1,ft2_loc_16315]
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space."); // ours
    return;
}
inv_add(inv, ft2_nuffs_certificate, 1);
%fairynuff_cert_taken = 2;

// the ransacked shelves and workbenches: one has a copy of the certificate in a vial (ours: the
// big potion shelves, ft2_loc_16216)
[oploc1,ft2_loc_16216]
if (%fairy2_queencure_quest < ^fairy2_started | ~obj_gettotal(ft2_nuffs_certificate) > 0 | %fairynuff_cert_taken = 1) {
    @fairy2_broken_glass;
}
if (inv_freespace(inv) = 0) {
    ~objbox(ft2_nuffs_certificate, "Hidden inside a vial you find a copy of Fairy Nuff's certificate, but you don't have space to take it.", 250, 0, 0);
    return;
}
inv_add(inv, ft2_nuffs_certificate, 1);
~objbox(ft2_nuffs_certificate, "Hidden inside a vial you find a copy of Fairy Nuff's certificate.", 250, 0, 0);
[oploc1,ft2_loc_16218] @fairy2_broken_glass;
[oploc1,ft2_loc_16220] @fairy2_broken_glass;
[oploc1,ft2_loc_16222] @fairy2_broken_glass;
[oploc1,ft2_loc_16212] @fairy2_broken_glass;
[oploc1,ft2_loc_16214] @fairy2_broken_glass;

[label,fairy2_broken_glass]
~mesbox("You don't find anything useful, just some glass from a broken vial.");

// ---------------------------------------------------------------- the certificate and the sign
[opheld1,ft2_nuffs_certificate]
if_openmain(ft2_certificate);

[opheld2,ft2_nuffs_certificate]
if (%fairy2_certificute_examined = 0) {
    %fairy2_certificute_examined = 1;
}
if_openmain(ft2_message);

[oploc1,ft2_rune_temple_sign_16307]
if (%fairy2_queencure_quest >= ^fairy2_started & %fairy2_sign_read < ^fairy2_sign_was_read) {
    %fairy2_sign_read = ^fairy2_sign_was_read;
}
if_openmain(ft2_sign);

// ---------------------------------------------------------------- the Fairy Godfather
[label,fairy2_godfather]
def_int $s = %fairy2_queencure_quest;
if ($s < ^fairy2_started | $s >= ^fairy2_complete) {
    ~mesbox("The Godfather is ignoring you.");
    return;
}
if ($s >= ^fairy2_rings_allowed) {
    ~fairy2_godfather_says("<p,quiz><displayname>, you are-a back! Have-a you found da Queen Bee?");
    ~chatplayer("<p,shifty>Err, no, not yet.");
    ~fairy2_godfather_says("<p,angry>Den whatta are you doing-a back here? Go and-a search for her!");
    return;
}
if (%fairyring_permission = 1) {
    // you said you'd rescue her yourself
    ~fairy2_godfather_says("<p,quiz>Ah, <displayname>, yous hassa changed your mind? Yous weel-a come and getta me before yous rescue da Queen Bee? Only den can-a I geev yous permission to use-a da reengs.");
    if (~p_choice2("Oh, okay then.", 1, "No, there's no chance of that happening.", 2) = 1) {
        ~chatplayer("<p,neutral>Oh, okay then.");
        ~fairy2_godfather_says("<p,happy>Good, I knew-a you would change-a your mind. Now I just-a need you to sign-a dis scroll before I geev-a yous da permission to use-a da fairyreengs.");
        if_openmain(ft2_contract);
        p_delay(2);
        if_close;
        ~chatplayer("<p,angry>I am not signing this! It says I am indebted to you until you release me!");
        ~fairy2_godfather_says("<p,shifty>Eet does? Oh, sorry, must-a geeven yous da wrong-a scroll. Tell-a yous what, yous hazza da honest face, so I'll trust-a yous. Go ahead, use-a da fairyreengs, but just-a make sure dat yous come-a back here and tell-a me when-a yous finda da Queen Bee, like-a yous promised. Now go-a and talk-a to da co-ordinator. She-a weel tell-a yous how da fairyreengs work.");
        ~fairy2_permission;
        return;
    }
    ~chatplayer("<p,angry>No, there's no chance of that happening.");
    ~fairy2_godfather_says("<p,neutral>Yous weel change-a your mind. Come and talk-a to me me yous do.");
    return;
}
def_int $choice;
if (inv_total(inv, ft2_nuffs_certificate) > 0) {
    $choice = ~p_choice3("Where is the Fairy Queen?", 1, "Where have all the fairies gone?", 2, "Show the Godfather the Certificate!", 3);
} else {
    $choice = ~p_choice2("Where is the Fairy Queen?", 1, "Where have all the fairies gone?", 2);
}
switch_int ($choice) {
    case 1 :
        ~chatplayer("<p,angry>Godfather! Where is the Fairy Queen?");
        ~fairy2_godfather_says("<p,confused>Whata are you-a talking about?");
        ~chatplayer("<p,angry>I've just been to Fairy Nuff's cave and when I got there I found it ransacked! Everything has been broken and the Fairy Queen and Fairy Nuff are missing!");
        ~fairy2_godfather_says("<p,shock>Essere nel panico! You-a say datta Queen Bee, she izza meesing? Theez izza terreeble! Who could-a have done such a theeng? We musta find her! I weel organise a search-a party right-a-way!");
        ~chatplayer("<p,neutral>Calm down! Let's think this through carefully.");
        @fairy2_godfather_questions;
    case 2 :
        ~chatplayer("<p,quiz>Where have all the fairies gone?");
        ~fairy2_godfather_says("<p,neutral>Da people are mostly out-a and about-a tryeeng to keep-a theengs working. Eet izza not easy weeth da Queen Bee notta here!");
    case 3 : @fairy2_show_godfather;
}

[label,fairy2_godfather_questions]
while (1 = 1) {
    if (~p_choice2("Do you have any idea who could have done this?", 1, "Where could she have been taken to?", 2) = 1) {
        ~chatplayer("<p,quiz>Do you have any idea who could have done this?");
        ~fairy2_godfather_says("<p,shifty>Errm...no! None atta all! Da Queen Bee, she izza well liked by-a everyone.");
        ~chatplayer("<p,neutral>That's not very helpful.");
    } else {
        ~chatplayer("<p,quiz>Where could she have been taken to?");
        ~fairy2_godfather_says("<p,neutral>Ze keednapper must-a have taken her through-a da fairyreengs. Dey weel-a be long gone by-a now.");
        ~chatplayer("<p,angry>We must go after them!");
        ~fairy2_godfather_says("<p,neutral>Yes! We must-a, but most-a of da folk are away from Zanaris atta the momento.");
        ~chatplayer("<p,neutral>Well tell me what to do and I'll go myself.");
        ~fairy2_godfather_says("<p,neutral>Ye-es, dat izza good idea. Hokay, you may use-a da fairyreengs. Talk-a to da co-ordinator, she will-a explain-a to you how to use-a da reengs, but you must-a promees me dat you weel come-a back-a here, eef you find-a her. Whoever keednapped her must-a be very powerful. You find-a da Queen Bee and den-a yous come right back here and we will-a rescue her together. Hokay?");
        if (~p_choice2("Yes, okay.", 1, "No, I'll rescue her myself.", 2) = 1) {
            ~chatplayer("<p,neutral>Yes, okay.");
            ~fairy2_godfather_says("<p,happy>Good. Now-a yous talk-a to da co-ordinator. She will-a tell you how-a da fairyreengs work.");
            ~fairy2_permission;
            return;
        }
        ~chatplayer("<p,neutral>No, I'll rescue her myself.");
        ~fairy2_godfather_says("<p,angry>Oh no, dat eet eez no good. Yous wanna to be da hero, but what-a about me? She izza my queen! No, no. You cannot-a use-a da fairyreengs");
        %fairyring_permission = 1;
        return;
    }
}

// the 2007 cache sets fairyring_use 1 and fairyring_permission 2 here (Quest Helper)
[proc,fairy2_permission]
%fairyring_use = 1;
%fairyring_permission = 2;
%fairy2_queencure_quest = ^fairy2_rings_allowed;
~send_quest_progress(questlist:fairy2, %fairy2_queencure_quest, ^fairy2_complete);

[label,fairy2_show_godfather]
if (%fairy2_certificute_examined = 0) {
    ~fairy2_godfather_says("<p,angry>For why you show-a me dat? I-a busy fairy! I donn-a have time for nonsense!");
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the Godfather.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
~fairy2_godfather_says("<p,happy>For why you show-a me dat? Eez very nice to see yous learning to draw! Bravo!");

// his pocket (the 2007 cache's Godfather from stage 50, fairy_godfather_check 2, with
// "Pick-pocket"). The wiki: Thieving 40, 47 experience, the secateurs every time; a failed attempt
// takes you outside Zanaris. Our choices: the chance is Thieving's usual roll (the wiki: the
// henchmen's eyes matter too; ours don't watch), and you wake by the shed in the Lumbridge Swamp.
[opnpc3,fairy_godfather_multi]
if (%fairy2_queencure_quest < ^fairy2_secateurs | %fairy2_queencure_quest >= ^fairy2_gave_secateurs) {
    mes("You don't need anything from the Godfather's pockets."); // ours
    return;
}
if (stat(thieving) < 40) {
    mes("You need a Thieving level of 40 to pick-pocket the Fairy Godfather."); // ours
    return;
}
mes("You attempt to pickpocket the Fairy Godfather.");
if (inv_total(inv, ft2_queens_secateurs) > 0) {
    ~mesbox("You already have the Queen's secateurs. You don't need to risk getting caught in the Godfather's pockets again.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have space to carry the secateurs");
    return;
}
anim(human_pickpocket, 0);
p_delay(2);
if (stat_random(thieving, 70, 240) = true) {
    inv_add(inv, ft2_queens_secateurs, 1);
    stat_advance(thieving, 470);
    ~objbox(ft2_queens_secateurs, "You pick-pocket the Fairy Godfather and get the Queen's enchanted secateurs!", 250, 0, 0);
    if (%fairy2_queencure_quest = ^fairy2_secateurs) {
        %fairy2_queencure_quest = ^fairy2_got_secateurs;
        ~send_quest_progress(questlist:fairy2, %fairy2_queencure_quest, ^fairy2_complete);
    }
    return;
}
npc_say("Rocco, teach-a thees thief a lesson!");
p_delay(1);
p_teleport(0_50_49_1_33); // where the Zanaris exit ring leaves you (lostcity fairy_rings.rs2)
~mesbox("You slowly wake up in an unknown place.");

// ---------------------------------------------------------------- the Co-ordinator and Fairy Fixit
[opnpc1,fairy_coordinator]
def_boolean $cert = false;
if (inv_total(inv, ft2_nuffs_certificate) > 0) $cert = true;
def_boolean $rings = false;
if (%fairy2_queencure_quest >= ^fairy2_rings_allowed) $rings = true;
if ($cert = true & $rings = true) {
    if (~p_choice2_header("Fairy Nuff's certificate.", 1, "The fairy rings.", 2, "What do you want to ask about?") = 1) {
        @fairy2_coordinator_certificate;
    }
    @fairy2_coordinator_rings;
}
if ($cert = true) @fairy2_coordinator_certificate;
if ($rings = true) @fairy2_coordinator_rings;
~chatnpc("<p,neutral>Now I must get back to work, there is so much to do and so few fairies left to do it."); // ours: her last line

[label,fairy2_coordinator_rings]
~chatplayer("<p,neutral>Hi, the Godfather said I should ask you to explain how the fairy rings work.");
~chatnpc("<p,angry>Goodness! As if I don't have enough to do already without giving every adventurer that comes along a history lesson! Let's get this over with quickly. Zanaris is an extremely old place, it was here long before we fairyfolk came to live here. In fact it is rumoured to be the nexus of all planes.");
~chatnpc("<p,neutral>When we arrived here we found many of the magical properties of this place to be dormant. One of these was the ability to jump between planes using a powerful portal that had been sealed for centuries. The Fairy Queen harnessed that magic and created the fairy rings, these are not as powerful as the original portal would have been, but are very effective nonetheless.");
~chatnpc("<p,neutral>There are 3 fairy rings in Zanaris, the one in the market and the one near the evil chicken's shrine will only take users to one specific place. However the third fairy ring, near the fountains, is a major portal.");
~chatnpc("<p,neutral>Anybody who activates that fairy ring will find themselves able to dial in a 3 digit code. These codes will all take the user to different locations. Some of the codes no longer work and other codes go to extremely dangerous places, so be careful.");
~chatnpc("<p,neutral>Fortunately the fairy rings are imbued with a powerful protective magic and as long as you stand in the middle of them nothing will be able to attack you. Remember, because you are a human, you will need to be holding your dramen staff to activate the rings. Now I must get back to work, there is so much to do and so few fairies left to do it.");

[label,fairy2_coordinator_certificate]
if (%fairy2_certificute_examined = 0) {
    ~chatnpc("<p,neutral>Fairy Nuff is very proud of that certificate, it's her most prized possession. She won't like you taking it.");
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the Fairy Coordinator.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
~chatnpc("<p,confused>They look familiar, but I can't think where I've seen marks like that. Try asking around, maybe someone else will recognise them.");

[opnpc1,ft2_fairy_fixit]
~chatnpc("<p,angry>What is it, human? Busy busy busy!");
if (~p_choice2("Why are you carrying that toolbox?", 1, "I'm okay, thanks.", 2) = 1) {
    ~chatplayer("<p,quiz>Why are you carrying that toolbox?");
    ~chatnpc("<p,angry>It's the fizgog! It's picking up cable again!");
    ~chatplayer("<p,confused>Uh, right. So is it safe to use the fairy rings then?");
    ~chatnpc("<p,neutral>Sure, as long as you have been given permission to use them. You should just be aware that using the fairy rings sometimes has strange results, the locations that you have been to may affect the locations you are trying to reach.");
    ~chatnpc("<p,neutral>I could fix it by replacing the fizgog and the whosprangit, I've put in a request for some new parts but they're pretty hard to get hold of, it seems.");
    return;
}
~chatplayer("<p,neutral>I'm okay, thanks.");

// ---------------------------------------------------------------- showing the certificate around
[opnpcu,fairy_godfather_multi]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
@fairy2_show_godfather;

[opnpcu,fairy_coordinator]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
@fairy2_coordinator_certificate;

[opnpcu,fairy_chef]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
if (%fairy2_certificute_examined = 0) {
    ~chatnpc("<p,neutral>Very nice, dearie, but that belongs to Fairy Nuff. I should put it back on her wall before she misses it if I were you. You wouldn't want her to think you stole it now, would you?");
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the Fairy chef.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
~chatnpc("<p,neutral>Sorry dearie, no, but I have seen a sign with similar marks near the mysterious ruins. You know, the ones that lead you to the Cosmic Rune Altar.");
if (%fairy2_chefchat = 0) {
    %fairy2_chefchat = 1;
}

[opnpcu,fairy_mindslayer]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the Gate Keeper.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
if (%fairy2_certificute_examined = 0) {
    ~chatnpc("<p,angry>That you've been doodelling? If you don't mind I have a job to do, please stop distracting me.");
    return;
}
~chatnpc("<p,angry>No I don't and I'm trying to work here. Please stop distracting me!");

[opnpcu,fairy_sheep] @fairy2_show_sheep;
[opnpcu,fairy_sheepsheered] @fairy2_show_sheep;
[label,fairy2_show_sheep]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the sheep.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
~chatnpc_specific("Sheep", npc_type, "<p,neutral>The human found some symbols|And doesn't know what they mean|So now it's cross-examining me|And spoiling my routine!");

[opnpcu,fairy_cow]
if (last_useitem ! ft2_nuffs_certificate) {
    ~displaymessage(^dm_default);
    return;
}
~objbox(ft2_nuffs_certificate, "You show the certificate to the cow.", 250, 0, 0);
~chatplayer("<p,quiz>Do you know what these strange marks mean?");
~chatnpc_specific("Cow", npc_type, "<p,angry>Can't the human take a hint? I've been ignoring you! Do you think I would ignore you if I wanted to discuss your Rorschach ink-blots ?");
mes("Once again, the cow is ignoring you.");

// ---------------------------------------------------------------- the Godfather's orks (ours: the
// transcript has nothing for them)
[opnpc1,ft2_multi_4424] ~mesbox("The ork is not interested in talking.");
[opnpc1,ft2_multi_4425] ~mesbox("The ork is not interested in talking.");
