// Fairytale II - Cure a Queen's stages (fairy2_queencure_quest, the 2007 cache's varbit). The
// values are the 2007 cache's: RuneLite's Quest Helper (FairytaleII.java) steps on 0, 5, 10, 20,
// 40, 45, 50, 60, 65, 70, 72, 73, 75 and 80, and the cache's multinpcs and multilocs show 90 and
// 100 (100 is complete: the cured Queen and Fairy Very Wise). What each one means is from the
// Quest Helper and the wiki's walkthrough; where neither says, ours (marked).
^fairy2_not_started = 0
// Martin has planted his seeds (about five and a half minutes' wait: OSRS wiki)
^fairy2_planting = 5
// his crops have grown
^fairy2_crops_grown = 10
// started: Nuff's room is ransacked, the Queen and Nuff are gone
^fairy2_started = 20
// the Fairy Godfather has given you permission to use the fairy rings (talkedToGodfather: 40)
^fairy2_rings_allowed = 40
// ours: you have found the hideout (Fairy Very Wise and the Godfather's orks show from here)
^fairy2_hideout = 45
// Fairy Nuff and Fairy Very Wise have sent you for the Queen's secateurs
^fairy2_secateurs = 50
// ours: you have picked the Godfather's pocket
^fairy2_got_secateurs = 60
// you have given Fairy Nuff the secateurs
^fairy2_gave_secateurs = 65
// Fairy Nuff wants a potion of magic essence
^fairy2_potion = 70
// the star flower is in the vial (addedFlowerCorrectly: 72)
^fairy2_flower_added = 72
// the gorak claw powder too (addedClawCorrectly: 73)
^fairy2_claw_added = 73
// ours: you have given the Queen the potion
^fairy2_queen_cured = 75
// the Queen is up
^fairy2_queen_awake = 80
// ours: the Queen has rewarded you but you had no room for her lamp
^fairy2_lamp_owed = 90
^fairy2_complete = 100

^fairy2_questpoints = 2

// fairy2_sign_read: what the 2007 cache counts there isn't known; the Quest Helper wants 4 ("has
// read the sign"). Ours: 4 once you've read it.
^fairy2_sign_was_read = 4

// how long Martin's crops take (OSRS wiki: about five and a half minutes of logged in time)
^fairy2_crops_ticks = 550
