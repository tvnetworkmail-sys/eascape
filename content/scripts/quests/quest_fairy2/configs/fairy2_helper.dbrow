[questhelper_step_fairy2_1]
table=questhelper_step
data=id,103001
data=section,0
data=text,Talk to Martin in the Draynor Market.
data=npc,martin_the_master_farmer
data=coord,0_48_50_6_58

[questhelper_step_fairy2_2]
table=questhelper_step
data=id,103002
data=section,0
data=text,Wait about five minutes (of logged-in time) for Martin's crops to grow.
data=coord,0_48_50_6_58

[questhelper_step_fairy2_3]
table=questhelper_step
data=id,103003
data=section,0
data=text,Return to Martin in the Draynor Market.
data=npc,martin_the_master_farmer
data=coord,0_48_50_6_58
data=option,Yes.
data=option,I suppose I'd better go and see what the problem is then.

[questhelper_step_fairy2_4]
table=questhelper_step
data=id,103004
data=section,1
data=text,"Travel to Zanaris, through the shed in the Lumbridge Swamp with a dramen staff."
data=loc,zanarisdoor
data=coord,0_50_49_2_33
data=item,dramen_staff,1

[questhelper_step_fairy2_5]
table=questhelper_step
data=id,103005
data=section,1
data=text,Take the broken healing certificate in Fairy Nuff's room in north west Zanaris.
data=loc,ft2_loc_16315
data=coord,0_37_69_24_53

[questhelper_step_fairy2_6]
table=questhelper_step
data=id,103006
data=section,1
data=text,Right-click study the certificate.
data=item,ft2_nuffs_certificate,1

[questhelper_step_fairy2_7]
table=questhelper_step
data=id,103007
data=section,1
data=text,Read the sign near the Cosmic Temple in the south of Zanaris.
data=loc,ft2_rune_temple_sign_16307
data=coord,0_37_68_41_17

[questhelper_step_fairy2_8]
table=questhelper_step
data=id,103008
data=section,1
data=text,Talk to the Fairy Godfather in the Throne Room.
data=npc,fairy_godfather_multi
data=coord,0_38_69_15_14
data=option,Where is the Fairy Queen?
data=option,Where could she have been taken to?
data=option,"Yes, okay."

