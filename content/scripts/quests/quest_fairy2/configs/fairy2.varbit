// EASCape: the August 2007 cache's varbits 2326-2344 on varps 810 and 816. 2326-2340 have
// RuneLite's gameval VarbitID names; 2341-2344 (the three dials and the last code used) have
// none there, so fairyring_dial1-3 and fairyring_last are ours.

[fairy2_queencure_quest]
basevar=queencure_multi
startbit=0
endbit=6

[fairynuff_cert_taken]
basevar=queencure_multi
startbit=7
endbit=8

[fairyring_use]
basevar=queencure_multi
startbit=9
endbit=9

[fairyring_permission]
basevar=queencure_multi
startbit=10
endbit=11

[fairyring_cosmic_plane]
basevar=queencure_multi
startbit=12
endbit=12

[fairyring_gorack_plane]
basevar=queencure_multi
startbit=13
endbit=13

[fairy2_nuffvisible]
basevar=queencure_multi
startbit=14
endbit=14

[fairy2_martinchat]
basevar=queencure_multi
startbit=15
endbit=15

[fairy2_universal_mystery]
basevar=queencure_multi
startbit=16
endbit=16

[fairy2_rewardgiven]
basevar=queencure_multi
startbit=17
endbit=17

[fairy2_certificute_examined]
basevar=queencure_multi
startbit=18
endbit=18

[fairy2_chefchat]
