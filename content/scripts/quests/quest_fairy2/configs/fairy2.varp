// EASCape: Fairytale II's and the fairy rings' variables, as the August 2007 cache has them
// (varps 810 queencure_multi and 816 fairyrings_multi; RuneLite gameval VarPlayerID names). Our
// ids are new ones after ours; the bits within them are the cache's (fairy2.varbit).
[queencure_multi]
scope=perm
transmit=yes

[fairyrings_multi]
scope=perm
transmit=yes

// EASCape: where your next star flower is coming up on the cosmic entity's plane (the shoot that
// blooms on the next tick of ft2_starflowers); ours
[ft2_starflower_spot]
type=coord
