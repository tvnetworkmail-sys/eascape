// EASCape: the potion of magic essence, from Void (skill/herblore: potion_unfinished.recipes.toml
// magic_essence_unf_potion and potion.recipes.toml magic_essence_finished): a star flower in a
// vial of water (57 Herblore, no experience), then gorak claw powder (57, 130 experience)
[ft2_unf_magic_essence]
param=brew_potion_ingredient,ft2_star_flower
param=brew_potion_solvent,vial_water
param=brew_potion_level,57
param=brew_potion_message,You put the Star flower into the vial of water.
param=brew_potion_mixture,ft2_unfinished_potion

[ft2_magic_essence]
param=brew_potion_ingredient,ft2_gorak_claw_powder
param=brew_potion_solvent,ft2_unfinished_potion
param=brew_potion_level,57
param=brew_potion_exp,1300
param=brew_potion_message,You mix the gorak claw powder into your potion.
param=brew_potion_mixture,ft2_magic_essence_3
