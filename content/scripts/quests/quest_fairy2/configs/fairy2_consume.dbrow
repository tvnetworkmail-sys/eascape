// EASCape: drinking magic essence raises Magic by 3 (Void PotionEffects.kt: magic_essence boosts
// Magic by 3); the message is ours, in the other potions' words
[ft2_magic_essence_consumable_effect]
table=consume_table
data=consumable,ft2_magic_essence_4
data=consumable,ft2_magic_essence_3
data=consumable,ft2_magic_essence_2
data=consumable,ft2_magic_essence_1
data=stat_change,magic,3,0

[ft2_magic_essence_consume_messages]
table=consume_messages_table
data=consumable,ft2_magic_essence_4
data=consumable,ft2_magic_essence_3
data=consumable,ft2_magic_essence_2
data=consumable,ft2_magic_essence_1
data=consume_message1,You drink some of your magic essence potion.
data=message_delay,1
