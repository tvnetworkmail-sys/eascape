[questhelper_step_chompybird_1]
table=questhelper_step
data=id,14001
data=section,0
data=text,Talk to Rantz in the east of Feldip Hills.
data=npc,rantz
data=coord,0_41_46_7_38
data=option,Yes.
data=option,"Ok, I'll make you some 'stabbers'."

[questhelper_step_chompybird_2]
table=questhelper_step
data=id,14002
data=section,0
data=text,Get some achey tree logs near Rantz.
data=loc,achey_tree
data=coord,0_41_46_3_31

[questhelper_step_chompybird_3]
table=questhelper_step
data=id,14003
data=section,0
data=text,Use your knife on the achey logs to make arrow shafts.
data=item,knife,1
data=item,achey_tree_logs,1

[questhelper_step_chompybird_4]
table=questhelper_step
data=id,14004
data=section,0
