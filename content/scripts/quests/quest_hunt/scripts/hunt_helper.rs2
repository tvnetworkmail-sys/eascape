// EASCape: Quest Helper for Pirate's Treasure, converted from RuneLite's Quest Helper (piratestreasure, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC ZEMBO not matched
//   NpcHintArrowRequirement not carried over

[proc,questhelper_hunt]()(int)
def_int $v = %hunt;
if ($v > 3) {
    return(0); // done
}
if ($v >= 3) {
    return(5);
}
if ($v >= 2) {
    if (~qh_hunt_c1 = true) {
        return(4);
    }
    if (~qh_hunt_c2 = true) {
        return(3);
    }
    return(2);
}
if ($v >= 1) {
    return(17);
}
if ($v >= 0) {
    return(1);
}
return(1);

[proc,qh_hunt_c1]()(boolean)
if (calc(inv_total(inv, piratemessage) + inv_total(worn, piratemessage)) >= 1) return(true);
return(false);

[proc,qh_hunt_c2]()(boolean)
if (inzone(1_50_52_13_63, 1_50_53_34_13, coord) = true) return(true);
return(false);
