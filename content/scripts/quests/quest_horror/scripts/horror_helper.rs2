[proc,questhelper_horror]()(int)
def_int $v = %horrorquest;
if ($v > 5) {
    return(0); // done
}
if ($v >= 5) {
    if (~qh_horror_c1 = true) {
        return(20);
    }
    if (~qh_horror_c2 = true) {
        return(19);
    }
    if (~qh_horror_c3 = true) {
        return(11);
    }
    return(6);
}
if ($v >= 4) {
    if (~qh_horror_c4 = true) {
