    }
    if (~qh_horror_c12 = true) {
        return(14);
    }
    if (~qh_horror_c15 = true) {
        return(15);
    }
    if (~qh_horror_c18 = true) {
        return(16);
    }
    if (~qh_horror_c21 = true) {
        return(17);
    }
    if (~qh_horror_c24 = true) {
        return(18);
    }
    if (~qh_horror_c3 = true) {
        return(11);
    }
    if (~qh_horror_c25 = true) {
        return(24);
    }
    if (~qh_horror_c26 = true) {
        return(12);
    }
    return(6);
}
if ($v >= 3) {
    if (~qh_horror_c29 = true) {
        return(10);
    }
    if (~qh_horror_c30 = true) {
        return(9);
    }
    if (~qh_horror_c26 = true) {
        return(8);
    }
    if (~qh_horror_c25 = true) {
        return(23);
    }
    if (~qh_horror_c3 = true) {
        return(7);
    }
    return(6);
}
if ($v >= 2) {
    if (~qh_horror_c29 = true) {
        return(10);
    }
    if (~qh_horror_c30 = true) {
        return(9);
    }
    if (~qh_horror_c26 = true) {
        return(8);
    }
    if (~qh_horror_c25 = true) {
        return(23);
    }
    if (~qh_horror_c3 = true) {
        return(7);
    }
    return(6);
}
if ($v >= 1) {
    if (~qh_horror_c34 = true) {
        return(5);
    }
    if (~qh_horror_c35 = true) {
        return(4);
    }
    if (~qh_horror_c31 = true) {
        return(3);
    }
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);

