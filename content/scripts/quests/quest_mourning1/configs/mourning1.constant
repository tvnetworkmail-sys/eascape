// Mourning's End Part I (19 July 2005): %mourning_quest (the cache's varp 517, as Void names it).
// The stage numbers are ours (no source gives the 2005 values); the steps are the RS wiki's
// transcript (Head Mourner, the quest ending in the Mourner basement) and the OSRS wiki's guide.
^me1_not_started = 0
^me1_started = 1
^me1_arianwyn = 2
^me1_recruit = 3
^me1_sheep_done = 4
^me1_poison = 5
^me1_complete = 10
^me1_questpoints = 2

// %mourning_gnome (the cache's varbit 8-11 of mourning_quest_bits: 0-6 he is on the rack, 7 and
// up the rack is empty and he stands beside it). Our steps:
^me1_gnome_none = 0
^me1_gnome_asked = 1
^me1_gnome_weakness = 2
^me1_gnome_tickled = 3
^me1_gnome_agreed = 4
^me1_gnome_fixing = 7
^me1_gnome_fixed = 8
^me1_gnome_free = 9

// %mourning_gun_ammo (the cache's varbit): the toad in the fixed device (ours: the toads' obj order)
^me1_ammo_none = 0
^me1_ammo_blue = 1
^me1_ammo_red = 2
^me1_ammo_yellow = 3
^me1_ammo_green = 4

// %mourning_elena (the cache's varbit): ours
^me1_elena_none = 0
^me1_elena_asked = 1
^me1_elena_apple = 2
^me1_elena_told = 3

// %me1_oron: Oronwen and the trousers (ours)
^me1_oron_none = 0
^me1_oron_shown = 1
^me1_oron_allin = 2
^me1_oron_mending = 3
^me1_oron_done = 4

// ours: how long Oronwen, Elena and the gnome take ("a minute", the RS wiki; the gnome "after
// some time")
^me1_wait = 100
