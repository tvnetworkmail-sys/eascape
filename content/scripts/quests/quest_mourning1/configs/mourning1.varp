// EASCape: ours. Mourning's End Part I's other progress (mourning1.varbit). The cache's own
// mourning_quest and mourning_quest_bits hold the stage, the gnome, the sheep, the toad in the
// device, Elena and the food stores.
[me1_bits]
scope=perm

// EASCape: ours. When Oronwen, Elena or the gnome will be done (map_clock).
[me1_oron_clock]
scope=perm

[me1_elena_clock]
scope=perm

[me1_gnome_clock]
scope=perm

// EASCape: ours. Where the fixed device is aimed (the aim and fire window).
[me1_aim]
type=coord
