[proc,questhelper_scorpcatcher]()(int)
def_int $v = %scorpcatcher;
if ($v > 3) {
    return(0); // done
}
if ($v >= 3) {
    if (~qh_scorpcatcher_c1 = true) {
        if (~qh_scorpcatcher_c3 = true) {
            return(14);
        }
        if (~qh_scorpcatcher_c5 = true) {
            return(13);
        }
        if (~qh_scorpcatcher_c8 = true) {
            return(8);
        }
        if (~qh_scorpcatcher_c10 = true) {
            return(7);
        }
        if (~qh_scorpcatcher_c14 = true) {
            return(11);
        }
        if (~qh_scorpcatcher_c15 = true) {
            return(9);
        }
        return(6);
    }
    if (~qh_scorpcatcher_c18 = true) {
        return(16);
    }
    if (~qh_scorpcatcher_c19 = true) {
        return(15);
    }
    if (~qh_scorpcatcher_c22 = true) {
        return(18);
    }
    if (~qh_scorpcatcher_c23 = true) {
        return(17);
    }
    if (~qh_scorpcatcher_c24 = true) {
        return(19);
    }
    if (~qh_scorpcatcher_c25 = true) {
        return(2);
    }
    if (~qh_scorpcatcher_c26 = true) {
        return(3);
    }
    return(4);
}
if ($v >= 2) {
    if (~qh_scorpcatcher_c1 = true) {
        if (~qh_scorpcatcher_c3 = true) {
            return(14);
        }
        if (~qh_scorpcatcher_c5 = true) {
            return(13);
        }
        if (~qh_scorpcatcher_c8 = true) {
            return(8);
        }
        if (~qh_scorpcatcher_c10 = true) {
            return(7);
        }
        if (~qh_scorpcatcher_c14 = true) {
            return(11);
        }
        if (~qh_scorpcatcher_c15 = true) {
            return(9);
        }
        return(6);
    }
    if (~qh_scorpcatcher_c18 = true) {
        return(16);
    }
    if (~qh_scorpcatcher_c19 = true) {
        return(15);
    }
    if (~qh_scorpcatcher_c22 = true) {
        return(18);
    }
    if (~qh_scorpcatcher_c23 = true) {
        return(17);
    }
    if (~qh_scorpcatcher_c24 = true) {
        return(19);
    }
    if (~qh_scorpcatcher_c25 = true) {
        return(2);
    }
    if (~qh_scorpcatcher_c26 = true) {
        return(3);
    }
    return(4);
}
if ($v >= 1) {
    return(5);
}
if ($v >= 0) {
    if (~qh_scorpcatcher_c24 = true) {
        return(1);
    }
    if (~qh_scorpcatcher_c25 = true) {
        return(2);
    }
    if (~qh_scorpcatcher_c26 = true) {
        return(3);
    }
    return(4);
}
return(1);

[proc,qh_scorpcatcher_c1]()(boolean)
if (calc(inv_total(inv, scorpioncageempty) + inv_total(worn, scorpioncageempty)) >= 1) return(true);
return(false);

[proc,qh_scorpcatcher_c2]()(boolean)
if (inzone(0_44_153_58_1, 0_45_153_0_6, coord) = true) return(true);
return(false);

