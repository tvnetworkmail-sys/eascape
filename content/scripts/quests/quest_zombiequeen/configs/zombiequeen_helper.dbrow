[questhelper_step_zombiequeen_1]
table=questhelper_step
data=id,68001
data=section,0
data=text,Talk to Mosol Rei east of Shilo Village in south Karamja to receive a wampum belt.
data=npc,mosol_rei
data=coord,0_45_46_4_7
data=option,Why do I need to run?
data=option,Rashiliyia? Who is she?
data=option,I'll go to see the Shaman.
data=option,"Yes, I'm sure and I'll take the Wampum belt to Trufitus."
data=option,What can we do?

[questhelper_step_zombiequeen_2]
table=questhelper_step
data=id,68002
data=section,0
data=text,Show the wampum belt to Trufitus in Tai Bwo Wannai village.
data=npc,trufitus
data=coord,0_43_48_57_13
data=option,Mosol gave me something to show you.
data=option,Mosol Rei said something about a legend?
data=option,Why was it called Ah Za Rhoon?
data=option,I am going to search for Ah Za Rhoon!
data=option,Yes.

