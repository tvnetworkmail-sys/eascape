data=required,spade,1
data=required,fishing_rod,1
data=skill,10 Fishing
data=section,Steps

[questhelper_step_fishingcompo_1]
table=questhelper_step
data=id,26001
data=section,0
data=text,Talk to Vestri just north of Catherby.
data=npc,tunnel_dwarf1
data=coord,0_44_54_5_30
data=option,I was wondering what was down those stairs?
data=option,Why not?
data=option,If you were my friend I wouldn't mind it.
data=option,"Well, let's be friends!"
data=option,And how am I meant to do that?
data=option,Yes.

[questhelper_step_fishingcompo_2]
table=questhelper_step
data=id,26002
data=section,0
data=text,Speak to Bonzo to start the competition.
data=npc,bonzo
data=coord,0_41_53_17_45
data=option,I'll enter the competition please.
data=item,coins,5

[questhelper_step_fishingcompo_3]
table=questhelper_step
data=id,26003
data=section,0
data=text,Pick the garlic up on the table in Seers' Village.
data=coord,0_42_54_26_22

[questhelper_step_fishingcompo_4]
table=questhelper_step
data=id,26004
data=section,0
data=text,Enter McGrubor's Woods via the northern entrance.
data=loc,mcgruborlooserailing
data=coord,0_41_54_38_44
data=option,Be careful of the Guard Dogs (level 44). They are aggressive!

[questhelper_step_fishingcompo_5]
table=questhelper_step
data=id,26005
data=section,0
data=text,Use your spade on the red vines to gather 1 Red Vine Worm.
data=loc,red_worm_junction
data=coord,0_41_54_7_40

[questhelper_step_fishingcompo_6]
table=questhelper_step
data=id,26006
data=section,0
data=text,Enter Hemenster with your fishing pass.
data=loc,fishinggateclosedr
data=coord,0_41_53_18_49

[questhelper_step_fishingcompo_7]
table=questhelper_step
data=id,26007
data=section,0
data=text,Speak to Grandpa Jack to get a fishing rod. You can leave McGrubor's Woods via the northern entrance.
data=npc,grandpa_jack
data=coord,0_41_53_25_59
data=option,Can I buy one of your fishing rods?
data=option,"Very fair, I'll buy that rod!"
data=item,coins,5

