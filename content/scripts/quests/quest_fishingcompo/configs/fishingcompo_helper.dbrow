[questhelper_step_fishingcompo_11]
table=questhelper_step
data=id,26011
data=section,0
data=text,Speak to Bonzo again after you have caught the winning fish.
data=npc,bonzo
data=coord,0_41_53_17_45
data=option,I have this big fish. Is it enough to win?
data=item,raw_giant_carp,1

