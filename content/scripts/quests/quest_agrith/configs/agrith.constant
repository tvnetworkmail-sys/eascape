// Shadow of the Storm (14 November 2005). The stage is the 377 cache's own %agrith_quest (varbit,
// bits 0-6 of agrith_quest_varp). The cache's multinpcs and multilocs use the stages 0, 10, 20 ...
// 120, 124 and 125: Father Reen stands south of Al Kharid bank at 0-20, Evil Dave guards the
// portal at 10-70, the broken kilns can be looked in at 60, the sandstorm blows and Eric's rubble
// lies in the passage at 90-110, Tanya falls to the ghosts at 90. What each stage means is ours,
// fitted to those and to the OSRS and RS wikis' walkthroughs.
^agrith_not_started = 0
^agrith_started = 10        // Father Reen: go and see Father Badden in Uzer
^agrith_badden = 20         // Badden: infiltrate the dark wizards (Evil Dave)
^agrith_joined = 30         // Evil Dave took you to Denath
^agrith_incantation = 40    // Denath taught you the incantation: make a sigil
^agrith_josef = 50          // Matthew told you of Josef and his book
^agrith_kilns = 60          // the golem saw Josef hide the book in a kiln (the cache: Look-in)
^agrith_tome = 70           // you found the demonic tome
^agrith_ritual = 80         // Matthew read the tome; Denath calls the ritual
^agrith_desummoned = 90     // the backwards ritual: Denath is gone (the cache: Tanya falls)
^agrith_gathering = 100     // Tanya is dead: find four more people
^agrith_ready = 110         // eight in the circle: lead the ritual forwards
^agrith_summoned = 120      // Agrith-Naar is here (the cache's sandstorm stops)
^agrith_slain = 124         // he is dead; Darklight, and the experience still to choose
^agrith_complete = 125
^agrith_questpoints = 1

// the incantation's words, as the OSRS wiki's transcript lists them in "Select a word." (the
// cache's agrith_incantation_1-5 hold Denath's order, one word each)
^agrith_word_caldar = 1
^agrith_word_nahudu = 2
^agrith_word_agrith = 3
^agrith_word_camerinthum = 4
^agrith_word_tarren = 5

// %agrith_convinced_dave (the cache: 1 shows him in the passage, 2 walking)
^agrith_dave_passage = 1
^agrith_dave_walking = 2
^agrith_dave_inside = 3     // ours: in the throne room
// %agrith_badden_uzer and %agrith_reen_uzer (the cache: 1 shows them in Uzer, 2 walking)
^agrith_priest_uzer = 1
^agrith_priest_walking = 2
^agrith_priest_inside = 3   // ours: in the throne room
// %agrith_convinced_golem (ours: the cache's walking golem is golem_clay 5)
^agrith_golem_reprogrammed = 1
^agrith_golem_inside = 2
^agrith_golem_clay_walking = 5  // the cache's agrith_golem_walking
^agrith_golem_clay_gone = 6     // ours: neither golem shows in Uzer

// places (the 377 maps' own spawns and locs)
^agrith_reen_alkharid = 0_51_49_7_22    // agrith_reen_alkharid's spawn
^agrith_badden_spot = 0_54_48_27_18     // agrith_badden_uzer's spawn
^agrith_reen_spot = 0_54_48_27_21       // agrith_reen_uzer's spawn
^agrith_golem_spot = 0_54_48_32_18      // golem_golem's spawn
^agrith_stairs_top = 0_54_48_36_18      // golem_insidestairs_top
^agrith_surface_arrive = 0_54_48_35_18  // where golem_insidestairs_base puts you
^agrith_basement_arrive = 0_42_76_33_22 // where golem_insidestairs_top puts you
^agrith_dave_passage_spot = 0_42_76_35_33 // agrith_dave_in_passage's spawn
^agrith_portal_door = 0_42_76_32_48     // golem_portal
^agrith_portal_outside = 0_42_76_25_49  // where golem_demon_portal puts you
^agrith_throne_arrive = 2_42_76_32_20   // where golem_portal puts you
^agrith_throne_portal = 2_42_76_31_19   // golem_demon_portal
// the throne room (ours: the room's floor between its pillars; the pillars are 3 by 3, so the
// places below keep clear of them)
^agrith_throne_sw = 2_42_76_26_19
^agrith_throne_ne = 2_42_76_36_49
