^agrith_circle = 2_42_76_30_34          // the 3 by 3 summon_floor_spotanim_loc (its south-west)
^agrith_naar_spot = 2_42_76_30_34       // Agrith-Naar is 3 by 3 too
^agrith_head = 2_42_76_31_38            // the head of the circle: you lead the incantation here
^agrith_circle_1 = 2_42_76_33_38
^agrith_circle_2 = 2_42_76_34_36
