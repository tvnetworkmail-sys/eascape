[questhelper_step_routequest_1]
table=questhelper_step
data=id,53001
data=section,0
data=text,Talk to Vanstrom Klause in the Canifis pub.
data=npc,route_vanstrom_klause_sitting
data=coord,0_54_54_47_21
data=option,Yes.

[questhelper_step_routequest_2]
table=questhelper_step
data=id,53002
data=section,0
data=text,Fill a druid pouch with at least 5 Mort Myre items. Try to have more in case a ghast hits you.
data=option,I'd better be off.
data=item,druid_pouch,5

[questhelper_step_routequest_3]
table=questhelper_step
data=id,53003
data=section,0
data=text,Talk to Cyreg in Mort'ton.
data=npc,route_cyreg_paddlehorn
data=coord,0_55_51_2_20
data=option,I'd better be off.
data=option,"Well, I guess they'll just die without weapons."
data=option,Resourceful enough to get their own steel weapons?
data=option,"If you don't tell me, their deaths are on your head!"
data=option,What kind of a man are you to say that you don't care?
data=option,Here are some planks for you.
data=item,druid_pouch,5
data=item,steel_longsword,1
data=item,steel_sword,2
data=item,steel_dagger,1
data=item,steel_mace,1
data=item,nails,225

