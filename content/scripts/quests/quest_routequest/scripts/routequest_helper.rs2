[proc,qh_routequest_c1]()(boolean)
if (inzone(0_54_153_46_37, 0_54_153_59_54, coord) = true) return(true);
return(false);

[proc,qh_routequest_c2]()(boolean)
if (inzone(0_53_153_58_0, 2_54_153_48_55, coord) = true) return(true);
return(false);

[proc,qh_routequest_c3]()(boolean)
if (inzone(0_54_53_24_38, 0_54_54_57_8, coord) = true) return(true);
return(false);

[proc,qh_routequest_c4]()(boolean)
if (~qh_routequest_c3 = false) return(false);
return(true);

[proc,qh_routequest_c5]()(boolean)
if (inzone(0_54_53_46_34, 0_54_53_46_38, coord) = true) return(true);
return(false);

[proc,qh_routequest_c6]()(boolean)
if (%bridgerung2 = 1) return(true);
return(false);

[proc,qh_routequest_c7]()(boolean)
if (~qh_routequest_c5 = false) return(false);
if (~qh_routequest_c6 = false) return(false);
return(true);

[proc,qh_routequest_c8]()(boolean)
