// EASCape: Quest Helper for Family Crest, converted from RuneLite's Quest Helper (familycrest, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   ItemOnTileRequirement not carried over
//   NPC AVAN_FITZHARMON_AVAN_1OP not matched
//   NPC AVAN_FITZHARMON_MAN not matched
//   NPC CALEB_FITZHARMON_1OP not matched
//   NPC JOHNATHON_FITZHARMON_1OP not matched

[proc,questhelper_crest]()(int)
def_int $v = %crestquest;
if ($v > 10) {
    return(0); // done
}
if ($v >= 10) {
    if (~qh_crest_c1 = true) {
        return(28);
    }
    if (~qh_crest_c2 = true) {
        return(27);
    }
    if (~qh_crest_c3 = true) {
        return(24);
    }
    return(25);
}
if ($v >= 9) {
    if (~qh_crest_c4 = true) {
        return(23);
    }
    return(21);
}
if ($v >= 8) {
    if (~qh_crest_c4 = true) {
        return(22);
    }
    return(21);
}
if ($v >= 7) {
    if (~qh_crest_c7 = true) {
        return(20);
    }
    if (~qh_crest_c5 = true) {
        return(19);
    }
    if (~qh_crest_c10 = true) {
        return(17);
    }
    if (~qh_crest_c9 = true) {
        return(18);
    }
    if (~qh_crest_c11 = true) {
        return(17);
    }
    if (~qh_crest_c14 = true) {
        return(16);
    }
    if (~qh_crest_c16 = true) {
        return(15);
    }
    if (~qh_crest_c18 = true) {
        return(14);
    }
    if (~qh_crest_c20 = true) {
        return(13);
    }
    if (~qh_crest_c19 = true) {
        return(12);
    }
    if (~qh_crest_c15 = true) {
        return(11);
    }
    if (~qh_crest_c17 = true) {
        return(10);
    }
    if (~qh_crest_c21 = true) {
        return(29);
    }
    return(9);
}
if ($v >= 6) {
    if (~qh_crest_c22 = true) {
        return(7);
    }
    return(8);
}
if ($v >= 5) {
    return(6);
}
if ($v >= 4) {
    return(5);
}
if ($v >= 3) {
    return(4);
}
if ($v >= 2) {
    return(3);
}
if ($v >= 1) {
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);

[proc,qh_crest_c1]()(boolean)
if (calc(inv_total(inv, family_crest) + inv_total(worn, family_crest)) >= 1) return(true);
return(false);

[proc,qh_crest_c2]()(boolean)
if (calc(inv_total(inv, johnathon_crest) + inv_total(worn, johnathon_crest)) >= 1) return(true);
return(false);

[proc,qh_crest_c3]()(boolean)
