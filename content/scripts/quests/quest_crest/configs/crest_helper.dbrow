data=id,16001
data=section,0
data=text,Talk to Dimintheis in south east Varrock.
data=npc,dimintheis
data=coord,0_51_53_16_10
data=option,Why would a nobleman live in a dump like this?
data=option,So where is this crest?
data=option,"Ok, I will help you."

