// EASCape: Quest Helper for Biohazard, converted from RuneLite's Quest Helper (biohazard, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC KILRON_VIS not matched
//   NPC KINGLATHAS_VIS not matched
//   NPC MOURNERSTEW2_VIS not matched
//   NPC OMART_VIS not matched

[proc,questhelper_biohazard]()(int)
def_int $v = %biohazard;
if ($v > 15) {
    return(0); // done
}
if ($v >= 15) {
    return(-1); // ('name', 'talkToTheKing')
}
if ($v >= 14) {
    return(20);
}
if ($v >= 12) {
    return(-1); // ('name', 'smuggleInChemicals')
}
if ($v >= 10) {
    return(23);
}
if ($v >= 7) {
    return(-1); // ('name', 'returnToElenaWithDistillator')
}
if ($v >= 6) {
    return(-1); // ('name', 'infiltrateMourners')
}
if ($v >= 5) {
    return(-1); // ('name', 'poisonFood')
}
if ($v >= 4) {
    return(7);
}
if ($v >= 3) {
    return(-1); // ('name', 'causeADistraction')
}
if ($v >= 2) {
    return(-1); // ('name', 'prepareADistraction')
}
if ($v >= 1) {
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);
