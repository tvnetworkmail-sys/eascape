// EASCape: Quest Helper for Biohazard, converted from RuneLite's Quest Helper (biohazard, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC KILRON_VIS not matched
//   NPC KINGLATHAS_VIS not matched
//   NPC MOURNERSTEW2_VIS not matched
//   NPC OMART_VIS not matched
//   VarbitRequirement ('field', ('name', 'VarbitID'), 'BIOHAZARD_FREE_CLOTHES') not in our game

[proc,questhelper_biohazard]()(int)
def_int $v = %biohazard;
if ($v > 15) {
    return(0); // done
}
if ($v >= 15) {
    if (~qh_biohazard_c1 = true) {
        return(21);
    }
    return(22);
}
if ($v >= 14) {
    return(20);
}
if ($v >= 12) {
    if (~qh_biohazard_c9 = true) {
        return(24);
    }
    if (~qh_biohazard_c10 = true) {
        return(26);
    }
    if (~qh_biohazard_c11 = true) {
        return(27);
    }
    if (~qh_biohazard_c12 = true) {
        return(28);
    }
    if (~qh_biohazard_c2 = true) {
        return(29);
    }
    if (~qh_biohazard_c13 = true) {
        return(30);
    }
    return(31);
}
if ($v >= 10) {
    return(23);
}
if ($v >= 7) {
    if (~qh_biohazard_c16 = true) {
        return(18);
    }
    if (~qh_biohazard_c18 = true) {
        return(19);
    }
    if (~qh_biohazard_c15 = true) {
        return(17);
    }
    if (~qh_biohazard_c20 = true) {
        return(16);
    }
    if (~qh_biohazard_c14 = true) {
        return(15);
    }
    if (~qh_biohazard_c21 = true) {
        return(14);
    }
    if (~qh_biohazard_c23 = true) {
        return(13);
    }
    if (~qh_biohazard_c17 = true) {
        return(11);
    }
    return(7);
}
if ($v >= 6) {
    if (~qh_biohazard_c24 = true) {
        return(12);
    }
    if (~qh_biohazard_c20 = true) {
        return(16);
    }
    if (~qh_biohazard_c14 = true) {
        return(15);
    }
    if (~qh_biohazard_c21 = true) {
        return(14);
    }
    if (~qh_biohazard_c23 = true) {
        return(13);
    }
    if (~qh_biohazard_c17 = true) {
        return(11);
    }
    return(7);
}
if ($v >= 5) {
    if (~qh_biohazard_c26 = true) {
        return(10);
    }
    if (~qh_biohazard_c24 = true) {
        return(9);
    }
    if (~qh_biohazard_c17 = true) {
        return(8);
    }
    return(7);
}
if ($v >= 4) {
    return(7);
}
if ($v >= 3) {
    if (~qh_biohazard_c27 = true) {
        return(6);
    }
    return(4);
}
if ($v >= 2) {
    if (~qh_biohazard_c29 = true) {
        return(3);
    }
    if (~qh_biohazard_c30 = true) {
        return(4);
    }
    return(5);
}
if ($v >= 1) {
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);

[proc,qh_biohazard_c1]()(boolean)
if (inzone(1_40_51_10_19, 1_40_51_30_46, coord) = true) return(true);
return(false);

[proc,qh_biohazard_c2]()(boolean)
if (inzone(0_51_52_1_48, 1_51_53_23_15, coord) = true) return(true);
return(false);

[proc,qh_biohazard_c3]()(boolean)
if (calc(inv_total(inv, liquid_honey) + inv_total(worn, liquid_honey)) >= 1) return(true);
return(false);

[proc,qh_biohazard_c4]()(boolean)
