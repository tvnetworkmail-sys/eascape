[questhelper_guide_ikov]
table=questhelper_guide
data=guide,^qh_ikov
data=key,ikov
data=name,Temple of Ikov
data=journal,Temple of Ikov
data=difficulty,Experienced
data=start,Talk to Lucien in the Flying Horse Inn in East Ardougne.
data=required,limpwurt_root,20
data=skill,"A light source (lit candle, torch or lantern) and a tinderbox"
data=skill,A bow that fires ice arrows (shortbow or longbow)
data=skill,Level 42 Thieving
data=skill,Level 40 Ranged
data=skill,You must weigh under 0 kg to cross the lava bridge
data=reward,1 Quest Point
data=reward,"10,500 Ranged experience"
data=reward,"8,000 Fletching experience"
data=section,Starting off
data=section,The boots and the lever
data=section,The Fire Warrior
data=section,Winelda and the Guardians

[questhelper_step_ikov_1]
table=questhelper_step
data=id,5001
data=section,0
data=text,Talk to Lucien in the Flying Horse Inn in East Ardougne and agree to get the Staff of Armadyl.
data=npc,ikov_lucien1
data=coord,0_40_51_13_57
data=option,I'm a mighty hero!
data=option,That sounds like a laugh!

[questhelper_step_ikov_2]
table=questhelper_step
data=id,5002
data=section,0
data=text,"With a light source, a bow and 20 limpwurt roots, climb down the ladder into the Temple of Ikov, by the statues north-east of East Ardougne."
data=loc,loc_1754
data=coord,0_41_53_53_13

[questhelper_step_ikov_3]
table=questhelper_step
data=id,5003
data=section,1
data=text,Go down the dark stairs in the west with your light source lit.
data=loc,ikov_darkstairsdown
data=coord,0_41_153_26_12

[questhelper_step_ikov_4]
table=questhelper_step
data=id,5004
data=section,1
data=text,"Pick up the boots of lightness, then go back up the stairs."
data=obj,ikov_bootsoflightness
data=coord,0_41_152_30_39

[questhelper_step_ikov_5]
table=questhelper_step
data=id,5005
data=section,1
data=text,"Wear the boots of lightness and bank or drop enough to weigh under 0 kg, cross the lava bridge and pick up the lever on the far side."
data=obj,ikov_lever
data=coord,0_41_153_13_27
data=item,ikov_bootsoflightness,1

[questhelper_step_ikov_6]
table=questhelper_step
data=id,5006
data=section,1
data=text,"Use the lever on the lever bracket in the east, then pull it to open the gate south of it."
data=loc,ikov_leverbracket
data=coord,0_41_153_47_12
data=item,ikov_lever,1

[questhelper_step_ikov_7]
table=questhelper_step
data=id,5007
data=section,2
data=text,Go through the south gate and search the chests in the ice spiders' cave until you find ice arrows.
data=loc,ikov_chestclosed
data=coord,0_42_153_41_58

[questhelper_step_ikov_8]
table=questhelper_step
data=id,5008
data=section,2
data=text,"Wear Lucien's pendant, go through the north door (it fills you with fear without it) and search the lever for traps (Thieving 42)."
data=loc,ikov_traplever
data=coord,0_41_153_41_63
data=item,ikov_pendantoflucien,1

[questhelper_step_ikov_9]
table=questhelper_step
data=id,5009
data=section,2
data=text,Pull the lever.
data=loc,ikov_traplever
data=coord,0_41_153_41_63

[questhelper_step_ikov_10]
table=questhelper_step
data=id,5010
data=section,2
data=text,Go through the door to the west and kill the Fire Warrior of Lesarkus with ice arrows (wield a bow).
data=npc,ikov_firewarrior
data=coord,0_41_154_22_10
data=item,ice_arrow,1

[questhelper_step_ikov_11]
table=questhelper_step
data=id,5011
data=section,3
data=text,Talk to Winelda in the north.
data=npc,ikov_winelda
data=coord,0_41_154_32_19
data=option,Yes I do!

[questhelper_step_ikov_12]
table=questhelper_step
data=id,5012
data=section,3
data=text,Bring Winelda 20 limpwurt roots (not noted) and talk to her: she teleports you across.
data=npc,ikov_winelda
data=coord,0_41_154_32_19
data=item,limpwurt_root,20

[questhelper_step_ikov_13]
table=questhelper_step
data=id,5013
data=section,3
data=text,Take off Lucien's pendant and talk to a Guardian of Armadyl: side with them against Lucien.
data=npc,ikov_guardianmale
data=npc,ikov_guardianfemale
data=coord,0_41_154_14_43
data=option,I seek the Staff of Armadyl.
data=option,Lucien will give me a grand reward for it!
data=option,"You're right, it's time for my yearly bath."
data=option,Ok! I'll help!

[questhelper_step_ikov_14]
table=questhelper_step
data=id,5014
data=section,3
data=text,Take the Staff of Armadyl to Lucien in his house in north-west Varrock.
data=npc,ikov_lucien2
data=coord,0_49_54_40_20
data=option,Yes! Here it is.
data=item,ikov_staffofarmardyl,1

[questhelper_step_ikov_15]
table=questhelper_step
data=id,5015
data=section,3
data=text,Wear the Pendant of Armadyl and kill Lucien in his house in north-west Varrock.
data=npc,ikov_lucien2
data=coord,0_49_54_40_20
data=item,ikov_pendantofarmardyl,1
