// Desert Treasure: %deserttreasure (varbit 358, bits 0-14 of varp deserttreasuremain), from the 377
// cache's own varbits. The NPCs that come and go with the quest are multinpcs on it: Eblis in his
// house (0-10), Eblis by the mirrors (10-15), Azzanadra (13-14). Steps 0-14 match RuneLite's Quest
// Helper (DesertTreasure.java); 15 is complete (^deserttreasure_complete, quest.constant).
^dt_not_started = 0
^dt_got_etchings = 1
^dt_gave_etchings = 2
^dt_got_translation = 4
^dt_gave_translation = 5
^dt_agreed_help = 6
^dt_bought_drink = 7
^dt_heard_diamonds = 8
^dt_eblis_items = 9
^dt_eblis_mirrors = 10
^dt_diamonds = 11
^dt_placing = 12
^dt_pyramid = 13
^dt_azzanadra = 14

^deserttreasure_questpoints = 3

// what Eblis needs for his scrying glasses (Quest Helper's list; noted items count)
^dt_magic_logs = 12
^dt_steel_bars = 6
^dt_molten_glass = 6

// the Shadow Diamond (fd_shadowwarrior_quest)
^dt_shadow_rasolo = 2
^dt_shadow_ring = 3
^dt_shadow_damis1 = 4
^dt_shadow_done = 5

// the Blood Diamond (fdvw_subquest)
^dt_blood_malak = 1
^dt_blood_asked = 2
^dt_blood_killed = 3
^dt_blood_done = 4

// the Ice Diamond (fd_icewarrior_subquest)
^dt_ice_cake = 1
^dt_ice_talked = 2
^dt_ice_kamil = 3
^dt_ice_freed = 4
^dt_ice_done = 5

// the smoke dungeon's torches burn this long once lit (ticks); our choice, the wiki says only
// that they go out if you're slow
^dt_torch_time = 100
