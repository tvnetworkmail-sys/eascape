// EASCape: set by a magic or fire-arrow hit on a sarcophagus mummy, the only ones that harm it
[dt_mummy_hit]
type=int

// how many times Dessous has teleported to you (he leaves after the third)
[dt_dessous_teleports]
type=int

// the map_clock of Dessous' last attack (he goes back to his grave after 2 minutes without one)
[dt_dessous_active]
type=int

// the map_clock from which Kamil may freeze you again (you get a few ticks after thawing)
[dt_kamil_freeze_ready]
type=int
