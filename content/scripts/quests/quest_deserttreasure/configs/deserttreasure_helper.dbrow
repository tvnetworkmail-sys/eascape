[questhelper_guide_deserttreasure]
table=questhelper_guide
data=guide,^qh_deserttreasure
data=key,deserttreasure
data=name,Desert Treasure
data=journal,Desert Treasure
data=difficulty,Master
data=start,Talk to the Archaeologist in the Bedabin Camp in the desert.
data=required,coins,650
data=required,magic_logs,12
data=required,steel_bar,6
data=required,molten_glass,6
data=required,ashes,1
data=required,charcoal,1
data=required,bloodrune,1
data=required,bones,1
data=required,silver_bar,1
data=required,fd_crushed_garlic,1
data=required,spicespot,1
data=required,cake,1
data=required,death_spikedboots,1
data=required,slayer_facemask,1
data=required,tinderbox,1
data=required,ice_gloves,1
data=required,lockpick,1
data=skill,"The Dig Site, The Tourist Trap, Temple of Ikov, Priest in Peril, Waterfall Quest and Troll Stronghold"
data=skill,"Level 53 Thieving, 50 Magic, 50 Firemaking, 10 Slayer"
data=skill,"Able to defeat Fareed (167), Damis (103 and 174), Dessous (139), Kamil (154) and 5 ice trolls"
data=skill,Water spells or melee with ice gloves for Fareed; fire spells for Kamil
data=skill,While you carry a diamond a Stranger (level 95) may attack you
data=reward,3 Quest Points
data=reward,"20,000 Magic experience"
data=reward,The Ancient Magicks
data=reward,"An ancient staff from Eblis (80,000 coins)"
data=section,Starting off
data=section,Diamond of Smoke
data=section,Diamond of Shadow
data=section,Diamond of Blood
data=section,Diamond of Ice
data=section,Freeing Azzanadra

[questhelper_step_deserttreasure_1]
table=questhelper_step
data=id,801
data=section,0
data=text,Talk to the Archaeologist in the Bedabin Camp (the magic carpet from the Shantay Pass goes there).
data=npc,fourdiamonds_indiana
data=coord,0_49_47_42_35
data=option,Do you have any quests?
data=option,Yes.
data=option,"Yes, I'll help you."

