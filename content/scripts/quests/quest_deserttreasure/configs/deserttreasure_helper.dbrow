table=questhelper_step
data=id,802
data=section,0
data=text,"Take the etchings to the archaeological expert in the Exam Centre, south-east of Varrock."
data=npc,archaeological_expert
data=coord,0_52_52_27_5
data=option,Ask about the Desert Treasure quest.
data=item,four_diamonds_etchings,1

