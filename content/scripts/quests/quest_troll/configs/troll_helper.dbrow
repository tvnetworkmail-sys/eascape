[questhelper_guide_troll]
table=questhelper_guide
data=guide,^qh_troll
data=key,troll
data=name,Troll Stronghold
data=journal,Troll Stronghold
data=difficulty,Experienced
data=start,Talk to Denulth in his tent at the Imperial Guard camp in Burthorpe (after Death Plateau).
data=required,death_climbingboots,1
data=recommended,coins,12
data=skill,Level 15 Agility
data=skill,Level 30 Thieving (to take the cell keys without a fight)
data=skill,Able to defeat a level 113 troll
data=reward,1 Quest Point
data=reward,A law talisman
data=reward,The way to the troll country
data=section,Starting off
data=section,The Troll Champion
data=section,The stronghold
data=section,The prisoners

[questhelper_step_troll_1]
table=questhelper_step
data=id,401
data=section,0
data=text,Talk to Denulth in his tent at the Imperial Guard camp in Burthorpe and offer to get Godric back.
data=npc,death_ig_commander
data=coord,0_45_55_16_8
data=option,How goes your fight with the trolls?
data=option,Is there anything I can do to help?
data=option,I'll get Godric back!

[questhelper_step_troll_2]
table=questhelper_step
data=id,402
data=section,0
data=text,"Buy climbing boots from Tenzing the Sherpa, west of Burthorpe (12 coins)."
data=npc,death_sherpa
data=coord,0_44_55_4_36
data=option,Can I buy some Climbing boots?
data=item,coins,12

[questhelper_step_troll_3]
table=questhelper_step
data=id,403
data=section,1
data=text,"Wear the climbing boots, climb up Death Plateau and go through the door into the arena."
data=loc,troll_stronghold_arena_entrance_left
data=coord,0_45_56_17_34
data=item,death_climbingboots,1

[questhelper_step_troll_4]
table=questhelper_step
data=id,404
data=section,1
data=text,"Talk to the Troll Champion (Dad), accept his challenge and defeat him (level 113)."
data=npc,troll_champion
data=coord,0_45_56_31_28
data=option,I accept your challenge!

[questhelper_step_troll_5]
table=questhelper_step
data=id,405
data=section,1
data=text,Leave the arena by the north door.
data=loc,troll_stronghold_arena_exit_left
data=coord,0_45_56_36_45

[questhelper_step_troll_6]
table=questhelper_step
data=id,406
data=section,2
data=text,Go north-west over the rocks (Agility 15) to the Troll Stronghold and go in through the door.
data=loc,troll_stronghold_door
data=coord,0_44_57_23_41

[questhelper_step_troll_7]
table=questhelper_step
data=id,407
data=section,2
data=text,Kill one of the Troll Generals on the top floor of the stronghold for the prison key.
data=npc,troll_general
data=npc,troll_general2
data=npc,troll_general3
data=obj,troll_key_prison
data=coord,2_44_157_15_38

[questhelper_step_troll_8]
table=questhelper_step
data=id,408
data=section,2
data=text,Go down the stairs in the north of the stronghold.
data=loc,troll_stronghold_stairstop
data=coord,2_44_157_27_60

[questhelper_step_troll_9]
table=questhelper_step
data=id,409
data=section,2
data=text,Open the prison door with the prison key.
data=loc,troll_stronghold_prison_door_closed
data=coord,1_44_157_32_59
data=item,troll_key_prison,1

[questhelper_step_troll_10]
table=questhelper_step
data=id,410
data=section,2
data=text,Go down the stairs into the prison.
data=loc,troll_stronghold_stairstop
data=coord,1_44_157_36_59

[questhelper_step_troll_11]
table=questhelper_step
data=id,411
data=section,3
data=text,Pickpocket the sleeping prison guards (Thieving 30) or kill them for the cell keys: the first guard has Godric's.
data=npc,troll_prison_guard1
data=npc,troll_prison_guard2
data=obj,troll_key_godric
data=obj,troll_key_eadgar
data=coord,0_44_157_16_32

[questhelper_step_troll_12]
table=questhelper_step
data=id,412
data=section,3
data=text,Use cell key 1 on Godric's cell door.
data=loc,troll_celldoor_godric
data=coord,0_44_157_16_30
data=item,troll_key_godric,1

[questhelper_step_troll_13]
table=questhelper_step
data=id,413
data=section,3
data=text,Optional: use cell key 2 on Mad Eadgar's cell door to free him too.
data=loc,troll_celldoor_eadgar
data=coord,0_44_157_16_34
data=item,troll_key_eadgar,1

[questhelper_step_troll_14]
table=questhelper_step
data=id,414
data=section,3
data=text,Leave the stronghold by the door in the south-west of the prison level.
data=loc,troll_stronghold_exit
data=coord,0_44_157_7_0

[questhelper_step_troll_15]
table=questhelper_step
data=id,415
data=section,3
data=text,"Tell Dunstan, the smith in Burthorpe, that his son Godric is safe."
data=npc,death_smithy
data=coord,0_45_55_39_54
