// EASCape: Rag and Bone Man (quest_rag): the Odd Old Man, his wish list and Fortunato. Dialogue from
// the RuneScape wiki's transcript (Transcript:Rag and Bone Man) and, for the wish list, the OSRS
// wiki's (Transcript:Rag and Bone Man II, without its later "Can I have both?"). The sack on his
// back mumbles over his head (ours).

[proc,rag_sack](string $text)
npc_say($text);

[opnpc1,rag_odd_old_man]
if (%rag_quest = ^rag_not_started) {
    @rag_start;
}
if (%rag_quest = ^rag_started) {
    @rag_main_talk;
}
@rag_wish_talk;

// ---------------------------------------------------------------- starting
[label,rag_start]
~chatnpc("<p,neutral>Can I help you with something?");
~chatplayer("<p,confused>Well, err... who are you and what are all these bones doing here?");
~chatnpc("<p,confused>Err...");
~rag_sack("Mumblemumble.");
~chatnpc("<p,neutral>I'm an archeologist and I work with the museum.");
~chatplayer("<p,confused>An archeologist?");
~chatnpc("<p,neutral>Yes.");
~chatplayer("<p,confused>Well, that explains the bones - sort of - but what are you doing all the way out here?");
~chatnpc("<p,confused>Err...");
~rag_sack("Mumblemumble. Mumblemumblemumble.");
~chatnpc("<p,neutral>I'm collecting bones for the museum. They've asked me to rig up some displays of Second and Third Age creatures, using their bones, so that people can come and, well, look at them. I need to get them into some sort of order before I begin, but I've run into a bit of a snag.");
~chatplayer("<p,neutral>What sort of snag?");
~chatnpc("<p,sad>Well, I need to have all the bones I'm going to use here first, then I've got to put them in some sort of order. I seem to be a few bones short of a skeleton, though.");
@rag_start_choice;

[label,rag_start_choice]
switch_int (~p_choice3("Where is that mumbling coming from?", 1, "Anything I could do to help?", 2, "Well, good luck with that.", 3)) {
    case 1 :
        ~chatplayer("<p,confused>Where is that mumbling coming from?");
        ~chatnpc("<p,confused>Errr...");
        ~rag_sack("Mumblemumble.");
        ~chatnpc("<p,angry>What mumbling? I have enough problems of my own without having to deal with a delusional adventurer.");
        @rag_start_choice;
    case 2 :
        ~chatplayer("<p,neutral>Anything I could do to help?");
        ~chatnpc("<p,confused>Err...");
        ~rag_sack("Mumblemumble.");
        ~chatnpc("<p,neutral>There is something you could do for me. I'm going to be busy, er ...");
        ~rag_sack("Mumble.");
        ~chatnpc("<p,happy>Sorting! Yes, sorting these bones out ready for the museum. I still need a few more, though.");
        ~chatnpc("<p,neutral>Will you help me out?");
        if (~p_choice2("Yes, I'll give you a hand.", 1, "No.", 2) = 2) {
            ~chatplayer("<p,neutral>No.");
            ~chatnpc("<p,sad>Oh...I see.");
            ~chatnpc("<p,sad>Well, never mind me young man, I'll just stagger over here under my massive burden, and continue my thankless task.");
            ~chatnpc("<p,sad>Unaided and alone...");
            ~chatplayer("<p,confused>Wow, trying a guilt trip much?");
            return;
        }
        @rag_accept;
    case 3 :
        ~chatplayer("<p,happy>Well, good luck with that.");
        ~chatnpc("<p,happy>Thanks stranger!");
}

[label,rag_accept]
~chatplayer("<p,happy>Yes, I'll give you a hand.");
%rag_quest = ^rag_started;
~send_quest_progress(questlist:rag, %rag_quest, ^rag_complete);
~chatnpc("<p,happy>You will? Excellent!");
~rag_sack("Sniggersnigger.");
~chatplayer("<p,neutral>Where do you need me to dig?");
~chatnpc("<p,confused>Dig?");
~rag_sack("Mumblemumble.");
~chatnpc("<p,neutral>Oh, you must have got the wrong end of the stick. I need some fresh, whole bones to replace ones that have become damaged.");
~chatplayer("<p,confused>What?");
~chatnpc("<p,confused>Err...");
~rag_sack("Mumblemumblemumblemumblemumble. Mumblemumblemumblemumble. Mumble.");
~chatplayer("<p,confused>Excuse me?");
~rag_sack("Shh!");
~chatplayer("<p,sad>Sorry...");
~rag_sack("Mumblemumble. Mumblemumblemumble.");
~chatnpc("<p,neutral>Okay, got it. Here's the thing: while sorting out, what bones I do have I managed to lose or damage a few. If you can get me some fresh, unbroken bones to use as replacements, then I can get on with things. Does that make things clearer?");
~chatplayer("<p,neutral>Well, it makes some sense I suppose...");
~chatnpc("<p,happy>Great. If you can get me a bone from a goblin, a bear, a big frog, a ram, a unicorn, a monkey, a giant rat and a giant bat, then I'll be able to move on with the, er...");
~chatnpc("<p,neutral>...displays.");
~chatplayer("<p,neutral>So you just want me to bring you these bones and that will be that?");
~chatnpc("<p,neutral>Well, I wouldn't mind you boiling them in vinegar first, if you don't mind. There is a wine merchant in Draynor called Fortunato who sells the stuff you'll need. You can even use my pot boiler if you want.");
~chatplayer("<p,confused>Why do I need to boil them in vinegar?");
~chatnpc("<p,neutral>It gets them bright and sparkling white... It's an archeologist thing. Just put the bone in a pot of vinegar, throw some logs on the fire, put the pot on the boiler, then light the logs. It takes a short while for the vinegar to evaporate, but the bone will be nice and clean in the end.");
~chatplayer("<p,neutral>Alright, I'll be back later.");
~chatnpc("<p,happy>Bye!");

// ---------------------------------------------------------------- the first list
[label,rag_main_talk]
def_int $polished = ~rag_count_polished(0, ^rag_main_bones);
if ($polished > 0) {
    ~chatplayer("<p,happy>I have some bones for you.");
    ~chatnpc("<p,happy>Great! Let me take a look at them.");
    ~rag_hand_in(0, ^rag_main_bones);
    if (~rag_count_handed(0, ^rag_main_bones) >= ^rag_main_bones) {
        @rag_main_done;
    }
    ~chatnpc("<p,happy>Wonderful! I'll put these with the rest.");
    ~chatplayer("<p,neutral>No problem. I'll be back if I find some more.");
    return;
}
if (~rag_count_unclean(0, ^rag_main_bones) > 0) {
    ~chatplayer("<p,happy>I have some bones for you.");
    ~chatnpc("<p,neutral>Great! Just clean them up in the pot-boiler and hand them over.");
    return;
}
~chatnpc("<p,neutral>Have you brought me any bones?");
~chatplayer("<p,neutral>Not at the moment. Can you give me a rundown on which bones I have left to give?");
~chatnpc("<p,happy>Sure.");
def_int $i = 0;
while ($i < ^rag_main_bones) {
    if (~rag_handed($i) = false) {
        ~rag_sack("Mumblemumble.");
        ~chatnpc("<p,neutral>You still need to bring me a <~rag_main_name($i)> bone. <~rag_main_hint($i)>");
    }
    $i = add($i, 1);
}
~chatnpc("<p,neutral>Did you get all that?");
~chatplayer("<p,neutral>Yes, I'll get right on it.");
~chatnpc("<p,neutral>Don't forget to boil them in vinegar first. Just chuck some logs into the pit, put the bone into the pot of vinegar and drop it into the pot boiler. Then light the logs and wait for the vinegar to boil away.");
~chatplayer("<p,neutral>Okay, I'll remember.");

[label,rag_main_done]
~chatnpc("<p,happy>That's the last of them! The museum will be thrilled to know I've completed the collection.");
~chatplayer("<p,happy>Well, I'm glad I could help.");
~rag_sack("Mumblemumble.");
~chatnpc("<p,happy>You've been a big help and no mistake. I'm always on the lookout for fresh bones, so if you see any of the ones on my wish list, bring them right over. I have it pinned to the outside of my shack whenever you want to check it.");
~chatplayer("<p,happy>No problem. I'll be sure to bring you anything you might like. I can't wait to see the displays once they are finished.");
queue(rag_complete, 0, 0);

[queue,rag_complete]
if (%rag_quest >= ^rag_complete) return;
%rag_quest = ^rag_complete;
stat_advance(cooking, 5000);
stat_advance(prayer, 5000);
session_log(^log_adventure, "Quest complete: Rag and Bone Man");
~send_quest_complete(questlist:rag, rag_polished_goblin_bone, 250, ^rag_questpoints, "You have completed Rag and Bone Man!", "1 Quest Point|500 Cooking XP|500 Prayer XP");

// ---------------------------------------------------------------- the wish list
[label,rag_wish_talk]
if (~rag_wish_done = true) {
    @rag_reward_again;
}
def_int $polished = ~rag_count_polished(^rag_main_bones, ^rag_all_bones);
if ($polished > 0) {
    ~chatplayer("<p,happy>I have some bones for you.");
    ~chatnpc("<p,happy>Great! Let me take a look at them.");
    ~rag_hand_in(^rag_main_bones, ^rag_all_bones);
    if (~rag_count_handed(^rag_main_bones, ^rag_all_bones) >= calc(^rag_all_bones - ^rag_main_bones)) {
        @rag_wish_finished;
    }
    ~chatnpc("<p,happy>Wonderful! I'll put this with the rest.");
    ~chatplayer("<p,neutral>No problem. I'll be back if I find some more.");
    return;
}
if (~rag_count_unclean(^rag_main_bones, ^rag_all_bones) > 0) {
    ~chatplayer("<p,happy>I have some bones for you.");
    ~chatnpc("<p,neutral>Great! Just clean them up in the pot-boiler and hand them over.");
    return;
}
~chatplayer("<p,neutral>So how is the sorting going?");
~chatnpc("<p,confused>Err...");
~rag_sack("Mumblemumble");
~chatnpc("<p,happy>It's going well, especially now I have all the bones I need.");
~chatnpc("<p,neutral>There are still a few bits and pieces I wouldn't mind, but that's the way things go.");
~chatplayer("<p,neutral>Well if I see any bones I think you might like I'll bring them over.");
~chatnpc("<p,happy>Cheers, we, err, that is myself and the museum staff, really appreciate it.");
~rag_sack("Snicker.");

[label,rag_wish_finished]
~chatnpc("<p,shock>That...that covers all the bones I was searching for!");
~chatplayer("<p,happy>Well I'm glad to have furthered the cause of the museum.");
~chatplayer("<p,happy>I just hope everyone will enjoy the finished displays.");
~chatnpc("<p,happy>Yes, I'm sure EVERYONE will get a chance to enjoy my work.");
~chatnpc("<p,laugh>Hahahahahahahahahaha!");
~chatnpc("<p,laugh>Bwahahahahahahahahahahahahaha!");
~chatnpc("<p,laugh>MWUHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA!");
~rag_sack("Ahem!");
~chatnpc("<p,sad>Sorry.");
~chatnpc("<p,neutral>Well anyway, I have a few items I've put together in my spare time if you want one.");
~chatnpc("<p,neutral>I have a ram skull helm or a snazzy bonesack like mine.");
~chatnpc("<p,neutral>Which would you like?");
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Well, as much as I'd like to toss them into the dirt and all, I think it's best if you came back later with an empty backpack.");
    return;
}
if (~p_choice2("The helm.", 1, "The bonesack.", 2) = 1) {
    ~chatplayer("<p,neutral>The helm.");
    ~chatnpc("<p,happy>Good choice!");
    %rag_helmet = 1;
} else {
    ~chatplayer("<p,neutral>The bonesack.");
    ~chatnpc("<p,happy>Well chosen, I knew you had taste!");
    %rag_bonesack = 1;
}
~chatnpc("<p,happy>Come and see me if you lose that one, I have plenty more!");
queue(rag_wish_complete, 0, 0);

[queue,rag_wish_complete]
if (~rag_wish_done = true) return;
%rag_bones_main = setbit(%rag_bones_main, 8);
stat_advance(prayer, 50000);
def_namedobj $reward = rag_bonesack;
def_string $name = "Bonesack";
if (%rag_helmet = 1) {
    $reward = rag_ram_helm;
    $name = "Ram skull helm";
}
inv_add(inv, $reward, 1);
session_log(^log_adventure, "Quest complete: Rag and Bone Man's wish list");
~send_quest_complete(questlist:rag, $reward, 250, ^rag_wish_questpoints, "You have completed the Odd Old Man's wish list!", "1 Quest Point|5,000 Prayer XP|<$name>");

// lost it? he has plenty more
[label,rag_reward_again]
def_namedobj $reward = rag_bonesack;
if (%rag_helmet = 1) $reward = rag_ram_helm;
if (calc(inv_total(inv, $reward) + inv_total(bank, $reward) + inv_total(worn, $reward)) > 0) {
    ~chatplayer("<p,neutral>So how is the sorting going?");
    ~chatnpc("<p,happy>It's going well, especially now I have all the bones I need.");
    return;
}
if (inv_freespace(inv) = 0) {
    ~chatnpc("<p,neutral>Well, as much as I'd like to toss them into the dirt and all, I think it's best if you came back later with an empty backpack.");
    return;
}
~chatplayer("<p,sad>I seem to have lost the one you gave me."); // ours
~chatnpc("<p,happy>Come and see me if you lose that one, I have plenty more!");
inv_add(inv, $reward, 1);
~objbox($reward, "The Odd Old Man gives you another one.", 250, 0, divide(^objbox_height, 2)); // ours

// ---------------------------------------------------------------- handing in
[proc,rag_count_polished](int $from, int $to)(int)
def_int $n = 0;
def_int $i = $from;
while ($i < $to) {
    if (~rag_handed($i) = false & inv_total(inv, ~rag_polished($i)) > 0) $n = add($n, 1);
    $i = add($i, 1);
}
return($n);

[proc,rag_count_unclean](int $from, int $to)(int)
def_int $n = 0;
def_int $i = $from;
while ($i < $to) {
    if (~rag_handed($i) = false & (inv_total(inv, ~rag_raw($i)) > 0 | inv_total(inv, ~rag_pot($i)) > 0)) $n = add($n, 1);
    $i = add($i, 1);
}
return($n);

[proc,rag_count_handed](int $from, int $to)(int)
def_int $n = 0;
def_int $i = $from;
while ($i < $to) {
    if (~rag_handed($i) = true) $n = add($n, 1);
    $i = add($i, 1);
}
return($n);

[proc,rag_hand_in](int $from, int $to)
def_int $i = $from;
while ($i < $to) {
    if (~rag_handed($i) = false & inv_total(inv, ~rag_polished($i)) > 0) {
        inv_del(inv, ~rag_polished($i), 1);
        ~rag_set_handed($i);
    }
    $i = add($i, 1);
}

// ---------------------------------------------------------------- the wish list on his shack
[oploc1,rag_shopping_list]
if (%rag_quest < ^rag_complete) {
    mes("It's a list of bones. The Odd Old Man must want them for his collection."); // ours
    return;
}
~quest_journal("Wish-list", ~rag_wish_text);

[proc,rag_wish_text]()(string)
def_string $t = "@dbl@The Odd Old Man would like a bone from each of these:|";
def_int $i = ^rag_main_bones;
while ($i < ^rag_all_bones) {
    if (~rag_handed($i) = true) $t = append($t, "|@str@<~rag_wish_name($i)>");
    else $t = append($t, "|@dre@<~rag_wish_name($i)>");
    $i = add($i, 1);
}
return($t);

// ---------------------------------------------------------------- Fortunato, the wine merchant
[opnpc1,rag_wine_merchant]
if (%rag_quest = ^rag_not_started) {
    ~chatnpc("<p,neutral>Can I help you at all?");
    if (~p_choice2("Yes, what are you selling?", 1, "Not at the moment.", 2) = 1) ~openshop_fortunato; // ours: the shop
    return;
}
if (%rag_wine = 0) {
    ~chatnpc("<p,neutral>Can I help you at all?");
    ~chatplayer("<p,neutral>Have you got any vinegar?");
    ~chatnpc("<p,angry>Vinegar? Vinegar! The very idea! My wines are the finest in the district!");
    ~chatplayer("<p,sad>Sorry, I was told to come and speak with a wine merchant about getting some vinegar. I must have the wrong person.");
    ~chatnpc("<p,shock>Wait! Did 'he' send you?");
    ~chatplayer("<p,neutral>If by 'he' you mean the old man with the sack of bones, then yes.");
    if (gender = 1) ~chatnpc("<p,happy>Ah, say no more, m'lady. I have some in specially.");
    else ~chatnpc("<p,happy>Ah, say no more, sir. I have some in specially.");
    %rag_wine = 1;
    ~openshop_fortunato;
    return;
}
~chatnpc("<p,neutral>Can I help you at all?");
~chatnpc("<p,happy>Ah! Good afternoon your lordship. I take it you have come for a refill?");
if (~p_choice2("Yes.", 1, "Not today.", 2) = 1) {
    ~chatplayer("<p,neutral>Yes.");
    ~openshop_fortunato;
    return;
}
~chatplayer("<p,neutral>Not today.");
~chatnpc("<p,neutral>Well, just remember I have some in stock for you when you want it.");

// ---------------------------------------------------------------- the journal (ours)
[if_button,questlist:rag]
if (%rag_quest = ^rag_not_started) {
    ~quest_journal("Rag and Bone Man", "@dbl@I can start this quest by speaking to the @dre@Odd Old Man@dbl@ by|@dbl@his shack north-east of Varrock, by the quarry west of|@dre@Paterdomus@dbl@.||@dbl@There are no requirements, but I'll need to kill a few|@dbl@monsters.");
    return;
}
def_string $t = "@str@The Odd Old Man asked me for some bones for his collection.";
if (%rag_quest = ^rag_started) {
    $t = "@dbl@The @dre@Odd Old Man@dbl@ asked me for some bones for his collection.|@dbl@I need to put each in a @dre@pot of vinegar@dbl@ (@dre@Fortunato@dbl@ in Draynor sells|@dbl@vinegar) and boil it in his @dre@pot-boiler@dbl@ before handing it in.|";
    def_int $i = 0;
    while ($i < ^rag_main_bones) {
        if (~rag_handed($i) = true) $t = append($t, "|@str@A <~rag_main_name($i)> bone");
        else $t = append($t, "|@dre@A <~rag_main_name($i)> bone");
        $i = add($i, 1);
    }
    ~quest_journal("Rag and Bone Man", $t);
    return;
}
$t = append($t, "|@str@I brought him all eight.");
if (~rag_wish_done = true) {
    $t = append($t, "|@str@I also brought him every bone on his wish list.||@red@QUEST COMPLETE!");
    ~quest_journal("Rag and Bone Man", $t);
    return;
}
$t = append($t, "||@red@QUEST COMPLETE!||@dbl@He still has a @dre@wish list@dbl@ pinned to his shack; he'd like:");
def_int $j = ^rag_main_bones;
while ($j < ^rag_all_bones) {
    if (~rag_handed($j) = false) $t = append($t, "|@dre@<~rag_wish_name($j)>");
    $j = add($j, 1);
}
~quest_journal("Rag and Bone Man", $t);
