// EASCape: generated (by hand, from the cache's rag_* objects): Rag and Bone Man's bones.
// Index 0-7 the Odd Old Man's first list, 8-34 his wish list (the order of the OSRS wiki's lists).

[proc,rag_raw](int $i)(namedobj)
switch_int ($i) {
    case 0 : return(rag_goblin_bone);
    case 1 : return(rag_bear_bone);
    case 2 : return(rag_medium_frog_bone);
    case 3 : return(rag_ram_bone);
    case 4 : return(rag_unicorn_bone);
    case 5 : return(rag_monkey_bone);
    case 6 : return(rag_giant_rat_bone);
    case 7 : return(rag_giant_bat_bone);
    case 8 : return(rag_wolf_bone);
    case 9 : return(rag_bat_bone);
    case 10 : return(rag_rat_bone);
    case 11 : return(rag_baby_blue_dragon_bone);
    case 12 : return(rag_ogre_bone);
    case 13 : return(rag_jogre_bone);
    case 14 : return(rag_zogre_bone);
    case 15 : return(rag_mogre_bone);
    case 16 : return(rag_dagganoth_bone);
    case 17 : return(rag_snake_bone);
    case 18 : return(rag_zombie_bone);
    case 19 : return(rag_werewolf_bone);
    case 20 : return(rag_moss_giant_bone);
    case 21 : return(rag_fire_giant_bone);
    case 22 : return(rag_ice_giant_bone);
    case 23 : return(rag_terrorbird_bone);
    case 24 : return(rag_ghoul_bone);
    case 25 : return(rag_troll_bone);
    case 26 : return(rag_seagull_bone);
    case 27 : return(rag_undead_cow_bone);
    case 28 : return(rag_experiment_bone);
    case 29 : return(rag_rabbit_bone);
    case 30 : return(rag_baby_basilisk_bone);
    case 31 : return(rag_desert_lizard_bone);
    case 32 : return(rag_cave_goblin_bone);
    case 33 : return(rag_vulture_bone);
    case 34 : return(rag_jackal_bone);
}
return(null);

