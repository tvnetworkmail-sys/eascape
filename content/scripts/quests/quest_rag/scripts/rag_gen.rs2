// which bone a monster has (by its name, as the wikis list them); -1 none
[proc,rag_bone_of](string $name)(int)
def_string $n = lowercase($name);
if (compare($n, "goblin") = 0) return(0);
if (compare($n, "bear") = 0 | compare($n, "grizzly bear") = 0 | compare($n, "black bear") = 0) return(1);
if (compare($n, "big frog") = 0) return(2);
if (compare($n, "ram") = 0) return(3);
if (compare($n, "unicorn") = 0) return(4);
if (compare($n, "monkey") = 0) return(5);
if (compare($n, "giant rat") = 0) return(6);
if (compare($n, "giant bat") = 0) return(7);
if (compare($n, "wolf") = 0) return(8);
if (compare($n, "bat") = 0) return(9);
if (compare($n, "rat") = 0) return(10);
if (compare($n, "baby blue dragon") = 0) return(11);
if (compare($n, "ogre") = 0) return(12);
if (compare($n, "jogre") = 0) return(13);
if (compare($n, "zogre") = 0) return(14);
if (compare($n, "mogre") = 0) return(15);
if (compare($n, "dagannoth") = 0) return(16);
if (compare($n, "snake") = 0 | compare($n, "desert snake") = 0) return(17);
if (compare($n, "zombie") = 0) return(18);
if (compare($n, "werewolf") = 0) return(19);
if (compare($n, "moss giant") = 0) return(20);
if (compare($n, "fire giant") = 0) return(21);
if (compare($n, "ice giant") = 0) return(22);
if (compare($n, "terrorbird") = 0) return(23);
if (compare($n, "ghoul") = 0) return(24);
if (compare($n, "troll") = 0 | compare($n, "mountain troll") = 0 | compare($n, "thrower troll") = 0) return(25);
if (compare($n, "seagull") = 0) return(26);
if (compare($n, "undead cow") = 0) return(27);
if (compare($n, "experiment") = 0) return(28);
if (compare($n, "rabbit") = 0) return(29);
if (compare($n, "basilisk") = 0) return(30);
if (compare($n, "lizard") = 0 | compare($n, "desert lizard") = 0) return(31);
if (compare($n, "cave goblin") = 0 | compare($n, "cave goblin guard") = 0 | compare($n, "cave goblin miner") = 0) return(32);
if (compare($n, "vulture") = 0) return(33);
if (compare($n, "jackal") = 0) return(34);
return(-1);

[proc,rag_wish_name](int $i)(string)
switch_int ($i) {
    case 8 : return("Wolf");
    case 9 : return("Bat");
    case 10 : return("Rat");
    case 11 : return("Baby blue dragon");
    case 12 : return("Ogre");
    case 13 : return("Jogre");
    case 14 : return("Zogre");
    case 15 : return("Mogre");
    case 16 : return("Dagannoth");
    case 17 : return("Snake");
    case 18 : return("Zombie");
    case 19 : return("Werewolf");
    case 20 : return("Moss giant");
    case 21 : return("Fire giant");
    case 22 : return("Ice giant");
    case 23 : return("Terrorbird");
    case 24 : return("Ghoul");
    case 25 : return("Troll");
    case 26 : return("Seagull");
    case 27 : return("Undead cow");
    case 28 : return("Experiment");
    case 29 : return("Rabbit");
    case 30 : return("Basilisk");
    case 31 : return("Desert lizard");
    case 32 : return("Cave goblin");
    case 33 : return("Vulture");
    case 34 : return("Jackal");
}
return("");

[proc,rag_main_name](int $i)(string)
switch_int ($i) {
    case 0 : return("goblin");
    case 1 : return("bear");
    case 2 : return("big frog");
    case 3 : return("ram");
    case 4 : return("unicorn");
    case 5 : return("monkey");
    case 6 : return("giant rat");
    case 7 : return("giant bat");
}
return("");

// the Odd Old Man's hints (the RuneScape wiki's transcript)
[proc,rag_main_hint](int $i)(string)
switch_int ($i) {
    case 0 : return("Goblins are relatively common. In fact, I hear there is a house full of them in Lumbridge.");
    case 1 : return("I hear there are some bears over by the Legends' guild, near Ardougne.");
    case 2 : return("This one might be a little tricky. You'll need to go into the Lumbridge Swamp Dungeon. Don't forget to take a light source! Never forget your light source down there.");
    case 3 : return("I'm sure you will be able to find a ram wherever there are sheep.");
    case 4 : return("I seem to remember seeing some unicorns south of Varrock. I think they might still be there.");
    case 5 : return("Monkeys tend to live in jungles, like those on Karamja. I think they are pretty plentiful there, if I can remember correctly.");
    case 6 : return("If you can't find one in a sewer, then you might want to try looking in some caves.");
    case 7 : return("Giant bats tend to live underground, but I have heard there are a few near the coal trucks in Kandarin.");
}
return("");

// a pot of vinegar used on a bone, and emptying a bone in vinegar
