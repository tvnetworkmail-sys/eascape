// EASCape: Rag and Bone Man (quest_rag), the update of 10 April 2006. %rag_quest is the cache's
// quest varp; the values are ours.
^rag_not_started = 0
^rag_started = 1          // the Odd Old Man asked for eight bones
^rag_complete = 2         // all eight handed in: his wish list is open
^rag_questpoints = 1
^rag_wish_questpoints = 1 // the wish list gave a quest point too until 11 August 2009 (RuneScape wiki)
^rag_main_bones = 8
^rag_all_bones = 35
^rag_boil_ticks = 20      // 12 seconds a pot (RuneScape wiki)
