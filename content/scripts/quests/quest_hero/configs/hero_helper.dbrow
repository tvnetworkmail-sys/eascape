data=coord,0_50_152_47_53

[questhelper_step_hero_24]
table=questhelper_step
data=id,35024
data=section,3
data=text,Talk to Alfonse the Waiter in the restaurant in Brimhaven.
data=npc,alfonse_the_waiter
data=coord,0_43_49_40_50
data=option,Do you sell Gherkins?

[questhelper_step_hero_25]
table=questhelper_step
data=id,35025
data=section,3
data=text,You'll need your partner to give you a miscellaneous key.
data=item,misc_key,1

[questhelper_step_hero_26]
table=questhelper_step
data=id,35026
data=section,3
data=text,Talk to Charlie the Cook in the back of the restaurant.
data=npc,charlie_the_cook
data=coord,0_43_49_38_55
data=option,I'm looking for a gherkin...
data=option,I want to steal Scarface Pete's candlesticks.

[questhelper_step_hero_27]
