[questhelper_step_hero_1]
table=questhelper_step
data=id,35001
data=section,0
data=text,"Talk to Achietties outside the Heroes' Guild, south of Burthorpe."
data=npc,achietties
data=coord,0_45_54_24_55
data=option,"I'm a hero, may I apply to join?"
data=option,I'll start looking for all those things then.

[questhelper_step_hero_2]
table=questhelper_step
data=id,35002
data=section,1
data=text,You need to get an oily rod. Talk to Gerrant in Port Sarim to get some slime.
data=npc,gerrant
data=coord,0_47_50_5_24
data=option,I want to find out how to catch a lava eel.

[questhelper_step_hero_3]
table=questhelper_step
data=id,35003
data=section,1
data=text,Combine the harralander potion (unf) with the blamish snail slime.

[questhelper_step_hero_4]
table=questhelper_step
data=id,35004
data=section,1
data=text,Use the Blamish oil on your fishing rod.

[questhelper_step_hero_5]
table=questhelper_step
data=id,35005
data=section,1
data=text,"Go to Taverley Dungeon. Bring a dusty key if you have one, otherwise you can get one in the dungeon."
data=coord,0_45_53_4_5
data=item,fishing_bait,1

[questhelper_step_hero_6]
table=questhelper_step
data=id,35006
data=section,1
data=text,Squeeze through the obstacle pipe.
data=coord,0_45_153_8_7

[questhelper_step_hero_7]
table=questhelper_step
data=id,35007
data=section,1
data=text,Travel through Taverley Dungeon until you reach the Black Knights' Base. Kill the Jailer in the east side of the base for a jail key.
data=npc,jailer
data=coord,0_45_151_50_28

[questhelper_step_hero_8]
table=questhelper_step
data=id,35008
data=section,1
data=text,Use the jail key on the south door and talk to Velrak for a dusty key.
data=npc,velrak_the_explorer
data=coord,0_45_151_50_21
data=option,So... do you know anywhere good to explore?

[questhelper_step_hero_9]
table=questhelper_step
data=id,35009
data=section,1
data=text,Enter the gate to the deeper Taverley dungeon.
data=loc,deepdungeondoor
data=coord,0_45_153_44_11

[questhelper_step_hero_10]
table=questhelper_step
data=id,35010
data=section,1
data=text,Fish a lava eel from the lava south of the blue dragons.
data=coord,0_45_152_18_36
data=item,fishing_bait,1

[questhelper_step_hero_11]
table=questhelper_step
data=id,35011
data=section,1
data=text,Cook the Lava Eel at a range. You cannot fail this.
data=item,raw_lava_eel,1

[questhelper_step_hero_12]
table=questhelper_step
data=id,35012
data=section,2
data=text,Talk to Katrine at the Black Arm Gang base in South west Varrock.
data=npc,katrine
data=coord,0_49_52_49_57
data=option,Is there any way I can get the rank of master thief?

[questhelper_step_hero_13]
table=questhelper_step
data=id,35013
data=section,2
data=text,Try to enter the house in east Brimhaven.
data=loc,grubordoor
data=coord,0_43_49_59_34
data=option,Four leaved clover.

[questhelper_step_hero_14]
table=questhelper_step
data=id,35014
data=section,2
data=text,Talk to Trobert inside.
data=npc,trobert
data=coord,0_43_49_55_38
data=option,So can you help me get Scarface Pete's candlesticks?
data=option,I volunteer to undertake that mission!

[questhelper_step_hero_15]
table=questhelper_step
data=id,35015
data=section,2
data=text,Equip your black armour and enter the mansion in the north west of Brimhaven.
data=loc,garvdoor
data=coord,0_43_49_22_51
data=item,id_papers,1

[questhelper_step_hero_16]
table=questhelper_step
data=id,35016
data=section,2
data=text,Talk to Grip.
data=npc,grip
data=coord,0_43_49_23_56
data=item,id_papers,1

[questhelper_step_hero_17]
table=questhelper_step
data=id,35017
data=section,2
data=text,getKeyFromGrip
data=loc,gripcbshut
data=coord,0_43_49_24_60
data=option,So what do my duties involve?
data=option,Anything I can do now?
data=option,He won't notice me having a quick look.

[questhelper_step_hero_18]
table=questhelper_step
data=id,35018
data=section,2
data=text,Pick up Grip's keyring
data=item,grip_keys,1

[questhelper_step_hero_19]
table=questhelper_step
data=id,35019
data=section,2
data=text,Use Grip's keyring on the treasure room door.
data=loc,pete_treasuredoor
data=coord,0_43_49_12_61

[questhelper_step_hero_20]
table=questhelper_step
data=id,35020
data=section,2
data=text,Search the chest in the treasure room for two candlesticks.
data=loc,shutcandlechest
data=coord,0_43_49_14_63

[questhelper_step_hero_21]
table=questhelper_step
data=id,35021
data=section,2
data=text,"Give one of Pete's candlesticks to your partner. Afterwards, return to Katrine with Pete's candlestick"
data=npc,katrine
data=coord,0_49_52_49_57
data=option,I have a candlestick now.
data=item,petecandlestick,1

[questhelper_step_hero_22]
table=questhelper_step
data=id,35022
data=section,3
data=text,Head into the Phoenix Gang's base in south Varrock.
data=loc,loc_11803
data=coord,0_50_52_44_55

