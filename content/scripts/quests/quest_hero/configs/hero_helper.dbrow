data=loc,herokitchenpanel
data=coord,0_43_49_35_54

[questhelper_step_hero_28]
table=questhelper_step
data=id,35028
data=section,3
data=text,Use the misc key on the door to the north west.
data=loc,pete_sidedoor
data=coord,0_43_49_29_61

[questhelper_step_hero_29]
table=questhelper_step
data=id,35029
data=section,3
data=text,"Wait for your partner to lure Grip into the room next to yours, and kill him with magic/ranged. Afterwards, trade your partner for a candlestick."
data=npc,grip
data=coord,0_43_49_23_56

[questhelper_step_hero_30]
table=questhelper_step
data=id,35030
data=section,3
