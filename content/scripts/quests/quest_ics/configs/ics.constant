// Icthlarin's Little Helper: the stages of %ics_little_var (varbit, bits 0-4 of varp main_ics_var).
// Ours: the 2007 cache shows the ceremony's priests at 19-25, its high priest at 19-24 and
// Icthlarin at 24, so those stages are fixed by the cache; the rest are our numbers.
^ics_not_started = 0
^ics_supplies = 1
^ics_hypnotised = 2
^ics_remembered = 3
^ics_token = 4
^ics_return_jar = 5
^ics_stole_jar = 6
^ics_jar_returned = 7
^ics_ceremony_prep = 8
^ics_symbol_hidden = 19
^ics_fight = 20
^ics_priest_beaten = 22
^ics_icthlarin = 24
^ics_return_town = 25
^ics_complete = 26
^ics_questpoints = 2
