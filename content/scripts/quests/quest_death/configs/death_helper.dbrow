data=id,17024
data=section,1
data=text,Talk to Saba.
data=npc,death_hermit
data=coord,0_35_74_30_21
data=option,Do you know of another way up Death Plateau?

[questhelper_step_death_25]
table=questhelper_step
data=id,17025
data=section,1
data=text,"Go northwest of Burthorpe, then south at the fork, and talk to Tenzing."
data=npc,death_sherpa
data=coord,0_44_55_4_35
data=option,"OK, I'll get those for you."

[questhelper_step_death_26]
table=questhelper_step
data=id,17026
data=section,1
data=text,Leave Saba's cave.
data=loc,death_hermitcave_exit
data=coord,0_35_74_29_15

[questhelper_step_death_27]
table=questhelper_step
data=id,17027
data=section,1
data=text,"Talk to Dunstan at the anvil in Burthorpe, then talk to Denulth, where you started the quest."
data=npc,death_smithy
data=coord,0_45_55_40_53

[questhelper_step_death_28]
table=questhelper_step
data=id,17028
data=section,1
data=text,Ask Denulth about Dunstan's son.
data=npc,death_ig_commander
data=coord,0_45_55_16_9

[questhelper_step_death_29]
table=questhelper_step
data=id,17029
data=section,1
data=text,Talk to Dunstan to exchange the climbing boots for spiked boots.
data=npc,death_smithy
data=coord,0_45_55_40_53
data=item,death_entrancecert,1
data=item,iron_bar,1

[questhelper_step_death_30]
table=questhelper_step
data=id,17030
data=section,2
data=text,"Bring the spiked boots, along with (unnoted) 10 bread and 10 trout to Tenzing."
data=npc,death_sherpa
data=coord,0_44_55_4_35
data=item,death_spikedboots,1
data=item,bread,10
data=item,trout,10

[questhelper_step_death_31]
table=questhelper_step
data=id,17031
data=section,2
data=text,"Exit Tenzing's house into the backyard THROUGH THE NORTH DOOR and OVER THE STILE. Continue north past the Death Plateau warning, and around to the east until you stop and say you've gone far enough."
data=coord,0_44_56_49_25
data=item,death_secretwaymap,1

[questhelper_step_death_32]
table=questhelper_step
data=id,17032
data=section,2
data=text,"Go back and talk to Denulth, giving him the secret map and Combination."
data=npc,death_ig_commander
data=coord,0_45_55_16_9
