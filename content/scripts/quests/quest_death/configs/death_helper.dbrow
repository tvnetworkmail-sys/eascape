[questhelper_step_death_1]
table=questhelper_step
data=id,17001
data=section,0
data=text,Talk to Denulth in Burthorpe. You can get there with the Burthorpe minigame teleport or a games necklace.
data=npc,death_ig_commander
data=coord,0_45_55_16_9
data=option,Do you have any quests for me?
data=option,Yes.

