[proc,quest_elena_set_progress](int $stage)
%elenaquest = $stage;
~elena_at_home;
~send_quest_progress(questlist:elena, %elenaquest, ^elena_complete);

[queue,quest_elena_complete]
inv_del(inv, elena_picture, ^max_32bit_int);
inv_del(inv, elenakey, ^max_32bit_int);
inv_del(inv, warrant, ^max_32bit_int);
inv_del(inv, scruffy_note, ^max_32bit_int);
inv_del(inv, turnip_book, ^max_32bit_int);
inv_add(inv, ardougnescroll, 1);
stat_advance(mining, 24250);
~quest_elena_set_progress(^elena_complete);
session_log(^log_adventure, "Quest complete: Plague City");
~send_quest_complete(questlist:elena, gasmask, 250, ^elena_questpoints, "You have completed the\\nPlague City Quest!", "2,425 Mining XP|An Ardougne Teleport Scroll");

// EASCape: Elena is back in her house once Plague City is done. Her house's Elena (elena2, on the
// map) only shows while plaguecity_elena_at_home is set, and nothing set it: she was invisible until
// her door (which spawned a second one) was opened. Set as the quest finishes, and on logging in
// for anyone who finished it before.
[proc,elena_at_home]
if(%elenaquest >= ^elena_complete) {
    %plaguecity_elena_at_home = 1;
} else {
    %plaguecity_elena_at_home = 0;
}
