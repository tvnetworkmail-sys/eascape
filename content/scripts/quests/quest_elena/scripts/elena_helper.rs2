[proc,qh_elena_c1]()(boolean)
if (inzone(0_39_151_39_6, 0_39_151_46_9, coord) = true) return(true);
return(false);

[proc,qh_elena_c2]()(boolean)
if (inzone(0_38_51_28_15, 2_39_52_60_6, coord) = true | inzone(0_38_51_2_41, 2_38_51_32_59, coord) = true | inzone(0_39_51_14_1, 2_39_51_60_16, coord) = true) return(true);
