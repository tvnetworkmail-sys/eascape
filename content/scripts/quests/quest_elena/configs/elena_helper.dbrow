[questhelper_step_elena_21]
table=questhelper_step
data=id,25021
data=section,3
data=text,Try to enter the house in the south-east corner of West Ardougne.
data=coord,0_39_51_44_9
data=option,I fear not a mere plague.
data=option,I want to check anyway.

[questhelper_step_elena_22]
table=questhelper_step
data=id,25022
data=section,3
data=text,Talk to the Clerk in the large building north of the manhole.
data=npc,clerk
data=coord,0_39_51_32_53
data=option,I need permission to enter a plague house.
data=option,This is urgent though! Someone's been kidnapped!

[questhelper_step_elena_23]
table=questhelper_step
data=id,25023
data=section,3
data=text,Talk to Bravek in the room to the east.
data=npc,bravek
data=coord,0_39_51_38_50
data=option,This is really important though!
data=option,Do you know what's in the cure?

[questhelper_step_elena_24]
table=questhelper_step
data=id,25024
data=section,3
data=text,Use your chocolate dust on the bucket of milk.
