// EASCape: Rogue Trader (15 August 2005). Progress lives in the 377 cache's own varp roguetrader_var
// and its varbits (all.varbit: roguetrader_started, _blackjacks, _clothes, _runes, _cheapflights,
// _justchanged_garments, _justchanged_weapons, _justobt_runes, _bj_urchingloat, _bjtold_ali,
// _playing_sudoku, _stallvar). The cache only gives names and sizes; what each value means is ours,
// except where the OSRS wiki's transcript logs a change (blackjacks 0 -> 1 when Ali names the
// blackjack seller, runes 1 -> 2 and justobt_runes 0 -> 1 when Aubury agrees, justobt_runes 1 -> 0
// when Ali reports the first shipment).

// %roguetrader_started (ours)
^rt_intro_done = 1
^rt_finished = 2

// %roguetrader_runes (ours past 2)
^rt_runes_aubury = 1
^rt_runes_deal = 2
^rt_runes_small = 3
^rt_runes_large = 4
^rt_runes_both = 5

// %roguetrader_blackjacks (ours past 1)
^rt_bj_told = 1
^rt_bj_asked = 2
^rt_bj_urchin = 3
^rt_bj_robbed = 4
^rt_bj_agreed = 5

// %roguetrader_justchanged_weapons: the kind Ali is being sent (ours)
^rt_bjline_defensive = 1
^rt_bjline_offensive = 2

// %roguetrader_clothes (ours past 1). Dyes give Menaphite clothing, pelts the desert outfit (the
// OSRS wiki's Rogue Trader page).
^rt_clothes_told = 1
^rt_clothes_asked = 2
^rt_clothes_menaphite = 3
^rt_clothes_desert = 4

// %roguetrader_stallvar while a rune lock is open: the rune picked on the left (the RuneScape
// wiki's numbering: air 1, water 2, earth 3, fire 4, mind 5, body 6, death 7, chaos 8, law 9) and
// 10 for the blank one (ours)
^rt_sel_blank = 10

// the fare on Ali's carpets (the OSRS wiki: 200, 100 with the discount)
^rt_fare = 200
^rt_fare_cheap = 100
