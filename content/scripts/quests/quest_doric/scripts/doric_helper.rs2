// EASCape: Quest Helper for Doric's Quest, converted from RuneLite's Quest Helper (doricsquest, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   (none)

[proc,questhelper_doric]()(int)
def_int $v = %doricquest;
if ($v > 10) {
    return(0); // done
}
if ($v >= 10) {
    return(1);
}
if ($v >= 0) {
    return(1);
}
return(1);
