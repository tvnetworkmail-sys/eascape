// EASCape: Creature of Fenkenstrain, its places and things. Ported from Void (GregHib/void:
// content/quest/member/creature_of_fenkenstrain/CreatureOfFenkenstrain.kt), its words and places;
// the conductor's casting from Void's silver_casting table (level 20, 50 XP); the pickled brain's
// place on the pub table from Void's canifis.item-spawns. Our choices are marked "ours".

// ---------------------------------------------------------------- helpers
[proc,fenk_give](namedobj $obj)
if (inv_freespace(inv) > 0 | (oc_stackable($obj) = true & inv_total(inv, $obj) > 0)) {
    inv_add(inv, $obj, 1);
    return;
}
obj_add(coord, $obj, 1, ^lootdrop_duration);
mes("Your pack is full: <oc_name($obj)> is on the ground."); // ours

// ---------------------------------------------------------------- Canifis
[oploc1,fenk_signpost]
if (%fenk_quest >= ^fenk_body_parts) {
    ~mesbox("The signpost has a note pinned onto it. The note says:|'~~~Braindead Butler Position Filled~~~|****No Further Applicants Please****'");
    return;
}
%fenk_read_signpost = 1;
~mesbox("The signpost has a note pinned onto it. The note says:|'----Braindead Butler Wanted----|Gravedigging skills essential - Hunchback advantageous|See Dr Fenkenstrain at the castle NE of Canifis'");

// the pickled brain on the pub table is Roavar's, for 50 gold
[opobj3,fenk_brain]
if (obj_coord ! 0_54_54_36_18) {
    @pickup_obj;
}
if (npc_find(coord, werewolfinnkeeper, 10, 0) = false) {
    @pickup_obj;
}
if (inv_total(inv, fenk_brain) > 0) {
    ~chatnpc_specific("Roavar", werewolfinnkeeper, "<p,neutral>You can leave that alone, my friend. I've already sold you one of your own- eat that. I can't afford to give away freebies in this business!");
    return;
}
~chatnpc_specific("Roavar", werewolfinnkeeper, "<p,neutral>You're interested in our speciality, I see. Would you like to buy some?");
~chatplayer("<p,quiz>What exactly is in the jar?");
~chatnpc_specific("Roavar", werewolfinnkeeper, "<p,neutral>Pickled brain, my friend. Only 50 gold to you.");
~chatplayer("<p,confused>Err...pickled brain from what animal?");
~chatnpc_specific("Roavar", werewolfinnkeeper, "<p,angry>Animal? Don't be disgusting, man! No, this is a human brain - only the best for my customers.");
if (inv_total(inv, coins) < 50) {
    ~chatplayer("<p,neutral>That sounds very nice, but I'm afraid I don't have enough gold at the moment.");
    return;
}
def_int $choice = ~p_choice2("I'll buy one, please.", 1, "I'm afraid I'm not really hungry at the moment.", 2);
if ($choice = 1) {
    ~chatplayer("<p,neutral>I'll buy one, please.");
    inv_del(inv, coins, 50);
    ~fenk_give(fenk_brain);
    ~chatnpc_specific("Roavar", werewolfinnkeeper, "<p,happy>A very wise choice, <text_gender("sir", "miss")>. Don't eat it all at once, savour every morsel - that's my advice to you.");
} else if ($choice = 2) {
    ~chatplayer("<p,neutral>I'm afraid I'm not really hungry at the moment.");
}

// ---------------------------------------------------------------- the castle
[oploc1,fenk_clock]
if (inv_total(inv, fenk_letter) = 0 & %fenk_wound_clock = 0) {
    ~fenk_give(fenk_letter);
    %fenk_wound_clock = 1;
    ~objbox(fenk_letter, "As you wind the old clock a letter falls out. Judging by the thick covering of dust it must have been here for some time.", 250, 0, 0);
}
mes("You wind the old clock.");

[oploc1,fenk_canepile]
mes("You take a garden cane from the pile.");
~fenk_give(fenk_cane);

[oploc1,fenk_chest_closed]
// ours: Void only has the open chest; this one opens as other chests do
loc_change(fenk_chest_open, 500);

[oploc1,fenk_chest_open]
if (%fenk_unlocked_cavern = 1 | inv_total(inv, fenk_mausoleum_key) > 0) {
    mes("The chest is empty.");
    return;
}
~fenk_give(fenk_mausoleum_key);
~objbox(fenk_mausoleum_key, "You take a key out of the chest.", 250, 0, 0);

[oploc2,fenk_chest_open]
mes("The hinges are filled with rust and won't budge.");

[oploc1,fenk_broomcupboard]
anim(human_opencupboard, 0);
sound_synth(cupboard_open, 1, 0);
loc_change(fenk_broomcupboard_open, 500);

[oploc3,fenk_broomcupboard_open]
anim(human_opencupboard, 0);
sound_synth(cupboard_close, 1, 0);
loc_change(fenk_broomcupboard, 500);

[oploc2,fenk_broomcupboard_open]
if (inv_total(inv, fenk_brush0) > 0) {
    mes("You search the cupboard but find nothing.");
    return;
}
~fenk_give(fenk_brush0);
~objbox(fenk_brush0, "You find a garden brush in the cupboard.", 250, 0, 0);

[oploc1,fenk_bookcase]
if (%fenk_quest < ^fenk_body_parts) {
    mes("It is a bookcase full of books.");
    return;
}
if (loc_coord = 1_55_55_35_38) {
    @fenk_east_bookcase;
}
if (loc_coord = 1_55_55_22_38) {
    @fenk_west_bookcase;
}
mes("It is a bookcase full of books."); // ours

[label,fenk_east_bookcase]
def_int $choice = ~p_choice4_header("Men are from Morytania, Women are from Lumbridge", 1, "Chimney Sweeping on a Budget", 2, "Handy Maggot Avoidance Techniques", 3, "My Family and Other Zombies", 4, "Which book would you like to read?");
if ($choice = 1) {
    ~objbox(fenk_journal, "You discover some fascinating insights into the mind of the male kind.", 250, 0, 0);
} else if ($choice = 2) {
    ~book("Chimney Sweeping on a Budget", "...that sometimes a sweep may find themselves brushless and without the funds to purchase the one tool that is most essential to their trade. What is a chimey sweep without his or her brush! In this kind of situation any normal long-handled brush might be a suitable replacement, altough when attaching extensions to the handle make sure to use something sturdy like wire, otherwise a sweep may find themselves losing their brush and livelyhood to the forces of gravity");
} else if ($choice = 3) {
    sound_synth(bookcasedoor, 1, 0);
    ~objbox(fenk_journal, "As you pull the book a hidden latch springs into place and the bookcase swings open, revealing a secret compartment.", 250, 0, 0);
    if (inv_total(inv, fenk_obsidian_amulet) > 0 | inv_total(inv, fenk_star_amulet) > 0 | %fenk_coffin = 1) {
        ~mesbox("The secret compartment is empty.");
    } else {
        ~fenk_give(fenk_obsidian_amulet);
        ~objbox(fenk_obsidian_amulet, "You find an obsidian amulet in the secret compartment.", 250, 0, 0);
    }
} else if ($choice = 4) {
    switch_int (random(4)) {
        case 0 : ~objbox(fenk_journal, "The book is a mediocre read.", 250, 0, 0);
        case 1 : ~objbox(fenk_journal, "This book is appallingly dull.", 250, 0, 0);
        case 2 : ~objbox(fenk_journal, "This book is mildly amusing.", 250, 0, 0);
        case default : ~objbox(fenk_journal, "This book is a fantastic read.", 250, 0, 0);
    }
}

[label,fenk_west_bookcase]
def_int $choice = ~p_choice4_header("1001 Ways To Eat Fried Gizzards", 1, "Practical Gardening For The Headless", 2, "Human Taxidermy for Nincompoops", 3, "The Joy of Gravedigging", 4, "Which book would you like to read?");
if ($choice = 1) {
    ~objbox(fenk_journal, "This book leaves you contemplating vegetarianism.", 250, 0, 0);
} else if ($choice = 2) {
    ~objbox(fenk_journal, "This book has some very enlightening points to make, but you are at a loss to know how anyone without a head could possibly read it.", 250, 0, 0);
} else if ($choice = 3) {
    ~objbox(fenk_journal, "This book seems to have been read hundreds of times, and has scribbles and formulae on every page. One such scribble says 'None good enough - have had to lock them in the caverns...'", 250, 0, 0);
} else if ($choice = 4) {
    sound_synth(bookcasedoor, 1, 0);
    ~objbox(fenk_journal, "As you pull the book a hidden latch springs into place and the bookcase swings open, revealing a secret compartment.", 250, 0, 0);
    if (inv_total(inv, fenk_marble_amulet) > 0 | inv_total(inv, fenk_star_amulet) > 0 | %fenk_coffin = 1) {
        ~mesbox("The secret compartment is empty.");
    } else {
        ~fenk_give(fenk_marble_amulet);
        ~objbox(fenk_marble_amulet, "You find a marble amulet in the secret compartment.", 250, 0, 0);
    }
}

// ---------------------------------------------------------------- the memorials and graves
[proc,fenk_grave_name](coord $coord)(string)
def_string $name = "";
switch_coord ($coord) {
    case 0_56_54_24_35 : $name = "Ed Lestwit";
    case 0_56_54_10_35 : $name = "Isla Skye";
    case 0_56_54_12_23 : $name = "Kandik Kludge";
    case 0_56_54_4_16 : $name = "Jayna Harrow";
    case 0_56_54_20_10 : $name = "Korvic Frey";
    case 0_56_54_24_10 : $name = "Marcus Harrow";
    case 0_56_54_35_13 : $name = "Anton Hayes";
    case 0_56_54_32_22 : $name = "Serra Alcanthric";
    case 0_56_54_47_20 : $name = "Petrik Corbo";
    case 0_56_54_55_14 : $name = "Jayna Corbo";
    case 0_56_54_45_27 : $name = "Eryn Treforest";
    case 0_56_54_50_47 : $name = "Domin O'Raleigh";
    case 0_56_54_42_39 : $name = "Callum Elding";
    case 0_56_54_9_53 : $name = "Elena Frey";
    case 0_56_54_1_41 : $name = "Marabella Kludge";
    case 0_54_55_46_56 : $name = "Rolomere, 14th Lord of the North Coast";
    case 0_54_55_48_57 : $name = "Rolovanne, 13th Lord of the North Coast";
    case 0_54_55_50_56 : $name = "Rologray, 12th Lord of the North Coast";
    case 0_55_54_22_30 : $name = "Unknown";
    case 0_55_54_21_15 : $name = "Unknown";
    case 0_55_55_52_7 : $name = "Unknown";
    case 0_55_55_56_6 : $name = "Unknown";
}
return($name);

[proc,fenk_grave_read](coord $coord)(boolean)
def_string $name = ~fenk_grave_name($coord);
if (string_length($name) = 0) {
    return(false);
}
mes("The grave says:");
mes(" 'Here lies <$name> - REST IN PEACE.'");
return(true);

[oploc1,fenk_coffin]
if (~fenk_grave_read(loc_coord) = true) {
    return;
}
if (loc_coord = 0_55_55_58_7) {
    if (%fenk_coffin = 1) {
        sound_synth(scrape, 1, 0);
        loc_anim(fenk_capstone_moves);
        p_delay(2);
        p_teleport(0_55_155_57_7);
        return;
    }
    mes("This coffin is incredibly heavy, and does not budge.");
    return;
}
if (loc_coord = 0_54_55_49_51) {
    sound_synth(scrape, 1, 0);
    loc_anim(fenk_capstone_moves);
    p_delay(2);
    p_teleport(0_54_155_48_49);
    return;
}
mes("This coffin is incredibly heavy, and does not budge.");

[oploc2,fenk_coffin]
if (loc_coord = 0_55_55_58_7) {
    if (%fenk_coffin = 1) {
        mes("The memorial stone holds a star amulet in place on its lid.");
    } else {
        mes("You find a depression in the memorial stone in the shape of a six-pointed star.");
    }
    return;
}
mes("You find nothing remarkable about the memorial stone.");

[oplocu,fenk_coffin]
if (last_useitem ! fenk_star_amulet | loc_coord ! 0_55_55_58_7) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, fenk_star_amulet, 1);
%fenk_coffin = 1;
~objbox(fenk_star_amulet, "The star amulet fits exactly into the depression on the coffin lid.", 250, 0, 0);

[oploc1,fenk_grave] if (~fenk_grave_read(loc_coord) = false) mes("Nothing interesting happens.");
[oploc1,fenk_grave_poor] if (~fenk_grave_read(loc_coord) = false) mes("Nothing interesting happens.");
[oploc2,fenk_grave] @fenk_dig_grave;
[oploc2,fenk_grave_poor] @fenk_dig_grave;

// the spots where a body part lies (the spade: general_use/scripts/spade.rs2)
[proc,fenk_at_grave]()(boolean)
switch_coord (coord) {
    case 0_54_55_47_56, 0_54_55_48_56, 0_54_55_49_56, 0_56_54_24_34 : return(true);
}
return(false);

[label,fenk_dig_grave]
p_arrivedelay;
if (inv_total(inv, spade) = 0) {
    mes("You don't have anything to dig with.");
    return;
}
anim(human_dig, 0);
mes("You start digging...");
p_delay(5);
anim(null, 0);
if (%fenk_quest < ^fenk_body_parts) {
    mes("...but the grave is empty.");
    return;
}
if (coord = 0_54_55_47_56 & inv_total(inv, fenk_torso) = 0 & %fenk_torso = 0) {
    ~fenk_give(fenk_torso);
    ~objbox(fenk_torso, "... and you unearth a torso.", 250, 0, 0);
} else if (coord = 0_54_55_48_56 & inv_total(inv, fenk_arms) = 0 & %fenk_arms = 0) {
    ~fenk_give(fenk_arms);
    ~objbox(fenk_arms, "... and you unearth a pair of arms.", 250, 0, 0);
} else if (coord = 0_54_55_49_56 & inv_total(inv, fenk_legs) = 0 & %fenk_legs = 0) {
    ~fenk_give(fenk_legs);
    ~objbox(fenk_legs, "... and you unearth a pair of legs.", 250, 0, 0);
} else if (coord = 0_56_54_24_34 & inv_total(inv, fenk_head_empty) = 0 & inv_total(inv, fenk_head_full) = 0 & %fenk_head = 0) {
    ~fenk_give(fenk_head_empty);
    ~objbox(fenk_head_empty, "... and you unearth a decapitated head.", 250, 0, 0);
} else {
    mes("...but the grave is empty.");
}

// ---------------------------------------------------------------- the doors
[oploc1,fenk_mausoleum_door]
if (%fenk_unlocked_cavern = 0 & inv_total(inv, fenk_mausoleum_key) = 0) {
    mes("The door is locked.");
    return;
}
if (inv_total(inv, fenk_mausoleum_key) > 0) {
    inv_del(inv, fenk_mausoleum_key, 1);
    %fenk_unlocked_cavern = 1;
}
~eascape_door_walk;

[oplocu,fenk_mausoleum_door]
if (last_useitem ! fenk_mausoleum_key) {
    ~displaymessage(^dm_default);
    return;
}
if (%fenk_unlocked_cavern = 1) {
    mes("The gate is already unlocked.");
    return;
}
inv_del(inv, fenk_mausoleum_key, 1);
%fenk_unlocked_cavern = 1;
~eascape_door_walk;

[oploc1,fenk_tower_door]
if (%fenk_unlocked_tower = 0 & inv_total(inv, fenk_tower_key) = 0) {
    mes("The door is locked.");
    return;
}
if (inv_total(inv, fenk_tower_key) > 0) {
    inv_del(inv, fenk_tower_key, 1);
    %fenk_unlocked_tower = 1;
}
~eascape_door_walk;

[oploc1,fenk_shed_door]
if (%fenk_unlocked_shed = 0 & inv_total(inv, fenk_shed_key) = 0) {
    mes("The door is locked.");
    return;
}
if (inv_total(inv, fenk_shed_key) > 0) {
    inv_del(inv, fenk_shed_key, 1);
    %fenk_unlocked_shed = 1;
}
~eascape_door_walk;

// the castle's double doors: they open and stay open a while, as other double doors do (the
// gardener can follow you through); upstairs, the doors out to the lightning conductor are locked
// until Fenkenstrain sends you there
[oploc1,fenk_door]
if (coordy(loc_coord) = 1 & %fenk_quest < ^fenk_conductor) {
    mes("The door to the lightning conductor is locked.");
    return;
}
~open_double_doors_left(500, door_right_closed, loc_param(open_sound));

[oploc1,fenk_door_mirror]
if (coordy(loc_coord) = 1 & %fenk_quest < ^fenk_conductor) {
    mes("The door to the lightning conductor is locked.");
    return;
}
~open_double_doors_right(500, door_left_closed, loc_param(open_sound));

// ---------------------------------------------------------------- the lightning conductor
[oploc1,fenk_conductor_broken] @fenk_repair_conductor;
[oplocu,fenk_conductor_broken]
if (last_useitem ! fenk_conductor) {
    ~displaymessage(^dm_default);
    return;
}
@fenk_repair_conductor;

[label,fenk_repair_conductor]
if (%fenk_quest > ^fenk_conductor) {
    mes("The lightning conductor is now beyond repair.");
    return;
}
if (inv_total(inv, fenk_conductor) = 0 | %fenk_quest < ^fenk_conductor) { // ours: only once he wants it
    mes("You don't have anything to repair the conductor with.");
    return;
}
inv_del(inv, fenk_conductor, 1);
loc_change(fenk_conductor_repaired, 5);
sound_synth(lightning, 1, 0);
%fenk_quest = ^fenk_creature_alive;
~send_quest_progress(questlist:creatureoffenkenstrain, %fenk_quest, ^fenk_complete);
~mesbox("You repair the lightning conductor not one moment too soon - a tremendous bolt of lightning melts the new lightning conductor, and power blazes throughout the castle, if only briefly.");

// the conductor, cast at a furnace from a silver bar (skill_crafting jewellery.rs2's craft_silver)
[proc,fenk_cast_conductor]()(boolean)
if (inv_total(inv, fenk_lightning_mould) = 0) {
    return(false);
}
if (stat(crafting) < 20) {
    ~mesbox("You need at least level 20 Crafting to make that.");
    return(true);
}
anim(human_furnace, 0);
sound_synth(furnace, 1, 0);
if_close;
p_delay(2);
inv_del(inv, silver_bar, 1);
inv_add(inv, fenk_conductor, 1);
stat_advance(crafting, 500);
mes("You make a lightning conductor."); // ours
return(true);

// ---------------------------------------------------------------- the chimney
[oplocu,fenk_fireplace]
if (last_useitem ! fenk_brush1 & last_useitem ! fenk_brush2 & last_useitem ! fenk_brush3) {
    ~displaymessage(^dm_default);
    return;
}
anim(fenk_human_poke, 0);
sound_synth(brushing, 1, 0);
if (last_useitem ! fenk_brush3) {
    mes("You stick the garden brush up the chimney, but it is not long enough to clear the blockage.");
    return;
}
if (loc_coord = 1_55_55_24_35 & inv_total(inv, fenk_lightning_mould) = 0 & %fenk_quest < ^fenk_creature_alive) {
    ~fenk_give(fenk_lightning_mould);
    ~objbox(fenk_lightning_mould, "A lightning conductor mould falls down out of the chimney.", 250, 0, 0);
    return;
}
mes("You give the chimney a jolly good clean out.");

// ---------------------------------------------------------------- items
[opheldu,fenk_marble_amulet] @fenk_star_amulet;
[opheldu,fenk_obsidian_amulet] @fenk_star_amulet;
[label,fenk_star_amulet]
if (last_useitem ! fenk_marble_amulet & last_useitem ! fenk_obsidian_amulet) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, fenk_marble_amulet) = 0 | inv_total(inv, fenk_obsidian_amulet) = 0) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, fenk_marble_amulet, 1);
inv_del(inv, fenk_obsidian_amulet, 1);
inv_add(inv, fenk_star_amulet, 1);
~objbox(fenk_star_amulet, "The marble and obsidian amulets snap together tightly to form a six-pointed amulet.", 250, 0, 0);

[opheldu,fenk_head_empty] @fenk_fill_head;
[opheldu,fenk_brain] @fenk_fill_head;
[label,fenk_fill_head]
if (inv_total(inv, fenk_head_empty) = 0 | inv_total(inv, fenk_brain) = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (last_useitem ! fenk_head_empty & last_useitem ! fenk_brain) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, fenk_head_empty, 1);
inv_del(inv, fenk_brain, 1);
inv_add(inv, fenk_head_full, 1);
~objbox(fenk_head_full, "You squeeze the pickled brain into the decapitated head.", 250, 0, 0);

[opheldu,fenk_cane]
switch_obj (last_useitem) {
    case fenk_brush0, fenk_brush1, fenk_brush2, fenk_brush3 : ~fenk_extend_brush(last_useitem);
    case default : ~displaymessage(^dm_default);
}
[opheldu,fenk_brush0] if (last_useitem = fenk_cane) { ~fenk_extend_brush(fenk_brush0); } else { ~displaymessage(^dm_default); }
[opheldu,fenk_brush1] if (last_useitem = fenk_cane) { ~fenk_extend_brush(fenk_brush1); } else { ~displaymessage(^dm_default); }
[opheldu,fenk_brush2] if (last_useitem = fenk_cane) { ~fenk_extend_brush(fenk_brush2); } else { ~displaymessage(^dm_default); }
[opheldu,fenk_brush3] if (last_useitem = fenk_cane) { ~fenk_extend_brush(fenk_brush3); } else { ~displaymessage(^dm_default); }

[proc,fenk_extend_brush](obj $brush)
if ($brush = fenk_brush3) {
    mes("The brush is too long to attach any more canes.");
    return;
}
if (inv_total(inv, bronzecraftwire) = 0) {
    mes("You try to attach the canes, but you need something suitable to hold them together.");
    return;
}
if (stat(crafting) < 20) {
    mes("You need Level 20 Crafting to attach the cane to the brush.");
    return;
}
def_namedobj $next = fenk_brush1;
if ($brush = fenk_brush1) {
    $next = fenk_brush2;
} else if ($brush = fenk_brush2) {
    $next = fenk_brush3;
}
inv_del(inv, bronzecraftwire, 1);
inv_del(inv, fenk_cane, 1);
inv_del(inv, $brush, 1);
inv_add(inv, $next, 1);
mes("You attach the cane to the brush.");

[opheld1,fenk_letter]
def_string $t = "Rologarric,||I am writing to you, my brother, to ask for your aid, and to forgive me on behalf of all the poor souls that I have sacrificed to save my own neck. I have no doubt that my own soul lies forfeit, but I would wish to see you once again before I am cast into the eternal fire. You well know the history of our noble ancestors, who have stood against the wave of darkness covering all of Morytania, protecting the inhabitants of this castle by sheer force of personality. I, however, stand lacking in their all too dominating shadow. I have been weak, my brother, letting Him rule in my stead.";
$t = append($t, "||You know of whom I speak but dare not name - my 'doctor' of many years, the very same creature you sought to escape ten years ago. He advised me that the power in the South was rising, and that soon our ancestral home would fall to the growing evil. He advised me to send a gift of tribute to the vampires, to satisfy their hunger for at least a while. I regret to say that I acceded to this request. I ordered a young girl out into the Forest to pick mushrooms, knowing that I was sending her to her death, or||Of course, soon after my advisor told me that the vampires were again restive, and to send another 'gift'. And of course, this I did, to ensure the safety of everyone in the castle.");
$t = append($t, "||But a vampires' hunger can never be sated. Every innocent soul I have sent into the Forest to their doom both strengthens their power and increases their hunger.||He knows this. I look into his eyes and see amusement. In his eyes I see the truth - that he must have struck a deal with them some time ago. He sold my people to them, in exchange for ... this castle.||I have sent them all to their doom, and now I fear my own.||Your brother,||Rologarth,||15th Lord of the North Coast");
~book("A letter", $t);

// the experiment with the key on its collar: not again once you have its key
[opnpc2,fenk_experiment_1]
if (inv_total(inv, fenk_mausoleum_key) > 0 | %fenk_unlocked_cavern = 1) {
    mes("You don't have the heart to kill this poor creature again.");
    return;
}
@player_combat_start;
[apnpc2,fenk_experiment_1]
if (inv_total(inv, fenk_mausoleum_key) > 0 | %fenk_unlocked_cavern = 1) {
    mes("You don't have the heart to kill this poor creature again.");
    return;
}
@player_combat_start_ap;
