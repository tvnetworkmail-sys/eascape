// EASCape: Wanted! - the hunt for Solus Dellagar. The OSRS wiki's walkthrough and transcript: seven
// scan places, Canifis 1st, the Champions' Guild 3rd, the Dorgeshuun mine 5th and the rune essence
// mine 7th, the 2nd, 4th and 6th drawn at random; Solus teleports you to Camelot at the 2nd, blinds
// you with smoke at the 3rd, hits you with the Flames of Zamorak at the 4th (never killing you:
// Savant takes you to the White Knights' Castle), plays a woman at the 5th and summons a level 32
// Black Knight at the 6th (kill it, or after 5 minutes it goes, the RS wiki); in the essence mine
// Savant's fifteen rangers die to his Ice Barrage and you fight him, weakened (40 hitpoints, melee).
// The cache's own pieces: the Commorb's Scan (wanted_crystal_ball_scan, its spotanim and the
// wanted_scan sound), wanted_solus1-19 (each shows only while its wanted_mission varbit is 1),
// the woman (wanted_solus_fake_woman, on wanted_mission3), wanted_summoned_black_knight,
// wanted_white_ranger, wanted_solus_attackable, wanted_solus_summon and the wanted_teleport
// spotanim. Ours: where in each place Solus stands (next to you), the size of each place, the
// timing, the share of your hitpoints the flames take (95%, leaving at least 1).

// ---------------------------------------------------------------- the nineteen places
[proc,wanted_mission](int $m)(int)
switch_int ($m) {
    case 1 : return(%wanted_mission1);
    case 2 : return(%wanted_mission2);
    case 3 : return(%wanted_mission3);
    case 4 : return(%wanted_mission4);
    case 5 : return(%wanted_mission5);
    case 6 : return(%wanted_mission6);
    case 7 : return(%wanted_mission7);
    case 8 : return(%wanted_mission8);
    case 9 : return(%wanted_mission9);
    case 10 : return(%wanted_mission10);
    case 11 : return(%wanted_mission11);
    case 12 : return(%wanted_mission12);
    case 13 : return(%wanted_mission13);
    case 14 : return(%wanted_mission14);
    case 15 : return(%wanted_mission15);
    case 16 : return(%wanted_mission16);
    case 17 : return(%wanted_mission17);
    case 18 : return(%wanted_mission18);
    case 19 : return(%wanted_mission19);
}
return(0);

[proc,wanted_mission_set](int $m, int $v)
switch_int ($m) {
    case 1 : %wanted_mission1 = $v;
    case 2 : %wanted_mission2 = $v;
    case 3 : %wanted_mission3 = $v;
    case 4 : %wanted_mission4 = $v;
    case 5 : %wanted_mission5 = $v;
    case 6 : %wanted_mission6 = $v;
    case 7 : %wanted_mission7 = $v;
    case 8 : %wanted_mission8 = $v;
    case 9 : %wanted_mission9 = $v;
    case 10 : %wanted_mission10 = $v;
    case 11 : %wanted_mission11 = $v;
    case 12 : %wanted_mission12 = $v;
    case 13 : %wanted_mission13 = $v;
    case 14 : %wanted_mission14 = $v;
    case 15 : %wanted_mission15 = $v;
    case 16 : %wanted_mission16 = $v;
    case 17 : %wanted_mission17 = $v;
    case 18 : %wanted_mission18 = $v;
    case 19 : %wanted_mission19 = $v;
}

[proc,wanted_mission_done](int $m)(int)
switch_int ($m) {
    case 1 : return(%wanted_mission1complete);
    case 2 : return(%wanted_mission2complete);
    case 3 : return(%wanted_mission3complete);
    case 4 : return(%wanted_mission4complete);
    case 5 : return(%wanted_mission5complete);
    case 6 : return(%wanted_mission6complete);
    case 7 : return(%wanted_mission7complete);
    case 8 : return(%wanted_mission8complete);
    case 9 : return(%wanted_mission9complete);
    case 10 : return(%wanted_mission10complete);
    case 11 : return(%wanted_mission11complete);
    case 12 : return(%wanted_mission12complete);
    case 13 : return(%wanted_mission13complete);
    case 14 : return(%wanted_mission14complete);
    case 15 : return(%wanted_mission15complete);
    case 16 : return(%wanted_mission16complete);
    case 17 : return(%wanted_mission17complete);
    case 18 : return(%wanted_mission18complete);
    case 19 : return(%wanted_mission19complete);
}
return(0);

[proc,wanted_mission_setdone](int $m, int $v)
switch_int ($m) {
    case 1 : %wanted_mission1complete = $v;
    case 2 : %wanted_mission2complete = $v;
    case 3 : %wanted_mission3complete = $v;
    case 4 : %wanted_mission4complete = $v;
    case 5 : %wanted_mission5complete = $v;
    case 6 : %wanted_mission6complete = $v;
    case 7 : %wanted_mission7complete = $v;
    case 8 : %wanted_mission8complete = $v;
    case 9 : %wanted_mission9complete = $v;
    case 10 : %wanted_mission10complete = $v;
    case 11 : %wanted_mission11complete = $v;
    case 12 : %wanted_mission12complete = $v;
    case 13 : %wanted_mission13complete = $v;
    case 14 : %wanted_mission14complete = $v;
    case 15 : %wanted_mission15complete = $v;
    case 16 : %wanted_mission16complete = $v;
    case 17 : %wanted_mission17complete = $v;
    case 18 : %wanted_mission18complete = $v;
    case 19 : %wanted_mission19complete = $v;
}

// the place Solus is at now (the one wanted_mission bit set), 0 if none
[proc,wanted_target]()(int)
def_int $m = 1;
while ($m <= ^wanted_m_last) {
    if (~wanted_mission($m) = 1) return($m);
    $m = calc($m + 1);
}
return(0);

// how far along the chase is: 1 Canifis ... 7 the essence mine
[proc,wanted_position]()(int)
def_int $n = 1;
def_int $m = 1;
while ($m <= ^wanted_m_last) {
    if (~wanted_mission_done($m) = 1) $n = calc($n + 1);
    $m = calc($m + 1);
}
return($n);

[proc,wanted_set_target](int $m)
def_int $i = 1;
while ($i <= ^wanted_m_last) {
    ~wanted_mission_set($i, 0);
    $i = calc($i + 1);
}
if ($m > 0) ~wanted_mission_set($m, 1);

[proc,wanted_clear_missions]
def_int $i = 1;
while ($i <= ^wanted_m_last) {
    ~wanted_mission_set($i, 0);
    ~wanted_mission_setdone($i, 0);
    $i = calc($i + 1);
}

// one of the places 5-19 not yet visited
[proc,wanted_pick_random]()(int)
def_int $free = 0;
def_int $m = ^wanted_m_first_random;
while ($m <= ^wanted_m_last) {
    if (~wanted_mission_done($m) = 0) $free = calc($free + 1);
    $m = calc($m + 1);
}
if ($free = 0) return(^wanted_m_first_random);
def_int $pick = random($free);
$m = ^wanted_m_first_random;
while ($m <= ^wanted_m_last) {
    if (~wanted_mission_done($m) = 0) {
        if ($pick = 0) return($m);
        $pick = calc($pick - 1);
    }
    $m = calc($m + 1);
}
return(^wanted_m_first_random);

// the places (the OSRS wiki's list). Ours: their extent, around the cache map's own npcs there.
[proc,wanted_in_place](int $m, coord $c)(boolean)
switch_int ($m) {
    case 1 : return(inzone(0_54_54_0_0, 0_54_54_63_63, $c)); // Canifis (its map square)
    case 2 : return(inzone(0_49_52_51_21, 1_49_52_61_37, $c)); // inside the Champions' Guild (Guildmaster, Valaine, Scavvo)
    case 3 : return(inzone(0_51_150_36_5, 0_52_150_2_60, $c)); // the Dorgeshuun mine (the cave goblin miners)
    case 5 : return(inzone(0_40_56_55_56, 0_41_58_61_3, $c)); // Rellekka (the Fremennik cloak and fur sellers)
    case 6 : return(inzone(0_45_49_20_9, 0_46_49_1_39, $c)); // Musa Point's banana plantation (Luthas)
    case 7 : return(inzone(0_48_49_28_16, 0_48_49_46_36, $c)); // the Wizards' Tower, ground floor
    case 8 : return(inzone(0_41_51_24_26, 0_41_51_51_56, $c)); // Ardougne market (the fur merchant)
    case 9 : return(inzone(0_38_48_3_8, 0_38_48_16_26, $c)); // Castle Wars (by the portals and judge)
    case 10 : return(inzone(0_38_54_27_34, 0_38_54_41_48, $c)); // the Grand Tree, by King Narnode
    case 11 : return(inzone(0_53_55_13_10, 0_53_55_60_60, $c)); // the Slayer Tower (the banshees)
    case 12 : return(inzone(0_43_49_38_16, 0_43_49_52_26, $c)); // Brimhaven's pub, the Dead Man's Chest
    case 13 : return(inzone(0_51_50_34_5, 0_51_50_46_17, $c)); // Ali Morrisane's stall, Al Kharid
    case 14 : return(inzone(0_50_148_10_63, 0_50_149_40_24, $c)); // the Lumbridge Swamp Caves' giant frogs
    case 15 : return(inzone(0_46_54_1_39, 0_46_55_21_0, $c)); // Goblin Village
    case 16 : return(inzone(0_39_48_54_2, 0_40_48_2_12, $c)); // the Dragon Inn, Yanille
    case 17 : return(inzone(0_41_54_1_9, 0_41_54_51_54, $c)); // McGrubor's Wood
    case 18 : return(inzone(0_48_50_0_43, 0_48_50_18_58, $c)); // Draynor Village market, by the seed stall
    case 19 : return(inzone(0_38_50_23_18, 0_38_50_43_38, $c)); // the Grave of Scorpius
}
return(false);

// a spot in each place (the cache map's own npc there), for ::wantedtele
[proc,wanted_place_coord](int $m)(coord)
switch_int ($m) {
    case 1 : return(0_54_54_58_23);   // Canifis' bank
    case 2 : return(0_49_52_55_34);   // the Guildmaster
    case 3 : return(0_51_150_52_32);  // a cave goblin miner
    case 4 : return(enum(int, coord, essence_mine_teleports, 0));
    case 5 : return(0_41_57_16_27);   // Rellekka's fur trader
    case 6 : return(0_45_49_59_18);   // Luthas
    case 7 : return(0_48_49_35_22);   // a wizard
    case 8 : return(0_41_51_42_31);   // the fur merchant
    case 9 : return(0_38_48_9_17);    // the Castle Wars judge
    case 10 : return(0_38_54_34_41);  // King Narnode
    case 11 : return(0_53_55_41_32);  // a banshee
    case 12 : return(0_43_49_45_19);  // the Dead Man's Chest's bartender
    case 13 : return(0_51_50_40_11);  // Ali Morrisane
    case 14 : return(0_50_149_24_8);  // a giant frog
    case 15 : return(0_46_54_14_55);  // General Bentnoze
    case 16 : return(0_39_48_60_6);   // the Dragon Inn's bartender
    case 17 : return(0_41_54_21_32);  // a guard dog
    case 18 : return(0_48_50_6_51);   // the seed merchant
    case 19 : return(0_38_50_33_27);  // the spirit of Scorpius
}
return(^wanted_tiffy);

[proc,wanted_solus_npc](int $m)(npc)
switch_int ($m) {
    case 1 : return(wanted_solus1);
    case 2 : return(wanted_solus2);
    case 3 : return(wanted_solus3);
    case 4 : return(wanted_solus4);
    case 5 : return(wanted_solus5);
    case 6 : return(wanted_solus6);
    case 7 : return(wanted_solus7);
    case 8 : return(wanted_solus8);
    case 9 : return(wanted_solus9);
    case 10 : return(wanted_solus10);
    case 11 : return(wanted_solus11);
    case 12 : return(wanted_solus12);
    case 13 : return(wanted_solus13);
    case 14 : return(wanted_solus14);
    case 15 : return(wanted_solus15);
    case 16 : return(wanted_solus16);
    case 17 : return(wanted_solus17);
    case 18 : return(wanted_solus18);
