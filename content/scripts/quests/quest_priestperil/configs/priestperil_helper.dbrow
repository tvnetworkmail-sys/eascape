[questhelper_step_priestperil_1]
table=questhelper_step
data=id,201
data=section,0
data=text,Talk to King Roald in Varrock Palace.
data=npc,king_roald
data=coord,0_50_54_22_20
data=option,Sure.

[questhelper_step_priestperil_2]
table=questhelper_step
data=id,202
data=section,0
data=text,"Knock at the temple door, east of Varrock where the River Salve starts, and say Roald sent you."
data=loc,priestperiltempledoorl
data=coord,0_53_54_16_33
data=option,Roald sent me to check on Drezel.
data=option,Sure.

[questhelper_step_priestperil_3]
table=questhelper_step
data=id,203
data=section,1
data=text,Open and climb down the trapdoor in the mausoleum north of the temple.
data=loc,trapdoor
data=coord,0_53_54_13_51

[questhelper_step_priestperil_4]
table=questhelper_step
data=id,204
data=section,1
data=text,"Kill the temple guardian, the dog in the room underground."
data=npc,priestperilguarddog
data=coord,0_53_154_13_46

[questhelper_step_priestperil_5]
table=questhelper_step
data=id,205
data=section,1
data=text,Climb back up the ladder.
data=loc,loc_1755
data=coord,0_53_154_13_51

[questhelper_step_priestperil_6]
table=questhelper_step
data=id,206
data=section,1
data=text,Go back to King Roald in Varrock Palace and tell him the dog is dead.
data=npc,king_roald
data=coord,0_50_54_22_20

[questhelper_step_priestperil_7]
table=questhelper_step
data=id,207
data=section,2
data=text,Go into the temple (the doors are open now) and up the stairs. Zamorakian monks (level 30) attack you inside.
data=loc,loc_1738
data=coord,0_53_54_25_28

[questhelper_step_priestperil_8]
table=questhelper_step
data=id,208
data=section,2
data=text,Climb the ladder to the top floor.
data=loc,ladder
data=coord,1_53_54_18_29

[questhelper_step_priestperil_9]
table=questhelper_step
data=id,209
data=section,2
data=text,"Talk-through the cell door to Drezel. Pick 'Tell me anyway.' and then 'Yes.'"
data=loc,pip_prisondoor
data=coord,2_53_54_23_33
data=option,Tell me anyway.
data=option,Yes.

[questhelper_step_priestperil_10]
table=questhelper_step
data=id,210
data=section,3
data=text,"Kill the Zamorakian monks in the temple until one drops a golden key, and pick it up."
data=npc,priestperilevilmonk3
data=obj,pipkey_gold
data=coord,0_53_54_21_31

[questhelper_step_priestperil_11]
table=questhelper_step
data=id,211
data=section,3
data=text,Take the golden key down the trapdoor in the mausoleum north of the temple.
data=loc,trapdoor
data=coord,0_53_54_13_51
data=item,pipkey_gold,1

[questhelper_step_priestperil_12]
table=questhelper_step
data=id,212
data=section,3
data=text,"Go through the gate and study the monuments: use the golden key on the one that reads 'Saradomin is the key that unlocks the mysteries of life' to swap it for the iron key."
data=coord,0_53_154_31_34
data=item,pipkey_gold,1

[questhelper_step_priestperil_13]
table=questhelper_step
data=id,213
data=section,3
data=text,Use a bucket on the well in the middle of the monuments to fill it with murky water.
data=loc,priestperil_well
data=coord,0_53_154_31_34
data=item,bucket_empty,1

[questhelper_step_priestperil_14]
