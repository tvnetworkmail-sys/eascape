// EASCape: Roving Elves, ported from 2009scape (content/region/tirranwn/quest/rovingelves: the
// quest, Islwyn's and Eluned's dialogue, the moss giant guardian, the seed's planting), with the
// OSRS wiki's rewards (10,000 Strength XP, a crystal bow or shield with 500 charges: the 2/10
// versions, as 2009scape gives) and prices
// (a new bow 900,000, a shield 750,000). Our choices are marked "ours".

// ---------------------------------------------------------------- Islwyn
[opnpc1,roving_islwyn]
if (%roving_elves_quest >= ^roving_complete) {
    ~chatplayer("<p,neutral>Hello Islwyn, I'm back.");
    @roving_islwyn_after;
}
if (%waterfall_quest < ^waterfall_complete) {
    ~chatplayer("<p,neutral>Hello there.");
    ~chatnpc("<p,neutral>Hello there, it's a lovely day for a walk in the woods.|So what can I help you with?");
    ~chatplayer("<p,neutral>I'm just looking around.");
    return;
}
if (%roving_elves_quest = ^roving_not_started) {
    ~chatplayer("<p,neutral>Hello there.");
    if (%regicide_quest < ^regicide_complete) { // ours: the wiki's other requirement
        ~chatnpc("<p,neutral>Leave me be, I have no time for easterners.");
        return;
    }
    @roving_islwyn_start;
}
~chatplayer("<p,neutral>Hello Islwyn.");
if (%roving_elves_quest = ^roving_planted) {
    @roving_islwyn_reward;
}
~chatnpc("<p,quiz>Have you spoken to Eluned yet?");
if (%roving_elves_quest = ^roving_seed) {
    ~chatplayer("<p,neutral>Yes I have! She explained that I have to visit|Glarial's old tomb and obtain a consecration seed|from the temple guardian in there.");
    ~chatnpc("<p,neutral>Good luck against the guardian, adventurer.|Do it in the name of my grandmother Glarial.");
    return;
}
~chatplayer("<p,neutral>Not yet, I'll be back when I have.");

[label,roving_islwyn_start]
~chatnpc("<p,angry>Leave me be, I have no time for easterners. Between|your lot and them gnomes, all you do is take and|destroy. No thought for others.");
~chatplayer("<p,confused>...but...");
~chatnpc("<p,angry>Save your excuses young one! It was one of your|species that disturbed my grandmother's remains. Will|she never get the peace she deserves?");
~chatplayer("<p,quiz>Grandmother?");
~chatnpc("<p,sad>Yes! Someone took her ashes from her tomb. If it|wasn't for them gnomes she'd have been left in peace.|But now I can sense her restlessness.");
~chatplayer("<p,quiz>Gnomes?");
~chatnpc("<p,angry>Yes gnomes! One of those little pests took the key to|my grandmother's tomb. He must've given it to the|human that desecrated the tomb.");
~chatplayer("<p,quiz>Was your grandmother's name Glarial?");
~chatnpc("<p,quiz>Yes... How did you know that?");
def_int $choice = ~p_choice3_header("Tell the truth?", 1, "Lie?", 2, "Leave the old elf be?", 3, "Do you want to;");
if ($choice = 2) {
    ~chatplayer("<p,neutral>I just guessed.|Well, now that that's over, I really need to be|going.");
    return;
}
if ($choice ! 1) {
    ~chatplayer("<p,neutral>On second thought, I really should be going.");
    return;
}
~chatplayer("<p,neutral>It's a bit of a long tale, but to cut the story short, her|remains reside in Baxtorian's home. I thought it's where|she'd want to be. It was I that removed your|grandmother's ashes.");
~chatnpc("<p,shock>You've been in grandfather's home? That's where we|originally wanted to leave Glarial's ashes to rest, but we|could not understand how to enter.");
~chatnpc("<p,neutral>This is gravely concerning... Her resting place must be|consecrated.");
$choice = ~p_choice2("Maybe I could help.", 1, "Sounds like you've got a lot to do.", 2);
if ($choice ! 1) {
    ~chatplayer("<p,neutral>Sounds like you've got a lot to do.");
    return;
}
~chatplayer("<p,neutral>Maybe I could help. What needs doing to consecrate|her new tomb?");
~chatnpc("<p,happy>Are you offering to help?!? Maybe not all humans are|as bad as I thought.");
~chatnpc("<p,neutral>I don't know the consecration process. You should speak|with Eluned... she is wise in the ways of the ritual.");
~chatplayer("<p,neutral>I'll see what I can do.");
%roving_elves_quest = ^roving_started;
~send_quest_progress(questlist:roving_elves, %roving_elves_quest, ^roving_complete);

[label,roving_islwyn_reward]
~chatnpc("<p,happy>You have returned! Thank you for all you have done.|Now both me and my grandmother can rest in peace.");
~chatplayer("<p,quiz>How did you know that I have consecrated the tomb?");
~chatnpc("<p,neutral>Her restlessness has finally left me. Here - I should|give you something for your effort.");
~doubleobjbox(roving_crystal_bow_1000, roving_crystal_shield_1000, "Islwyn shows you a crystal bow and a crystal shield.", 250);
~chatnpc("<p,neutral>Crystal equipment is at its best when new and|previously unused. The bow does not require|ammunition and reduces in strength the more it's fired.|The shield decreases in defensive capabilities the more");
~chatnpc("<p,neutral>it's hit. Both the shield and the bow I am carrying only|have 500 uses before they revert to seed.");
~chatplayer("<p,quiz>Revert to seed? What do you mean?");
~chatnpc("<p,neutral>Ahhh, young one. It was thousands of years before we|fully understood that ourselves. All will be explained if|we feel you are ready. Now which one of these crystal|creations would you like?");
def_int $choice = ~p_choice2("Shields are for wimps! Give me the bow!", 1, "I don't like running and hiding behind mushrooms. Shield please!", 2);
if ($choice = 1) {
    ~chatplayer("<p,happy>Shields are for wimps! Give me the bow!");
    ~roving_complete(roving_crystal_bow_200);
} else if ($choice = 2) {
    ~chatplayer("<p,happy>I don't like running and hiding behind mushrooms.|Shield please!");
    ~roving_complete(roving_crystal_shield_200);
}

[proc,roving_complete](namedobj $reward)
if (~crystal_bow($reward) = true) {
    %crystal_bow_shots = 0;
} else {
    %crystal_shield_hits = 0;
}
if (inv_freespace(inv) > 0) {
    inv_add(inv, $reward, 1);
} else {
    obj_add(coord, $reward, 1, ^lootdrop_duration);
    mes("Your pack is full: <oc_name($reward)> is on the ground."); // ours
}
%roving_elves_quest = ^roving_complete;
stat_advance(strength, 100000);
session_log(^log_adventure, "Quest complete: Roving Elves");
~send_quest_complete(questlist:roving_elves, roving_crystal_bow_1000, 250, ^roving_questpoints, "You have completed\\nRoving Elves!", "1 Quest Point|Used elf equipment|10000 Strength XP");

// after the quest: a new bow or shield, or a seed re-enchanted (2009scape's choices; the OSRS
// wiki's prices for new ones; re-enchanting is 2009scape's crystalWeaponPrice, the wiki's too)
[label,roving_islwyn_after]
~chatnpc("<p,happy>Welcome back to the land of the elves, friend!|Do you need your seeds charged into equipment?");
def_int $choice = ~p_choice3("I need to buy a new piece of equipment.", 1, "I need to recharge my seeds into equipment.", 2, "Nothing, thanks.", 3);
if ($choice = 1) {
    ~chatplayer("<p,neutral>I need to buy a new piece of equipment.");
    $choice = ~p_choice2("Purchase bow", 1, "Purchase shield", 2);
    if ($choice = 1) {
        ~chatplayer("<p,neutral>I'd like to buy a new bow.");
        ~roving_buy(roving_crystal_bow_new, 900000);
    } else if ($choice = 2) {
        ~chatplayer("<p,neutral>I'd like to buy a new shield.");
        ~roving_buy(roving_crystal_shield_new, 750000);
    }
} else if ($choice = 2) {
    ~chatplayer("<p,neutral>I need to recharge my current seeds into equipment.");
    $choice = ~p_choice2("Recharge seed into bow", 1, "Recharge seed into shield", 2);
    if ($choice = 1) {
        ~chatplayer("<p,neutral>Recharge my seed into a bow, please.");
        ~roving_recharge(roving_crystal_bow_1000);
    } else if ($choice = 2) {
        ~chatplayer("<p,neutral>Recharge my seed into a shield, please.");
        ~roving_recharge(roving_crystal_shield_1000);
    }
} else if ($choice = 3) {
    ~chatplayer("<p,neutral>Nothing, thanks."); // ours
}

[proc,roving_recharge](namedobj $obj)
if (inv_total(inv, crystal_seed_old) = 0) {
    ~mesbox("You don't have any seeds to recharge.");
    return;
}
def_int $price = max(sub(900000, multiply(180000, %roving_update_ilfeen_chant)), 180000);
if (inv_total(inv, coins) < $price) {
    ~mesbox("You don't have enough coins, you need <tostring($price)>.");
    return;
}
inv_del(inv, crystal_seed_old, 1);
inv_del(inv, coins, $price);
inv_add(inv, $obj, 1);
%roving_update_ilfeen_chant = add(%roving_update_ilfeen_chant, 1);
if (~crystal_bow($obj) = true) {
    %crystal_bow_shots = 0;
} else {
    %crystal_shield_hits = 0;
}

[proc,roving_buy](namedobj $obj, int $price)
~chatnpc("<p,neutral>Ah, very well. That will be <tostring($price)> coins.");
if (inv_total(inv, coins) < $price) {
    ~mesbox("You don't have enough coins.");
    return;
}
if (inv_freespace(inv) < 1) {
    ~mesbox("You don't have enough room in your pack."); // ours
    return;
}
inv_del(inv, coins, $price);
inv_add(inv, $obj, 1);

// ---------------------------------------------------------------- Eluned
[opnpc1,roving_female_woodelf]
if (%roving_elves_quest = ^roving_started) {
    ~chatplayer("<p,neutral>Hey there... Islwyn said you may be able to help me.|He told me you know how to consecrate ground for an|elven burial. I need to reconsecrate Glarial's resting|place.");
    ~chatnpc("<p,neutral>That I do... It is elvish tradition to plant a specially|enchanted crystal seed at the graves of our ancestors.|The seed will create guardians to protect the area.");
    ~chatnpc("<p,neutral>Unfortunately the crystal seed must be tuned to the|person it's protecting... a new seed won't do. But you|should be able to recover the seed from her old tomb.");
    ~chatnpc("<p,neutral>The tomb's guardian will be protecting the seed, you'll|need to defeat him to get it. Once you have it, return|here and I will re-enchant it.");
    ~chatplayer("<p,neutral>OK... I'll be back as soon as I have it.");
    %roving_elves_quest = ^roving_seed;
    return;
}
~chatplayer("<p,neutral>Good day.");
if (%roving_elves_quest = ^roving_seed) {
    if (inv_total(inv, roving_new_consecration_seed) > 0 & inv_total(inv, roving_old_consecration_seed) = 0) {
        ~chatnpc("<p,neutral>You still have the charged seed with you, I can feel it.|Hurry adventurer, go plant the seed and free|my grandmother's spirit.");
        return;
    }
    ~chatnpc("<p,quiz>Hello, any luck finding the consecration seed?");
    if (inv_total(inv, roving_old_consecration_seed) > 0) {
        ~chatplayer("<p,neutral>Yes, I have it here.");
        ~objbox(roving_old_consecration_seed, "You hand the crystal seed to Eluned.", 250, 0, 0);
        ~chatnpc("<p,neutral>...");
        ~chatplayer("<p,confused>How odd. I can see her lips moving... But there's no|sound.");
        inv_del(inv, roving_old_consecration_seed, 1);
        inv_add(inv, roving_new_consecration_seed, 1);
        ~objbox(roving_new_consecration_seed, "Eluned hands you an enchanted crystal seed.", 250, 0, 0);
        ~chatnpc("<p,neutral>Plant this seed in Glarial's new tomb, close to her|remains and she will rest in peace.");
        ~chatplayer("<p,neutral>OK.");
        return;
    }
    // ours (the OSRS wiki): a lost charged seed is given again
    ~chatplayer("<p,neutral>I forgot what you told me to do.");
    ~chatnpc("<p,neutral>Re-enter Glarial's tomb and defeat the tomb's guardian.|Take the consecration seed it is guarding and|bring it back to me.");
    return;
}
if (%roving_elves_quest = ^roving_planted) {
    ~chatnpc("<p,quiz>Hey... how's it going? Have you managed to|reconsecrate Glarial's resting place?");
    ~chatplayer("<p,happy>Yes, it's done.");
    ~chatnpc("<p,happy>Well done... You should go see Islwyn, but I'd guess he|already knows.");
    return;
}
~chatnpc("<p,neutral>Hello there, it's a lovely day for a walk in the woods.|So what can I help you with?");
~chatplayer("<p,neutral>I'm just looking around.");

// ---------------------------------------------------------------- the guardian in Glarial's tomb
[ai_queue3,roving_mossgiant]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
if (%roving_elves_quest = ^roving_seed & inv_total(inv, roving_old_consecration_seed) = 0 & inv_total(inv, roving_new_consecration_seed) = 0) {
    mes("A small grey seed drops on the ground.");
    obj_add(npc_coord, roving_old_consecration_seed, 1, ^lootdrop_duration);
}

// ---------------------------------------------------------------- planting the seed by the chalice
[opheld1,roving_new_consecration_seed]
if (distance(coord, 0_40_154_43_55) > 3 | %roving_elves_quest ! ^roving_seed) {
    mes("Nothing interesting happens."); // ours
    return;
}
if (inv_total(inv, spade) = 0) {
    mes("You need a spade to plant the seed.");
    return;
}
anim(human_dig, 0);
mes("You dig a small hole with your spade.");
p_delay(2);
mes("You drop the crystal seed in the hole.");
anim(human_pickupfloor, 0);
facesquare(0_40_154_44_51);
p_delay(2);
inv_del(inv, roving_new_consecration_seed, 1);
%roving_elves_quest = ^roving_planted;
spotanim_map(smokepuff, 0_40_154_44_51, 0, 0);
mes("The seed vanishes in a puff of smoke.");

// ---------------------------------------------------------------- Isafdar
[oploc1,roving_fire_remains]
~mesbox("The firepit is still warm, there must be travellers about. Maybe I|should look for them.");
