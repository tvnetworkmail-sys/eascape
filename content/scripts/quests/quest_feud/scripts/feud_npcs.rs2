// EASCape: The Feud's people (4 April 2005, with Pollnivneach and Ali Morrisane). Their words are the
// OSRS wiki's quest transcript (Transcript:The Feud) and NPC transcripts; the stage values are the
// OSRS game's (feud.constant). Where the transcript loops back to a menu we end the chat (ours).

// ---------------------------------------------------------------- Ali Morrisane (Al Kharid)
[opnpc1,feud_ali_m]
def_int $s = %feud_var;
if ($s = ^feud_not_started) @feud_alim_start;
if ($s = ^feud_mayor_thanked) @feud_alim_finish;
if ($s >= ^feud_complete) @rt_ali; // Rogue Trader (miniquest_rogue_trader/rt_ali.rs2)
~chatnpc("<p,neutral>I sent you to learn the whereabouts of my nephew, Ali. Is there any word of him in Pollnivneach?");
~chatplayer("<p,sad>Not yet, I'm afraid.");
~chatnpc("<p,sad>That's not really the news I was hoping for.");
~chatnpc("<p,neutral>But since you've been gone trade has gotten even busier. Will you have a look at my wares?");
@feud_alim_wares;

[label,feud_alim_wares]
if (~p_choice2("No, I'm really too busy.", 1, "Okay.", 2) = 2) {
    ~openshop(feud_morrisanes, 550, 1000, 10, "Ali's Discount Wares.");
}

[label,feud_alim_start]
~chatnpc("<p,happy>Good day and welcome back to Al Kharid.");
~chatnpc("<p,happy>My name is Ali Morrisane - the greatest salesman in the world.");
def_int $c = ~p_choice2("Are you really the greatest salesman in the world?", 1, "So what are you selling then?", 2);
if ($c = 2) {
    ~openshop(feud_morrisanes, 550, 1000, 10, "Ali's Discount Wares.");
    return;
}
~chatplayer("<p,quiz>If you're the greatest salesman in the world, why are you still selling goods from a stall?");
~chatnpc("<p,neutral>Well one can only do and sell so much. If I had more staff I'd be able to sell more, rather than wasting my time on menial things. I could get on with selling sand to the Bedabin and useless tourist trinkets to just about everyone else.");
if (~p_choice2("I'm too busy to help. Adventuring is a full time job you know!", 1, "I'd like to help you, but...", 2) = 1) {
    @feud_alim_busy;
}
~chatplayer("<p,neutral>I'd like to help you but...");
~chatnpc("<p,neutral>Yes, I know, I know - the life of a shop keeper isn't slaying dragons and wooing damsels, but it has its charms.");
~chatnpc("<p,neutral>Although perhaps you can help me some other way. A nephew of mine lives not too far from here in a little town called Pollnivneach. He was supposed to become my assistant, but he hasn't shown up. If you fetch him here I'll give you the first month of his salary!");
if (stat_base(thieving) < 30) {
    ~mesbox("You need a Thieving level of 30 to start The Feud."); // the wiki's requirement; the words are ours
    return;
}
if (~p_choice2_header("Yes.", 1, "No.", 2, "Start The Feud quest?") = 2) @feud_alim_busy;
~chatplayer("<p,happy>I'll find your nephew.");
~chatplayer("<p,neutral>But you had better become the greatest merchant in Gielinor once I succeed!");
%feud_var = ^feud_started;
~send_quest_progress(questlist:feud, %feud_var, ^feud_complete);
~chatnpc("<p,happy>Ah, many thanks, my friend. My nephew's name is Ali and he lives to the south in a town called Pollnivneach.");
~chatnpc("<p,neutral>Tell him his uncle Ali M needs his help up in Al Kharid.");
~chatnpc("<p,neutral>And while you're here, have a look at my wares.");
@feud_alim_wares;

[label,feud_alim_busy]
~chatplayer("<p,neutral>I'm too busy to help. Adventuring is a full time job you know!");
~chatnpc("<p,neutral>No problem my friend, perhaps another time.");
~chatnpc("<p,neutral>Anyway, have a look at my wares.");
@feud_alim_wares;

[label,feud_alim_finish]
~chatnpc("<p,neutral>Hello again my friend. I have heard nothing from my troublesome nephew. Have you any news of his whereabouts?");
~chatplayer("<p,neutral>Indeed I do. I was able to eventually learn of his fortunes, although it was a little bit more challenging than I originally thought.");
~chatnpc("<p,quiz>Well then please, tell me what has become of him. Nothing bad I hope.");
~chatplayer("<p,neutral>I was able to discover that he is quite the salesman. Perhaps too good. He has roughly forty people working under him.");
~chatplayer("<p,neutral>Unfortunately a number of people didn't approve of his sales techniques and as a result he is in hiding.");
~chatnpc("<p,happy>You make an old man very happy. I'm so proud of young Baba.");
~chatplayer("<p,quiz>But he's considered a thief!");
~chatnpc("<p,neutral>Yes, by people with too much money and not enough sense. All willingly parted with their money and received what they purchased.");
~chatnpc("<p,neutral>Well, it seems I still am in need of an assistant...");
~chatnpc("<p,happy>..but take the reward anyway.");
~feud_complete;
~chatplayer("<p,quiz>I've just been thinking Ali, there seems to be a few parallels between yourself and your nephew. Both of you are unscrupulous salesmen, both of you come from the same town and both of you no longer trade there.");
~chatplayer("<p,quiz>Were you sent into exile too?");
~chatnpc("<p,neutral>I have my reasons.");
~chatplayer("<p,neutral>No, now hang on, this seems to me like one of the strangest quests I have ever been involved with. I do not believe that a businessman like you would not know of a competitor, particularly a competitor as talented as your nephew.");
~chatplayer("<p,neutral>So what was your motive to get me to visit Pollnivneach? Was it concern for the towns people? Hmm. I don't think so, I'd say you would probably sell your grandmother if you could get a good price for her. What was the reason?");
~chatnpc("<p,happy>My my, you surprise me, you're not as dumb as you look.");
~chatplayer("<p,quiz>Surely you didn't do all this to sell me a fake beard and headpiece.");
~chatnpc("<p,happy>Ah, once again you underestimate me. I sold you far more than that.");
~chatplayer("<p,neutral>Really? Well I did buy some other odds and ends off you.... no hang on! I get it now, you're in league with Ali the Camel seller, the Kebab seller and the mayor aren't you.");
~chatnpc("<p,happy>I like the word 'tourism'. Did you not enjoy your stay in Pollnivneach? Was there not action, intrigue and fun to be had, and did you not notice all the other tourists there too?");
~chatplayer("<p,happy>I must apologise for ever doubting you. You really are the greatest salesman in all of Gielinor.");
~chatnpc("<p,happy>Now that we both agree on that, may I show you my wares?");
@feud_alim_wares;

// ---------------------------------------------------------------- Ali the Barman
[opnpc1,feud_ali_the_barman]
def_int $s = %feud_var;
~chatplayer("<p,neutral>Hello there.");
~chatnpc("<p,neutral>Good day. Can I help you with anything?");
if ($s = ^feud_traitor_found) {
    switch_int (~p_choice3("Yes, I'd like a drink please.", 1, "What's going on in town?", 2, "I'm looking for Traitorous Ali.", 3)) {
        case 1 : @feud_barman_drink;
        case 2 : @feud_barman_town;
        case 3 :
            ~chatplayer("<p,neutral>I'm looking for Traitorous Ali.");
            %feud_var_drink_found = 1;
            ~chatnpc("<p,neutral>He was just here! Look, he's even left his drink on the table by those barrels. Must have nipped out to go to the toilet.");
            ~chatnpc("<p,neutral>He might be gone a while though. The nearest outhouse is all the way over on Fossil Island.");
    }
    return;
}
if ($s >= ^feud_mayor_thanked & %feud_report_drink = 0) {
    switch_int (~p_choice3("Yes, I'd like a drink please.", 1, "What's going on in town?", 2, "Could you tell Traitorous Ali that someone has poisoned his drink?", 3)) {
        case 1 : @feud_barman_drink;
        case 2 : @feud_barman_town;
        case 3 :
            ~chatplayer("<p,neutral>Could you tell Traitorous Ali that someone has poisoned his drink?");
            ~chatnpc("<p,shock>What?! Poisoned drinks, in my bar?! My reputation would be destroyed if someone died here. Thank you adventurer.");
            ~chatplayer("<p,happy>No problem at all.");
            ~chatnpc("<p,happy>Here, have a beer - it's on the house.");
            switch_int (~p_choice3("Thanks!", 1, "Thanks but no thanks, I don't drink.", 2, "Yuck! I don't like beer.", 3)) {
                case 1 :
                    %feud_report_drink = 2;
                    if (inv_freespace(inv) = 0) {
                        inv_dropitem(inv, coord, beer, 1, 200);
                    } else {
                        inv_add(inv, beer, 1);
                    }
                    ~objbox(beer, "Ali the barman gives you a beer.", 250, 0, 0);
                case 2 :
                    %feud_report_drink = 1;
                    ~chatplayer("<p,neutral>Thanks but no thanks, I don't drink.");
                    ~chatnpc("<p,neutral>Don't say that around here too loud please, it may catch and then I'd be out of business.");
                    ~chatplayer("<p,neutral>You could always open up a non alcoholic fruit juice bar. You'd have less problems with drunken customers");
                    ~chatnpc("<p,neutral>You might be onto something there, but then what would I do with the drunken sailor?");
                    ~chatplayer("<p,quiz>Who?");
                    ~chatnpc("<p,neutral>Drunken Ali. Oh never mind it's a long story.");
                case 3 :
                    %feud_report_drink = 1;
                    ~chatplayer("<p,neutral>Yuck! I don't like beer.");
                    ~chatnpc("<p,angry>Fine, suit yourself. There's no need to insult me.");
            }
    }
    return;
}
switch_int (~p_choice4("Yes, I'd like a drink please.", 1, "What's going on in town?", 2, "I'm looking for Ali from Pollnivneach.", 3, "The 'Asp and Snake'? What a strange name for a bar.", 4)) {
    case 1 : @feud_barman_drink;
    case 2 : @feud_barman_town;
    case 3 :
        ~chatplayer("<p,neutral>I'm looking for Ali from Pollnivneach.");
        ~chatnpc("<p,neutral>Well, I'm called Ali and I'm from here. Are you looking for me?");
        ~chatplayer("<p,quiz>Do you have an uncle called Ali?");
        ~chatnpc("<p,happy>Yes! All my uncles are called Ali!");
        ~chatplayer("<p,neutral>Oh dear. Well do any of your uncles have a stall in the Bazaar in Al Kharid?");
        ~chatnpc("<p,neutral>Um... no.");
        ~chatplayer("<p,quiz>Well do you know if anyone here does?");
        ~chatnpc("<p,neutral>That's a difficult question to answer. I don't know anyone else's uncles.");
    case 4 :
        ~chatplayer("<p,neutral>The 'Asp and Snake'? What a strange name for a bar.");
        ~chatnpc("<p,neutral>Maybe around these parts. Were you expecting it to have 'Ali' in the name?");
        ~chatnpc("<p,neutral>I did think about calling it 'Ali's', but then it'd get confused with the Camel Shop, the Kebab House, the Mayor's residence...");
        ~chatplayer("<p,neutral>Yes, I get your point. It's a perfectly fine name.");
}

[label,feud_barman_drink]
~chatplayer("<p,neutral>Yes, I'd like a drink please.");
~openshop(feud_alispub, 550, 1000, 10, "The Asp & Snake Bar.");

[label,feud_barman_town]
~chatplayer("<p,quiz>What's going on in town?");
if (%feud_var >= ^feud_mayor_thanked) {
    ~chatnpc("<p,happy>Well since you gave the two gangs a good kicking, business has really taken off! Both gangs are spending all their gold here drowning their sorrows.");
    ~chatplayer("<p,happy>That's great! So do I get a cut of the profits?");
    ~chatnpc("<p,angry>Get out of here, you cheeky rascal. A cut of my profits? As if!");
    return;
}
~chatnpc("<p,neutral>Nothing much really. About what you'd expect from a sleepy little town like ours.");
~chatplayer("<p,quiz>What about those two gangs? That seems exciting.");
~chatnpc("<p,neutral>They're paying customers, so I won't rock the boat if you don't mind.");

// ---------------------------------------------------------------- Drunken Ali
[opnpc1,feud_drunken_ali]
switch_int (%feud_var_drink) {
    case 0 : ~chatnpc("<p,drunk>Ahh, a kind stranger. Get this old man a drink so that he may wet his throat and tell you of the strange happenings in this town.");
    case 1 : ~chatnpc("<p,drunk>Get this poor, thirsty old man another drink so that he may wet his lips and continue.");
    case 2 : ~chatnpc("<p,drunk>Alas, my throat has dried up, and I cannot speak... perhaps another drink would help?");
    case default : ~chatnpc("<p,drunk>What were we talking about again? Yes yes, when I was a boy... no, that's not it.");
}

[opnpcu,feud_drunken_ali]
if (last_useitem ! beer) {
    ~chatnpc("<p,drunk>Eh? What's this? I don't want that, get me a beer.");
    return;
}
if (%feud_var < ^feud_started | %feud_var_drink >= 3) {
    ~chatnpc("<p,drunk>What were we talking about again? Yes yes, when I was a boy... no, that's not it.");
    return;
}
inv_del(inv, beer, 1);
inv_add(inv, beer_glass, 1);
if (%feud_var_drink = 0) {
    ~chatnpc("<p,drunk>Now where were we? Ah yes, Ali Morrisane's wayward nephew.");
    ~chatplayer("<p,shock>What?! How did you know that's who I was looking for?");
    ~chatnpc("<p,drunk>Er... well, he's a real scamp, that lad! I can't imagine a stranger would be asking after anyone else.");
    ~chatplayer("<p,neutral>Hmm. Well go on then, where is he?");
    ~chatnpc("<p,drunk>I'd tell you more, but my throat is drying up. This desert climate is an inhospitable one. Get me another beer so that I can continue my tale.");
    %feud_var_drink = 1;
    return;
}
if (%feud_var_drink = 1) {
    ~chatnpc("<p,drunk>You are too kind, now what were we talking about?");
    ~chatplayer("<p,neutral>Ali Morrisane's nephew.");
    ~chatnpc("<p,drunk>Of course! I've known him since he was a wee lad. A right little mischievous beggar...");
    ~chatplayer("<p,neutral>Yes, I can imagine. Do you have any more recent information about him? Where is he?");
    ~chatnpc("<p,drunk>Well now, if you had just asked me that in the first place I would have told you directly!");
    ~chatplayer("<p,neutral>You're right, I'm sorry for beating around the bush. Do you know where Ali's nephew is now, though?");
    ~chatnpc("<p,drunk>I'd tell you more, but my throat is drying up. This desert climate is an inhospitable one. Get me another beer so that I can continue my tale.");
    %feud_var_drink = 2;
    return;
}
~chatnpc("<p,drunk>Ahh, that hits the spot.");
~chatnpc("<p,drunk>Now which of you two adventurers wanted to know where Ali's nephew is?");
~chatplayer("<p,neutral>I think you're seeing double.");
~chatnpc("<p,drunk>Is this a double? No wonder I feel sick...");
~chatplayer("<p,neutral>Look, all I want to know is the whereabouts of Ali Morrisane's nephew.");
~chatnpc("<p,drunk>Now is that his nephew from his side or his wife's? They have a huge family you see. I remember...");
~chatplayer("<p,angry>No, no, no. Stop right there. You are not going to fool me into buying you another beer without first giving me some useful information.");
~chatnpc("<p,drunk>But my lips are so dry, how can I possibly continue?");
~chatplayer("<p,angry>Well if your lips are dry, I'll have to wring you like a wet cloth and squeeze out enough booze to fill another tankard. I'd reckon it would hurt though.");
~chatnpc("<p,drunk>I see. Don't worry about me, I'll just have to soldier on. Now what do you want to know?");
~chatplayer("<p,angry>For the last time, where is Ali Morrisane's nephew?");
~chatnpc("<p,drunk>Oh, I don't know.");
~chatplayer("<p,angry>Seriously?");
~chatnpc("<p,drunk>Wait, wait! The last I heard he was in trouble with those gangs hanging around town. You won't get any answers out of them, though, not while they're feuding. Maybe if you were to solve that little problem...");
~chatnpc("<p,drunk>Anyway, is there any chance of another beer?");
%feud_var_drink = 3;
if (%feud_var < ^feud_drunk_told) %feud_var = ^feud_drunk_told;
~chatplayer("<p,neutral>What do you think?");

// ---------------------------------------------------------------- the bandits
[opnpc1,feud_arabian_guard_multi] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard2_multi] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard1_1] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard1_2] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard2_1] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard2_2] @feud_bandit_talk(false);
[opnpc1,feud_arabian_guard_coward] @feud_bandit_talk(true);

[label,feud_bandit_talk](boolean $coward)
def_int $s = %feud_var;
if ($s = ^feud_drunk_told | $s = ^feud_gangs_asked) {
    ~chatplayer("<p,neutral>Hello.");
    ~chatnpc("<p,angry>What do you want?");
    ~chatplayer("<p,neutral>I am trying to get to the bottom of this feud between you and the Menaphites.");
    ~chatnpc("<p,angry>What's it to you?");
    ~chatplayer("<p,neutral>I'm just trying to understand why thieves of your repute would stoop to their level.");
    ~chatnpc("<p,neutral>Well, if memory serves me correctly, I think the hostilities began when they robbed one of our camels. A heinous crime.");
    ~chatplayer("<p,quiz>So if they offered a camel back as a gesture of goodwill, would you and the rest of the bandits cease your hostilities?");
    ~chatnpc("<p,neutral>Those Menaphites would never do that. They have no sense of honour.");
    ~chatplayer("<p,quiz>But if they did?");
    ~chatnpc("<p,neutral>I suppose so.");
    %feud_var_talk_gangs = setbit(%feud_var_talk_gangs, 0);
    ~feud_gangs_asked;
    return;
}
if ($s = ^feud_camels_bought) {
    ~chatplayer("<p,happy>Good news, the Menaphites have agreed to give you a camel in order to restore peace.");
    if (testbit(%feud_var_comp_gangs, 0) = ^true) {
        ~chatnpc("<p,angry>Tell them that we have changed our minds and demand 10 full-price camels in return for our mercy."); // ours: after the receipt
        return;
    }
    if (inv_total(inv, feud_camel_receipt) = 0) {
        ~chatnpc("<p,quiz>So where's the camel?");
        ~chatplayer("<p,neutral>Um... I'll get back to you on that.");
        return;
    }
    inv_del(inv, feud_camel_receipt, 1);
    ~mesbox("You hand the guard a sales receipt for the camel.");
    ~chatnpc("<p,angry>What's this? A mere promise of a camel? From a discount camel store? I knew those Menaphites were cowards. Tell them that we have changed our minds and demand 10 full-price camels in return for our mercy.");
    ~chatplayer("<p,sad>Oh no... why do I bother?");
    %feud_var_comp_gangs = setbit(%feud_var_comp_gangs, 0);
    ~feud_camels_refused;
    return;
}
if ($s = ^feud_camels_refused) {
    ~chatplayer("<p,neutral>Hello.");
    ~chatnpc("<p,neutral>Good day adventurer. Have you come with the Menaphite peace offering?");
    ~chatplayer("<p,neutral>Umm... no. Not yet. Actually I've come to ask about something else.");
    ~chatnpc("<p,neutral>We can talk once you bring back the Menaphites' full peace offering.");
    return;
}
if ($s >= ^feud_joined & $s < ^feud_menaphites_beaten) {
    ~chatplayer("<p,neutral>Good day.");
    ~chatnpc("<p,angry>Get out of here, you Menaphite dog!");
    if ($coward = true) {
        ~chatplayer("<p,angry>What was that? Are you looking for a fight.");
        ~chatnpc("<p,shock>Me? No, no, I was just, er, complimenting your, that is - don't kill me, please!");
        ~chatplayer("<p,neutral>I wouldn't waste my time.");
    }
    return;
}
if ($s = ^feud_menaphites_beaten) {
    ~chatplayer("<p,neutral>Hello.");
    if ($coward = true) {
        ~chatnpc("<p,neutral>Welcome. Our leader would be pleased to congratulate you on your disposal of the Menaphites who plagued this town.");
        return;
    }
    if (%feud_talk_villager = 0) {
        ~chatnpc("<p,happy>Welcome! Your actions surprise me.");
        ~chatplayer("<p,quiz>What do you mean?");
        ~chatnpc("<p,happy>It was brilliant the way you got rid of the Menaphite leader.");
        ~chatplayer("<p,neutral>Er... yes. Thank you.");
        ~chatnpc("<p,quiz>So will you run the rest of them out of town now?");
        ~chatplayer("<p,neutral>I don't know.");
        return;
    }
    ~chatnpc("<p,happy>Welcome! Our leader wants to congratulate you on your swift disposal of the Menaphites who plagued this town.");
    return;
}
if ($s = ^feud_bandits_beaten) {
    if ($coward = true) {
        ~chatnpc("<p,angry>You dog! You killed our champion and for that I hope you die a slow and painful death.");
        ~chatplayer("<p,angry>What was that? Are you looking for a fight?");
        ~chatnpc("<p,shock>Me? No, no, I was just, er, complimenting your, that is - don't kill me, please!");
        ~chatplayer("<p,neutral>I wouldn't waste my time.");
        return;
    }
    ~chatnpc("<p,angry>You dog! You killed our champion and for that you will die!");
    npc_setmode(opplayer2);
    return;
}
// ours: the bandits' everyday words (Transcript:Bandit (Pollnivneach) has none outside the quest)
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,angry>What do you want?");

// ---------------------------------------------------------------- the Menaphite thugs
[opnpc1,feud_egyptian_doorman_multi] @feud_thug_talk;
[opnpc1,feud_egyptian_doorman_1] @feud_thug_talk;
[opnpc1,feud_egyptian_doorman_2] @feud_thug_talk;

[label,feud_thug_talk]
def_int $s = %feud_var;
if ($s = ^feud_drunk_told | $s = ^feud_gangs_asked) {
    ~chatplayer("<p,neutral>Hello.");
    ~chatnpc("<p,angry>What do you want?");
    ~chatplayer("<p,neutral>I am trying to figure out the feud that exists between you and the Bandits.");
    ~chatnpc("<p,neutral>Not much to figure out there, the problem is those thieving bandits.");
    ~chatplayer("<p,quiz>In what way?");
    ~chatnpc("<p,angry>They are always stealing, starting fights and disrupting the lives of the townsfolk.");
    ~chatplayer("<p,neutral>Word has it that the Menaphites are also involved in unsavoury behaviour.");
    ~chatnpc("<p,neutral>Well, we also steal, start fights, and disrupt lives - but we do it with class! And the bandits definitely started it.");
    ~chatplayer("<p,quiz>How did 'they' start it?");
    ~chatnpc("<p,neutral>I can scarcely remember, it's been so long.");
    ~chatplayer("<p,neutral>Go on try.");
    ~chatnpc("<p,neutral>I think our leader once mentioned that they robbed one of our camels. A heinous crime around these parts.");
    ~chatplayer("<p,quiz>So if they offered a camel as a gesture of goodwill would you agree to cease hostilities?");
    ~chatnpc("<p,neutral>Those bandits would never agree to that. They couldn't afford even the mangiest excuse for a camel, never mind the desert traversing, four legged beauty that we would demand.");
    ~chatplayer("<p,quiz>But if they did?");
    ~chatnpc("<p,neutral>Well, I suppose so.");
    %feud_var_talk_gangs = setbit(%feud_var_talk_gangs, 1);
    ~feud_gangs_asked;
    return;
}
if ($s = ^feud_camels_bought) {
    ~chatplayer("<p,happy>Good news, the bandits have agreed to give you a camel in order to restore peace.");
    if (testbit(%feud_var_comp_gangs, 1) = ^true) {
        ~chatnpc("<p,angry>Tell them that we have changed our minds and demand 10 camels in return for our mercy."); // ours: after the receipt
        return;
    }
    if (inv_total(inv, feud_camel_receipt) = 0) {
        ~chatnpc("<p,quiz>So where's the camel?");
        ~chatplayer("<p,neutral>Um... I'll get back to you on that.");
        return;
    }
    inv_del(inv, feud_camel_receipt, 1);
    ~mesbox("You hand the doorman a sales receipt for the camel.");
    ~chatnpc("<p,angry>A mere receipt? For a discount camel? I knew those bandits were cheap! Tell them that we have changed our minds and demand 10 camels in return for our mercy.");
    ~chatplayer("<p,sad>Oh no... why do I bother?");
    %feud_var_comp_gangs = setbit(%feud_var_comp_gangs, 1);
    ~feud_camels_refused;
    return;
}
if ($s = ^feud_camels_refused) {
    ~chatnpc("<p,neutral>Greetings Adventurer, Ali wants to have a word with you.");
    ~chatplayer("<p,quiz>Really? Which one?");
    ~chatnpc("<p,neutral>Ali, our Chief of Operations. He should be somewhere nearby the tent.");
    ~chatplayer("<p,neutral>Thanks.");
    return;
}
if ($s = ^feud_traitor_task) {
    ~chatplayer("<p,neutral>I was wondering if you could help me?");
    ~chatnpc("<p,neutral>Tell me what your problem is and I'll see what I can do.");
    ~chatplayer("<p,neutral>I've heard there's a traitor among the Menaphites. What do you know about it?");
    ~chatnpc("<p,shock>It wasn't me, I swear!");
    ~chatplayer("<p,quiz>Really? So what do you know?");
    ~chatnpc("<p,sad>I just can't believe one of my friends could be a traitor.");
    ~chatnpc("<p,neutral>Well, I suppose there is Traitorous Ali.");
    ~chatplayer("<p,quiz>'Traitorous Ali'?");
    ~chatnpc("<p,neutral>Oh yes. The most untrustworthy, backstabbing little rat to scamper across Tumeken's fair desert. He'd sell his own mother to slavers if he hadn't already betrayed her and had her locked up for the last job he pulled.");
    ~chatplayer("<p,neutral>I suppose the name is a bit of a giveaway.");
    ~chatplayer("<p,quiz>That was a little too simple, are you sure it was him?");
    ~chatnpc("<p,neutral>Positive, he was turned by the offer of a set of waterproofs and a ride on a camel.");
    ~chatplayer("<p,neutral>I see he drives a hard bargain.");
    ~chatnpc("<p,neutral>Well what can I say? We don't call him 'Ali of the Good Decisions', do we?");
    %feud_found_trait = 1;
    return;
}
if ($s = ^feud_meet_leader) {
    ~chatnpc("<p,angry>You treacherous jackal! Prepare to die!");
    npc_setmode(opplayer2);
    return;
}
if ($s >= ^feud_menaphites_beaten) {
    ~chatplayer("<p,neutral>Hello.");
    ~chatnpc("<p,angry>You treacherous jackal! I should never have trusted you.");
    ~chatplayer("<p,neutral>What can I say, you live and learn.");
    ~chatnpc("<p,angry>I will avenge my master!");
    npc_setmode(opplayer2);
    return;
}
if ($s >= ^feud_joined) {
    ~chatplayer("<p,neutral>Hi.");
    ~chatnpc("<p,happy>Tumeken be praised, you have seen the error of your ways. May Elidinis the river goddess bless your lands.");
    ~chatplayer("<p,neutral>I was wondering if I could ask you about something.");
    ~chatnpc("<p,neutral>You're better off asking Ali the Operator. He's the brains behind the whole operation.");
    return;
}
// Transcript:Menaphite Thug
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,angry>What do you want?");

[proc,feud_gangs_asked]
if (%feud_var_talk_gangs = 3) {
    if (%feud_var = ^feud_drunk_told) %feud_var = ^feud_gangs_asked;
    ~chatplayer("<p,neutral>Maybe if I got both gangs a camel, I could use the mutual good will to find out what happened to Ali's nephew.");
}

[proc,feud_camels_refused]
if (%feud_var_comp_gangs = 3) {
    %feud_var = ^feud_camels_refused;
    ~chatplayer("<p,neutral>The camel approach doesn't seem to be working. Perhaps I should be more direct and try to join one of the gangs.");
}

// ---------------------------------------------------------------- Ali the Camel Man
[opnpc1,feud_ali_the_discount_camel_seller] @feud_camelman;
[opnpc3,feud_ali_the_discount_camel_seller] @feud_camelman; // ours: no source has a camel shop

[label,feud_camelman]
def_int $s = %feud_var;
if ($s >= ^feud_complete) {
    ~chatnpc("<p,happy>Hello! Welcome back to my discount camel store. How are those camels getting along?");
    ~chatplayer("<p,happy>Hey Ali!");
    ~chatnpc("<p,happy>Hello adventurer.");
    ~chatplayer("<p,quiz>Any news?");
    ~chatnpc("<p,happy>Not much really, I just want to thank you for what you have done for this town. I might even stick around now that business is better!");
    ~chatplayer("<p,quiz>Any grand plans?");
    ~chatnpc("<p,neutral>Well I've been debating whether I should diversify into camel rental, too. Although I do have all these cages lying around... do you think there's a market for discount jackals?");
    ~chatplayer("<p,happy>Maybe! Best of luck, in any case.");
    ~chatnpc("<p,happy>Thank you.");
    return;
}
if ($s >= ^feud_camels_bought) {
    ~chatnpc("<p,happy>Hello! Welcome back to my discount camel store. How are those camels getting along?");
    switch_int (~p_choice3("About those camels. I've lost the receipt. Can I have another?", 1, "I decided to get rid of the camels.", 2, "Tell me about this town.", 3)) {
        case 1 :
            ~chatplayer("<p,neutral>About those camels. I've lost the receipt, can I have another?");
            def_int $have = calc(inv_total(inv, feud_camel_receipt) + inv_total(bank, feud_camel_receipt));
            def_int $want = sub(2, add(testbit(%feud_var_comp_gangs, 0), testbit(%feud_var_comp_gangs, 1)));
            if ($s >= ^feud_camels_refused | $have >= $want) {
                ~chatnpc("<p,angry>I think you're trying to con me into giving you an extra receipt.");
                return;
            }
            if (inv_freespace(inv) < sub($want, $have)) {
                ~chatnpc("<p,neutral>Come back to me when you're not so burdened.");
                return;
            }
            ~chatnpc("<p,happy>No problem, There you go.");
            inv_add(inv, feud_camel_receipt, sub($want, $have));
        case 2 :
            ~chatnpc("<p,quiz>Why? did they not please you?");
            switch_int (~p_choice3("No, they didn't. I sold them as Kebab meat!", 1, "I'm not really a camel person, so I gave them to a better owner.", 2, "I decided to try and use them to end the hostilities between the two gangs.", 3)) {
                case 1 :
                    ~chatplayer("<p,happy>No, they didn't. I sold them as Kebab meat!");
                    ~chatnpc("<p,angry>Nooooo! Not Sandy and Lumps! You beast! Get out of my shop this instant!");
                case 2 :
                    ~chatplayer("<p,neutral>I'm not really a camel person, so I gave them to a better owner.");
                    ~chatnpc("<p,happy>That's very responsible of you. Too many people let their camels run feral through the desert, instead of sending them to happy homes.");
                    ~chatnpc("<p,neutral>You want to watch out for those feral camels, you know.");
                case 3 :
                    ~chatplayer("<p,neutral>I decided to try and use them to end the hostilities between the two gangs.");
                    ~chatnpc("<p,happy>A noble purpose for two noble beasts! Did you succeed?");
                    ~chatplayer("<p,sad>Still working on that, I'm afraid.");
                    ~chatnpc("<p,neutral>Well, I wish you the best of luck.");
            }
        case 3 : @feud_camelman_town;
    }
    return;
}
~chatnpc("<p,happy>Welcome to my discount camel store. Can I help you with anything?");
switch_int (~p_choice5("A discount camel store?", 1, "Tell me about this town.", 2, "Lovely day isn't it?", 3, "Are those camels around the side for sale?", 4, "I'm looking for Ali from Pollnivneach.", 5)) {
    case 1 :
        ~chatplayer("<p,quiz>A discount camel store?");
        ~chatnpc("<p,happy>Yes - it's my great idea - selling camels at discounted prices so that the common man can experience the joys of owning a camel of their very own! They're not just a source of kebab meat you know!");
        switch_int (~p_choice4("So can I buy a camel then? I'm hungry!", 1, "Yes, camels are beautiful creatures.", 2, "Why would I want a camel? All they do is spit and...", 3, "So is the discount camel business good then?", 4)) {
            case 1 :
                ~chatplayer("<p,happy>So can I buy a camel then? I'm hungry!");
                ~chatnpc("<p,angry>I would never sell one to the likes of you! They are beautiful, majestic creatures, not food! Get out of my shop.");
            case 2 :
                ~chatplayer("<p,happy>Yes, camels are beautiful creatures.");
                ~chatnpc("<p,happy>Ah, wondrous camels! Best of all Saradomin's creations. Ships of the desert, far more useful than any horse or donkey. Truly, they are a man's best friend.");
                ~chatnpc("<p,happy>Perhaps you'd like a camel of your own? You're in the right place, if so...");
            case 3 :
                ~chatplayer("<p,neutral>Why would I want a camel? All they do is spit and...");
                ~chatnpc("<p,angry>Pah! I've seen mummies with more brains than you! If you treat camels badly then of course they're going to spit at you. May your robes never be clean again!");
            case 4 :
                ~chatplayer("<p,quiz>So is the discount camel business good then?");
                ~chatnpc("<p,happy>Business is booming! Pollnivneach has never seen this number of visitors.");
                ~chatnpc("<p,neutral>In fact I'm thinking of expanding and trying to break into the camel hire market.");
                ~chatnpc("<p,neutral>If only I could figure out how to get people to return the camels...");
        }
    case 2 : @feud_camelman_town;
    case 3 :
        ~chatplayer("<p,happy>Lovely day isn't it?");
        ~chatnpc("<p,neutral>It's a beautiful day today, but word has it that it will rain tomorrow.");
        ~chatplayer("<p,quiz>Really?");
        ~chatnpc("<p,happy>No! When have you ever known it to rain here in Gielinor?");
        ~chatplayer("<p,neutral>Oh. Anyway...");
    case 4 :
        ~chatplayer("<p,quiz>Are those camels around the side for sale?");
        ~chatnpc("<p,neutral>Those two camels around the side are already sold.");
        if ($s < ^feud_gangs_asked) {
            ~chatnpc("<p,neutral>I've got new stock coming very soon though. Come back later if you're still interested.");
            return;
        }
        ~chatnpc("<p,happy>But you are in luck - I have another two beautiful camels arriving soon from the best stable in all of Al Kharid.");
        ~chatplayer("<p,neutral>Excellent! Although another two ugly camels would have been fine, I think.");
        if (~p_choice2("Can you tell me a little about them?", 1, "What price do you want for both of them?", 2) = 1) {
            ~chatplayer("<p,quiz>Can you tell me a little about them?");
            ~chatnpc("<p,happy>Well Sandy, the female camel, is a placid beast. At 20 years of age she comes from a prestigious line of camels - her mother was part of the Emir's baggage train!");
            ~chatnpc("<p,neutral>Lumps, on the other hand, is a 15 year old male. He's a bit surly and prone to bouts of stubbornness. However, he more than makes up for this failing with his immense strength and stamina.");
            ~chatnpc("<p,neutral>Both of them are of the 'Camelus Horribleus' family, a rare breed only found in this area of Gielinor. It is...");
            ~chatplayer("<p,angry>Ok, ok, that's enough! They're camels, I get it.");
            return;
        }
        ~chatplayer("<p,quiz>What price do you want for both of them?");
        ~chatnpc("<p,neutral>One cannot put a price on these beauties, they are precious beyond the worth of the crass value of gold coins!");
        @feud_camelman_offer;
    case 5 :
        ~chatplayer("<p,neutral>I'm looking for Ali from Pollnivneach.");
        ~chatnpc("<p,happy>Well, you've found your man.");
        ~chatplayer("<p,quiz>Really? Do you have an uncle called Ali?");
        ~chatnpc("<p,happy>Why yes - all my uncles are called Ali!");
        ~chatplayer("<p,neutral>Oh dear! Do any of them own a stall in the Al Kharid Bazaar?");
        ~chatnpc("<p,neutral>Well no, but one of them owns a moderately successful camel hire franchise.");
        ~chatnpc("<p,happy>Have you considered hiring a camel? Or perhaps purchasing one of your own? I can get you a discount.");
        ~chatplayer("<p,neutral>Never mind.");
}

[label,feud_camelman_offer]
switch_int (~p_choice4("So can I have them for free then?", 1, "Would 200 gold coins for the pair of them do?", 2, "Would 500 gold coins for the pair of them do?", 3, "Would 1000 gold coins for the pair of them do?", 4)) {
    case 1 :
        ~chatplayer("<p,happy>So can I have them for free then?");
        ~chatnpc("<p,angry>Are you trying to be funny?");
        ~chatplayer("<p,neutral>Perhaps I could make another offer?");
        @feud_camelman_offer;
    case 2 :
        ~chatplayer("<p,neutral>Would 200 gold coins for the pair of them do?");
        ~chatnpc("<p,angry>Pah! That might buy you a mangy, flea-infested sheep if you're lucky. Don't insult me.");
        ~chatplayer("<p,neutral>Perhaps I could make another offer?");
        @feud_camelman_offer;
    case 3 :
        ~chatplayer("<p,neutral>Would 500 gold coins for the pair of them do?");
        @feud_camelman_buy(500);
    case 4 :
        ~chatplayer("<p,neutral>Would 1,000 gold coins for the pair of them do?");
        @feud_camelman_buy(1000);
}

[label,feud_camelman_buy](int $price)
if (inv_freespace(inv) < 2) {
    ~chatnpc("<p,neutral>I would consider giving them to you if you were able to look after them. But it is abundantly clear that you've got your hands - and your inventory - full at the moment.");
    return;
}
if (inv_total(inv, coins) < $price) {
    ~chatnpc("<p,angry>You don't even have that much money do you? Come back when you're able to make a proper offer and stop wasting my time.");
    return;
}
if ($price = 500) {
    ~chatnpc("<p,neutral>I suppose I can silence my moral objections for that.");
} else {
    ~chatnpc("<p,happy>You are too generous. I would have sold them for half of that!");
}
inv_del(inv, coins, $price);
inv_add(inv, feud_camel_receipt, 2);
%feud_var = ^feud_camels_bought;
~objbox(feud_camel_receipt, "Ali the discount camel seller gives you a receipt for the camels in return for <tostring($price)> gold coins.", 250, 0, 0);
~chatnpc("<p,happy>Here are the receipts for the camels, so that you can pick them up as soon as I get them in.");

[label,feud_camelman_town]
~chatplayer("<p,quiz>Tell me about this town.");
~chatnpc("<p,neutral>Well, Pollnivneach is a funny little place. It's a small town and you'd think it'd be nice and quiet.");
~chatnpc("<p,sad>But those Menaphites and bandits are making the place quite unbearable.");
switch_int (~p_choice3("In what way?", 1, "Well the weak will always be trodden on. Why not stand up to them?", 2, "Perhaps I could help.", 3)) {
    case 1 :
        ~chatplayer("<p,quiz>In what way?");
        ~chatnpc("<p,angry>Well, one group is as bad as the other! They steal, they fight, they cause trouble with us locals. Just yesterday one of those bandits came looking for protection money!");
        ~chatplayer("<p,quiz>Why don't the authorities stop this?");
        ~chatnpc("<p,sad>We're a small town. We don't have the resources to keep the gangs off our backs! Menaphos and Al Kharid are no help either.");
        ~chatnpc("<p,neutral>To tell the truth we live in hope that an outsider, someone with no ties to either group, could broker a deal to halt the hostilities between them.");
        ~chatplayer("<p,neutral>Hmm...");
    case 2 :
        ~chatplayer("<p,neutral>Well the weak will always be trodden on. Why not stand up to them?");
        ~chatnpc("<p,neutral>That's a little unfair, my friend. We can't all be brave adventurers. If we were, where would you purchase quality camels at discounted prices?");
        ~chatnpc("<p,neutral>You might think about that. Anyway, isn't it the job of the brave adventurer to protect the weak and innocent from evil and harm?");
    case 3 :
        ~chatplayer("<p,neutral>Perhaps I could help.");
        ~chatnpc("<p,neutral>Yes, perhaps you could.");
        ~chatplayer("<p,quiz>You know the politics better than I do. What do you recommend?");
        ~chatnpc("<p,shock>Me?! I am but a humble discount camel seller. You're the adventurer, don't you know what to do?");
        if (~p_choice2("Of course I know what to do! I was just testing you!", 1, "Perhaps I should know, but offered advice should never be shunned.", 2) = 1) {
            ~chatplayer("<p,happy>Of course I know what to do! I was just testing you!");
            ~chatnpc("<p,neutral>That is reassuring to hear. Too often one meets brainless adventurers whose solution to every problem is to hack, maim and murder.");
            ~chatnpc("<p,happy>I'm glad to know you're not of that ilk.");
            return;
        }
        ~chatplayer("<p,neutral>Perhaps I should know, but offered advice should never be shunned.");
        ~chatnpc("<p,neutral>The state of adventurers today. They need everything spelled out for them.");
        ~chatnpc("<p,neutral>What, you want me to put a little note in your quest journal?");
        ~chatnpc("<p,neutral>But fine, I'll give you a hint. Try and see if you can get the gangs to agree to a truce by offering them each a token gift as an act of reconciliation.");
        ~chatnpc("<p,neutral>If that fails to work, you must consider trying to influence the gangs from within.");
}

// ---------------------------------------------------------------- Ali the Mayor
[opnpc1,feud_mayor] @feud_mayor_talk;
[opnpc1,feud_mayor_geom] @feud_mayor_talk;
[label,feud_mayor_talk]
def_int $s = %feud_var;
if ($s >= ^feud_complete) {
    // Transcript:Ali the Mayor
    ~chatnpc("<p,happy>Welcome, adventurer, to the town of Pollnivneach, the gateway to Menaphos and Al Kharid. My name is Ali and I'm the mayor of this town. I hope you enjoy your stay here.");
    return;
}
if ($s = ^feud_mayor_thanked) {
    ~chatnpc("<p,happy>Thank you once again. Have you spoken to Ali Morrisane yet?");
    ~chatplayer("<p,neutral>No not yet.");
    ~chatnpc("<p,neutral>Perhaps you should! I'm sure he's keen to hear word of his nephew.");
    return;
}
if ($s = ^feud_bandits_beaten & %feud_talk_villager = 2) {
    ~chatnpc("<p,happy>My thanks, adventurer. Your methods and motives may be questionable, but none can argue that you have delivered our little town from the wicked gangs who plagued it. I think things will change around here, now that our problems are at a manageable size.");
    ~chatnpc("<p,neutral>The least that I can do for you is answer your questions about the whereabouts of Ali Morrisane's nephew. He always was a mischievous young man, full of harebrained schemes.");
    ~chatnpc("<p,neutral>He dreamed of being the greatest salesman in all of Gielinor! Unfortunately, he was a little too good.");
    ~chatnpc("<p,neutral>He angered a number of people by coercing them into buying things they didn't really want. Completely within the law, of course, but the law could only protect young Ali for so long.");
    ~chatnpc("<p,neutral>Once he angered the Menaphites and the bandits, I knew I could no longer protect him.");
    ~chatnpc("<p,neutral>Under cover of darkness I smuggled him out of the town, and he's been gone ever since.");
    ~chatnpc("<p,neutral>I can assure you, however, that he is safe and well - and now that you have effectively ended the threat posed by the gangs, he can continue his business elsewhere. Last I heard he planned to open some kind of trade network with forty of his friends. A 'treasure trove', he claims. I'll believe it when I see it.");
    ~chatnpc("<p,neutral>I hope that helps you in your quest. If you speak to Ali Morrisane, do tell him that I wholeheartedly apologise for the way he - er, his family - has been treated.");
    %feud_var = ^feud_mayor_thanked;
    ~chatplayer("<p,neutral>I think I may be able to help with one other thing. I heard that your house was burgled recently. If you're interested in recovering the goods, you ought to have a word with Ali the Operator.");
    ~chatnpc("<p,quiz>Now, how would a passing adventurer know where to find my missing jewels?");
    ~chatplayer("<p,neutral>Er, let's just put it down to adventurer's intuition.");
    return;
}
if ($s >= ^feud_menaphites_beaten) {
    ~chatnpc("<p,angry>I don't know what we did to deserve your presence here, but I for one am filled with regret.");
    ~chatplayer("<p,angry>Well that's some show of gratitude! Can't I even get a 'thank you' for ridding your town of one of the gangs?");
    ~chatnpc("<p,angry>Do you understand the concept of consequences?");
    ~chatplayer("<p,quiz>Er, I think so?");
    ~chatnpc("<p,angry>Well, the consequences of your little piece of butchery are that the town is now even worse off. The bandits no longer have to waste time and energy fighting with the Menaphites and can direct all their attention towards making us miserable. So for your efforts I thank you, but I wish no-one had asked for your help.");
    ~chatplayer("<p,neutral>I'll set this town right before I leave, I promise.");
    ~chatnpc("<p,sad>Why do I wish that you hadn't said that? Your heavyhanded tactics scare me.");
    return;
}
if ($s >= ^feud_got_jewels) {
    ~chatnpc("<p,sad>I really can't chat for very long, the recent escalation in crime has me run off my feet. Just a short while ago even my own house was robbed. This cannot continue.");
    return;
}
if ($s >= ^feud_camels_refused) {
    ~chatnpc("<p,sad>I really can't chat for very long, the recent escalation in crime has me run off my feet. There are muggings and burglaries happening in broad daylight! It's really not on.");
    return;
}
~chatnpc("<p,happy>Welcome, adventurer, to the town of Pollnivneach, the gateway to Menaphos and Al Kharid. My name is Ali and I'm the mayor of this town. I hope you enjoy your stay here.");
if ($s < ^feud_started) return;
~chatplayer("<p,happy>Thank you. That is one of the warmest welcomes I've ever had! People generally treat travelling adventurers with suspicion.");
~chatnpc("<p,neutral>All are welcome here. Now more than ever I suppose.");
~chatplayer("<p,quiz>What do you mean by that?");
~chatnpc("<p,sad>There's trouble in town, and a lot of villagers have left as a result. Things are looking dire.");
~chatplayer("<p,neutral>I'm looking for someone called Ali.");
~chatnpc("<p,happy>Well, take your pick!");
~chatplayer("<p,neutral>I mean I'm looking for a specific Ali. He's Ali Morrisane's nephew.");
~chatnpc("<p,neutral>Oh, that Ali! Well, er, your best bet is to ask around town. I'm sure someone will know what he's up to.");

// ---------------------------------------------------------------- the street urchin
[opnpc1,feud_street_urchin]
def_int $s = %feud_var;
if ($s = ^feud_pickpocket1) @feud_urchin_distract;
if ($s >= ^feud_distracted & $s < ^feud_menaphites_beaten) {
    ~chatplayer("<p,happy>Hey there!");
    if (%feud_var_urchin = 0) {
        ~chatnpc("<p,happy>Did you see the way I distracted that guy? Man, I'm one smooth operator!");
        ~chatplayer("<p,happy>You did good, kid.");
        ~chatnpc("<p,quiz>So where's my money?");
        if (~p_choice2("What money?", 1, "Here you go, thanks.", 2) = 1) {
            ~chatplayer("<p,quiz>What money?");
            ~chatnpc("<p,angry>Don't play stupid with me, I'm better at it. Where's my money?");
            ~chatplayer("<p,happy>Oh, that money! I don't think you deserve it!");
            ~chatnpc("<p,angry>Liar, thief!");
            ~chatplayer("<p,happy>How observant of you!");
            ~chatnpc("<p,angry>Give me my money!");
            ~chatplayer("<p,angry>Make me!");
            %feud_var_urchin = 2;
            ~chatnpc("<p,angry>You'll be sorry!");
            return;
        }
        if (inv_total(inv, coins) < 10) {
            ~chatplayer("<p,sad>I don't seem to have the money on me."); // ours
            return;
        }
        inv_del(inv, coins, 10);
        %feud_var_urchin = 1;
        ~chatplayer("<p,happy>Here you go, thanks.");
        ~chatnpc("<p,happy>Thanks, I didn't think you would hold up your side of the deal. There's not much honour amongst thieves, you know.");
        return;
    }
    if (%feud_var_urchin = 2) {
        ~chatnpc("<p,angry>Thief! Thief!");
        ~chatplayer("<p,angry>Shut up! Don't cause any more trouble or you'll regret it.");
        ~chatnpc("<p,angry>Give me double and I'll be quiet!");
        if (inv_total(inv, coins) < 20) {
            ~chatplayer("<p,sad>I don't have that much on me."); // ours: the transcript has no words here
            return;
        }
        inv_del(inv, coins, 20);
        ~chatplayer("<p,angry>Okay, here you go - you thief.");
        ~chatnpc("<p,happy>Better a thief than a liar!");
        %feud_var_urchin = 1;
        return;
    }
    ~chatnpc("<p,happy>Hi! Do you want to go rob some more people? I could do with some more money.");
    ~chatplayer("<p,neutral>I think I need to try a different tactic. Sorry, kid!");
    return;
}
if ($s >= ^feud_complete & ~rt_urchin_wants = true) @rt_urchin; // Rogue Trader (rt_npcs.rs2)
if ($s >= ^feud_menaphites_beaten) {
    ~chatplayer("<p,happy>Hey there!");
    ~chatnpc("<p,happy>Hi! Do you want to go rob some more people? I could do with some more money.");
    ~chatplayer("<p,neutral>I think I need to try a different tactic. Sorry, kid!");
    ~chatnpc("<p,neutral>Well do you need any information then?");
    ~chatplayer("<p,neutral>No thanks, I think I have a fair idea of what is going on in the town now.");
    return;
}
~chatplayer("<p,happy>Hello there!");
~chatnpc("<p,quiz>What do you want? Information?");
~chatplayer("<p,quiz>What would you know?");
~chatnpc("<p,neutral>No one knows what's going on in the streets better than me. I live, sleep, eat and drink here. The fact that I'm so small means that people tend to ignore me which helps even more.");
@feud_urchin_info;

[label,feud_urchin_info]
~chatnpc("<p,quiz>Do you need any other information?");
if (~p_choice2("Yes tell me about...", 1, "No thanks.", 2) = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    ~chatnpc("<p,neutral>Come back if you need any info about anything in the town.");
    ~chatplayer("<p,neutral>I will do thanks.");
    return;
}
~chatplayer("<p,neutral>Yes, tell me about...");
switch_int (~p_choice5("The Menaphites", 1, "The bandits", 2, "The Mayor", 3, "Ali Morrisane's nephew", 4, "The town", 5)) {
    case 1 :
        ~chatplayer("<p,neutral>Tell me about the Menaphites.");
        ~chatnpc("<p,neutral>They're a bad bunch, always starting fights down in the Asp and Snake. Word on the street is that they're led by some deranged priest. Nobody's ever seen them though - they do all their deals through Ali 'the Operator'. I reckon they're up to something, but they're such a close knit group that little ever slips out.");
    case 2 :
        ~chatplayer("<p,neutral>Tell me about the bandits.");
        ~chatnpc("<p,neutral>There's not much to say, really. They're just a group of local thugs led by the biggest and strongest amongst them. If they have any other plans, I don't know about it.");
    case 3 :
        ~chatplayer("<p,neutral>Tell me about the Mayor.");
        ~chatnpc("<p,angry>The mayor is a spineless coward! He never stands up to anybody. That's why the Menaphites are so strong now! He let them stay, and then they started causing trouble. When he realised his mistake, he hired a band of local thugs to drive them out, but they saw how weak he was and turned on us too. Now we've got bandits and Menaphites, and the mayor isn't doing anything!");
    case 4 :
        ~chatplayer("<p,neutral>Tell me about Ali Morrisane's nephew.");
        ~chatnpc("<p,angry>I know him! He used to kick us when he caught any of us stealing from his stall.");
        ~chatplayer("<p,quiz>Do you know where he is now then?");
        ~chatnpc("<p,neutral>He disappeared a little while ago. All I know is it had something to do with the gangs. Probably he scammed them. You'd have to gain their trust to find out more, m'afraid - if I get too close, they might disappear me too!");
    case 5 :
        ~chatplayer("<p,neutral>Tell me about the town.");
        ~chatnpc("<p,sad>It's boring! We're not as big as Menaphos or as powerful as Al Kharid, and we've got a really nasty crime problem. It's no wonder so many grown-ups have left.");
}
@feud_urchin_info;

// the urchin draws a villager away while you pick its pocket
[label,feud_urchin_distract]
~chatplayer("<p,neutral>Hey kid, come here!");
~chatnpc("<p,quiz>What do you want?");
~chatplayer("<p,neutral>I need a little help, do you want to make some easy money?");
~chatnpc("<p,neutral>That depends.");
~chatplayer("<p,neutral>Do you see that villager over there? If you could distract him for a bit I'll give you 10 gold coins.");
~chatnpc("<p,quiz>Is that it?");
~chatplayer("<p,happy>That's it!");
if (~feud_find_villager(10) = false) {
    ~chatnpc("<p,neutral>Listen, you're crazy. I can't see anyone to distract.");
    return;
}
~chatnpc("<p,happy>Okay, I see them. Here I go!");
%feud_var = ^feud_distracted;
%feud_distracted = 1;
npc_say("Hey you, camel features! Come here.");
if (.npc_find(coord, feud_villager_multi_1, 10, 0) = true) {
    .npc_say("Excuse me?");
} else if (.npc_find(coord, feud_villager_multi_2, 10, 0) = true) {
    .npc_say("Excuse me?");
} else if (.npc_find(coord, feud_villager_multi_3, 10, 0) = true) {
    .npc_say("Excuse me?");
}

// the villagers are multi NPCs, whose base type has no options, so npc_huntall skips them; look
// for each base type with the secondary npc pointer instead (the urchin stays the active one)
[proc,feud_find_villager](int $range)(boolean)
if (.npc_find(coord, feud_villager_multi_1, $range, 0) = true) return(true);
if (.npc_find(coord, feud_villager_multi_2, $range, 0) = true) return(true);
if (.npc_find(coord, feud_villager_multi_3, $range, 0) = true) return(true);
return(false);

// ---------------------------------------------------------------- Ali the Operator
[opnpc1,feud_egyptian_minder]
def_int $s = %feud_var;
if ($s < ^feud_camels_refused) {
    ~chatnpc("<p,angry>What do you want? I'm busy."); // ours: no transcript before the gangs refuse the camels
    return;
}
if ($s = ^feud_camels_refused) {
    ~chatnpc("<p,neutral>You seem to be a man of action. We could do with more people like you to sort those despicable bandits out.");
    ~chatplayer("<p,happy>Yeah, those pesky bandits!");
    ~chatnpc("<p,quiz>So will you join us in our fight to wipe them out?");
    if (~p_choice2("Yes, of course, those bandits should be taught a lesson.", 1, "Perhaps later, I'm quite busy at the moment.", 2) = 2) {
        ~chatplayer("<p,neutral>Perhaps later, I'm quite busy at the moment.");
        ~chatnpc("<p,neutral>Tell me when you are ready. This deed should not be undertaken lightly.");
        return;
    }
    ~chatplayer("<p,happy>Yes, of course, those pesky bandits should be taught a lesson.");
    ~chatnpc("<p,happy>Good choice my friend, together we will crush them.");
    ~chatplayer("<p,quiz>So when do we start?");
    ~chatnpc("<p,neutral>Slow down, slow down. First you must prove yourself capable and trustworthy.");
    ~chatplayer("<p,quiz>How will I manage that?");
    ~chatnpc("<p,neutral>Don't worry about that, I'll just set you a few jobs to do.");
    ~chatnpc("<p,neutral>As you might have gathered we have a less-than- sparkling reputation around here.");
    ~chatnpc("<p,neutral>So I want you to foster this reputation and grow it.");
    ~chatplayer("<p,quiz>What exactly does that mean?");
    ~chatnpc("<p,neutral>It means that I want you to go out into the town and pickpocket three villagers, then report back to me.");
    ~chatnpc("<p,neutral>If you have any problems don't be afraid to ask for some advice.");
    ~chatplayer("<p,neutral>Oh right, thanks.");
    %feud_var = ^feud_joined;
    @feud_operator_more;
}
if ($s = ^feud_joined) {
    ~chatnpc("<p,quiz>How is the pickpocketing going?");
    ~chatplayer("<p,neutral>I haven't started yet. I'm still psyching myself up to it.");
    ~chatnpc("<p,angry>Don't take all day, time is getting on and there are still plenty of foul deeds to be done.");
    return;
}
if ($s = ^feud_pickpocket1 | $s = ^feud_distracted) {
    ~chatnpc("<p,quiz>How is the pickpocketing going? Need a hand?");
    if (~p_choice2("Yeah, I could do with a bit of advice.", 1, "Nah, no problems here. I want to ask you about something else.", 2) = 2) @feud_operator_more;
    ~chatplayer("<p,neutral>Yeah, I could do with a bit of advice.");
    ~chatnpc("<p,neutral>If you can't achieve your goal directly, try adding another element into the equation, like a distraction.");
    ~chatnpc("<p,quiz>Do you know what I mean?");
    ~chatplayer("<p,neutral>I think so.");
    return;
}
if ($s >= ^feud_pickpocket2 & $s < ^feud_pickpocket3) {
    ~chatnpc("<p,quiz>Having problems?");
    if (~p_choice2("Yeah, I could do with a bit of advice.", 1, "Nah, no problems here. I want to ask you about something else.", 2) = 2) @feud_operator_more;
    ~chatplayer("<p,neutral>Yeah, I could do with a bit of advice.");
    ~chatnpc("<p,quiz>The distraction tactic isn't working any more?");
    ~chatplayer("<p,sad>No, they seem to have figured that one out already.");
    ~chatnpc("<p,neutral>It is a small town, news spreads fast. Perhaps using a spot of cunning and a bit of brute force might work better.");
    if (inv_freespace(inv) = 0) {
        ~chatnpc("<p,neutral>Here, take this, it might help.");
        ~mesbox("Ali the Operator motions as if to give you a Blackjack but you decline, as you have no room in your inventory.");
        return;
    }
    if (~obj_gettotal(blackjack_oak) > 0) {
        ~chatnpc("<p,neutral>I've already given you a Blackjack, try using it.");
        return;
    }
    inv_add(inv, blackjack_oak, 1);
    ~objbox(blackjack_oak, "Ali The Operator hands you a Blackjack made out of oak.", 250, 0, 0);
    return;
}
if ($s = ^feud_pickpocket3) {
    ~chatnpc("<p,happy>Well done! You have finished your first trial.");
    ~chatplayer("<p,quiz>First trial?");
    ~chatnpc("<p,neutral>You didn't think we'd hire you off the back of a couple of pick-pocketings, did you?");
    ~chatplayer("<p,neutral>Ah, of course not.");
    ~chatnpc("<p,happy>Good! Now, the next thing you have to do is a spot of burglary.");
    ~chatnpc("<p,neutral>The only place worth pilfering around here is the mayor's villa.");
    ~chatnpc("<p,neutral>I want you to retrieve his wife's jewels.");
    ~chatplayer("<p,quiz>Got any advice?");
    ~chatnpc("<p,neutral>Well I think that a disguise would be a good start. After that I would stake out the place to make sure he's not in.");
    ~chatnpc("<p,neutral>You'll need a key to the front door, too.");
    if (inv_freespace(inv) = 0) {
        ~chatplayer("<p,sad>I can't carry anything else.");
        ~chatnpc("<p,neutral>Well then come back to me again when you are ready. Don't be too long.");
        return;
    }
    inv_add(inv, feud_mayors_house_keys, 1);
    ~objbox(feud_mayors_house_keys, "Ali the Operator hands you a set of keys.", 250, 0, 0);
    %feud_var = ^feud_got_keys;
    ~chatplayer("<p,quiz>Anything else?");
    ~chatnpc("<p,angry>No! Now get going.");
    return;
}
if ($s = ^feud_got_keys | $s = ^feud_staked_out) {
    if ($s = ^feud_got_keys) {
        ~chatnpc("<p,neutral>Haven't I helped you enough already?");
        ~chatplayer("<p,neutral>Actually, I'm still having problems getting in.");
    } else {
        ~chatnpc("<p,neutral>What now?");
    }
    if (~obj_gettotal(feud_mayors_house_keys) = 0 & %feud_var_mayorsdoor = 0) {
        ~chatnpc("<p,neutral>So you've lost your keys then. It's lucky I keep a spare pair.");
        if (inv_freespace(inv) = 0) {
            inv_dropitem(inv, coord, feud_mayors_house_keys, 1, 200);
        } else {
            inv_add(inv, feud_mayors_house_keys, 1);
        }
        ~objbox(feud_mayors_house_keys, "Ali the Operator hands you a set of keys.", 250, 0, 0);
        return;
    }
    if ($s = ^feud_staked_out) {
        if (%feud_var_mayorsdoor = 0) {
            ~chatplayer("<p,neutral>I've managed to stake the place out. What should I do now?");
            ~chatnpc("<p,neutral>Try using those keys I gave you to open the door!");
            return;
        }
        ~chatplayer("<p,neutral>I've managed to break in, but I'm unable to get the jewels.");
        ~chatnpc("<p,neutral>Then search the house more thoroughly! Everything you need should be there.");
        return;
    }
    ~chatnpc("<p,quiz>So what's the problem? Have you created a disguise yet?");
    if (~p_choice2("Yes of course.", 1, "Now that you mention it, I'm having a few problems with that.", 2) = 1) {
        ~chatplayer("<p,happy>Yes of course.");
        ~chatnpc("<p,neutral>Then make sure that you stake the place out to make sure neither the mayor or his family are inside.");
        return;
    }
    ~chatplayer("<p,neutral>Now that you mention it, yes I am having problems with the disguise.");
    ~chatnpc("<p,neutral>You'll have to create something that will hide your hair and obscure your facial features.");
    ~chatnpc("<p,neutral>Make sure you're wearing a pair of gloves so that you don't leave any incriminating finger prints.");
    ~chatnpc("<p,neutral>You should have all this equipped before you stake out the house.");
    return;
}
if ($s = ^feud_got_jewels) {
    ~chatplayer("<p,happy>I've completed your task.");
    ~chatnpc("<p,quiz>Impressive, I didn't expect you to crack that safe so quickly. Did you have help?");
    ~chatplayer("<p,neutral>Of course not, although the mayor did leave a number of hints lying around.");
    ~chatnpc("<p,neutral>That man is a fool. Now give me the jewels.");
    if (inv_total(inv, feud_mayors_jewels) = 0) {
        ~chatplayer("<p,sad>Actually I seem to have misplaced them.");
        ~chatnpc("<p,angry>You are trying my patience. Hurry back with the jewels. Don't disappoint me.");
        return;
    }
    inv_del(inv, feud_mayors_jewels, 1);
    %feud_given_jewels = 1;
    ~objbox(feud_mayors_jewels, "You hand Ali the Operator the jewels.", 250, 0, 0);
    ~chatnpc("<p,neutral>Now, your final task is one of the upmost importance. It has come to my attention that there is a traitor in our midst.");
    ~chatplayer("<p,quiz>Oh really?");
    ~chatnpc("<p,neutral>Yes, and I want you to root them out.");
    ~chatplayer("<p,quiz>Why me?");
    ~chatnpc("<p,neutral>Because I feel like I can trust you. You don't have the emotional baggage that comes with playing the villain your entire life.");
    %feud_var = ^feud_traitor_task;
    ~chatplayer("<p,happy>Aw! You can count on me to find the traitor.");
    ~chatnpc("<p,neutral>Well then get to it.");
    return;
}
if ($s = ^feud_traitor_task) {
    if (%feud_found_trait = 0) {
        ~chatnpc("<p,quiz>How is the search for the traitor going?");
        ~chatplayer("<p,sad>Still no breakthrough.");
        ~chatnpc("<p,neutral>Make sure you interview our other members. They may know more than they let on.");
        return;
    }
    ~chatplayer("<p,neutral>I have discovered the identity of the traitor. It was...");
    ~chatplayer("<p,neutral>Traitorous Ali!");
    ~chatnpc("<p,shock>No! I would never have suspected Traitorous Ali.");
    ~chatnpc("<p,neutral>Well, there was that time he sold out his entire family for a sandpit and an umbrella.");
    ~chatnpc("<p,neutral>But I'm sure it took much more for him to betray us!");
    ~chatplayer("<p,neutral>Actually he sold you out for...");
    %feud_var = ^feud_traitor_found;
    ~chatnpc("<p,sad>Stop, I don't want to know. It hurts too much already. Find him and then kill him, but do it quietly. I don't want a fuss.");
    return;
}
if ($s >= ^feud_traitor_found & $s < ^feud_drink_poisoned) {
    ~chatnpc("<p,quiz>Is the deed done?");
    ~chatplayer("<p,neutral>I'm still working on it.");
    ~chatnpc("<p,angry>Well don't waste time talking to me. Get on with it.");
    return;
}
if ($s = ^feud_drink_poisoned) {
    ~chatnpc("<p,quiz>Is the deed done?");
    ~chatplayer("<p,happy>Almost, his drink is poisoned. As soon as he gets back, he'll be done for.");
    ~chatnpc("<p,happy>Excellent work! Now, go speak with our boss.");
    ~chatnpc("<p,neutral>He wants to discuss the future direction of the gang.");
    %feud_var = ^feud_meet_leader;
    %feud_boss_vis = 1;
    return;
}
if ($s = ^feud_meet_leader) {
    ~chatnpc("<p,quiz>What did the boss say?");
    ~chatplayer("<p,neutral>I haven't spoken with him yet.");
    return;
}
~chatnpc("<p,angry>Why did you have to go and ruin everything? We had a beautiful future ahead of us, the town would have been ours!");
switch_int (~p_choice3("Maybe I wanted to make it MY town!", 1, "Evil megalomaniacs set on destruction should be opposed.", 2, "I'm sorry, I didn't mean to upset you. Can we still be friends?", 3)) {
    case 1 :
        ~chatplayer("<p,angry>Maybe I wanted to make it MY town!");
        ~chatnpc("<p,neutral>I see. I knew the hunger for power would get to you eventually.");
    case 2 :
        ~chatplayer("<p,neutral>Evil megalomaniacs set on destruction should be opposed.");
        ~chatnpc("<p,quiz>Really? I thought you were meant to follow those types blindly, with unquestioning loyalty.");
        ~chatplayer("<p,neutral>Look, Gielinor is full of power mad evil-doers. I'm sure another will come along soon enough.");
        ~chatnpc("<p,sad>No... it just wouldn't be the same. I think I'll just wallow in self pity for a while.");
    case 3 :
        ~chatplayer("<p,sad>I'm sorry, I didn't mean to upset you. Can we still be friends?");
        ~chatnpc("<p,sad>No, I think I'll just wallow in self pity for a while.");
}

[label,feud_operator_more]
~chatnpc("<p,quiz>Can I help you with anything else?");
if (~p_choice2("Yes I'd like to ask you about something else.", 1, "No thanks.", 2) = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    return;
}
~chatplayer("<p,neutral>Yes I'd like to ask you about something else.");
switch_int (~p_choice3("Tell me about yourself.", 1, "Tell me about the other people in the town.", 2, "I'm looking for Ali.", 3)) {
    case 1 :
        ~chatplayer("<p,neutral>Tell me about yourself.");
        ~chatnpc("<p,neutral>That information is available on a need to know basis and right now, you don't need to know.");
    case 2 :
        ~chatplayer("<p,neutral>Tell me about the other people in the town.");
        ~chatnpc("<p,neutral>Sheep, ready for the slau... hang on. I shouldn't be telling you that. Just forget I said anything.");
    case 3 :
        ~chatplayer("<p,neutral>I'm looking for Ali.");
        ~chatnpc("<p,neutral>Can you be a bit more specific? Everyone here is called Ali.");
        ~chatplayer("<p,neutral>So I noticed. Well, he has an uncle called Ali Morrisane, a market vendor in Al Kharid. That's all I really know about him.");
        ~chatnpc("<p,angry>Say no more. I know just the Ali you mean - that little snake robbed me too! If we work together perhaps we can catch him and teach him a lesson.");
}
@feud_operator_more;

// ---------------------------------------------------------------- Ali the Hag
[opnpc1,feud_hag]
def_int $s = %feud_var;
~chatplayer("<p,neutral>Good day, Hag.");
~chatnpc("<p,angry>Good day to you too, Blockhead.");
if ($s = ^feud_traitor_found) {
    if (%feud_metwitch = 0) {
        ~chatnpc("<p,quiz>Now what do you want? A hex? A spot potion? Power, beauty, eternal youth, etcetera?");
        ~chatplayer("<p,neutral>Actually I just want your help to, erm, remove someone. It's simple enough!");
        ~chatnpc("<p,neutral>Ahh, I see. But I warn you, stranger - extinguishing the flame of life is simple, but people rarely wish to face the consequences, and I doubt you are any different.");
        ~chatplayer("<p,neutral>Don't worry about the consequences - I need it carried out in a manner which would draw no suspicion to me.");
        ~chatnpc("<p,happy>Well now this is getting interesting. I'd recommend a poisoning. Who do you wish dead? I need to know so that I may tailor a poison to their specific needs.");
        ~chatplayer("<p,neutral>'Traitorous Ali', please.");
        ~chatnpc("<p,happy>Traitorous Ali? Say no more! That wretch traded his grandmother's house for a jar of pickled aubergines! I believe he'll be easily gotten rid of...");
        ~chatplayer("<p,quiz>What payment do you require?");
        ~chatnpc("<p,happy>None at all - I will extract much pleasure from his passing. Just bring me the ingredients I require.");
        ~chatplayer("<p,quiz>What do you need?");
        ~chatnpc("<p,neutral>Ah, impatience! Traitorous Ali's time is indeed nigh. Firstly bring me some snake venom, which will act as the main toxin.");
        ~chatplayer("<p,quiz>Where would I get some snake poison?");
        ~chatnpc("<p,neutral>From a snake perhaps?");
        ~chatplayer("<p,neutral>What I meant was how do I extract the poison from the snake?");
        %feud_metwitch = 1;
        ~chatnpc("<p,angry>Sheesh! You'd make a terrible hag. Just bring me a snake with teeth in its head - and don't even think of giving me that snake charmer's pet worm, it's about as dangerous as a rubber knife.");
        return;
    }
    if (inv_total(inv, basket_with_snake) = 0) {
        ~chatnpc("<p,quiz>Have you got a snake yet?");
        ~chatplayer("<p,neutral>No, I'm still working on that.");
        ~chatnpc("<p,angry>Well don't bother me again until you do!");
        return;
    }
    ~chatplayer("<p,neutral>I have the snake. What else do you need?");
    ~chatnpc("<p,happy>Ah yes, that snake will do nicely. Hello, you wriggly little cutie!");
    ~chatnpc("<p,happy>Who's a vindictive little beast? You are! You are!");
    ~chatplayer("<p,quiz>Erm, yes. Do you need anything else?");
    ~chatnpc("<p,neutral>Now that I have the toxin I need something to hide its trace. Fresh camel dung should do the job.");
    ~chatplayer("<p,shock>What? That's disgusting.");
    ~chatnpc("<p,angry>Do you want the poison or not?");
    ~chatplayer("<p,neutral>Fine, fine, I'll get some camel dung.");
    ~chatnpc("<p,neutral>And make that fresh camel dung! Nice and stinky. Now hand over that venomous little darling before it takes a bite out of you.");
    ~chatplayer("<p,shock>Oops! I almost forgot!");
    inv_del(inv, basket_with_snake, 1);
    %feud_var = ^feud_snake_given;
    ~objbox(basket_with_snake, "You hand the basket with the charmed snake over to the old hag.", 250, 0, 0);
    return;
}
if ($s = ^feud_snake_given) {
    if (inv_total(inv, feud_camel_pooh_bucket) = 0) {
        ~chatnpc("<p,quiz>Do you have the camel dung yet?");
        ~chatplayer("<p,neutral>No, I'm still working on that.");
        ~chatnpc("<p,angry>Well don't come back until you have it!");
        return;
    }
    ~chatnpc("<p,happy>Here's your poison!");
    ~chatplayer("<p,shock>Wow, that was quick!");
    ~chatnpc("<p,neutral>Actually I already had it brewing. I just needed the ingredients for another batch.");
    ~chatnpc("<p,happy>You wouldn't believe the demand. It's been murder!");
    ~chatplayer("<p,angry>That's not even remotely funny.");
    ~chatnpc("<p,happy>Sorry, I've been dying to say that for ages.");
    ~chatplayer("<p,neutral>Just stop. Thanks for the poison and good day to you.");
    ~chatnpc("<p,neutral>Wait! Just remember, this poison isn't designed to be used on a weapon. In fact it's not a contact poison at all. You'll have to do more than just smear it on a blade!");
    ~chatplayer("<p,happy>Got it. Thanks again!");
    inv_del(inv, feud_camel_pooh_bucket, 1);
    inv_add(inv, bucket_empty, 1);
    inv_add(inv, poison_from_hag, 1);
    %feud_var = ^feud_got_poison;
    ~objbox(poison_from_hag, "You hand over your bucket of fresh camel dung and receive a vial of poison in return.", 250, 0, 0);
    return;
}
if ($s = ^feud_got_poison) {
    ~chatplayer("<p,neutral>I was wondering if I could have another batch of poison?");
    ~chatnpc("<p,quiz>Why? Was the first batch not good enough?");
    if (inv_total(inv, poison_from_hag) > 0) {
        ~chatplayer("<p,neutral>Well no, I was just being greedy and wanted another batch for no good reason.");
        ~chatnpc("<p,angry>Well if that's the case, no! I have better things to be doing than continuously brewing poisons for people who have no use for it.");
        return;
    }
    ~chatplayer("<p,sad>I lost the first batch.");
    ~chatnpc("<p,angry>What? How do you just lose a batch of the most potent poison in all of Gielinor? It's even more deadly than the jungle karambwan.");
    ~chatplayer("<p,neutral>It's a long and not very interesting story.");
    ~chatnpc("<p,neutral>Well alright, I'll give you another batch this once.");
    if (inv_freespace(inv) = 0) {
        inv_dropitem(inv, coord, poison_from_hag, 1, 200);
    } else {
        inv_add(inv, poison_from_hag, 1);
    }
    return;
}
if ($s = ^feud_drink_poisoned) {
    ~chatnpc("<p,quiz>Have you good reason to disturb me again?");
    ~chatplayer("<p,happy>Nope!");
    ~chatnpc("<p,angry>I warned you about needlessly bothering me. That's it! I'm turning you into a frog!");
    ~chatplayer("<p,happy>Ribbit, ribbit!");
    ~chatnpc("<p,angry>Don't taunt me, fool! Once I find a spare minute you'll be ribbiting on the other side of your face, you mark my words!");
    return;
}
// Transcript:Ali the Hag
~chatnpc("<p,quiz>Now what do you want? A hex? A spot potion? Power, beauty, eternal youth, etcetera?");
~chatplayer("<p,neutral>Nothing, thanks."); // ours

// ---------------------------------------------------------------- the Menaphite Leader
[opnpc1,feud_menap_boss] @feud_menap_boss_talk;
[opnpc1,feud_menap_boss2] @feud_menap_boss_talk;
[opnpc1,feud_menap_boss_vis] @feud_menap_boss_talk;
[label,feud_menap_boss_talk]
if (%feud_var ! ^feud_meet_leader) return;
if (%feud_var_menaboss = 1) {
    npc_say("Guards!");
    @feud_toughguy_call;
}
~chatplayer("<p,neutral>Ali the Operator said you wanted to see me.");
~chatnpc("<p,neutral>That's right. I have kept a close eye on your progress. I'm impressed.");
~chatplayer("<p,quiz>So what are your plans for the bandits?");
~chatnpc("<p,neutral>The bandits? A mere nuisance, insignificant to my overall goal.");
~chatplayer("<p,quiz>Wait, if you're not warring with the bandits, what are you planning?");
~chatnpc("<p,happy>World domination! First Pollnivneach, then Al Kharid, then the whole of the desert!");
~chatplayer("<p,shock>What?");
~chatnpc("<p,quiz>You do understand who we are, don't you?");
~chatplayer("<p,neutral>Actually I thought you were a ragtag band of good-for- nothing thieves sucking the life out of this innocent town.");
~chatnpc("<p,angry>Silence! We are the descendants of assassins, the heirs of the revolutionaries who defeated the corrupt pharaoh and his brood!");
~chatnpc("<p,angry>For centuries we have wandered the desert, rebuilding the empire we were promised!");
~chatnpc("<p,quiz>Will you join us in our quest to defeat the thralls of Tumeken and reclaim our birthright?");
~chatplayer("<p,angry>Sorry, I have this irrational hatred for megalomaniac, despotic zealots! Prepare to meet your maker, you big jerk!");
%feud_var_menaboss = 1;
~chatnpc("<p,angry>Fool! You'll never get to me. Guards protect me.");
@feud_toughguy_call;

// ---------------------------------------------------------------- the Bandit Leader
[opnpc1,feud_bandit_boss] @feud_bandit_boss_talk;
[opnpc1,feud_bandit_boss_vis] @feud_bandit_boss_talk;
[label,feud_bandit_boss_talk]
def_int $s = %feud_var;
if ($s = ^feud_bandits_beaten) {
    ~chatplayer("<p,angry>I told you to clear off! Why are you still here?");
    ~chatnpc("<p,neutral>Adventurer... I have underestimated you. Perhaps we can come to an agreement. How about I work for you? Think of the riches you would make.");
    ~chatplayer("<p,angry>Don't try my patience. Get out of here, and never return to this town again!");
    ~chatnpc("<p,happy>Ha! You fancy yourself the people's champion, do you? You are so naive. You don't even realise you've been tricked!");
    ~chatplayer("<p,quiz>What do you mean?");
    ~chatnpc("<p,neutral>Go have a chat with these precious townspeople of yours. You'll soon see.");
    ~chatplayer("<p,angry>I'll go talk to a villager now, just to prove you wrong. Now get out of here before I really get angry with you.");
    return;
}
if ($s ! ^feud_menaphites_beaten) return;
if (%feud_var_banditboss = 1) {
    npc_say("Ali, come here!");
    @feud_champion_call;
}
~chatnpc("<p,happy>Come here my friend, so I may embrace you. You have done us a great turn by disposing of those Menaphites.");
~chatplayer("<p,angry>Don't jump to conclusions, I didn't do it for you.");
~chatnpc("<p,happy>Regardless, I am still very grateful. Now I have the town at my mercy.");
~chatplayer("<p,neutral>That's what I'm here to talk to you about.");
~chatnpc("<p,quiz>Do you want a reward? A fee? I will not begrudge you that.");
~chatplayer("<p,angry>No, I'm here to give you an ultimatum: either leave the town of your own free will or I will make you.");
~chatnpc("<p,angry>How the worm has turned. This no-name adventurer who was robbing, looting and poisoning not too long ago is now taking the moral high ground! Or are you trying to keep the whole town for yourself?");
~chatnpc("<p,angry>Pollnivneach is mine. You won't run me out without a fight. If you want us gone, you must defeat our strongest warrior in battle.");
%feud_var_banditboss = 1;
~chatplayer("<p,angry>Start packing your bags!");
@feud_champion_call;

// ---------------------------------------------------------------- villagers
[opnpc1,feud_villager_multi_1] @feud_villager_talk;
[opnpc1,feud_villager_multi_2] @feud_villager_talk;
[opnpc1,feud_villager_multi_3] @feud_villager_talk;
[opnpc1,feud_villager_1_1] @feud_villager_talk;
[opnpc1,feud_villager_1_2] @feud_villager_talk;
[opnpc1,feud_villager_1_3] @feud_villager_talk;
[opnpc1,feud_villager_2_1] @feud_villager_talk;
[opnpc1,feud_villager_2_2] @feud_villager_talk;
[opnpc1,feud_villager_2_3] @feud_villager_talk;
[opnpc1,feud_villager_3_1] @feud_villager_talk;
[opnpc1,feud_villager_3_2] @feud_villager_talk;
[opnpc1,feud_villager_3_3] @feud_villager_talk;

[label,feud_villager_talk]
def_int $s = %feud_var;
if ($s = ^feud_menaphites_beaten) {
    ~chatplayer("<p,neutral>Hello.");
    ~chatnpc("<p,angry>You! You're the one that just made everything worse for us poor villagers!");
    ~chatplayer("<p,shock>What?! I just single-handedly took apart one of the gangs that was ruining your town!");
    ~chatnpc("<p,angry>You adventurers! You never think, you just act. You think that by killing a powerful bad person, Gielinor will become a better place.");
    ~chatnpc("<p,angry>It's not that simple, things never are. You've created a vacuum, and now all that power will go to whoever's strong enough to take it.");
    ~chatnpc("<p,quiz>Who do you think is stronger? Our elderly mayor, or the leader of the bandits?");
    ~chatplayer("<p,sad>Oops. Sorry, I was just trying to help. So are things really that much worse?");
    ~chatnpc("<p,angry>Yes. Before your intervention the two gangs pretty much cancelled each other out. They spent most of their energy trying to kill each other.");
    ~chatnpc("<p,angry>Now that the balance is lost, the Bandits reign unopposed! They no longer have to deal with the Menaphites and heap misery upon misery on us. You must finish the job that you have started.");
    ~chatplayer("<p,neutral>You know, this adventuring lark is a lot more complicated than I thought!");
    %feud_talk_villager = 1;
    %feud_bandit_boss_vis = 1;
    ~chatnpc("<p,angry>If you're prepared to change something you must also be prepared to deal with the consequences! Now hurry up and fix this mess you created!");
    if (~p_choice2("What do you mean by fix the mess I created?", 1, "Ok I'll get to it.", 2) = 1) {
        ~chatplayer("<p,quiz>What do you mean by fix the mess I created?");
        ~chatnpc("<p,angry>Do I have to spell it out to you?");
        ~chatplayer("<p,neutral>Would you please?");
        ~chatnpc("<p,neutral>Just run the bandits out of town. Incidentally, I spotted their leader to the north-west just a few minutes ago.");
        return;
    }
    ~chatplayer("<p,neutral>Okay, I'll get to it.");
    return;
}
if ($s = ^feud_bandits_beaten) {
    ~chatplayer("<p,quiz>Now are you satisfied?");
    ~chatnpc("<p,neutral>Oh, it's you again!");
    ~chatplayer("<p,angry>I have delivered you from two evil tyrants. Where's my thank you?");
    ~chatnpc("<p,angry>Thank you? For what? You come into our town. You rob, mug, burgle and kill and then expect respect and gratitude? Look, if it's praise and thanks you're looking for, talk to the mayor.");
    %feud_talk_villager = 2;
    %feud_mayor_invis = 0;
    %feud_bandit_boss_vis = 0;
    ~chatplayer("<p,sad>I wonder why I bother sometimes! This place has been nothing but trouble and I still haven't found Ali's nephew.");
    return;
}
// Transcript:Villager (random)
~chatplayer("<p,neutral>Hello, how's it going?");
if (random(2) = 0) {
    ~chatnpc("<p,shock>Argh! Don't rob me!");
    ~chatplayer("<p,quiz>What are you talking about?");
    ~chatnpc("<p,neutral>Sorry, I thought you were a bandit.");
    ~chatplayer("<p,neutral>There are a lot of them around here...");
    return;
}
~chatnpc("<p,neutral>Perhaps it's time to elect a new mayor...");

// ---------------------------------------------------------------- the town's other people
// Transcript:Ali the Kebab seller (2009scape's AliTheKebabSeller has the same words)
[opnpc1,feud_kebabman]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,happy>Hello. What can I do for you?");
~chatplayer("<p,quiz>I don't know, what can you do for me?");
~chatnpc("<p,neutral>Well, that depends.");
~chatplayer("<p,quiz>Depends on what?");
~chatnpc("<p,neutral>It depends on whether you like kebabs or not.");
~chatplayer("<p,quiz>Why is that?");
~chatnpc("<p,neutral>Seeing as I'm in the kebab construction industry, I mainly help people in need of a kebab.");
~chatplayer("<p,quiz>Well then, what kind of kebabs do you, er, construct?");
~chatnpc("<p,neutral>I offer two different types of kebabs: the standard run- of-the-mill kebab seen throughout Gielinor and enjoyed by many an intoxicated dwarf, and my speciality, the extra-hot kebab. So which shall it be?");
@feud_kebab_menu;

[label,feud_kebab_menu]
switch_int (~p_choice5("I want a standard kebab, please.", 1, "Could I have an extra-hot kebab please?", 2, "Would you sell me that bottle of special kebab sauce?", 3, "What is the difference between the standard and the extra-hot kebab?", 4, "I need some information.", 5)) {
    case 1 :
        ~chatplayer("<p,neutral>I want a standard kebab, please.");
        ~chatnpc("<p,neutral>That will be three gold coins.");
        @feud_kebab_buy(kebab, 3);
    case 2 :
        ~chatplayer("<p,neutral>Could I have one of those crazy hot kebabs of yours?");
        ~chatnpc("<p,happy>One super kebab coming up! Be careful, they really are as hot as they're made out to be.");
        ~chatplayer("<p,neutral>Sure, sure.");
        @feud_kebab_buy(super_kebab, 5);
    case 3 :
        ~chatplayer("<p,neutral>Would you sell me that bottle of special kebab sauce?");
        ~chatnpc("<p,quiz>Well, that depends. What do you intend to do with it?");
        ~chatplayer("<p,neutral>Don't worry, I've no intention of setting up a rival kebab shop.");
        ~chatnpc("<p,quiz>But then what do you want it for?");
        ~chatplayer("<p,happy>I don't know, but I think I could have a little bit of fun with it.");
        ~chatnpc("<p,quiz>You're not going to put it in Drunken Ali's drink, are you? That's what happened the last time I gave someone the sauce.");
        ~chatplayer("<p,neutral>No, that would be a bit cliché. I think I'll come up with something more original.");
        if (inv_freespace(inv) = 0) {
            ~chatplayer("<p,neutral>Actually, I might get back to you on the sauce. I'm a bit overburdened as it is.");
        } else {
            inv_add(inv, superhot_kebab_sauce, 1);
            ~objbox(superhot_kebab_sauce, "Ali the Kebab seller gives you the red hot sauce.", 250, 0, 0); // ours: the transcript says only that he gives it
            ~chatnpc("<p,neutral>Just be careful with it, it's potent enough to give a camel the runs.");
            ~chatplayer("<p,happy>Thank you very much.");
        }
        @feud_kebab_more;
    case 4 :
        ~chatplayer("<p,quiz>What is the difference between the standard and the extra-hot kebab?");
        ~chatnpc("<p,neutral>If I told you that I would have to kill you. Kebab construction is a cut-throat industry. The extra-hot kebab gives me my competitive edge and if I were to divulge my secrets to every passing adventurer, I'd soon be out of business.");
        ~chatplayer("<p,quiz>So there's no difference except the sauce you use?");
        ~chatnpc("<p,shock>Shh! Keep your voice down. You should have told me you were from the union.");
    case 5 :
        ~chatplayer("<p,neutral>I need some information.");
        ~chatnpc("<p,neutral>If information is what you need, there are many better people to ask than myself who could help you. One of the town's street urchins or perhaps the local drunk. I may be many things to many different people, but a gossip I am not.");
        @feud_kebab_more;
}

[label,feud_kebab_buy](namedobj $obj, int $cost)
if (inv_total(inv, coins) < $cost | inv_freespace(inv) = 0 & inv_total(inv, coins) ! $cost) {
    ~chatplayer("<p,sad>I seem to be short on coins. Sorry.");
    @feud_kebab_more;
}
inv_del(inv, coins, $cost);
inv_add(inv, $obj, 1);
~chatnpc("<p,happy>Here you go.");
~chatplayer("<p,happy>Thanks.");
@feud_kebab_more;

[label,feud_kebab_more]
~chatnpc("<p,quiz>Is there anything else I can do for you?");
if (~p_choice2("Yes, actually.", 1, "No thanks, I'm good.", 2) = 1) @feud_kebab_menu;
~chatplayer("<p,neutral>No thanks, I'm good.");
~chatnpc("<p,neutral>Come back soon, I could do with a few more customers.");

// Transcript:Ali the Snake Charmer
[opnpc1,feud_snakecharmer]
~chatplayer("<p,happy>Wow, a snake charmer! Can I have a go? Can I have a go? Please?");
~mesbox("The snake charmer is focusing intently on his music and doesn't seem to notice you.");

[oplocu,feud_money_bowl]
if (last_useitem ! coins) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, coins, 1); // ours: one coin, as the quick guide says to use "a coin"
~mesbox("The snake charmer snaps out of his trance and directs his full attention to you.");
if (~p_choice2("Wow, a snake charmer! Can I have a go? Can I have a go? Please?", 1, "Never mind.", 2) = 2) return;
~chatplayer("<p,happy>Wow, a snake charmer! Can I have a go? Can I have a go? Please?");
if (npc_find(coord, feud_snakecharmer, 10, 0) = false) return;
def_boolean $flute = false;
def_boolean $basket = false;
if (~obj_gettotal(snake_flute) > 0) $flute = true;
if (~obj_gettotal(basket_for_snake) > 0 | ~obj_gettotal(basket_with_snake) > 0) $basket = true;
if ($flute = true & $basket = true) {
    ~chatnpc("<p,neutral>I'm not stopping you! You have your own snake charming flute.");
    return;
}
if ($flute = true) {
    if (inv_freespace(inv) = 0) @feud_charmer_full;
    ~chatnpc("<p,angry>Ah, I see you've lost your basket. Here you are, now leave me alone! You're ruining the show.");
    inv_add(inv, basket_for_snake, 1);
    return;
}
if ($basket = true) {
    if (inv_freespace(inv) = 0) @feud_charmer_full;
    ~chatnpc("<p,angry>Ah, I see you've lost your snake charming flute. Here you go, now leave me alone! You're distracting my punters... er, I mean, crowd.");
    inv_add(inv, snake_flute, 1);
    return;
}
if (inv_freespace(inv) < 2) @feud_charmer_full;
~chatnpc("<p,angry>If you're that desperate to try, have my patented snake charming starter kit. It comes with a special snake charming flute and a basket to keep your charmed snakes in. Now, leave me alone!");
inv_add(inv, snake_flute, 1);
inv_add(inv, basket_for_snake, 1);
~doubleobjbox(snake_flute, basket_for_snake, "The snake charmer gives you a snake charming flute and a basket.", 250);

[label,feud_charmer_full]
~chatnpc("<p,angry>If it means that you'll leave me alone, I will happily give you my snake charming super starter kit, complete with flute and basket. But you're clearly over burdened as it is.");

// Transcript:Market seller (the shop is Trade, shop.rs2)
[opnpc1,feud_marketseller]
~chatnpc("<p,happy>Greetings! Are you in need of provisions?");
if (~p_choice2("Yes thank you.", 1, "No thanks.", 2) = 1) {
    ~openshop_activenpc;
    return;
}
~chatplayer("<p,neutral>No thanks.");

// Transcript:Ali the Camel (random)
[opnpc3,feud_camel]
switch_int (random(4)) {
    case 0 :
        ~chatplayer("<p,neutral>That beast would probably bite my fingers off if I tried to pet it.");
        ~chatnpc("<p,angry>If you want me to bite your fingers off, you're going the right way about it!");
    case 1 :
        ~chatplayer("<p,neutral>I'm not going to pet that! It will probably bite my hand off, that filthy beast.");
        ~chatnpc("<p,angry>Watch who you're calling a filthy beast, human.");
    case 2 :
        ~chatplayer("<p,happy>Mmmm... you'd make a tasty kebab.");
        ~chatnpc("<p,angry>And you'd make an excellent spit bucket! Pchoo!");
    case default :
        ~chatplayer("<p,neutral>I'm not going to pet that nasty creature! I might get fleas... or worse!");
        ~chatnpc("<p,angry>You're fairly nasty yourself, human. When was the last time you took a shower?");
}

// Transcript:Ali the dyer (Rana): red, yellow and blue dyes for 25 coins
[opnpc1,feud_dye_lady]
~chatplayer("<p,happy>Wow! look at this place, it's so colourful.");
~chatnpc("<p,happy>Why thank you. Can I help you with anything?");
~chatplayer("<p,neutral>I take it by the clothes you are wearing and this room that you are in the dye trade?");
~chatnpc("<p,neutral>How observant of you.");
if (~p_choice2("Could you make some dye for me please?", 1, "No thanks.", 2) = 2) return; // ours: the second option
~chatplayer("<p,neutral>Can you make dyes for me please?");
~chatnpc("<p,neutral>What colour dye do you want? I can make you blue, red or yellow dyes for you. If you bring me the correct raw materials.");
switch_int (~p_choice3("What do you need to make red dye?", 1, "What do you need to make yellow dye?", 2, "What do you need to make blue dye?", 3)) {
    case 1 :
        ~chatplayer("<p,quiz>What do you need to make red dye?");
        ~chatnpc("<p,neutral>Hmm.... 3 lots of redberries should do the trick and 25 coins should cover any other costs.");
        if (~p_choice2("Okay, make me some red dye please.", 1, "I don't think I have all the ingredients yet.", 2) = 2) @feud_dyer_later;
        @feud_dyer_make(redberries, 3, reddye, "berries", "red", "You hand the redberries and some coins to Rana, who then rummages around some shelves, eventually finding a red bottle, which she then hands to you.");
    case 2 :
        ~chatplayer("<p,quiz>What do you need to make yellow dye?");
        ~chatnpc("<p,neutral>Yellow is an awkward colour to recreate, I guess if you got me 2 onions I could use their skins to make a warm yellow dye for you. Oh yes and lest I forget I'll need 25 coins to cover the cost my wages.");
        if (~p_choice2("Okay, make me some yellow dye please.", 1, "I don't think I have all the ingredients yet.", 2) = 2) @feud_dyer_later;
        @feud_dyer_make(onion, 2, yellowdye, "onions", "yellow", "You hand two onions to Rana, who then rummages around some shelves, eventually finding a yellow bottle, which she then hands to you.");
    case 3 :
        ~chatplayer("<p,quiz>What do you need to make blue dye?");
        ~chatnpc("<p,neutral>To make a bottle of blue dye I'll need 2 woad leaves and 25 coins from you.");
        if (~p_choice2("Okay, make me some blue dye please.", 1, "I don't think I have all the ingredients yet.", 2) = 2) @feud_dyer_later;
        @feud_dyer_make(woadleaf, 2, bluedye, "woad leaves", "blue", "You hand the woad leaves and some coins to Rana, who then rummages around some shelves, eventually finding a blue bottle, which she then hands to you.");
}

[label,feud_dyer_later]
~chatplayer("<p,neutral>I don't think I have all the ingredients yet.");
~chatnpc("<p,neutral>You know what you need to get, now come back when you have them. Goodbye for now.");

[label,feud_dyer_make](namedobj $need, int $count, namedobj $dye, string $what, string $colour, string $box)
if (inv_total(inv, $need) < $count) {
    ~mesbox("You don't have enough <$what> to make the <$colour> dye.");
    return;
}
if (inv_total(inv, coins) < 25) {
    ~mesbox("You don't have enough coins to pay for the dye.");
    return;
}
inv_del(inv, $need, $count);
inv_del(inv, coins, 25);
inv_add(inv, $dye, 1);
~objbox($dye, $box, 250, 0, 0);

// the blackjack seller stands in town once the feud is over (ours: no transcript)
[opnpc1,feud_black_jack_seller_multi] ~chatnpc("<p,neutral>Blackjacks? Not for sale to the likes of you. Not yet, anyway.");
[opnpc3,feud_black_jack_seller_multi] ~chatnpc("<p,neutral>Blackjacks? Not for sale to the likes of you. Not yet, anyway.");
[opnpc1,feud_bjseller] @rt_bjseller; // Rogue Trader (miniquest_rogue_trader/rt_npcs.rs2)
[opnpc3,feud_bjseller] @rt_bjseller_trade;

// Transcript:Aristarchus ("Before Enakhra's Lament", which we don't have)
[opnpc1,enakh_aristarchus]
~chatnpc("<p,neutral>I'm sorry, but I'm currently doing some research. Could you talk to me later, please?");
~chatplayer("<p,neutral>Okay then.");

// Transcript:Monkey (magic carpet) (without a M'speak amulet)
[opnpc1,magic_carpet_monkey]
~chatplayer("<p,happy>Who's a cute little monkey?");
~chatnpc("<p,neutral>Ukkuk oook! Eeek aka, ahh aka gonk.");
