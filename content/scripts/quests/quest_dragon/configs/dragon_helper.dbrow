[questhelper_step_dragon_16]
table=questhelper_step
data=id,19016
data=section,2
data=text,"Go to Port Sarim Jail. You can either pay Wormbrain there 10,000 coins for Lozar's map piece, or kill him with ranged/mage and telegrab it with level 33 magic."
data=npc,wormbrain
data=coord,0_47_49_7_59
data=option,I believe you've got a piece of a map that I need.
data=option,I suppose I could pay you for the map piece...
data=option,"Alright then, 10,000 it is."

