[questhelper_step_dragon_1]
table=questhelper_step
data=id,19001
data=section,0
data=text,"Talk to the Guildmaster in the Champions' Guild, south of Varrock."
data=npc,guildmaster
data=coord,0_49_52_54_32
data=option,Can I have a quest?

[questhelper_step_dragon_2]
table=questhelper_step
data=id,19002
data=section,0
data=text,Talk to Oziach in his house in north western Edgeville.
data=npc,oziach
data=coord,0_47_54_60_61
data=option,Can you sell me a rune platebody?
data=option,The Guildmaster of the Champions' Guild told me.
data=option,I thought you were going to give me a quest.
data=option,"A dragon, that sounds like fun."

[questhelper_step_dragon_3]
table=questhelper_step
data=id,19003
data=section,0
data=text,Return to the Guildmaster and ask him all the available questions.
