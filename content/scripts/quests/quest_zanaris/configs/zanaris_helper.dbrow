[questhelper_guide_zanaris]
table=questhelper_guide
data=guide,^qh_zanaris
data=key,zanaris
data=name,Lost City
data=journal,Lost City
data=required,bronze_axe,1
data=required,knife,1
data=skill,31 Crafting
data=skill,36 Woodcutting
data=section,Starting off
data=section,Finding Shamus
data=section,Getting a Dramen branch
data=section,Entering Zanaris

[questhelper_step_zanaris_1]
table=questhelper_step
data=id,67001
data=section,0
data=text,Talk to the Warrior south east of Draynor Village.
data=npc,warrioradventurerpg
data=coord,0_49_50_15_7
data=option,What are you camped out here for?
data=option,What makes you think it's out here?
data=option,If it's hidden how are you planning to find it?
data=option,Looks like you don't know either.
data=option,Yes.

[questhelper_step_zanaris_2]
table=questhelper_step
data=id,67002
data=section,1
data=text,Try cutting the tree just to the west.
data=loc,leprechauntree
data=coord,0_49_50_3_13
data=option,"I've been in that shed, I didn't see a city."

[questhelper_step_zanaris_3]
table=questhelper_step
data=id,67003
data=section,1
data=text,Talk to Shamus.
data=npc,zanarisleprechaun
data=coord,0_49_50_2_12
data=option,"I've been in that shed, I didn't see a city."

[questhelper_step_zanaris_4]
table=questhelper_step
data=id,67004
data=section,2
data=text,"Bank all weapons and armour you have (including the axe), and go to Port Sarim to get a boat to Entrana."
data=npc,shipmonk1_c
data=coord,0_47_50_39_36

[questhelper_step_zanaris_5]
table=questhelper_step
data=id,67005
data=section,2
data=text,"If you've lost your Dramen branch/staff, you will need to return to Entrana and cut another. You will not need to defeat the Tree Spirit again."
data=item,dramen_branch,1

[questhelper_step_zanaris_6]
table=questhelper_step
data=id,67006
data=section,2
data=text,"Climb down the ladder on the north side of the island. Once you go down, you can only escape via teleport."
data=loc,entranaladdertop
data=coord,0_44_52_4_46
data=option,Well that is a risk I will have to take.

[questhelper_step_zanaris_7]
table=questhelper_step
data=id,67007
data=section,2
data=text,Kill zombies until one drops an axe.
data=coord,0_44_152_27_32

[questhelper_step_zanaris_8]
table=questhelper_step
data=id,67008
data=section,2
data=text,Pick up the axe

[questhelper_step_zanaris_9]
table=questhelper_step
data=id,67009
data=section,2
data=text,"Attempt to cut a branch from the Dramen tree. Be prepared for a Tree Spirit (level 101) to appear, which you can safespot behind nearby fungus."
data=loc,dramentree
data=coord,0_44_152_45_7

[questhelper_step_zanaris_10]
table=questhelper_step
data=id,67010
data=section,2
data=text,Kill the Tree Spirit. They can be safespotted behind nearby fungi to the east.
data=npc,tree_spirit
data=coord,0_44_152_43_6

[questhelper_step_zanaris_11]
table=questhelper_step
data=id,67011
data=section,2
data=text,Cut at least one branch from the Dramen tree. It's recommended you cut at least 4 branches so you don't have to return in future quests.
data=loc,dramentree
data=coord,0_44_152_45_7

[questhelper_step_zanaris_12]
table=questhelper_step
data=id,67012
data=section,2
data=text,"Teleport away with the branches, preferably to Lumbridge."
data=item,dramen_branch,1

[questhelper_step_zanaris_13]
table=questhelper_step
data=id,67013
data=section,3
data=text,Use a knife on the dramen branch to craft a dramen staff.

[questhelper_step_zanaris_14]
table=questhelper_step
data=id,67014
data=section,3
data=text,Enter the shed south of Lumbridge with your Dramen Staff equipped.
data=loc,zanarisdoor
data=coord,0_50_49_2_33
