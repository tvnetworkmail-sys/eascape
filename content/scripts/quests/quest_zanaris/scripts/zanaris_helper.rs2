    return(1);
}
return(1);

[proc,qh_zanaris_c1]()(boolean)
if (inzone(0_44_151_1_58, 0_44_152_63_56, coord) = true) return(true);
return(false);

[proc,qh_zanaris_c2]()(boolean)
if (calc(inv_total(inv, dramen_staff) + inv_total(worn, dramen_staff)) >= 1) return(true);
return(false);

[proc,qh_zanaris_c3]()(boolean)
if (~qh_zanaris_c1 = false) return(false);
if (~qh_zanaris_c2 = false) return(false);
return(true);

[proc,qh_zanaris_c4]()(boolean)
if (calc(inv_total(inv, dramen_staff) + inv_total(worn, dramen_staff)) >= 1) return(true);
return(false);

[proc,qh_zanaris_c5]()(boolean)
if (calc(inv_total(inv, dramen_branch) + inv_total(worn, dramen_branch)) >= 1) return(true);
return(false);

[proc,qh_zanaris_c6]()(boolean)
if (~qh_zanaris_c1 = false) return(false);
if (~qh_zanaris_c5 = false) return(false);
return(true);

[proc,qh_zanaris_c7]()(boolean)
