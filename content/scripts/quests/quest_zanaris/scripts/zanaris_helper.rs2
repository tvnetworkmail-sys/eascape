        return(7);
    }
    if (~qh_zanaris_c10 = true) {
        return(6);
    }
    return(5);
}
if ($v >= 3) {
    if (~qh_zanaris_c3 = true) {
        return(12);
    }
    if (~qh_zanaris_c4 = true) {
        return(14);
    }
    if (~qh_zanaris_c6 = true) {
        return(12);
    }
    if (~qh_zanaris_c7 = true) {
        return(13);
    }
    if (~qh_zanaris_c9 = true) {
        return(11);
    }
    if (~qh_zanaris_c1 = true) {
        return(7);
    }
    if (~qh_zanaris_c10 = true) {
        return(6);
    }
    return(5);
}
if ($v >= 2) {
    if (~qh_zanaris_c12 = true) {
