return(false);

[proc,qh_zanaris_c9]()(boolean)
if (~qh_zanaris_c1 = false) return(false);
if (~qh_zanaris_c8 = false) return(false);
return(true);

[proc,qh_zanaris_c10]()(boolean)
if (inzone(0_43_51_46_63, 1_44_53_62_2, coord) = true) return(true);
return(false);

[proc,qh_zanaris_c11]()(boolean)
if (npc_find(coord, tree_spirit, 15, 0) = true) return(true);
return(false);

[proc,qh_zanaris_c12]()(boolean)
if (~qh_zanaris_c1 = false) return(false);
if (~qh_zanaris_c11 = false) return(false);
return(true);

[proc,qh_zanaris_c13]()(boolean)
