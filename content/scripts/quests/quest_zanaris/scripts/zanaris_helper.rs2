[proc,questhelper_zanaris]()(int)
def_int $v = %zanaris;
if ($v > 5) {
    return(0); // done
}
if ($v >= 5) {
    if (~qh_zanaris_c3 = true) {
        return(12);
    }
    if (~qh_zanaris_c4 = true) {
        return(14);
    }
    if (~qh_zanaris_c6 = true) {
