// EASCape: ours. Mourning's End Part II's own state. The cache's mourning_quest_part2 (the stage,
// Arianwyn, the collector's tray and the chests) and mourning_part2_basevar2 (Thorgel's first 21
// items, the rope, the black door, the safeguards) hold the rest; the beams and light doors
// (mourning_quest_beams1-6, vert_beams1-5, beam_cross1-2, light_doors) are worked out again from
// these at login.

// what is in each pillar of the light maze: 31 slots of four bits (mourning2.enum's me2_slot)
[me2_pillars1]
scope=perm

[me2_pillars2]
scope=perm

[me2_pillars3]
scope=perm

[me2_pillars4]
scope=perm

// Thorgel's list: items 22-50 handed in (bit n-22); the cache's mourning_dwarf_* varbits hold 1-21
[me2_list]
scope=perm

// Thorgel's list: which ticket (bits 0-1), book (2-3) and key (4-5) he asked for this time
[me2_picks]
scope=perm

// where you stood last tick by the temple's front door (the crystal trinket's check)
[me2_lastx]
scope=perm
