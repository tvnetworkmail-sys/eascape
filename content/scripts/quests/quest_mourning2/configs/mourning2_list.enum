// EASCape: ours (quest_mourning2).
// Thorgel's list (the RS and OSRS wikis' 50 items). Ours: the order - the 21 the cache names in
// mourning_part2_basevar2 (mourning_dwarf_rune ... _tomato) first, in its bit order, then the rest
// as the wikis list them; the 48th is a ticket, the 49th a book and the 50th a key, one of three
// each at random (me2_list_ticket/book/key).
[me2_list_obj]
inputtype=int
outputtype=namedobj
default=null
val=1,blankrune_high
val=2,lobster_pot
val=3,fishing_rod
val=4,tinderbox
val=5,lockpick
val=6,bronze_med_helm
val=7,white_apron
val=8,jug_wine
val=9,kebab
val=10,leather_boots
val=11,swamppaste
val=12,redberries
val=13,cheese
val=14,vial_water
val=15,flax
val=16,gold_ring
val=17,egg
val=18,leather_gloves
val=19,cake_tin
val=20,necklace_mould
val=21,rotten_tomato
val=22,babydragon_bones
val=23,ball_of_wool
val=24,bronze_bar
val=25,bucket_milk
val=26,chisel
val=27,cooked_meat
val=28,slayer_facemask
val=29,hammer
val=30,iron_axe
val=31,nails_iron
val=32,iron_pickaxe
val=33,knife
val=34,needle
val=35,oak_logs
val=36,piedish
val=37,woodplank
val=38,pot_flour
val=39,cactus_potato
val=40,sack_potato_10
val=41,rope
val=42,shears
val=43,skull
val=44,spade
val=45,thread
val=46,unicorn_horn_dust
val=47,white_berries

[me2_list_ticket]
inputtype=int
outputtype=namedobj
default=null
val=0,archery_ticket
val=1,agilityarena_ticket
val=2,castlewars_ticket

[me2_list_book]
inputtype=int
outputtype=namedobj
default=null
val=0,barrows_book_history
val=1,elemental_workshop_shield_book
val=2,mourning_book1

[me2_list_key]
inputtype=int
outputtype=namedobj
default=null
val=0,jail_key
val=1,dusty_key
val=2,witches_doorkey

