// Mourning's End Part II (17 October 2005). The stage is the 377 cache's own %mourning_quest_main
// (bits 0-7 of mourning_quest_part2). The numbers are ours (no source gives them); the steps are the
// RS wiki's transcript (the 2005 words: the Head Mourner, Eluned's copy, Thorgel) and the OSRS and
// RS wikis' guides.
^me2_not_started = 0
^me2_started = 10       // the Head Mourner gave you the new key: find the dig team
^me2_found_team = 20    // you found the dig team at the temple: tell Arianwyn
^me2_sample = 30        // Arianwyn wants a sample of the darkened crystal
^me2_eluned = 40        // Eluned is here: hand her the blackened crystal
^me2_eluned_making = 45 // she has it
^me2_new_crystal = 50   // she gave you the newly made crystal: ask Arianwyn
^me2_altar = 60         // power it on the altar, then put it with the other shards
^me2_powered = 70       // it is powered
^me2_restored = 80      // the safeguards are restored: tell Arianwyn
^me2_complete = 100
^me2_questpoints = 2

// the light maze. Directions (mourning2.enum's me2_edge): 1 north, 2 east, 3 south, 4 west, 5 up,
// 6 down. Colours: the cache's multiloc order on every beam loc.
^me2_n = 1
^me2_e = 2
^me2_s = 3
^me2_w = 4
^me2_up = 5
^me2_down = 6
^me2_red = 1
^me2_yellow = 2
^me2_green = 3
^me2_cyan = 4
^me2_blue = 5
^me2_magenta = 6
^me2_white = 7

// what is in a pillar (ours): 0 nothing, 1-6 a mirror facing that way, then the crystals
^me2_held_yellow = 7
^me2_held_cyan = 8
^me2_held_blue = 9
^me2_held_fractured1 = 10 // the clear side north (the OSRS wiki's "horizontal" one, Void's 6646)
^me2_held_fractured2 = 11 // the clear side east (the "vertical" one, Void's 6647)
^me2_held_green = 12      // fused into the middle floor's pillar 10 (the RS wiki)
^me2_held_magenta = 13    // fused into the top floor's pillar 2 (the RS wiki)

// the nodes the scripts name (mourning2.enum)
^me2_node_source = 49     // the middle floor's pillar 9, over the temple's great crystal
^me2_node_final = 20
^me2_node_green = 50
^me2_node_magenta = 62
^me2_node_1_1 = 21        // the three mirrors already in place (the OSRS wiki: mirrors #8, #9, #14)
^me2_node_1_13 = 33
^me2_node_1_b = 38
^me2_wall = 99

// the light doors (me2_light_gen.rs2's me2_door_set)
^me2_door_1_c = 11

// the chests: the cache's mourning_temple_parts_2-6 (parts_1: ours, the collector's first load)
// the RS wiki's transcript: what each holds
^me2_mirrors_start = 4

// places
^me2_digteam_x = 1927     // ours: the dig team's corpses come into view west of here
^me2_handhold_west = 1_29_72_45_4
^me2_handhold_east = 1_29_72_55_4
^me2_handhold_fall = 0_29_72_50_5   // ours: the hallway below (the RS wiki: full of shadows)
^me2_rope_top = 1_29_72_19_12       // ours: beside the rock
^me2_rope_bottom = 0_29_72_22_12    // ours: beside the rope
^me2_tunnel_temple = 0_29_72_2_31   // ours: inside the hole in the back wall
^me2_tunnel_upass = 0_36_153_7_1    // ours: beside the dwarves' tunnel (the cache's cavewalltunnel_to_temple)
^me2_front_door_x = 1917            // the temple's front door (the map's light door frame)
