// EASCape: generated (me2gen/gen.py): the beam varbits by index (me2_edge's seg1/seg2), the cross
// points' varbits, and the light doors. Colours are the cache's multiloc order: 1 red, 2 yellow,
// 3 green, 4 cyan, 5 blue, 6 magenta, 7 white.
[proc,me2_seg](int $seg, int $colour)
switch_int ($seg) {
    case 1 : %mourning_light_temple_1_1_east = $colour;
    case 2 : %mourning_light_temple_1_1_south = $colour;
    case 3 : %mourning_light_temple_1_3_west = $colour;
    case 4 : %mourning_light_temple_1_3_east = $colour;
    case 5 : %mourning_light_temple_1_3_6 = $colour;
    case 6 : %mourning_light_temple_1_6_west = $colour;
    case 7 : %mourning_light_temple_1_6_7 = $colour;
    case 8 : %mourning_light_temple_1_6_11 = $colour;
    case 9 : %mourning_light_temple_1_10_11 = $colour;
    case 10 : %mourning_light_temple_1_10_14 = $colour;
    case 11 : %mourning_light_temple_1_11_12 = $colour;
    case 12 : %mourning_light_temple_1_11_south = $colour;
    case 13 : %mourning_light_temple_1_13_north = $colour;
    case 14 : %mourning_light_temple_1_13_east = $colour;
    case 15 : %mourning_light_temple_1_14_east = $colour;
    case 16 : %mourning_light_temple_1_14_west = $colour;
    case 17 : %mourning_light_temple_1_16_north = $colour;
    case 18 : %mourning_light_temple_1_16_west = $colour;
    case 19 : %mourning_light_temple_1_b_east = $colour;
    case 20 : %mourning_light_temple_1_b_west = $colour;
    case 21 : %mourning_light_temple_1_d_west = $colour;
    case 22 : %mourning_light_temple_2_2_west = $colour;
    case 23 : %mourning_light_temple_2_2_3 = $colour;
    case 24 : %mourning_light_temple_2_2_5 = $colour;
    case 25 : %mourning_light_temple_2_3_east = $colour;
    case 26 : %mourning_light_temple_2_3_south = $colour;
    case 27 : %mourning_light_temple_2_5_6 = $colour;
    case 28 : %mourning_light_temple_2_6_north = $colour;
    case 29 : %mourning_light_temple_2_6_7 = $colour;
    case 30 : %mourning_light_temple_2_6_11 = $colour;
    case 31 : %mourning_light_temple_2_7_9 = $colour;
    case 32 : %mourning_light_temple_2_9_south = $colour;
    case 33 : %mourning_light_temple_2_11_west = $colour;
    case 34 : %mourning_light_temple_2_11_east = $colour;
    case 35 : %mourning_light_temple_2_11_15 = $colour;
    case 36 : %mourning_light_temple_2_15_east = $colour;
    case 37 : %mourning_light_temple_2_15_west = $colour;
    case 38 : %mourning_light_temple_2_16_north = $colour;
    case 39 : %mourning_light_temple_2_16_west = $colour;
    case 40 : %mourning_light_temple_3_1_2 = $colour;
    case 41 : %mourning_light_temple_3_1_8 = $colour;
    case 42 : %mourning_light_temple_3_2_3 = $colour;
    case 43 : %mourning_light_temple_3_2_5 = $colour;
    case 44 : %mourning_light_temple_3_3_east = $colour;
    case 45 : %mourning_light_temple_3_3_south = $colour;
    case 46 : %mourning_light_temple_3_5_6 = $colour;
    case 47 : %mourning_light_temple_3_5_west = $colour;
    case 48 : %mourning_light_temple_3_6_north = $colour;
    case 49 : %mourning_light_temple_3_6_east = $colour;
    case 50 : %mourning_light_temple_3_6_11 = $colour;
    case 51 : %mourning_light_temple_3_8_east = $colour;
    case 52 : %mourning_light_temple_3_8_13 = $colour;
    case 53 : %mourning_light_temple_3_10_11 = $colour;
    case 54 : %mourning_light_temple_3_10_south = $colour;
    case 55 : %mourning_light_temple_3_10_west = $colour;
    case 56 : %mourning_light_temple_3_11_12 = $colour;
    case 57 : %mourning_light_temple_3_11_15 = $colour;
