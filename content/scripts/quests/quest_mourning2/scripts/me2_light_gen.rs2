    case 98 : %mourning_light_temple_2_14_up = $colour;
    case 99 : %mourning_light_temple_3_14_up = $colour;
    case 100 : %mourning_light_temple_2_15_up = $colour;
    case 101 : %mourning_light_temple_3_15_up = $colour;
    case 102 : %mourning_light_temple_2_16_up = $colour;
    case 103 : %mourning_light_temple_3_16_up = $colour;
}

// a cross point: 1-7 a north-south beam, 8-14 east-west, 15-21 up-down, 22-28 crossed (the cache's
// multilocs); $class 0 north-south, 7 east-west, 14 up-down
[proc,me2_cross_mark](int $node, int $class, int $colour)
def_int $v = 0;
switch_int ($node) {
    case 22 : $v = %mourning_pillar_light_cross_1_2;
    case 25 : $v = %mourning_pillar_light_cross_1_5;
    case 35 : $v = %mourning_pillar_light_cross_1_15;
    case 41 : $v = %mourning_pillar_light_cross_2_1;
    case 52 : $v = %mourning_pillar_light_cross_2_12;
    case 53 : $v = %mourning_pillar_light_cross_2_13;
    case 54 : $v = %mourning_pillar_light_cross_2_14;
    case 64 : $v = %mourning_pillar_light_cross_3_4;
    case 67 : $v = %mourning_pillar_light_cross_3_7;
    case 74 : $v = %mourning_pillar_light_cross_3_14;
}
def_int $new = add($class, $colour);
if ($v > 0 & $v <= 14 & $class < 14) {
    if (($v <= 7 & $class = 7) | ($v > 7 & $class = 0)) $new = add(21, $colour);
}
if ($v > 21) $new = $v;
switch_int ($node) {
    case 22 : %mourning_pillar_light_cross_1_2 = $new;
    case 25 : %mourning_pillar_light_cross_1_5 = $new;
    case 35 : %mourning_pillar_light_cross_1_15 = $new;
    case 41 : %mourning_pillar_light_cross_2_1 = $new;
    case 52 : %mourning_pillar_light_cross_2_12 = $new;
    case 53 : %mourning_pillar_light_cross_2_13 = $new;
    case 54 : %mourning_pillar_light_cross_2_14 = $new;
    case 64 : %mourning_pillar_light_cross_3_4 = $new;
    case 67 : %mourning_pillar_light_cross_3_7 = $new;
    case 74 : %mourning_pillar_light_cross_3_14 = $new;
}

[proc,me2_door_set](int $door, int $open)
switch_int ($door) {
    case 1 : %mourning_door_1_1_south = $open;
    case 2 : %mourning_door_1_1_east = $open;
    case 3 : %mourning_door_1_13_north = $open;
    case 4 : %mourning_door_1_13_east = $open;
    case 5 : %mourning_door_1_16_north = $open;
    case 6 : %mourning_door_1_16_west = $open;
    case 7 : %mourning_door_2_4_west = $open;
    case 8 : %mourning_door_2_16_north = $open;
    case 9 : %mourning_door_2_16_west = $open;
    case 10 : %mourning_door_1_b = $open;
    case 11 : %mourning_door_1_c = $open;
}

[proc,me2_door_open](int $door)(int)
switch_int ($door) {
    case 1 : return(%mourning_door_1_1_south);
    case 2 : return(%mourning_door_1_1_east);
    case 3 : return(%mourning_door_1_13_north);
    case 4 : return(%mourning_door_1_13_east);
    case 5 : return(%mourning_door_1_16_north);
    case 6 : return(%mourning_door_1_16_west);
    case 7 : return(%mourning_door_2_4_west);
    case 8 : return(%mourning_door_2_16_north);
    case 9 : return(%mourning_door_2_16_west);
    case 10 : return(%mourning_door_1_b);
    case 11 : return(%mourning_door_1_c);
}
return(0);

