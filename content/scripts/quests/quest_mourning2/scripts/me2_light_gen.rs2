    case 81 : %mourning_light_temple_3_5_up = $colour;
    case 82 : %mourning_light_temple_2_6_up = $colour;
    case 83 : %mourning_light_temple_3_6_up = $colour;
    case 84 : %mourning_light_temple_2_7_up = $colour;
    case 85 : %mourning_light_temple_3_7_up = $colour;
    case 86 : %mourning_light_temple_2_8_up = $colour;
    case 87 : %mourning_light_temple_3_8_up = $colour;
    case 88 : %mourning_light_temple_2_9_up = $colour;
