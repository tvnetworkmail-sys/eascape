// the pillars where the light turns down from the top floor and towards the final pillar below
// (the RS wiki: mirrors fused into place)
[oploc1,mourning_temple_pillar_3_a] ~me2_fused_mirror;

[oplocu,mourning_temple_pillar_1_1] ~me2_pillar_use(21, last_useitem, last_useslot);
[oplocu,mourning_temple_pillar_1_3] ~me2_pillar_use(23, last_useitem, last_useslot);
[oplocu,mourning_temple_pillar_1_6] ~me2_pillar_use(26, last_useitem, last_useslot);
[oplocu,mourning_temple_pillar_1_7] ~me2_pillar_use(27, last_useitem, last_useslot);
[oplocu,mourning_temple_pillar_1_10] ~me2_pillar_use(30, last_useitem, last_useslot);
[oplocu,mourning_temple_pillar_1_11] ~me2_pillar_use(31, last_useitem, last_useslot);
