// EASCape: Mourning's End Part II - the Mourner tunnels and the Temple of Light: the dig team, the
// blackened crystal, the crystal collector and its tray, the pillars of light, the light doors, the
// chests, the wall supports, the rope, the low walls, the dwarves' tunnel and the front door.
// Words: the RS wiki's transcript (2005, "Head Mourner") and the OSRS wiki's where the RS one has
// none; the places are the 377 map's (m29_72, m30_72).

// ---------------------------------------------------------------- the dig team (the RS wiki: the
// camera pans over the dead guards and slaves; ours: it happens as you reach their bodies, with
// no camera)
[zone,0_30_72_0_24] ~me2_digteam_check;
[zone,0_30_72_0_32] ~me2_digteam_check;
[zone,0_30_72_8_24] ~me2_digteam_check;
[zone,0_30_72_8_32] ~me2_digteam_check;

[proc,me2_digteam_check]
if (%mourning_quest_main = ^me2_started) queue(me2_digteam, 0, 0);

[queue,me2_digteam]
if (%mourning_quest_main ! ^me2_started) return;
~me2_set(^me2_found_team);
~chatplayer("<p,neutral>Well, this looks like the digteam. I should hurry and tell Arianwyn. I'd better make sure that the Head Mourner doesn't find out.");

// the guard against the northern wall is Nissyen Edern (the OSRS wiki); in 2005 he had both the
// colour wheel and his journal (the RS wiki's transcript)
[oploc1,mourning_dead_guard1]
def_int $wheel = ~obj_gettotal(mourning_colour_wheel);
def_int $journal = ~obj_gettotal(mourning_ederns_journal);
if ($wheel > 0 & $journal > 0) {
    ~mesbox("The dead mourner has nothing other than the journal and colour wheel which you've taken.");
    return;
}
def_int $need = 0;
if ($wheel = 0) $need = add($need, 1);
if ($journal = 0) $need = add($need, 1);
if (inv_freespace(inv) < $need) {
    // the OSRS wiki's words for a full pack
    ~mesbox("You find something but you don't have enough room to take it.");
    return;
}
if ($wheel = 0 & $journal = 0) {
    inv_add(inv, mourning_colour_wheel, 1);
    inv_add(inv, mourning_ederns_journal, 1);
    ~doubleobjbox(mourning_colour_wheel, mourning_ederns_journal, "You find a colour wheel and a journal.", 250);
    return;
}
if ($wheel = 0) {
    inv_add(inv, mourning_colour_wheel, 1);
    ~objbox(mourning_colour_wheel, "You find a colour wheel.", 250, 0, divide(^objbox_height, 2));
    return;
}
inv_add(inv, mourning_ederns_journal, 1);
~objbox(mourning_ederns_journal, "You find a journal.", 250, 0, divide(^objbox_height, 2));

[oploc1,mourning_dead_guard2] ~mesbox("The man died with nothing.");
[oploc1,mourning_dead_guard3] ~mesbox("The man died with nothing.");
[oploc1,mourning_dead_slave1] ~mesbox("The man died with nothing.");
[oploc1,mourning_dead_slave2] ~mesbox("The man died with nothing.");

// ---------------------------------------------------------------- the blackened crystal (top
// floor, over the entrance)
[oploc1,mourning_temple_obsidian_crystal]
if (%mourning_light_temple_safe_guards = 1) {
    ~mesbox("The crystal seems intact and is successfully powering the temple's safeguards.");
    return;
}
~mesbox("There are many blackened crystal shards here.");
if (~p_choice2_header("Try to chisel a shard off the crystal.", 1, "Leave the crystal alone.", 2, "What do you want to do?") = 2) return;
~me2_chip;

[oplocu,mourning_temple_obsidian_crystal]
if (last_useitem = chisel & %mourning_light_temple_safe_guards = 0) {
    ~me2_chip;
    return;
}
if (last_useitem = mourning_crystal_new_powered & %mourning_light_temple_safe_guards = 0) {
    inv_del(inv, mourning_crystal_new_powered, 1);
    %mourning_light_temple_safe_guards = 1;
    if (%mourning_quest_main < ^me2_restored) ~me2_set(^me2_restored);
    ~objbox(mourning_crystal_new_powered, "You place the powered crystal amongst the other shards.", 250, 0, divide(^objbox_height, 2));
    mes("Nothing interesting happens."); // the RS wiki: it always says so
    return;
}
~displaymessage(^dm_default);

[proc,me2_chip]
if (inv_total(inv, chisel) = 0) {
    // the OSRS wiki
    ~mesbox("There are many blackened crystal shards here. They are firmly attached. You'll need something suitable to chip one off.");
    return;
}
if (~obj_gettotal(mourning_crystal_sample) > 0 | %mourning_quest_main >= ^me2_eluned_making | %mourning_quest_main < ^me2_started) {
    ~mesbox("There are many blackened crystal shards here, but you have no need for them.");
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough room to carry a shard."); // ours
    return;
}
inv_add(inv, mourning_crystal_sample, 1);
~objbox(mourning_crystal_sample, "You chip off one of the many blackened crystal shards that are here.", 250, 0, divide(^objbox_height, 2));

// ---------------------------------------------------------------- the crystal collector (the RS
// wiki: pulling the lever returns every mirror and crystal; the tray then holds them all, so
// anything lost can be had again). The tray is the cache's mourning_temple_*_reset_tray; ours:
// its orange bit is the yellow crystal and its red bit the cyan one.
[oploc1,mourning_temple_light_wall_lever]
loc_anim(mourning_temple_lever);
mes("You pull the lever.");
~me2_clear_pillars;
%mourning_temple_parts_1 = 1;
def_int $mirrors = calc(^me2_mirrors_start + 2 * %mourning_temple_parts_2 + 2 * %mourning_temple_parts_3 + 2 * %mourning_temple_parts_5 + 3 * %mourning_temple_parts_6);
$mirrors = sub($mirrors, inv_total(inv, mourning_mirror));
if ($mirrors < 0) $mirrors = 0;
%mourning_temple_mirrors_reset_tray = $mirrors;
%mourning_temple_orange_crystal_reset_tray = 0;
if (inv_total(inv, mourning_crystal_yellow) = 0) %mourning_temple_orange_crystal_reset_tray = 1;
%mourning_temple_red_crystal_reset_tray = 0;
if (%mourning_temple_parts_2 = 1 & inv_total(inv, mourning_crystal_cyan) = 0) %mourning_temple_red_crystal_reset_tray = 1;
%mourning_temple_blue_crystal_reset_tray = 0;
if (%mourning_temple_parts_4 = 1 & inv_total(inv, mourning_crystal_blue) = 0) %mourning_temple_blue_crystal_reset_tray = 1;
%mourning_temple_fractured_crystal_1_reset_tray = 0;
if (%mourning_temple_parts_5 = 1 & inv_total(inv, mourning_fractured_crystal_1) = 0) %mourning_temple_fractured_crystal_1_reset_tray = 1;
%mourning_temple_fractured_crystal_2_reset_tray = 0;
if (%mourning_temple_parts_6 = 1 & inv_total(inv, mourning_fractured_crystal_2) = 0) %mourning_temple_fractured_crystal_2_reset_tray = 1;
~me2_light_update;

[proc,me2_tray_crystals]()(int)
return(calc(%mourning_temple_orange_crystal_reset_tray + %mourning_temple_red_crystal_reset_tray + %mourning_temple_blue_crystal_reset_tray + %mourning_temple_fractured_crystal_1_reset_tray + %mourning_temple_fractured_crystal_2_reset_tray));

[oploc1,mourning_temple_light_wall_collector]
def_int $m = %mourning_temple_mirrors_reset_tray;
def_int $c = ~me2_tray_crystals;
if ($m = 0 & $c = 0) {
    ~mesbox("There is nothing in the tray.");
    return;
}
def_int $choice = 4;
if ($m > 0 & $c > 0) {
    $choice = ~p_choice4_header("Take the mirrors.", 1, "Take the crystals.", 2, "Take all the items.", 3, "Leave all the items.", 4, "There are mirrors and crystals in the tray...");
} else if ($c > 0) {
    $choice = ~p_choice2_header("Take the crystals.", 2, "Leave the crystals.", 4, "There are only crystals in the tray...");
} else {
    $choice = ~p_choice2_header("Take the mirrors.", 1, "Leave the mirrors", 4, "There are only mirrors in the tray...");
}
if ($choice = 4) {
    ~mesbox("You leave the items in the tray.");
    return;
}
def_boolean $all = true;
if ($choice = 1 | $choice = 3) {
    while (%mourning_temple_mirrors_reset_tray > 0 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_mirror, 1);
        %mourning_temple_mirrors_reset_tray = sub(%mourning_temple_mirrors_reset_tray, 1);
    }
    if (%mourning_temple_mirrors_reset_tray > 0) $all = false;
}
if ($choice = 2 | $choice = 3) {
    if (%mourning_temple_orange_crystal_reset_tray = 1 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_crystal_yellow, 1);
        %mourning_temple_orange_crystal_reset_tray = 0;
    }
    if (%mourning_temple_red_crystal_reset_tray = 1 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_crystal_cyan, 1);
        %mourning_temple_red_crystal_reset_tray = 0;
    }
    if (%mourning_temple_blue_crystal_reset_tray = 1 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_crystal_blue, 1);
        %mourning_temple_blue_crystal_reset_tray = 0;
    }
    if (%mourning_temple_fractured_crystal_1_reset_tray = 1 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_fractured_crystal_1, 1);
        %mourning_temple_fractured_crystal_1_reset_tray = 0;
    }
    if (%mourning_temple_fractured_crystal_2_reset_tray = 1 & inv_freespace(inv) > 0) {
        inv_add(inv, mourning_fractured_crystal_2, 1);
        %mourning_temple_fractured_crystal_2_reset_tray = 0;
    }
    if (~me2_tray_crystals > 0) $all = false;
}
switch_int ($choice) {
    case 1 : ~mesbox("You take the mirrors from the tray.");
    case 2 : ~mesbox("You take the crystals from the tray.");
    case 3 : ~mesbox("You take the items from the tray.");
}
if ($all = false) mes("You don't have enough room for the rest; they are still in the tray."); // ours

// ---------------------------------------------------------------- the pillars of light (the RS
// wiki's transcript; ours: a choice of ways in place of the rotation window, which the 377 cache
// doesn't have)
[oploc1,mourning_temple_pillar_1_1] ~me2_pillar_search(21);
[oploc1,mourning_temple_pillar_1_3] ~me2_pillar_search(23);
[oploc1,mourning_temple_pillar_1_6] ~me2_pillar_search(26);
