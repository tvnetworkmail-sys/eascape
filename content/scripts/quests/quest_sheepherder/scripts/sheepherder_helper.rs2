// EASCape: Quest Helper for Sheep Herder, converted from RuneLite's Quest Helper (sheepherder, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   ItemOnTileRequirement not carried over
//   NPC COUNCILLOR_HALGRIVE_VIS not matched
//   eq not carried over

[proc,questhelper_sheepherder]()(int)
def_int $v = %sheepherderquest;
if ($v > 2) {
    return(0); // done
}
if ($v >= 2) {
    if (~qh_sheepherder_c9 = true) {
        return(11);
    }
    if (~qh_sheepherder_c14 = true) {
        return(9);
    }
    if (~qh_sheepherder_c16 = true) {
        return(8);
    }
    if (~qh_sheepherder_c17 = true) {
        return(7);
    }
    if (~qh_sheepherder_c18 = true) {
        return(6);
    }
    if (~qh_sheepherder_c15 = true) {
        return(5);
    }
    if (~qh_sheepherder_c19 = true) {
        return(4);
    }
    return(3);
}
if ($v >= 1) {
    return(2);
}
if ($v >= 0) {
    return(1);
}
return(1);

[proc,qh_sheepherder_c1]()(boolean)
if (calc(inv_total(inv, sheepbonesc) + inv_total(worn, sheepbonesc)) >= 1) return(true);
return(false);

[proc,qh_sheepherder_c2]()(boolean)
if (~qh_sheepherder_c1 = true) return(true);
return(false);

[proc,qh_sheepherder_c3]()(boolean)
if (calc(inv_total(inv, sheepbonesd) + inv_total(worn, sheepbonesd)) >= 1) return(true);
return(false);

