// EASCape: Quest Helper for Elemental Workshop I, converted from RuneLite's Quest Helper (elementalworkshopi, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC ELEM1_QIP_EARTH_ELEMENTAL_ROCK_VERSION not matched
//   NPC ELEM1_QIP_EARTH_ELEMENTAL_ROCK_VERSION_ROCK not matched

[proc,questhelper_elemental_workshop]()(int)
def_int $v = %elemental_workshop_bits;
if ($v > 0) {
    return(0); // done
}
return(1);
