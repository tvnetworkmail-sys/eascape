// EASCape: ours. The cache's own ratcatch varps hold the quest; these hold what a fight and the
// rat pits need while they last (not perm, so a login clears them), and the mansion checkpoint.

// the King rat, or the pit rat your cat is fighting
[rc_foe_uid]
type=npc_uid
scope=temp
protect=no

// your cat's hitpoints in a fight (the OSRS wiki's cat stats)
[rc_cat_hp]
scope=temp

// the King rat's hitpoints
[rc_foe_hp]
scope=temp

// the mansion checkpoint the directions and the guards send you to (^rc_cp_)
[rc_checkpoint]
scope=perm
protect=no

// the rat pits: who you challenged or are fighting, the bet, your cat's kills, the state, the
// tactic you gave your cat, and when your cat tires (also the mansion's grace after being spotted)
[rc_pit_opp]
type=player_uid
scope=temp
protect=no

[rc_pit_bet]
scope=temp
protect=no

[rc_pit_kills]
scope=temp
protect=no

[rc_pit_state]
scope=temp
protect=no

[rc_pit_tactic]
scope=temp
protect=no

[rc_fight_clock]
scope=temp
protect=no
