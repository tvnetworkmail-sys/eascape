// EASCape: ours. The chasms' floor (m29_77, level 1): the cache's invisible_occ (an invisible
// overlay), but not occluding, so the client draws what stands below it: the track supports and
// the islands' rock (tools/forgettable_tale/chasm.py).
[ft_chasm_invisible]
overlay=yes
colour=0xff00ff
occlude=no
