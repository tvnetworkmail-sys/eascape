// EASCape: ours. What the rowdy dwarf asked you to get (1-24, ft_seeds.rs2) and when (map_clock).
[ft_rowdy_item]
scope=perm

[ft_rowdy_when]

// EASCape: ours. Where the cart is (a node of the chasm's track, ft_puzzle.rs2) while you are out
// on it: x and z in the track map's own units, with 1 added so 0 means "at the start".
[ft_cart_at]

// EASCape: ours. The locs spawned for you at the far end of a cart ride (the box and the cart back).
[ft_ride_box]
type=coord

[ft_ride_cart]
type=coord

// EASCape: ours. Forgettable Tale's other progress (forgettable_tale.constant ^ftf_ bits).
[ft_flags]
scope=perm

// EASCape: ours. The bookcase in the Red Axe's records room that had the employee records.
[ft_bookcase]
type=coord
scope=perm
