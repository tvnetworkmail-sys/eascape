// EASCape: generated by tools/forgettable_tale/chasm.py. The railways over the three chasms and
// the cart's way along them. Ours: the layout (the cache's map has no track over the chasm; the
// track maps are ft_tracks.rs2's, laid with the cache's track pieces; chasm.py says how).

// how many track pieces a chasm has
[proc,ft_track_count](int $room)(int)
switch_int ($room) {
    case 1 : return(291);
    case 2 : return(438);
    case 3 : return(604);
}
return(0);

// a chasm's track piece $i (0 up): its square, loc, angle and shape
[proc,ft_track_piece](int $room, int $i)(coord, loc, int, locshape)
