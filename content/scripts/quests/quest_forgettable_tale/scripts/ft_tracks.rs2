// EASCape: generated by tools/forgettable_tale/tracks.py from the cache's puzzle interfaces
// (inter_179, inter_180, inter_288: each junction's green and yellow ways are its own models, whose
// ends give where each way goes). The boxes, the exit and the dead ends are the OSRS wiki's
// solution pictures. A target is a junction (1-19), ^ft_exit, ^ft_box1, ^ft_box2, ^ft_top or
// ^ft_dead; x and z are in the track map's units (96 between junctions).

[proc,ft_jnode](int $room, int $j)(int, int)
switch_int (calc($room * 100 + $j)) {
    case 101 : return(-240, 0);
    case 102 : return(-144, 96);
    case 103 : return(-144, -96);
    case 104 : return(48, 192);
    case 105 : return(48, 96);
    case 106 : return(-48, -192);
    case 107 : return(48, -96);
    case 108 : return(144, -192);
    case 201 : return(-288, 0);
    case 202 : return(-192, 96);
    case 203 : return(-192, -96);
    case 204 : return(-96, 192);
    case 205 : return(-96, 96);
    case 206 : return(-96, -192);
    case 207 : return(0, 288);
    case 208 : return(0, -288);
    case 209 : return(96, 192);
    case 210 : return(96, 96);
    case 211 : return(96, -192);
    case 212 : return(192, 96);
    case 301 : return(-384, 0);
    case 302 : return(-288, 96);
    case 303 : return(-288, -96);
    case 304 : return(-192, 192);
    case 305 : return(-192, -96);
    case 306 : return(-96, 192);
    case 307 : return(-96, -192);
    case 308 : return(0, 288);
    case 309 : return(0, -96);
    case 310 : return(0, -192);
    case 311 : return(96, 192);
    case 312 : return(96, 0);
    case 313 : return(96, -192);
    case 314 : return(192, 288);
    case 315 : return(192, 96);
    case 316 : return(192, -288);
    case 317 : return(288, 192);
    case 318 : return(288, -96);
    case 319 : return(288, -192);
}
return(0, 0);

[proc,ft_edge](int $room, int $j, int $dir)(int, int, int)
switch_int (calc($room * 1000 + $j * 10 + $dir)) {
    case 1011 : return(2, -144, 96);
    case 1012 : return(3, -144, -96);
    case 1021 : return(4, 48, 192);
    case 1022 : return(5, 48, 96);
    case 1031 : return(^ft_box1, -48, 0);
    case 1032 : return(6, -48, -192);
    case 1041 : return(^ft_top, 144, 288);
    case 1042 : return(^ft_box2, 144, 96);
    case 1051 : return(^ft_box2, 144, 96);
    case 1052 : return(^ft_dead, 144, 0);
    case 1061 : return(7, 48, -96);
    case 1062 : return(^ft_dead, 48, -288);
    case 1071 : return(^ft_exit, 144, -96);
    case 1072 : return(8, 144, -192);
    case 1081 : return(^ft_dead, 240, -96);
    case 1082 : return(^ft_dead, 240, -288);
    case 2011 : return(2, -192, 96);
    case 2012 : return(3, -192, -96);
    case 2021 : return(4, -96, 192);
    case 2022 : return(5, -96, 96);
    case 2031 : return(^ft_dead, -96, 0);
    case 2032 : return(6, -96, -192);
    case 2041 : return(7, 0, 288);
    case 2042 : return(10, 96, 96);
    case 2051 : return(^ft_dead, 0, 96);
    case 2052 : return(^ft_box1, 0, 0);
    case 2061 : return(11, 96, -192);
    case 2062 : return(8, 0, -288);
    case 2071 : return(^ft_dead, 96, 288);
    case 2072 : return(9, 96, 192);
    case 2081 : return(11, 96, -192);
    case 2082 : return(^ft_dead, 96, -288);
    case 2091 : return(^ft_dead, 192, 288);
    case 2092 : return(^ft_top, 192, 192);
    case 2101 : return(12, 192, 96);
    case 2102 : return(^ft_dead, 192, 0);
    case 2111 : return(^ft_box2, 192, -96);
    case 2112 : return(^ft_dead, 192, -288);
    case 2121 : return(^ft_dead, 288, 192);
    case 2122 : return(^ft_exit, 288, 0);
    case 3011 : return(2, -288, 96);
    case 3012 : return(3, -288, -96);
    case 3021 : return(4, -192, 192);
    case 3022 : return(^ft_dead, -192, 96);
    case 3031 : return(^ft_dead, -192, 0);
    case 3032 : return(5, -192, -96);
    case 3041 : return(^ft_dead, -96, 288);
    case 3042 : return(6, -96, 192);
    case 3051 : return(^ft_dead, -96, 0);
    case 3052 : return(7, -96, -192);
    case 3061 : return(8, 0, 288);
    case 3062 : return(^ft_box1, 0, 96);
    case 3071 : return(9, 0, -96);
    case 3072 : return(10, 0, -192);
    case 3081 : return(^ft_dead, 96, 288);
    case 3082 : return(11, 96, 192);
    case 3091 : return(12, 96, 0);
    case 3092 : return(^ft_dead, 96, -96);
    case 3101 : return(13, 96, -192);
    case 3102 : return(^ft_dead, 96, -288);
    case 3111 : return(14, 192, 288);
    case 3112 : return(15, 192, 96);
    case 3121 : return(^ft_box2, 192, 0);
    case 3122 : return(18, 288, -96);
    case 3131 : return(^ft_dead, 192, -192);
    case 3132 : return(16, 192, -288);
    case 3141 : return(^ft_dead, 288, 288);
    case 3142 : return(17, 288, 192);
    case 3151 : return(^ft_dead, 288, 96);
    case 3152 : return(^ft_dead, 288, 0);
    case 3161 : return(19, 288, -192);
    case 3162 : return(^ft_dead, 288, -288);
    case 3171 : return(^ft_dead, 384, 288);
    case 3172 : return(^ft_exit, 384, 96);
    case 3181 : return(^ft_dead, 384, 0);
    case 3182 : return(^ft_dead, 384, -96);
    case 3191 : return(^ft_dead, 384, -192);
    case 3192 : return(^ft_dead, 384, -288);
}
return(^ft_dead, 0, 0);
