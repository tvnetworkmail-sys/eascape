// EASCape: Forgettable Tale: the boarded-up tunnel, the Red Axe's mines under Keldagrim (three
// chasms crossed by setting junctions with square stones, and the rooms between them) and the
// memory spell. The words are the OSRS wiki's (Transcript:Forgettable Tale..., its walkthrough for
// the puzzle rules and the boxes' stones, Transcript:Cart conductor); the places are the cache's
// map (m29_77: the chasm at level 1 with its platform at 1859-1864,4952-4961, the cart, the
// machinery and the box; the three rooms at level 2 with their cave exits, crates and bookcases),
// the puzzle screens the cache's (ft_puzzle_ui.rs2) and the track maps read off them
// (ft_tracks.rs2). Ours: the chasm has only its starting platform, so a ride takes you out over the
// abyss to the end of the track, where a box and a cart back are put for you; where on the chasm
// each track point is (the screen's map stretched over it); the cutscenes' places and camera; the
// rides' and rooms' order of stops; that the cave exits back and the cart's Return take you to
// Keldagrim. Ours is marked.

// ---------------------------------------------------------------- the cart conductor (2922,10166)
// the one nearest the boarded-up tunnel asks about it (the OSRS wiki); his [opnpc1]
// (eascape_world/eascape_world.rs2) comes here, and his other talk is the station's
[label,ft_conductor]
def_int $s = %forget_quest;
if ($s < ^ft_tale | $s >= ^ft_wiped) @keldagrim_cart_station;
if ($s >= ^ft_boards) {
    ~chatnpc("<p,neutral>Tickets, tickets, get your tickets here!"); // the RuneScape wiki's greeting
    // ours: no cart stands at the tunnel in our map, so he sends you in
    if (~p_choice2("Ride the cart into the tunnel.", 1, "Ask any other question.", 2) = 2) @keldagrim_cart_menu;
    ~chatplayer("<p,neutral>I'd like to ride the cart into the tunnel.");
    @ft_enter_mines;
}
if (~p_choice2("Ask about closed off tunnel.", 1, "Ask any other question.", 2) = 2) @keldagrim_cart_station;
if ($s = ^ft_tale) {
    ~chatplayer("<p,quiz>Excuse me, can you tell me what's behind that boarded up tunnel to the south?");
    ~chatnpc("<p,neutral>Why, that part of the mines hasn't been used in a long time. I don't rightly know what you would find behind there.");
    ~chatplayer("<p,neutral>I need to go through there. Can you open up the tunnel for me?");
    ~chatnpc("<p,neutral>I don't have the authority to do that kind of thing.");
    ~chatplayer("<p,quiz>Then who do I talk to? I really need to get in.");
    ~chatnpc("<p,neutral>I don't know. Perhaps you have an influential friend?");
    ~ft_set(^ft_conductor);
    return;
}
~chatplayer("<p,neutral>I really need to go through that tunnel.");
~chatnpc("<p,neutral>I can't help you, sorry.");
~chatplayer("<p,quiz>At least tell me who can, please?");
~chatnpc("<p,neutral>I don't know that either. Don't you have any influential friends in the city?");

// ---------------------------------------------------------------- your company's director
// the directors' label (quest_giant_dwarf/gd_consortium.rs2) comes here first when it's your
// company's director and the tunnel is still boarded up
[proc,ft_director_tunnel](int $c)(boolean)
if (%forget_quest = ^ft_conductor & $c = ~ft_company) return(true);
return(false);

[label,ft_director](int $c)
~chatnpc("<p,happy>Hello <displayname>! Have you seen the statue? It looks beautiful! It's a pity it's been overshadowed by the departure of the Red Axe.");
switch_int (~p_choice4("It's an honour to meet you!", 1, "Do you have any more tasks for me?", 2, "Can you help me with a boarded up tunnel?", 3, "Thank you for your time.", 4)) {
    case 1 :
        ~chatplayer("<p,happy>It's an honour to meet you!");
        ~chatnpc("<p,happy>Don't mention it, <displayname>!"); // one of the directors' lines (gd_director_menu)
        @gd_director_menu($c);
    case 2 : @gd_director_task($c);
    case 3 :
        ~chatplayer("<p,quiz>Can you help me with a boarded up tunnel?");
        ~chatnpc("<p,quiz>Ah, and what would be lurking behind this particular tunnel?");
        ~chatplayer("<p,neutral>I think it leads to something that might be related to the Red Axe.");
        ~chatnpc("<p,shock>The Red Axe!");
        ~chatnpc("<p,angry>This is indeed an important issue. They've gone too far this time. A major company willingly leaving the Consortium has never happened before.");
        ~chatplayer("<p,quiz>Can you help me get the boarding removed then?");
        ~chatnpc("<p,happy>Forthwith, <displayname>, forthwith! I'll order the removal at once!");
        %forget_boarding_removed = 1;
        ~ft_set(^ft_boards);
        ~chatplayer("<p,happy>Thanks! I'll investigate the tunnel immediately!");
    case 4 :
        ~chatplayer("<p,happy>Thank you for your time.");
        ~chatnpc("<p,happy>Not at all, it was a delight to speak to you once more!");
}

// ---------------------------------------------------------------- into the mines
// the OSRS wiki: both hands free to ride ("Make sure to remove any held items in your hands")
[proc,ft_hands_free]()(boolean)
if (inv_getobj(worn, ^wearpos_rhand) ! null | inv_getobj(worn, ^wearpos_lhand) ! null) {
    ~mesbox("You need both hands free to ride the cart."); // ours
    return(false);
}
return(true);

// where you go in: wherever you had got to
[label,ft_enter_mines]
if (~ft_hands_free = false) return;
def_int $s = %forget_quest;
if ($s = ^ft_boards) ~ft_set(^ft_puzzle1);
$s = %forget_quest;
if_close;
~fade_out;
p_delay(2);
~keldagrim_cart_ride(true);
p_telejump(0_45_158_46_47);
p_delay(1);
~fade_in;
~forcemove(0_45_158_46_44);
~fade_out;
p_delay(3);
~keldagrim_cart_ride(false);
if ($s = ^ft_listen) {
    @ft_room_listen;
}
if ($s = ^ft_archive) {
    @ft_room_archive;
}
@ft_chasm_arrive;

[proc,ft_room]()(int)
switch_int (%forget_quest) {
    case ^ft_puzzle1 : return(1);
    case ^ft_puzzle2 : return(2);
    case ^ft_puzzle3 : return(3);
}
return(0);

// back to Keldagrim, by the tunnel (2926,10159)
[label,ft_leave_mines]
if (~p_choice2_header("Yes.", 1, "No.", 2, "Return to Keldagrim?") = 2) return;
if_close;
~fade_out;
p_delay(2);
~ft_ride_clear;
cam_reset;
p_telejump(0_45_158_46_47);
facesquare(0_45_158_46_48);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);

// ---------------------------------------------------------------- the chasms
[label,ft_chasm_arrive]
def_int $room = ~ft_room;
p_telejump(1_29_77_6_28);
facesquare(1_29_77_8_29);
def_boolean $first = false;
if ($room = 1 & %forget_tunnel_cutscene1 = 0) $first = true;
if ($room = 2 & %forget_tunnel_cutscene2 = 0) $first = true;
if ($room = 3 & %forget_tunnel_cutscene3 = 0) $first = true;
if ($first = false) {
    p_delay(1);
    ~fade_in;
    p_delay(2);
    if_openoverlay(null);
    return;
}
// the first time in each: the camera goes out along the railroad
cam_moveto(1_29_77_4_22, 900, 0, 100);
cam_lookat(1_29_77_34_29, 200, 0, 100);
p_delay(1);
~fade_in;
cam_moveto(1_29_77_40_14, 1100, 2, 0);
cam_lookat(1_29_77_58_29, 200, 2, 0);
p_delay(8);
cam_moveto(1_29_77_2_29, 700, 3, 0);
cam_lookat(1_29_77_20_29, 200, 3, 0);
p_delay(6);
if_openoverlay(null);
cam_reset;
if ($room = 1) {
    %forget_tunnel_cutscene1 = 1;
    ~chatplayer("<p,confused>I'm deep underground now, but how am I supposed to get across here?");
} else if ($room = 2) {
    %forget_tunnel_cutscene2 = 1;
    ~chatplayer("<p,neutral>Looks like another chasm I need to cross.");
} else {
    %forget_tunnel_cutscene3 = 1;
    ~chatplayer("<p,shock>What the Guthix is this? Another chasm? And even more tracks!");
}

// a chasm's start: nothing in the junctions, no stones, the boxes full (ours: each chasm begins
// afresh)
[proc,ft_chasm_reset]
%forget_puzzle_var = 0;
%forget_start_emptied = 0;
%forget_box1_emptied = 0;
%forget_box2_emptied = 0;
%forget_box3_emptied = 0;
%forget_if17 = 0;
%forget_if18 = 0;
%forget_if19 = 0;
%forget_num_left = 0;
%forget_num_right = 0;
if (inv_total(inv, turnleft_trackjunction_control_card) > 0) inv_del(inv, turnleft_trackjunction_control_card, inv_total(inv, turnleft_trackjunction_control_card));
if (inv_total(inv, turnright_trackjunction_control_card) > 0) inv_del(inv, turnright_trackjunction_control_card, inv_total(inv, turnright_trackjunction_control_card));

[oploc1,forget_puzzle_entrance] @ft_leave_mines;
[oploc2,forget_train_cart] @ft_leave_mines;

// the box by the machinery, and the boxes at the ends of the tracks
[oploc1,keldagrim_track_junction_card_box]
def_int $room = ~ft_room;
if ($room = 0) {
    ~mesbox("There is nothing more inside this box.");
    return;
}
if (loc_coord = 1_29_77_6_26) {
    if (%forget_start_emptied = 1) {
        ~mesbox("There is nothing more inside this box.");
        return;
    }
    if (inv_freespace(inv) < 2) {
        ~mesbox("You need two free spaces in your pack to take what is in this box."); // ours
        return;
    }
    anim(human_pickuptable, 0);
    %forget_start_emptied = 1;
    if ($room = 1) {
        ~ft_stones(1, 1);
        ~mesbox("You find a green stone and a yellow stone in the storage box. You wonder what you can use these for...");
    } else if ($room = 2) {
        ~ft_stones(1, 2);
        ~mesbox("You find a green stone and two yellow stones in the storage box.");
    } else {
        ~ft_stones(2, 2);
        ~mesbox("You find two green stones and two yellow stones in the storage box.");
    }
    return;
}
def_int $box = %ft_cart_at;
if ($box = ^ft_top) {
    ~mesbox("The box turns out to be completely empty. And after all that effort to get here!");
    return;
}
if (($box = ^ft_box1 & %forget_box1_emptied = 1) | ($box = ^ft_box2 & %forget_box2_emptied = 1) | ($box ! ^ft_box1 & $box ! ^ft_box2)) {
    ~mesbox("There is nothing more inside this box.");
    return;
}
if (inv_freespace(inv) < 2) {
    ~mesbox("You need two free spaces in your pack to take what is in this box."); // ours
    return;
}
anim(human_pickuptable, 0);
if ($box = ^ft_box1) {
    %forget_box1_emptied = 1;
    if ($room = 1) {
        ~ft_stones(1, 0);
        ~mesbox("You search the box and find another stone with a green marking on it. Perhaps you should take the cart back to the start and see what you can do with it?");
    } else if ($room = 2) {
        ~ft_stones(1, 0);
        ~mesbox("You search the box and find another stone with a green marking on it.");
    } else {
        ~ft_stones(1, 1);
        ~mesbox("You search the box and find another two stones with markings on them: one green, one yellow.");
    }
    return;
}
%forget_box2_emptied = 1;
if ($room = 1) {
    ~ft_stones(0, 1);
    ~mesbox("You search the box and find another stone with a yellow marking on it.");
} else if ($room = 2) {
    ~ft_stones(1, 0);
    ~mesbox("You search the box and find yet another stone with a green marking on it.");
} else {
    ~ft_stones(1, 1);
    ~mesbox("You search the box and find another two stones with markings on them. Well, you know what to do with those by now...");
}

[proc,ft_stones](int $green, int $yellow)
if ($green > 0) inv_add(inv, turnleft_trackjunction_control_card, $green);
if ($yellow > 0) inv_add(inv, turnright_trackjunction_control_card, $yellow);

[opheld5,turnleft_trackjunction_control_card] ~mesbox("You'd better hang on to this, it looks important.");
[opheld5,turnright_trackjunction_control_card] ~mesbox("You'd better hang on to this, it looks important.");

// the machinery: the puzzle screen
[oploc1,keldagrim_track_junction_control_box]
def_int $room = ~ft_room;
if ($room = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (inv_total(inv, turnleft_trackjunction_control_card) = 0 & inv_total(inv, turnright_trackjunction_control_card) = 0 & %forget_if1 = 0) {
    ~mesbox("You look at the strange machinery and feel as if you're missing something... perhaps something to put into those strange holes in the stone slab?");
    return;
}
~ft_puzzle_counts;
switch_int ($room) {
    case 1 : if_openmain(inter_179);
    case 2 : if_openmain(inter_180);
    case 3 : if_openmain(inter_288);
}
~ft_puzzle_stones($room);

// how many of each stone you can still put in (the screen's two counters)
[proc,ft_puzzle_counts]
%forget_num_left = min(255, inv_total(inv, turnleft_trackjunction_control_card));
%forget_num_right = min(255, inv_total(inv, turnright_trackjunction_control_card));

[proc,ft_puzzle_count](int $room)(int)
switch_int ($room) {
    case 1 : return(8);
    case 2 : return(12);
}
return(19);

[proc,ft_puzzle_stones](int $room)
def_int $j = 1;
def_int $n = ~ft_puzzle_count($room);
while ($j <= $n) {
    if (~ft_junction($j) = 0) {
        if_sethide(~ft_stone_layer($room, $j), true);
    } else {
        if_sethide(~ft_stone_layer($room, $j), false);
    }
    $j = calc($j + 1);
}

// the OSRS wiki: "click once for green, twice for yellow, and three times to remove the stone"
// (ours: a colour you have none of is passed over)
[proc,ft_junction_click](int $room, int $j)
if (~ft_room ! $room) {
    if_close;
    return;
}
def_int $v = ~ft_junction($j);
if ($v = ^ft_green) inv_add(inv, turnleft_trackjunction_control_card, 1);
if ($v = ^ft_yellow) inv_add(inv, turnright_trackjunction_control_card, 1);
def_int $new = 0;
if ($v = 0) {
    if (inv_total(inv, turnleft_trackjunction_control_card) > 0) {
        $new = ^ft_green;
    } else if (inv_total(inv, turnright_trackjunction_control_card) > 0) {
        $new = ^ft_yellow;
    }
} else if ($v = ^ft_green) {
    if (inv_total(inv, turnright_trackjunction_control_card) > 0) $new = ^ft_yellow;
}
if ($new = ^ft_green) inv_del(inv, turnleft_trackjunction_control_card, 1);
if ($new = ^ft_yellow) inv_del(inv, turnright_trackjunction_control_card, 1);
~ft_junction_set($j, $new);
~ft_puzzle_counts;
~ft_puzzle_stones($room);

// a track point on the chasm (ours: the screen's map stretched over the chasm, its left end at the
// cart, 1864,4957)
[proc,ft_world](int $room, int $mx, int $mz)(coord)
def_int $x0 = -240;
def_int $span = 480;
if ($room = 2) {
    $x0 = -288;
    $span = 576;
} else if ($room = 3) {
    $x0 = -384;
    $span = 768;
}
return(movecoord(1_29_77_8_29, calc(($mx - $x0) * 52 / $span), 0, calc($mz * 7 / 96)));

// the ride: junction to junction until a junction has no stone or the track ends
[oploc1,forget_train_cart]
def_int $room = ~ft_room;
if ($room = 0) {
    ~displaymessage(^dm_default);
    return;
}
if (~ft_hands_free = false) return;
if (%forget_if1 = 0) {
    ~chatplayer("<p,neutral>This junction is blocked. I'd better go back to the start and find some way to make it go left or right.");
    return;
}
if_close;
~ft_ride_clear;
~keldagrim_cart_ride(true);
p_telejump(1_29_77_8_29);
p_delay(0);
def_int $j = 1;
def_int $end = 0;
def_int $v;
def_int $next;
def_int $nx;
def_int $nz;
while ($end = 0) {
    $v = ~ft_junction($j);
    if ($v = 0) {
        $end = ^ft_blocked;
    } else {
        $next, $nx, $nz = ~ft_edge($room, $j, $v);
        ~forcemove(~ft_world($room, $nx, $nz));
        if ($next >= ^ft_exit) {
            $end = $next;
        } else {
            $j = $next;
        }
    }
}
if ($end = ^ft_exit) @ft_chasm_exit($room);
~keldagrim_cart_ride(false);
%ft_cart_at = $end;
%ft_ride_cart = movecoord(coord, -1, 0, 0);
loc_add(%ft_ride_cart, forget_train_return_cart, 0, centrepiece_straight, 1000);
if ($end = ^ft_box1 | $end = ^ft_box2 | $end = ^ft_top) {
    %ft_ride_box = movecoord(coord, 0, 0, 1);
    loc_add(%ft_ride_box, keldagrim_track_junction_card_box, 0, centrepiece_straight, 1000);
    return;
}
if ($end = ^ft_blocked) {
    ~chatplayer("<p,neutral>This junction is blocked. I'd better go back to the start and find some way to make it go left or right.");
    return;
}
~chatplayer("<p,sad>I've come to a dead end. I'd better get back to the start.");

[oploc1,forget_train_return_cart]
~mesbox("You take the minecart back to the start point.");
if_close;
~fade_out;
p_delay(2);
~ft_ride_clear;
p_telejump(1_29_77_6_28);
facesquare(1_29_77_8_29);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);

// the box and cart put out for a ride (they stay out a while if someone else is there; ours)
[proc,ft_ride_clear]
if (%ft_ride_box ! null) {
    if (loc_find(%ft_ride_box, keldagrim_track_junction_card_box) = true) loc_del(1);
    %ft_ride_box = null;
}
if (%ft_ride_cart ! null) {
    if (loc_find(%ft_ride_cart, forget_train_return_cart) = true) loc_del(1);
    %ft_ride_cart = null;
}
%ft_cart_at = 0;
~keldagrim_cart_ride(false);

// over the chasm: the next room (the cache's "puzzle completed" jingle, midi_437: the 2007 cache's
// jingle 12, Void's forgettable_tale_puzzle_completed; same notes)
[label,ft_chasm_exit](int $room)
midi_jingle("midi_437");
~fade_out;
p_delay(3);
~keldagrim_cart_ride(false);
~ft_chasm_reset;
if ($room = 1) {
    ~ft_set(^ft_listen);
    @ft_room_listen;
}
if ($room = 2) {
    ~ft_set(^ft_archive);
    @ft_room_archive;
}
@ft_final_room;

// the cave exits in the rooms: back to Keldagrim, or on
[oploc1,forget_story_exit_prev] @ft_leave_mines;
[oploc1,forget_story_exit_next]
if (loc_coord = 2_29_77_33_54) {
    // the listening room (1889,4982)
    if (%forget_room1_once = 0) {
        ~chatplayer("<p,neutral>I should stay and listen for a bit longer...");
        return;
    }
    anim(human_crawl_ready_for_forget, 0);
    p_delay(1);
    if (%forget_quest = ^ft_listen) {
        ~ft_set(^ft_puzzle2);
        ~ft_chasm_reset;
    }
    if_close;
    ~fade_out;
    p_delay(2);
    ~ft_room_clear;
    @ft_chasm_arrive;
}
if (loc_coord = 2_29_77_58_37) {
    // the records room (1914,4965)
    if (%forget_room2_bookcase = 0 | %forget_room2_paper1 = 0 | %forget_room2_paper2 = 0) {
        ~chatplayer("<p,neutral>I should explore this room fully before moving on. I should be able to find out a little bit more.");
        return;
    }
    if (~p_choice2_header("Yes.", 1, "No.", 2, "Move deeper into the mines?") = 2) return;
    anim(human_crawl_ready_for_forget, 0);
    p_delay(1);
    if (%forget_quest = ^ft_archive) {
        ~ft_set(^ft_puzzle3);
        ~ft_chasm_reset;
    }
    if_close;
    ~fade_out;
    p_delay(2);
    @ft_chasm_arrive;
}
~displaymessage(^dm_default);

// ---------------------------------------------------------------- the Red Axe talking (1874-1885,4984-4988, across the pit)
[label,ft_room_listen]
p_telejump(2_29_77_13_55);
facesquare(2_29_77_23_58);
~ft_room_actors;
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);

// ours: where they stand; they chatter until you listen (the OSRS wiki's overhead lines)
[proc,ft_room_actors]
if (npc_find(2_29_77_23_58, forget_redaxe_director_cutscene_alt, 4, 0) = false) {
    npc_add(2_29_77_23_58, forget_redaxe_director_cutscene_alt, 1000);
    npc_facesquare(2_29_77_23_57);
    npc_say("Blah blah...");
}
if (npc_find(2_29_77_25_57, forget_redaxe_henchman_cutscene_alt, 4, 0) = false) {
    npc_add(2_29_77_25_57, forget_redaxe_henchman_cutscene_alt, 1000);
    npc_facesquare(2_29_77_23_58);
    npc_say("Yak yak...");
}
if (npc_find(2_29_77_20_58, forget_redaxe_shaman_cutscene_alt, 4, 0) = false) {
    npc_add(2_29_77_20_58, forget_redaxe_shaman_cutscene_alt, 1000);
    npc_facesquare(2_29_77_23_58);
    npc_say("Yadda yadda...");
}

[proc,ft_room_clear]
if (map_playercount(2_29_77_12_50, 2_29_77_33_60) > 1) return; // ours: someone else is still listening
if (npc_find(2_29_77_23_58, forget_redaxe_director_cutscene_alt, 6, 0) = true) npc_del;
if (npc_find(2_29_77_25_57, forget_redaxe_henchman_cutscene_alt, 6, 0) = true) npc_del;
if (npc_find(2_29_77_20_58, forget_redaxe_shaman_cutscene_alt, 6, 0) = true) npc_del;

// they stand across the pit from you: you listen from where you are (ours: within the approach range)
[apnpc1,forget_redaxe_director_cutscene_alt] @ft_listen;
[apnpc1,forget_redaxe_henchman_cutscene_alt] @ft_listen;
[apnpc1,forget_redaxe_shaman_cutscene_alt] @ft_listen;

[label,ft_listen]
%forget_room1_listening = 1;
~chatnpc_specific("Red Axe Henchman", forget_redaxe_henchman_cutscene_alt, "<p,quiz>What's the new plan?");
~chatnpc_specific("Ogre shaman", forget_redaxe_shaman_cutscene_alt, "<p,angry>Me dead human!");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene_alt, "<p,neutral>No, not yet. <text_gender("He", "She")> may still prove useful to us.");
~chatnpc_specific("Red Axe Henchman", forget_redaxe_henchman_cutscene_alt, "<p,angry>My axe on <text_gender("his", "her")> head would be more useful!");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene_alt, "<p,neutral>Forget about the human and the statue for now. Our experiments are more important.");
~chatnpc_specific("Red Axe Henchman", forget_redaxe_henchman_cutscene_alt, "<p,neutral>We are nearly ready with our next test.");
~chatnpc_specific("Ogre shaman", forget_redaxe_shaman_cutscene_alt, "<p,quiz>More little fire lookers?");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene_alt, "<p,neutral>This time they'll survive, I hope.");
~chatnpc_specific("Red Axe Henchman", forget_redaxe_henchman_cutscene_alt, "<p,angry>Our slaves are too weak, it will never work.");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene_alt, "<p,sad>Yes, things would have been so much easier with the statue.");
~chatnpc_specific("Red Axe Henchman", forget_redaxe_henchman_cutscene_alt, "<p,happy>It was a great plan! Sabotaging the base of the statue and bribing that boatman to crash into it!");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene_alt, "<p,angry>And we would have gotten away with it too, if it wasn't for that pesky human.");
%forget_room1_listening = 0;
%forget_room1_once = 1;
~chatplayer("<p,neutral>Pesky human, huh? Well, I think I have enough info now. I'd better explore the rest of these mines.");

// ---------------------------------------------------------------- the Red Axe's records (1898-1913,4960-4970)
[label,ft_room_archive]
p_telejump(2_29_77_42_37);
facesquare(2_29_77_44_37);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);

[oploc1,forget_metal_crate_withpapers1]
~chatplayer("<p,neutral>Statistical data, salary structures, shopping lists... no, I don't think there's anything interesting here.");

[oploc1,forget_metal_crate_withpapers2]
~mesbox("You find a copy of a letter, addressed to the boatman that brought you to Keldagrim a while back.");
%forget_room2_paper1 = 1;
~book("Letter", "I am writing to advise you that our secret preparations to the statue have been completed. All you need to do now is hit it with your boat. Take some gullible human along when you do, the mines are crawling with them these days. The human will surely get the major blame.||After this, the statue is going to be rebuilt in the image of our great director. You need not concern yourself with the how and why, but rest assured you will be compensated greatly.||Regards,|Colonel Grimsson of the Red Axe");

[oploc1,forget_metal_crate_withpapers3]
~mesbox("You find something that seems to shed some light on what happened to the drunken dwarf in Keldagrim. You should read it carefully before moving on.");
%forget_room2_paper2 = 1;
~book("Report on Intruder", "We found a dwarf wandering in our mines. We weren't sure if he was a spy or simply an explorer, but we couldn't take any risks. We decided to send him back with his memory wiped, rather than put him to use as one of our test subjects. We can't afford having to explain another mysterious disappearance at this point. Additionally, we added something to the spell that would make him hungry for kebabs and thirsty for beer, so that whatever he can remember will be dismissed as the ravings of a drunken fool. Grunsh did a good job, he seems to be fitting in well. Nevertheless, the spell seems to have been a little bit too strong, the subject is unlikely to recover from his condition. His obsession with kebabs is a bit too extreme. Will tell Grunsh to adjust his spell next time.");

// the first bookcase you search has the book (ours: which one); the others have nothing more
[oploc1,dwarf_keldagrim_metal_bookcase]
if (inzone(2_29_77_40_30, 2_29_77_60_45, coord) = false) {
    ~displaymessage(^dm_default);
    return;
}
if (%forget_room2_bookcase = 1) {
    if (%ft_bookcase ! loc_coord) {
        ~mesbox("You thoroughly search the bookcase but find no other books about the Red Axe.");
        return;
    }
    ~mesbox("You take the Red Axe Employee Records book from its shelf again.");
} else {
    ~mesbox("You find an interesting book that seems to contain a lot of data about Red Axe employees. You should read it fully before continuing.");
    %forget_room2_bookcase = 1;
    %ft_bookcase = loc_coord;
}
def_string $text = "Hreidmar, director of the Red Axe (employee #1)||Information classified.||Grimsson, the butcher of Barendir (employee #4297)||Grimsson was once a soldier in the dwarven army and quickly made his way up the ranks, up to colonel. He served with the Black Guard at Ice Mountain and in Kandarin. ";
$text = append($text, "He was present at the battle of Barendir when he fought against an army of trolls. It was here that he got his nickname, the Butcher of Barendir, as he mercilessly killed the trolls even as they retreated in defeat. ");
$text = append($text, "Here, also, he got his distinctive scar running across his forehead in a hand-to-hand battle with a particularly ferocious troll. After this battle Grimsson became more and more aggressive, even to his fellow dwarves. ");
$text = append($text, "Following a particularly vicious attack on a comrade, he was dismissed from the Black Guard. Soon after, he was recruited by the Red Axe. Here he's learned to control his rage and become even stronger. By now, he has become the right hand dwarf of the director. ");
$text = append($text, "While he holds no official rank, he is still often affectionately referred to as 'The Colonel'.||Grunsh, Ogre Shaman (employee #38262)||Found lost and near death in the ice cold mountains above Keldagrim, Grunsh was nearly mistaken for a troll at first. ");
$text = append($text, "Taken in by the Red Axe and nursed back to health, it turned out that he was in fact a powerful ogre shaman. Intelligent by ogre standards, and steadfastly loyal to his rescuers, he has taken up a prominent position in the ranks of the Red Axe. ");
$text = append($text, "This is primarily due to the fact that since dwarves cannot use magic, they must rely on other races as spellcasters. Grunsh fits the bill perfectly.");
~book("Red Axe Employee Records", $text);

// ---------------------------------------------------------------- the last room, and Grunsh's spell
// (the OSRS wiki: the director shows his chaos dwarves to the gnome emissary; Grunsh sneaks up and
// casts the spell; you wake at the tunnel's entrance). The jingle is "Kebabsh..." (midi_444: the 2007
// cache's jingle 105, the OSRS wiki's cache id for it; same notes). Ours: where everyone stands in
// the room (1860-1909,4942-4953), how the chaos dwarves come in, Grunsh's animation and spell
// graphic (ogre_attack, confuse_impact) and the camera.
[label,ft_final_room]
p_telejump(2_29_77_10_17);
facesquare(2_29_77_20_19);
npc_add(2_29_77_22_19, forget_redaxe_director_cutscene, 200);
npc_facesquare(2_29_77_24_17);
npc_add(2_29_77_24_20, forget_redaxe_henchman3_cutscene, 200);
npc_facesquare(2_29_77_22_19);
npc_add(2_29_77_25_17, forget_cutscene_gnome_emissary, 200);
npc_facesquare(2_29_77_22_19);
npc_add(2_29_77_26_16, forget_cutscene_gnome_companion1, 200);
npc_facesquare(2_29_77_22_19);
npc_add(2_29_77_26_18, forget_cutscene_gnome_companion2, 200);
npc_facesquare(2_29_77_22_19);
cam_moveto(2_29_77_14_10, 700, 0, 100);
cam_lookat(2_29_77_23_18, 150, 0, 100);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);
~chatplayer("<p,shock>There's the Red Axe director again!");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene, "<p,quiz>How did the experiment go?");
~chatnpc_specific("Colonel Grimsson", forget_redaxe_henchman3_cutscene, "<p,neutral>The test subjects are still alive, director. They will suffice as soldiers.");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene, "<p,happy>Excellent! We are improving. Laneel!");
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene, "<p,neutral>Return to Arposandra and tell your superiors we've had a partial success.");
~chatnpc_specific("Gnome emissary", forget_cutscene_gnome_emissary, "<p,neutral>I will tell them, but I'd like to see some of your test subjects first, if I may.");
~chatnpc_specific("Colonel Grimsson", forget_redaxe_henchman3_cutscene, "<p,happy>Look, here comes the first group!");
if_close;
midi_jingle("midi_444");
def_int $i = 0;
while ($i < 6) {
    npc_add(movecoord(2_29_77_44_16, modulo($i, 2), 0, divide($i, 2)), forget_cutscene_chaos_dwarf, 200);
    npc_walk(movecoord(2_29_77_30_16, modulo($i, 2), 0, divide($i, 2)));
    $i = calc($i + 1);
}
cam_moveto(2_29_77_20_9, 800, 2, 0);
cam_lookat(2_29_77_30_17, 150, 2, 0);
p_delay(10);
if (npc_find(2_29_77_22_19, forget_redaxe_director_cutscene, 2, 0) = true) {
    npc_facesquare(2_29_77_30_17);
    npc_anim(forgettable_evil_dwarf_laugh, 0);
}
~chatnpc_specific("Red Axe Director", forget_redaxe_director_cutscene, "<p,evillaugh>Behold the power of Zamorak!");
~chatplayer("<p,shock>Chaos dwarves!!!");
~chatplayer("<p,shock>I must tell Veldaban!!!");
// Grunsh, behind you
npc_add(2_29_77_7_17, forget_redaxe_shaman2_cutscene, 200);
npc_walk(2_29_77_8_17);
p_delay(2);
facesquare(2_29_77_8_17);
~chatnpc_specific("Grunsh", forget_redaxe_shaman2_cutscene, "<p,happy>Lookings likes we's finding da spying creatures'ies!");
if_close;
if (npc_find(2_29_77_8_17, forget_redaxe_shaman2_cutscene, 3, 0) = true) {
    npc_facesquare(coord);
    npc_anim(ogre_attack, 0);
}
spotanim_pl(confuse_impact, 92, 0);
p_delay(2);
~chatplayer("<p,shock>Nooooooo!");
if_close;
~fade_out;
p_delay(3);
~ft_final_clear;
cam_reset;
~ft_set(^ft_wiped);
p_telejump(0_45_158_46_47);
facesquare(0_45_158_46_48);
p_delay(2);
~fade_in;
p_delay(2);
if_openoverlay(null);
~chatplayer("<p,confused>Er, what? Where am I? Errrrr... I must tell Veldaban... something. Yes... ehm. I don't remember what though. Errr...");

[proc,ft_final_clear]
def_coord $c = 2_29_77_24_18;
while (npc_find($c, forget_cutscene_chaos_dwarf, 25, 0) = true) npc_del;
if (npc_find($c, forget_redaxe_director_cutscene, 25, 0) = true) npc_del;
if (npc_find($c, forget_redaxe_henchman3_cutscene, 25, 0) = true) npc_del;
if (npc_find($c, forget_cutscene_gnome_emissary, 25, 0) = true) npc_del;
if (npc_find($c, forget_cutscene_gnome_companion1, 25, 0) = true) npc_del;
if (npc_find($c, forget_cutscene_gnome_companion2, 25, 0) = true) npc_del;
if (npc_find($c, forget_redaxe_shaman2_cutscene, 25, 0) = true) npc_del;
