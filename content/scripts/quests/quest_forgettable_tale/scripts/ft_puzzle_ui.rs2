    case 311 : return(inter_288:com_60);
    case 312 : return(inter_288:com_62);
    case 313 : return(inter_288:com_64);
    case 314 : return(inter_288:com_66);
    case 315 : return(inter_288:com_68);
    case 316 : return(inter_288:com_70);
    case 317 : return(inter_288:com_72);
    case 318 : return(inter_288:com_74);
    case 319 : return(inter_288:com_76);
}
return(null);

[proc,ft_junction](int $j)(int)
switch_int ($j) {
    case 1 : return(%forget_if1);
    case 2 : return(%forget_if2);
    case 3 : return(%forget_if3);
    case 4 : return(%forget_if4);
    case 5 : return(%forget_if5);
    case 6 : return(%forget_if6);
    case 7 : return(%forget_if7);
    case 8 : return(%forget_if8);
    case 9 : return(%forget_if9);
    case 10 : return(%forget_if10);
    case 11 : return(%forget_if11);
    case 12 : return(%forget_if12);
    case 13 : return(%forget_if13);
    case 14 : return(%forget_if14);
    case 15 : return(%forget_if15);
    case 16 : return(%forget_if16);
    case 17 : return(%forget_if17);
    case 18 : return(%forget_if18);
    case 19 : return(%forget_if19);
}
return(0);

[proc,ft_junction_set](int $j, int $v)
switch_int ($j) {
    case 1 : %forget_if1 = $v;
    case 2 : %forget_if2 = $v;
    case 3 : %forget_if3 = $v;
    case 4 : %forget_if4 = $v;
    case 5 : %forget_if5 = $v;
    case 6 : %forget_if6 = $v;
    case 7 : %forget_if7 = $v;
    case 8 : %forget_if8 = $v;
