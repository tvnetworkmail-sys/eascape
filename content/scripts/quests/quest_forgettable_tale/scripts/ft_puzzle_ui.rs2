[proc,ft_stone_layer](int $room, int $j)(component)
switch_int (calc($room * 100 + $j)) {
    case 101 : return(inter_179:com_18);
    case 102 : return(inter_179:com_20);
    case 103 : return(inter_179:com_22);
    case 104 : return(inter_179:com_24);
    case 105 : return(inter_179:com_26);
