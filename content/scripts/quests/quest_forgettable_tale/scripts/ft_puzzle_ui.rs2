    case 210 : return(inter_180:com_44);
    case 211 : return(inter_180:com_46);
    case 212 : return(inter_180:com_48);
    case 301 : return(inter_288:com_40);
    case 302 : return(inter_288:com_42);
    case 303 : return(inter_288:com_44);
    case 304 : return(inter_288:com_46);
    case 305 : return(inter_288:com_48);
    case 306 : return(inter_288:com_50);
    case 307 : return(inter_288:com_52);
    case 308 : return(inter_288:com_54);
    case 309 : return(inter_288:com_56);
