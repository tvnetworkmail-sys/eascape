// Garden of Tranquillity (30 August 2005). The quest's stage is the cache's own %garden_quest
// (varbit, bits 0-5 of garden_varp_1); Void's garden_of_tranquillity varbit has completed = 60.
// The other stages are ours (no source numbers them).
^got_not_started = 0
^got_started = 10   // Ellamaria gave you the list: see the Wise Old Man
^got_ring = 20      // the Wise Old Man opened the Ring of Charos
^got_roald = 30     // the garden is done: fetch King Roald
^got_complete = 60
^got_questpoints = 2

// %got_flags bits (ours)
^gotf_wom_told = 0      // the Wise Old Man told you about the ring (bring it / get it back)
^gotf_wom_failed = 1    // you failed his test
^gotf_alain = 2         // Alain told you about the rune essence cure

// the gardeners' own varbits (the cache's names; the values are ours)
// %garden_elstan_varbit
^got_elstan_agreed = 1
^got_elstan_planted = 2   // marigolds sown in his flower patch after he asked
^got_elstan_picked = 3    // you picked them
^got_elstan_done = 4      // he gave you the delphinium seeds
// %garden_lyra_varbit and %garden_kragen_varbit
^got_grow_agreed = 1
^got_grow_grown = 2       // the onions / cabbages grown
^got_grow_done = 3        // the seeds given
// %garden_dantaera_varbit
^got_dantaera_allowed = 1
^got_dantaera_cut = 2
// %garden_althric_varbit
^got_althric_told = 1     // get rid of the ring
^got_althric_allowed = 2  // you may take the seeds
// %garden_bernald_varbit (its multiloc: 0-3 the vines diseased, 4-5 cured)
^got_bernald_deal = 1
^got_bernald_tried = 2    // plant cure didn't work
^got_bernald_alain = 3    // he sent you to Alain
^got_bernald_cured = 4
^got_bernald_done = 5     // he gave you the vine seeds
// the statues' varbits (the multilocs: 0 at home, 1 on your trolley, 2 on the garden's plinth)
^got_statue_home = 0
^got_statue_trolley = 1
^got_statue_placed = 2
// %garden_trolley_varbit (the multinpc: 0 empty, 1 Saradomin, 2 the king)
^got_trolley_saradomin = 1
^got_trolley_king = 2

// the garden's patches (the multilocs: 0-2 weeds, 3 weeded, 4 sown, 5-6 growing, 7 grown;
// the orchid pots 0 empty, 1 compost; the White Tree 8 grown and 9-12 one to four fruit)
^got_patch_weeded = 3
^got_patch_sown = 4
^got_patch_grown = 7
^got_tree_grown = 8
^got_tree_fruit4 = 12

// ours: how long you have with a statue before the guards take it back (the OSRS wiki
// walkthrough: "more than five minutes")
^got_statue_ticks = 500

// where things are (the map's own locs and npcs)
^got_king_plinth = 0_50_54_33_31        // garden_king_statue_multi (the northern plinth)
^got_sara_plinth = 0_50_54_29_23        // garden_saradomin_statue_multi (the southern plinth, 2 wide)
^got_falador_statue = 0_46_52_21_53     // falador_statue_saradomin
^got_lumbridge_statue = 0_50_50_31_17   // garden_lumbridge_statue
^got_edgeville_well = 0_48_54_12_46     // the well west of Edgeville bank
^got_white_tree = 0_46_54_63_41         // garden_white_tree_dead on Ice Mountain
// ours: where you and the trolley come out in the palace's northern courtyard
^got_courtyard_player = 0_50_54_26_38
^got_courtyard_trolley = 0_50_54_27_38
