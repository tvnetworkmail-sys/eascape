// EASCape: A Soul's Bane (quest_soulbane): the room of hopelessness. Five hopeless creatures, each
// to be killed three times; then the bridge of hope (OSRS wiki). Their three forms are the cache's
// three (hope_monst3, then 2, then 1: ours, the order).

[proc,sb_hope_spot](int $n)(coord)
switch_int ($n) {
    case 0 : return(0_47_81_6_14);  // 3014,5198
    case 1 : return(0_47_81_12_17); // 3020,5201
    case 2 : return(0_47_81_21_14); // 3029,5198
    case 3 : return(0_47_81_24_17); // 3032,5201
    case default : return(0_47_81_17_23); // 3025,5207
}

[proc,sb_hope_setup]
%soulbane_hope_killedtally = 0;
if (%soulbane_prog >= ^sb_hope_done) {
    %soulbane_hope_bridgepres = 1;
    return;
}
%soulbane_hope_bridgepres = 0;
def_int $n = 0;
while ($n < 5) {
    ~sb_spawn(~sb_hope_spot($n), soulbane_hope_monst3);
    $n = calc($n + 1);
}

[ai_queue3,soulbane_hope_monst3] @sb_hope_died(2);
[ai_queue3,soulbane_hope_monst2] @sb_hope_died(1);
[ai_queue3,soulbane_hope_monst1] @sb_hope_died(0);

[label,sb_hope_died](int $next)
def_coord $at = npc_coord;
gosub(npc_death);
if (npc_findhero = ^false) return;
if ($next = 0) {
    queue(sb_hope_down, 0, 0);
    return;
}
queue*(sb_hope_rises, 1)($at, $next);

// it gets up again
[queue,sb_hope_rises](coord $at, int $form)
if (%soulbane_prog ! ^sb_hope | ~sb_room_at(coord) ! 4) return;
if ($form = 2) ~sb_spawn($at, soulbane_hope_monst2);
else ~sb_spawn($at, soulbane_hope_monst1);
queue(sb_engage, 3, 0);

[queue,sb_hope_down](int $unused)
if (%soulbane_prog ! ^sb_hope) return;
%soulbane_hope_killedtally = calc(%soulbane_hope_killedtally + 1);
switch_int (%soulbane_hope_killedtally) {
    case 1 : say("Is there any end to killing these monsters?");
    case 2 : say("This is hard work!");
    case 3 : say("I've almost killed them all now!");
    case 4 : say("Maybe if I kill one more?");
}
if (%soulbane_hope_killedtally < 5) return;
// a flash of bright light, and the bridge of hope
~fade_out;
p_delay(1);
%soulbane_hope_bridgepres = 1;
%soulbane_prog = ^sb_hope_done;
~send_quest_progress(questlist:soulbane, %soulbane_prog, ^sb_complete);
~fade_in;
p_delay(2);
if_openoverlay(null);
~chatplayer("<p,happy>A bridge of hope! Tolna should feel that help is at hand by now!");
