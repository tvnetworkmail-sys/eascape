// EASCape: A Soul's Bane (quest_soulbane), the update of 3 April 2006.
// %soulbane_prog is the cache's varbit (bits 0-4 of the quest's varp soulbane, 709). Void
// (a_souls_bane.varbits.toml) gives 13 for completed; the stages between are ours.
^sb_not_started = 0
^sb_started = 1          // Launa asked you to look for her husband and son
^sb_rage = 2             // in the room of rage (heard Tolna's voice)
^sb_rage_done = 3        // the rage burst out; the fire's gone from the exit
^sb_fear = 4             // in the room of fear
^sb_fear_done = 5        // five fear reapers killed; the black hole is lit
^sb_confusion = 6        // in the room of confusion
^sb_confusion_done = 7   // the last confusing door is open
^sb_hope = 8             // in the room of hopelessness
^sb_hope_done = 9        // the bridge of hope appeared
^sb_tolna = 10           // found Tolna and his father, Brana
^sb_tolna_beaten = 11    // Tolna's three heads killed; he's human again
^sb_tolna_saved = 12     // talked to Tolna; he's back at the surface
^sb_complete = 13

^sb_questpoints = 1

// the rage meter fills with the damage you deal (ours: the OSRS wiki's 7-8 kills of 200
// hitpoints each)
^sb_rage_full = 1500

// the surface: by Launa, just north of the rift (3309,3455)
^sb_surface = 0_51_53_45_63
// the rooms, where you arrive in each (under its way back to the surface)
^sb_rage_arrive = 0_47_81_7_60        // 3015,5244
^sb_fear_arrive = 0_47_81_46_60       // 3054,5244
^sb_confusion_arrive = 0_47_81_52_25  // 3060,5209
^sb_hope_arrive = 0_47_81_13_25       // 3021,5209
^sb_tolna_arrive = 1_46_81_24_28      // 2968,5212, level 1
^sb_tolna_brana = 1_46_81_28_25       // 2972,5209
^sb_tolna_centre = 1_46_81_40_29      // 2984,5213
// the post-quest training dungeon (2009scape's ASoulsBaneListeners: 3297,9824)
^sb_dungeon = 0_51_153_33_32
