// EASCape: Recruitment Drive, room 6: Miss Cheevers. 2009scape MissCheeversDialogue.kt (what's on
// which shelf and in which crate, the mixes, the stone door, the key) and AlchemicalNotes.kt; the
// words the OSRS and RS wikis' transcripts (Recruitment Drive). The RS wiki's transcript: a
// bookshelf or crate gives its thing again once you no longer carry one, and the notes only turn up
// after you've begged her for help. The cache's varbits keep which vials you took (rd_got_*,
// rd_spare_water), the stone door (rd_room6_stone_door), the reaction (rd_react_on_spade), what's in
// the tin (rd_gypsum_in_tin, rd_water_in_tin) and the hint (rd_room6_hint1). Ours is marked.

[label,rcd_cheevers_start]
~rcd_say(rd_observer_room_6, "<p,happy>Greetings, <displayname>. Welcome to my challenge.");
~rcd_say(rd_observer_room_6, "<p,neutral>All you need to do is leave from the opposite door to where you came in by.");
~rcd_say(rd_observer_room_6, "<p,neutral>I will warn you that this is more complicated than it may at first appear.");
~rcd_say(rd_observer_room_6, "<p,neutral>I should also warn you that there are limited supplies of the items in this room, so think carefully before using them, or you may find yourself stuck, and have to leave to start again!");
~rcd_say(rd_observer_room_6, "<p,happy>Best of luck!");

[opnpc1,rd_observer_room_6]
if (~rcd_in_room(^rcd_cheevers) = false) return;
if (~rcd_passed(^rcd_cheevers) = true) @rcd_praise(^rcd_cheevers);
if (%rcd_cheevers_talk = 0) {
    ~chatplayer("<p,quiz>Can you give me any help?");
    ~chatnpc("<p,neutral>No, I am sorry, but that is forbidden by our rules.");
    ~chatnpc("<p,neutral>If you are having a particularly tough time of it, I suggest you leave and come back later when you are in a more receptive frame of mind.");
    ~chatnpc("<p,neutral>Sometimes a break from concentration will yield fresh insight. Our aim is to test you, but not to the point of frustration!");
    ~chatplayer("<p,happy>Okay, thanks!");
    %rcd_cheevers_talk = 1;
    return;
}
~chatplayer("<p,sad>Please... I am REALLY stuck... Isn't there ANYTHING you can do to help me...?");
~chatnpc("<p,shifty>Well... Look, I really shouldn't say anything about this room, but...");
~chatnpc("<p,neutral>When I was attempting to join the Temple Knights I myself had to do this puzzle myself.");
~chatnpc("<p,neutral>It was slightly different, but the idea behind it was the same, and I left the notes I had made while doing it hidden in one of the bookcases.");
~chatnpc("<p,neutral>If you look carefully you may find them, and they may be of some use to you.");
~chatnpc("<p,neutral>I really can't be any more help than that I'm afraid, it is more than my job's worth to have given you the help I already have.");
~chatplayer("<p,happy>Okay, thanks a lot, you've been very helpful!");
~chatnpc("<p,happy>Best of luck with the test <displayname>, I hope your application is successful.");
%rcd_cheevers_talk = 2;
%rd_room6_hint1 = 1;

// ---------------------------------------------------------------- searching
[label,rcd_find](string $searching, namedobj $obj, string $found)
if (~rcd_in_room(^rcd_cheevers) = false) return;
mes($searching);
p_delay(1);
if ($obj ! null) {
    if (inv_total(inv, $obj) = 0) {
        ~rcd_give($obj, 1);
        mes($found);
        return;
    }
}
mes("You don't find anything interesting.");

[oploc1,rd_bookshelf_old_tall] @rcd_find("You search the bookshelves...", rd_magnet, "Hidden amongst the books you find a magnet.");
[oploc1,rd_bookshelf_old_tall2]
if (%rd_room6_hint1 = 1) @rcd_find("You search the bookshelves...", rd_chem_book, "You find a book that looks like it might be helpful.");
@rcd_find("You search the bookshelves...", null, "");
[oploc1,rd_bookshelf_old_tall3] @rcd_find("You search the bookshelves...", rd_knife, "Hidden amongst the books you find a knife.");
[oploc1,rd_bookshelf_old_tall4] @rcd_find("You search the bookshelves...", null, "");

// 2009scape: the tin at 2476,4943, the chisel at 2476,4937, the wire at 2475,4943
[oploc1,rd_large_crate]
if (loc_coord = 0_38_77_44_15) @rcd_find("You search the crate...", rd_tin, "Inside the crate you find a tin.");
@rcd_find("You search the crate...", null, "");
[oploc1,rd_large_crates]
if (loc_coord = 0_38_77_44_9) @rcd_find("You search the crate...", rd_chisel, "Inside the crate you find a chisel.");
@rcd_find("You search the crate...", null, "");
[oploc1,rd_small_crates]
if (loc_coord = 0_38_77_43_15) @rcd_find("You search the crate...", rd_wire, "Inside the crate you find some wire.");
@rcd_find("You search the crate...", null, "");

[oploc1,rd_chest_closed] ~open_chest(rd_chest_open);
[oploc2,rd_chest_open] ~close_chest(rd_chest_closed);
[oploc1,rd_chest_open] @rcd_find("You search the chest...", rd_shears, "Inside the chest you find some shears.");

// the metal spade on the table (a map spawn): the RS wiki's transcript
[opobj3,rd_metal_spade]
if (inv_total(inv, rd_metal_spade) > 0 | inv_total(inv, rd_metal_spade_no_handle) > 0) {
    mes("You don't need another spade...");
    return;
}
@pickup_obj;

// ---------------------------------------------------------------- the shelves of vials
// 2009scape: shelf 1 acetic acid and a vial of liquid, 2 cupric sulphate, 3 gypsum, 4 sodium
// chloride, 5 nitrous oxide, 6 tin ore powder, 7 cupric ore powder, 8 three vials of liquid
[oploc1,rd_shelves_chemicals_1]
if (~rcd_in_room(^rcd_cheevers) = false) return;
if (%rd_got_vinegar = 0 & %rd_got_water = 0) {
    ~mesbox("There are two vials on this shelf.");
    switch_int (~p_choice3_header("Take the first vial.", 1, "Take the second vial.", 2, "Take both vials.", 3, "Take the vials?")) {
        case 1 :
            %rd_got_vinegar = 1;
            ~rcd_give(rd_acetic_acid, 1);
        case 2 :
            %rd_got_water = 1;
            ~rcd_give(rd_dihydrogen_monoxide, 1);
        case 3 :
            %rd_got_vinegar = 1;
            %rd_got_water = 1;
            ~rcd_give(rd_acetic_acid, 1);
            ~rcd_give(rd_dihydrogen_monoxide, 1);
    }
    return;
}
if (%rd_got_vinegar = 0) {
    if (~rcd_take_vial = true) {
        %rd_got_vinegar = 1;
        ~rcd_give(rd_acetic_acid, 1);
    }
    return;
}
if (%rd_got_water = 0) {
    if (~rcd_take_vial = true) {
        %rd_got_water = 1;
        ~rcd_give(rd_dihydrogen_monoxide, 1);
    }
    return;
}
~mesbox("There is nothing of interest on these shelves.");

[proc,rcd_take_vial]()(boolean)
~mesbox("There is a vial on this shelf.");
if (~p_choice2_header("YES", 1, "NO", 2, "Take the vial?") = 1) return(true);
return(false);

[oploc1,rd_shelves_chemicals_2]
if (~rcd_in_room(^rcd_cheevers) = false) return;
if (%rd_got_copsulph = 1) {
    ~mesbox("There is nothing of interest on these shelves.");
    return;
}
if (~rcd_take_vial = true) {
    %rd_got_copsulph = 1;
    ~rcd_give(rd_cupric_sulphate, 1);
}

[oploc1,rd_shelves_chemicals_3]
