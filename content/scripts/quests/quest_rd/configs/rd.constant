// Recruitment Drive (27 June 2005). The quest's own state is the cache's %rd_main (varbit 657 on
// the saved varp recruitmentdrive; Void's recruitment_drive varbit: 0 unstarted, 2 completed).
// 1 is ours: Sir Amik has put your name forward (2009scape's stages 1-3 all sit here).
^rcd_not_started = 0
^rcd_started = 1
^rcd_complete = 2
^rcd_questpoints = 1

// the seven test rooms, numbered as the cache's locs and varbits number them (rd_portal_room1..7,
// rd_room1..7_complete), which is also 2009scape's RecruitmentDriveListeners.Stages order
^rcd_spishyus = 1
^rcd_table = 2
^rcd_kuam = 3
^rcd_tinley = 4
^rcd_ren = 5
^rcd_cheevers = 6
^rcd_hynn = 7

// 2009scape: five rooms of the seven in a row
^rcd_tests = 5
