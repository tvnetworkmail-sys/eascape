// EASCape: Sir Tiffy Cashien's Initiate Temple Knight Armoury (the OSRS wiki's Transcript:Sir Tiffy
// Cashien names it). Stock: Void (falador.shops.toml initiate_temple_knight_armoury, 10 of each);
// Void's initiate harness is later than 2006 and isn't in our data. Restock is ours.
[rcd_initiate_armoury]
scope=shared
size=40
restock=yes
allstock=no
stock1=basic_tk_helm,10,100
stock2=basic_tk_legs,10,100
stock3=basic_tk_body,10,100
