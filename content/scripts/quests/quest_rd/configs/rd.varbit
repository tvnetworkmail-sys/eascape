// EASCape: ours (rd.varp). 2009scape keeps these as player attributes.
// the five rooms, 3 bits each (1-7), and which of them you're in (0-4)
[rcd_order]
basevar=rcd_run
startbit=0
endbit=14

[rcd_index]
basevar=rcd_run
startbit=15
endbit=17

// Lady Table: which of the 12 statue orders you got (1-12), and the missing statue is back
[rcd_statue]
basevar=rcd_run
startbit=18
endbit=21

[rcd_placed]
basevar=rcd_run
startbit=22
endbit=22

// Sir Ren Itchood: the password (1-6: BITE FISH LAST MEAT RAIN TIME) and clues asked (0-2)
[rcd_clue]
basevar=rcd_run
startbit=23
endbit=25

[rcd_clues_asked]
basevar=rcd_run
startbit=26
endbit=27

// Ms. Hynn Terprett: the riddle (1-5)
[rcd_riddle]
basevar=rcd_run
startbit=28
endbit=30

// Sir Spishyus and Miss Cheevers: how many times you've asked them for help since the room began
[rcd_spish_talk]
basevar=rcd_run2
startbit=0
endbit=1

[rcd_cheevers_talk]
basevar=rcd_run2
startbit=2
endbit=3

// Miss Cheevers: what has been poured on the spade in the stone door
[rcd_spade_cupric]
basevar=rcd_run2
startbit=4
endbit=4

[rcd_spade_water]
basevar=rcd_run2
startbit=5
endbit=5

// Sir Tinley: waiting, and for how many ticks
[rcd_waiting]
basevar=rcd_run2
startbit=6
endbit=6

[rcd_tinley_ticks]
basevar=rcd_run2
startbit=7
endbit=11

// a room's opening is running (a door, portal or talk mustn't start another)
[rcd_busy]
basevar=rcd_run2
startbit=12
endbit=12
