[proc,qh_hauntedmine_c1]()(boolean)
if (inzone(0_43_69_10_2, 0_43_69_28_33, coord) = true | inzone(0_43_69_10_5, 0_43_69_58_23, coord) = true | inzone(0_43_69_45_24, 0_43_69_56_34, coord) = true) return(true);
return(false);

[proc,qh_hauntedmine_c2]()(boolean)
if (inzone(0_42_71_20_44, 0_42_85_48_59, coord) = true) return(true);
return(false);

[proc,qh_hauntedmine_c3]()(boolean)
if (inzone(0_42_71_28_15, 0_42_71_46_25, coord) = true) return(true);
return(false);

[proc,qh_hauntedmine_c4]()(boolean)
if (calc(inv_total(inv, glowing_fungus) + inv_total(worn, glowing_fungus)) >= 1) return(true);
return(false);

[proc,qh_hauntedmine_c5]()(boolean)
if (inzone(0_43_69_6_34, 0_43_69_24_40, coord) = true) return(true);
return(false);

[proc,qh_hauntedmine_c6]()(boolean)
if (calc(inv_total(inv, hauntedmine_reward_key) + inv_total(worn, hauntedmine_reward_key)) >= 1) return(true);
return(false);

[proc,qh_hauntedmine_c7]()(boolean)
if (calc(inv_total(inv, chisel) + inv_total(worn, chisel)) >= 1) return(true);
return(false);

[proc,qh_hauntedmine_c8]()(boolean)
if (~qh_hauntedmine_c4 = false) return(false);
if (~qh_hauntedmine_c5 = false) return(false);
if (~qh_hauntedmine_c6 = false) return(false);
if (~qh_hauntedmine_c7 = false) return(false);
return(true);

[proc,qh_hauntedmine_c9]()(boolean)
if (inzone(0_42_69_0_16, 0_43_69_1_56, coord) = true) return(true);
return(false);

[proc,qh_hauntedmine_c10]()(boolean)
if (~qh_hauntedmine_c4 = false) return(false);
if (~qh_hauntedmine_c9 = false) return(false);
