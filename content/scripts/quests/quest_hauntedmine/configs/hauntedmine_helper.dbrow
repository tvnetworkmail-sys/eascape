[questhelper_guide_hauntedmine]
table=questhelper_guide
data=guide,^qh_hauntedmine
data=key,hauntedmine
data=name,Haunted Mine
data=journal,Haunted Mine
data=recommended,potato_tuna+sweetcorn,1
data=skill,35 Crafting
data=section,Starting off
data=section,Getting a light source
data=section,Getting the salve crystals

[questhelper_step_hauntedmine_1]
table=questhelper_step
data=id,33001
data=section,0
data=text,Talk to the Zealot outside the Abandoned Mine in south west Morytania.
data=npc,saradominist_zealot
data=coord,0_53_50_51_58
data=option,And what sort of purpose would that be?
data=option,Yes.
data=option,Is there any other way into the mines?
data=option,I come seeking challenges and quests.
data=option,I follow the path of Saradomin.
data=option,What quest is that then?

[questhelper_step_hauntedmine_2]
table=questhelper_step
data=id,33002
data=section,0
data=text,Pickpocket the Zealot outside the Abandoned Mine in south west Morytania.
data=npc,saradominist_zealot
data=coord,0_53_50_51_58

