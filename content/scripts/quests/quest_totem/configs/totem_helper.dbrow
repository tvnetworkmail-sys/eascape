data=name,Tribal Totem
data=journal,Tribal Totem
data=recommended,coins,90
data=recommended,amulet_of_glory_1,1
data=skill,21 Thieving
data=section,Retrieving the totem

[questhelper_step_totem_1]
table=questhelper_step
data=id,61001
data=section,0
data=text,Talk to Kangai Mau in the Brimhaven food store.
data=npc,kangai_mau
data=coord,0_43_49_42_46
data=option,I'm in search of adventure!
data=option,"Ok, I will get it back."
data=option,Yes.

[questhelper_step_totem_2]
table=questhelper_step
data=id,61002
data=section,0
data=text,Travel to the GPDT depot in Ardougne and investigate the most northeastern crate for a label.
data=loc,horncrate
data=coord,0_41_51_26_9

[questhelper_step_totem_3]
table=questhelper_step
data=id,61003
data=section,0
data=text,Use the label on the highlighted crate.
data=loc,teleportcrate
data=coord,0_41_51_26_7
data=item,tribal_totem_label,1

[questhelper_step_totem_4]
table=questhelper_step
data=id,61004
data=section,0
data=text,Talk to a nearby GPDT employee.
data=npc,rpdt_employee
data=coord,0_41_51_23_8
data=option,"So, when are you going to deliver this crate?"

[questhelper_step_totem_5]
table=questhelper_step
data=id,61005
data=section,0
data=text,Talk to Wizard Cromperty in north east Ardougne.
data=coord,0_41_51_59_62
data=option,Chat.
data=option,So what have you invented?
data=option,Can I be teleported please?
data=option,"Yes, that sounds good. Teleport me!"

[questhelper_step_totem_6]
table=questhelper_step
data=id,61006
data=section,0
data=text,"Try and open the door to the west. The password is 'KURT', (K=10 right, U=6 left, R=9 left, T=7 left)"
data=loc,combodoor
data=coord,0_41_51_10_59

[questhelper_step_totem_7]
table=questhelper_step
data=id,61007
data=section,0
data=text,solvePassword

[questhelper_step_totem_8]
table=questhelper_step
data=id,61008
data=section,0
data=text,"FIRST Right-click 'Investigate' the stairs to disable a trap, then climb the stairs."
data=loc,totemtrapstairs
data=coord,0_41_51_8_59

[questhelper_step_totem_9]
table=questhelper_step
data=id,61009
data=section,0
data=text,Open the chest on the top floor and search it for the totem.
data=loc,totemshutchest
data=coord,1_41_51_14_60

[questhelper_step_totem_10]
table=questhelper_step
data=id,61010
data=section,0
data=text,Return to Kangai Mau in Brimhaven.
data=npc,kangai_mau
data=coord,0_43_49_42_46
