// EASCape: Quest Helper for Tribal Totem, converted from RuneLite's Quest Helper (tribaltotem, BSD 2-Clause)
// by tools/quests/qh2server.py. Conditions it couldn't carry over count as not met:
//   NPC CROMPERTY_PRE_DIARY not matched

[proc,questhelper_totem]()(int)
def_int $v = %totemquest;
if ($v > 0) {
    return(0); // done
}
return(1);
