[questhelper_step_tbwt_1]
table=questhelper_step
data=id,60001
data=section,0
data=text,Talk to Timfraku upstairs in his house in Tai Bwo Wannai.
data=npc,tbwt_timfraku
data=option,I am a roving adventurer.
data=option,I am a travelling explorer.
data=option,Who me? Oh I'm just a nobody.
data=option,Trufitus sent me.
data=option,Your gratitude is all I deserve.
data=option,"Well, some gold would be nice."
data=option,Yes.

