[questhelper_guide_ball]
table=questhelper_guide
data=guide,^qh_ball
data=key,ball
data=name,Witch's House
data=journal,Witch's House
data=section,Start the quest
data=section,Accessing the garden
data=section,Checkpoint
data=section,Defeat the witch's experiment

[questhelper_step_ball_1]
table=questhelper_step
data=id,11001
data=section,0
data=text,Talk to the Boy in Taverley to start the quest.
data=npc,ballboy
data=coord,0_45_54_48_0
data=option,What's the matter?
data=option,"Ok, I'll see what I can do."
data=option,Yes.

[questhelper_step_ball_2]
table=questhelper_step
data=id,11002
data=section,1
data=text,Look under the potted plant just outside the witch's house for the house key.
data=loc,witchpot
data=coord,0_45_54_20_18

[questhelper_step_ball_3]
table=questhelper_step
data=id,11003
data=section,1
data=text,Enter the witch's house.
data=loc,witchhousedoor
data=coord,0_45_54_20_17
data=item,witches_doorkey,1

[questhelper_step_ball_4]
table=questhelper_step
data=id,11004
data=section,1
data=text,Go back downstairs.
data=coord,1_45_54_27_15

[questhelper_step_ball_5]
table=questhelper_step
data=id,11005
data=section,1
data=text,Go down the ladder to the basement.
data=coord,0_45_54_27_20

[questhelper_step_ball_6]
table=questhelper_step
data=id,11006
data=section,1
data=text,"Go through the gate whilst wearing gloves. If you don't have gloves, search the nearby boxes until you get a pair."
data=loc,shockgater
data=coord,0_45_154_22_17

[questhelper_step_ball_7]
table=questhelper_step
data=id,11007
data=section,1
data=text,Open the cupboard and get a magnet from it
data=loc,magnetcbshut
data=coord,0_45_154_18_18

[questhelper_step_ball_8]
table=questhelper_step
data=id,11008
data=section,1
data=text,Open the cupboard and get a magnet from it
data=loc,magnetcbopen
data=coord,0_45_154_18_18

[questhelper_step_ball_9]
table=questhelper_step
data=id,11009
data=section,1
data=text,Climb back up the ladder.
data=coord,0_45_154_27_20

[questhelper_step_ball_10]
table=questhelper_step
data=id,11010
data=section,1
data=text,"Use the cheese on the mouse hole in the south room, then use the magnet on the mouse which emerges."
data=loc,witchmousehole
data=coord,0_45_54_23_10
data=item,cheese,1
data=item,magnet,1

[questhelper_step_ball_11]
table=questhelper_step
data=id,11011
data=section,2
data=text,Pick up the witch's diary from the table and read it to ensure the door stays unlocked. Check the 'Checkpoint' section if you want to skip this step.
data=item,witches_diary,1

[questhelper_step_ball_12]
table=questhelper_step
data=id,11012
data=section,3
data=text,"Enter the garden and sneak around the perimeter to search the fountain. If the witch spots you, you'll be teleported outside."
data=loc,witchfountain
data=coord,0_45_54_30_15

[questhelper_step_ball_13]
table=questhelper_step
data=id,11013
data=section,3
data=text,Use the shed key on the shed door to enter.
data=loc,witchsheddoor
data=coord,0_45_54_54_7
data=item,witches_shedkey,1

[questhelper_step_ball_14]
table=questhelper_step
data=id,11014
data=section,3
data=text,"Enter the shed. If the door doesn't open, you need to get the shed key from the fountain again."
data=loc,witchsheddoor
data=coord,0_45_54_54_7

[questhelper_step_ball_15]
table=questhelper_step
data=id,11015
data=section,3
data=text,"Kill all four forms of the Witch's experiment (levels 19, 30, 42, and 53). You can safe spot the last two forms from the crate in the south of the room."
data=npc,shapeshifterglob
data=npc,shapeshifterspider
data=npc,shapeshifterbear
data=npc,shapeshifterwolf
data=coord,0_45_54_55_7

[questhelper_step_ball_16]
table=questhelper_step
data=id,11016
data=section,3
data=text,"If an experiment hasn't spawned, attempt to pick up the ball once."
data=coord,0_45_54_56_14
data=item,ball,1

[questhelper_step_ball_17]
table=questhelper_step
data=id,11017
data=section,3
data=text,Pick up the ball.
data=coord,0_45_54_55_4
data=item,ball,1

[questhelper_step_ball_18]
table=questhelper_step
data=id,11018
data=section,3
data=text,Return the ball to the boy. Make sure the witch doesn't spot you or you'll have to get the ball back again..
data=npc,ballboy
data=coord,0_45_54_48_0
