[proc,qh_ball_c1]()(boolean)
if (calc(inv_total(inv, ball) + inv_total(worn, ball)) >= 1) return(true);
return(false);

[proc,qh_ball_c2]()(boolean)
if (inzone(0_45_54_54_3, 0_45_54_57_11, coord) = true) return(true);
return(false);

[proc,qh_ball_c3]()(boolean)
if (inzone(0_45_54_21_10, 0_45_54_27_20, coord) = true | inzone(0_45_54_20_3, 0_45_54_53_9, coord) = true | inzone(0_45_54_28_10, 0_45_54_53_11, coord) = true | inzone(0_45_54_28_11, 0_45_54_32_19, coord) = true) return(true);
return(false);

