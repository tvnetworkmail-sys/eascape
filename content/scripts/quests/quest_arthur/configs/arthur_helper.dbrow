[questhelper_step_arthur_1]
table=questhelper_step
data=id,10001
data=section,0
data=text,Talk to King Arthur in Camelot Castle to start.
data=npc,king_arthur
data=coord,0_43_54_11_57
data=option,Yes.
data=option,I want to become a Knight of the Round Table!

[questhelper_step_arthur_2]
table=questhelper_step
data=id,10002
data=section,0
data=text,Talk to Sir Gawain about how Merlin got trapped.
data=npc,sir_gawain
data=coord,0_43_54_6_48
data=option,Do you know how Merlin got trapped?

[questhelper_step_arthur_3]
table=questhelper_step
data=id,10003
data=section,0
data=text,Go upstairs to talk to Lancelot.
data=coord,0_42_54_63_55

[questhelper_step_arthur_4]
table=questhelper_step
data=id,10004
data=section,0
data=text,Talk to Sir Lancelot about getting into Morgan Le Faye's stronghold.
data=npc,sir_lancelot
data=coord,1_43_54_8_55
data=option,Any ideas on how to get into Morgan Le Faye's stronghold?
data=option,Thank you for the information.

[questhelper_step_arthur_5]
table=questhelper_step
data=id,10005
data=section,1
data=text,Hide in Arhein's crate behind the Candle Maker's shop in Catherby.
data=loc,merlincrate_empty
data=coord,0_43_53_49_50
data=option,Yes.

[questhelper_step_arthur_6]
table=questhelper_step
data=id,10006
data=section,1
data=text,Hide in Arhein's crate behind the Candle Maker's shop in Catherby.
data=coord,1_42_54_63_56

[questhelper_step_arthur_7]
table=questhelper_step
data=id,10007
data=section,1
data=text,Go up the stairs in the fortress.
data=loc,stairs
data=coord,0_43_53_18_13

[questhelper_step_arthur_8]
table=questhelper_step
data=id,10008
data=section,1
data=text,Go up another floor.
data=loc,stairs
data=coord,1_43_53_18_7

[questhelper_step_arthur_9]
table=questhelper_step
data=id,10009
data=section,1
data=text,Attack Sir Mordred down to 0hp to cause Morgan Le Faye to spawn.
data=npc,sir_mordred
data=coord,2_43_53_18_11
data=option,Tell me how to untrap Merlin and I might.
data=option,Ok I will do all that.

[questhelper_step_arthur_10]
table=questhelper_step
data=id,10010
data=section,1
data=text,Go through Morgan le Faye's dialog. IF YOU EXIT FROM THIS DIALOG YOU WILL HAVE TO FIGHT MORDRED AGAIN.
data=option,Tell me how to untrap Merlin and I might.
data=option,Ok I will do all that.

[questhelper_step_arthur_11]
table=questhelper_step
data=id,10011
data=section,2
data=text,"Climb down from Keep Le Faye and step through the front door, then kill a Giant bat for some bat bones."
data=coord,2_43_53_17_7

[questhelper_step_arthur_12]
table=questhelper_step
data=id,10012
data=section,2
data=text,"Climb down from Keep Le Faye and step through the front door, then kill a Giant bat for some bat bones."
data=coord,1_43_53_17_13

[questhelper_step_arthur_13]
table=questhelper_step
data=id,10013
data=section,2
data=text,Kill a Giant bat outside Keep Le Faye for some bat bones.
data=npc,bat
data=coord,0_43_53_5_9

[questhelper_step_arthur_14]
table=questhelper_step
data=id,10014
data=section,3
data=text,Return to Catherby.

[questhelper_step_arthur_15]
table=questhelper_step
data=id,10015
data=section,3
data=text,"If you still need wax, go grab the insect repellent in a house in north Catherby. Otherwise, get your wax out."
data=coord,0_43_53_55_58

[questhelper_step_arthur_16]
table=questhelper_step
data=id,10016
data=section,3
data=text,Go grab the bucket in the bee field west of Catherby.
data=coord,0_43_53_14_49
data=item,bucket_empty,1

[questhelper_step_arthur_17]
table=questhelper_step
data=id,10017
data=section,3
data=text,"Use the insect repellent on a bee hive, then try to take some wax."
data=loc,merlin_beehive
data=coord,0_43_53_10_51
data=item,bucket_empty,1

[questhelper_step_arthur_18]
table=questhelper_step
data=id,10018
data=section,3
data=text,Talk to the Candle Maker in Catherby twice until he gives you a black candle.
data=npc,candle_maker
data=coord,0_43_53_45_48
data=option,Have you got any black candles?

[questhelper_step_arthur_19]
table=questhelper_step
data=id,10019
data=section,4
data=text,Talk to the Lady of the Lake in Taverley.
data=npc,ladyofthelake
data=coord,0_45_53_44_12
data=option,I seek the sword Excalibur.

[questhelper_step_arthur_20]
table=questhelper_step
data=id,10020
data=section,4
data=text,Attempt to enter the jewelery store in Port Sarim.
data=loc,jewellersdoor
data=coord,0_47_50_8_46
data=option,Yes certainly.
data=option,"Yes, here you go."
data=item,bread,1

[questhelper_step_arthur_21]
table=questhelper_step
data=id,10021
data=section,4
data=text,Talk to the beggar who appears and give him some bread.
data=npc,lake_beggar
data=coord,0_47_50_8_47
data=option,Yes certainly.
data=option,"Yes, here you go."
data=item,bread,1

[questhelper_step_arthur_22]
table=questhelper_step
data=id,10022
data=section,5
data=text,"Check the altar in the Zamorak Temple in south east Varrock. If you've already learnt the spell, just mark this step complete in the Quest Helper sidebar."
data=loc,thrantaxaltar
data=coord,0_50_52_60_53

[questhelper_step_arthur_23]
table=questhelper_step
data=id,10023
data=section,6
data=text,Enter the gates towards Camelot Castle.
data=coord,0_43_54_6_26
data=item,unlit_black_candle,1

[questhelper_step_arthur_24]
table=questhelper_step
data=id,10024
data=section,6
data=text,Go stand in the star symbol north east of Camelot Castle.
data=coord,0_43_54_28_59
data=option,Snarthon Candtrick Termanto
data=item,unlit_black_candle,1

[questhelper_step_arthur_25]
table=questhelper_step
data=id,10025
data=section,6
data=text,Light the Black candle with your tinderbox.

[questhelper_step_arthur_26]
table=questhelper_step
data=id,10026
data=section,6
data=text,Right-click drop the bat bones in the star.
data=option,Snarthon Candtrick Termanto
data=item,lit_black_candle,1

[questhelper_step_arthur_27]
table=questhelper_step
data=id,10027
data=section,6
data=text,Say the spell 'Snarthon Candtrick Termanto'. Be careful not to click the wrong option or you'll have to get another Black Candle.
data=option,Snarthon Candtrick Termanto

[questhelper_step_arthur_28]
