data=option,"Okay, I've read that book about the Shield of Arrav."

[questhelper_step_blackarmgang_4]
table=questhelper_step
data=id,13004
data=section,0
data=text,"To start the quest as the Black Arm Gang, talk to Charlie the Tramp in south Varrock to start."
data=npc,tramppg
data=coord,0_50_53_8_0
data=option,Is there anything down this alleyway?
data=option,I'm looking for the Black Arm Gang.
data=option,Do you think they would let me join?

[questhelper_step_blackarmgang_5]
table=questhelper_step
data=id,13005
data=section,0
data=text,Talk to Katrine down the alley to the west.
data=npc,katrine
data=coord,0_49_52_49_57
data=option,I've heard you're the Black Arm Gang.
data=option,I'd rather not reveal my sources.
data=option,I want to become a member of your gang.
data=option,"Well, you can give me a try can't you?"
data=option,"Ok, no problem."

[questhelper_step_blackarmgang_6]
table=questhelper_step
data=id,13006
data=section,1
data=text,"Get the weapon storeroom key from another player.  If you cannot trade, have them use the key on you to drop it at your feet."

[questhelper_step_blackarmgang_7]
table=questhelper_step
data=id,13007
data=section,1
data=text,Go up the ladder in south east Varrock to the Phoenix Weapon Storeroom.
