// Quest Helper guide for Goblin Diplomacy, written by hand: RuneLite's guide follows OSRS's rework
// (it starts elsewhere and uses varbits), so ours follows our %goblinquest stages (0-6).
// Places and options are from our maps and scripts (bartender.rs2, quest_gobdip.rs2, aggie.rs2,
// dye_cape.rs2, goblin_mail.rs2); goblin mail drops from goblins (drop_tables/goblin.rs2).
[questhelper_guide_gobdip]
table=questhelper_guide
data=guide,^qh_gobdip
data=key,gobdip
data=name,Goblin Diplomacy
data=journal,Goblin Diplomacy
data=difficulty,Novice
data=start,Talk to the bartender in the Rusty Anchor in Port Sarim.
data=required,goblin_armour,3
data=required,orangedye,1
data=required,bluedye,1
data=recommended,coins,15
data=reward,5 Quest Points
data=reward,200 Crafting experience
data=reward,A gold bar
data=section,Starting off
data=section,Getting the armour
data=section,Orange armour
data=section,Blue armour
data=section,Brown armour

[questhelper_step_gobdip_1]
table=questhelper_step
data=id,101001
data=section,0
data=text,Talk to the bartender in the Rusty Anchor in Port Sarim.
data=npc,rustyanchor_bartender
data=coord,0_47_50_37_57
data=option,"Not very busy in here today, is it?"
data=option,Have you heard any more rumours in here?

[questhelper_step_gobdip_2]
table=questhelper_step
data=id,101002
data=section,0
data=text,"Talk to General Wartface or General Bentnoze in the Goblin Village, north of Falador."
data=npc,general_wartface
data=npc,general_bentnoze
data=coord,0_46_54_13_55
data=option,Do you want me to pick an armour colour for you?

[questhelper_step_gobdip_3]
table=questhelper_step
data=id,101003
data=section,1
data=text,Get goblin mail: goblins drop it. You need three.
data=npc,goblin
data=obj,goblin_armour

[questhelper_step_gobdip_4]
table=questhelper_step
data=id,101004
data=section,2
data=text,"Make orange dye: mix red dye (Aggie in Draynor, 3 redberries and 5 coins) with yellow dye (Aggie, 2 onions and 5 coins)."
data=npc,aggie
data=coord,0_48_50_14_59
data=item,reddye,1
data=item,yellowdye,1

[questhelper_step_gobdip_5]
table=questhelper_step
data=id,101005
data=section,2
data=text,Use the orange dye on a goblin mail.
data=item,orangedye,1
data=item,goblin_armour,1

[questhelper_step_gobdip_6]
table=questhelper_step
data=id,101006
data=section,2
data=text,Give the orange goblin armour to the generals.
data=npc,general_wartface
data=npc,general_bentnoze
data=coord,0_46_54_13_55
data=item,goblin_armour_orange,1

[questhelper_step_gobdip_7]
table=questhelper_step
data=id,101007
data=section,3
data=text,Make blue dye: Aggie in Draynor makes it from 2 woad leaves and 5 coins.
data=npc,aggie
data=coord,0_48_50_14_59
data=item,woadleaf,2
data=item,coins,5

[questhelper_step_gobdip_8]
table=questhelper_step
data=id,101008
data=section,3
data=text,Use the blue dye on a goblin mail.
data=item,bluedye,1
data=item,goblin_armour,1

[questhelper_step_gobdip_9]
table=questhelper_step
data=id,101009
data=section,3
data=text,Give the dark blue goblin armour to the generals.
data=npc,general_wartface
data=npc,general_bentnoze
data=coord,0_46_54_13_55
data=item,goblin_armour_darkblue,1

[questhelper_step_gobdip_10]
table=questhelper_step
data=id,101010
data=section,4
data=text,Give a plain (brown) goblin mail to the generals.
data=npc,general_wartface
data=npc,general_bentnoze
data=coord,0_46_54_13_55
data=item,goblin_armour,1
