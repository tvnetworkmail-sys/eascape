data=id,22001
data=section,0
data=text,Talk to Brother Omad in the monastery south of East Ardougne.
data=npc,brother_omad
data=coord,0_40_50_47_11
data=option,"Why can't you sleep, what's wrong?"
data=option,Yes.

[questhelper_step_drunkmonk_2]
table=questhelper_step
data=id,22002
data=section,1
data=text,Go down the ladder in a circle of stones west of the monastery.
data=coord,0_40_50_1_22

[questhelper_step_drunkmonk_3]
table=questhelper_step
data=id,22003
data=section,1
data=text,Pick up the Child's blanket in the room to the south.
data=coord,0_40_150_10_4
data=item,childs_blanket,1

[questhelper_step_drunkmonk_4]
table=questhelper_step
data=id,22004
data=section,1
data=text,Go back up the ladder.
data=coord,0_40_150_1_22
data=item,childs_blanket,1

[questhelper_step_drunkmonk_5]
table=questhelper_step
data=id,22005
data=section,1
data=text,Bring the blanket back to Brother Omad in the monastery.
data=npc,brother_omad
data=coord,0_40_50_47_11
data=item,childs_blanket,1

[questhelper_step_drunkmonk_6]
