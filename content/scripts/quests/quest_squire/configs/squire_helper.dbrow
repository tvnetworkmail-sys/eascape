[questhelper_step_squire_1]
table=questhelper_step
data=id,59001
data=section,0
data=text,Talk to the Squire in Falador Castle's courtyard.
data=npc,squire
data=coord,0_46_52_34_13
data=option,And how is life as a squire?
data=option,I can make a new sword if you like...
data=option,So would these dwarves make another one?
data=option,Yes.

[questhelper_step_squire_2]
table=questhelper_step
data=id,59002
data=section,0
data=text,Talk to Reldo in Varrock Castle's library.
data=npc,reldo_normal
data=coord,0_50_54_11_38
data=option,What do you know about the Imcando dwarves?

[questhelper_step_squire_3]
table=questhelper_step
data=id,59003
data=section,1
data=text,Talk to Thurgo south of Port Sarim and give him a redberry pie.
data=npc,thurgo
data=coord,0_46_49_56_9
data=option,Would you like a redberry pie?
data=item,redberry_pie,1

[questhelper_step_squire_4]
table=questhelper_step
data=id,59004
data=section,1
data=text,Talk to Thurgo again.
data=npc,thurgo
data=coord,0_46_49_56_9
data=option,Can you make a special sword for me?

[questhelper_step_squire_5]
table=questhelper_step
data=id,59005
data=section,2
data=text,Talk to the Squire in Falador Castle's courtyard.
data=npc,squire
data=coord,0_46_52_34_13

[questhelper_step_squire_6]
table=questhelper_step
data=id,59006
data=section,2
data=text,Climb up the east ladder in Falador Castle.
data=coord,0_46_52_50_13

[questhelper_step_squire_7]
table=questhelper_step
data=id,59007
data=section,2
data=text,Go up the staircase west of the ladder on the 1st floor.
data=coord,1_46_52_41_10

[questhelper_step_squire_8]
table=questhelper_step
data=id,59008
data=section,2
data=text,Search the cupboard in the room south of the staircase. You'll need Sir Vyvin to be in the other room.
data=loc,vyvincupboardopen
data=coord,2_46_52_41_8

[questhelper_step_squire_9]
table=questhelper_step
data=id,59009
data=section,2
data=text,Bring Thurgo the portrait.
data=npc,thurgo
data=coord,0_46_49_56_9
data=option,About that sword...
data=item,iron_bar,2
data=item,knights_portrait,1

[questhelper_step_squire_10]
table=questhelper_step
data=id,59010
data=section,3
data=text,Go down the ladder south of Port Sarim. Be prepared for ice giants and ice warriors to attack you.
data=loc,loc_1738
data=coord,0_47_49_0_14
data=item,iron_bar,2

[questhelper_step_squire_11]
table=questhelper_step
data=id,59011
data=section,3
data=text,Mine a blurite ore in the eastern cavern.
data=loc,macro_candlelight_pillar11
data=coord,0_47_149_41_30

[questhelper_step_squire_12]
table=questhelper_step
data=id,59012
data=section,3
data=text,Return to Thurgo with a blurite ore and two iron bars.
data=npc,thurgo
data=coord,0_46_49_56_9
data=option,Can you make that replacement sword now?
data=item,blurite_ore,1
data=item,iron_bar,2

[questhelper_step_squire_13]
table=questhelper_step
data=id,59013
data=section,4
data=text,Return to the Squire with the sword to finish the quest.
data=npc,squire
data=coord,0_46_52_34_13
data=item,faladian_sword,1
