//   NPC GRANDTREE_NARNODE_1OP not matched
//   NPC GT_ANITA not matched
//   NPC PILOT_GRAND_TREE_BASE not matched
//   NpcInteractingRequirement not carried over

[proc,questhelper_grandtree]()(int)
