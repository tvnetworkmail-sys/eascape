[proc,qh_grandtree_c1]()(boolean)
if (calc(inv_total(inv, grandtree_daconiarock) + inv_total(worn, grandtree_daconiarock)) >= 1) return(true);
return(false);

[proc,qh_grandtree_c2]()(boolean)
