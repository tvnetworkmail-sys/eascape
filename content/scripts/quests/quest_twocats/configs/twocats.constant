// A Tail of Two Cats (26 September 2005). The stage is the 377 cache's own %twocats_quest (varbit,
// bits 0-6 of twocats_varbit). The cache fixes three of the numbers: the music list unlocks Strange
// Place at 40 (the Sphinx's cutscene) and twocats_niete shows Neite at Unferth's house at 60, 65
// and 70 (Bob is home with her). The other numbers are ours (no source numbers them).
^ttc_not_started = 0
^ttc_started = 10       // Unferth asked you to see Hild
^ttc_hild = 15          // Hild wants five death runes
^ttc_amulet = 20        // Hild enchanted the amulet: find Bob
^ttc_found_bob = 25     // Bob is in love with Neite: ask Gertrude about his parents
^ttc_gertrude = 30      // Gertrude sent you to Reldo
^ttc_reldo = 35         // Reldo told the tale of Robert the Strong: back to Bob
^ttc_sphinx = 37        // Bob doesn't remember: see the Sphinx
^ttc_chores = 40        // the Sphinx's cutscene: Bob's list of chores (cache: Strange Place)
^ttc_chores_done = 45   // every chore done: talk to Unferth
^ttc_ill = 50           // Unferth wants a doctor: see the Apothecary
^ttc_hat = 55           // the Apothecary gave you a hat
^ttc_cured = 60         // Unferth is "cured": find Bob (cache: Neite at Unferth's)
^ttc_holiday = 65       // Bob's holiday cutscene: back to Unferth
^ttc_complete = 70
^ttc_questpoints = 2

// the chores' own varbits (the cache's names; their values are the cache's multilocs/multinpcs)
^ttc_bed_made = 1                // %twocats_chores_tidyhouse: twocats_bed_made
^ttc_fire_wood = 1               // %twocats_chores_warmhuman: twocats_fireplace_got_wood
^ttc_fire_lit = 2                // twocats_fireplace_lit
^ttc_table_empty = 1             // %twocats_chores_feedhuman: twocats_table_empty
^ttc_table_milk = 2
^ttc_table_cake = 3
^ttc_table_full = 4              // twocats_table_cake_milk
^ttc_hair_long = 4               // %twocats_chores_tidyhuman: twocats_unferth_longhair
^ttc_hair_bald = 8               // the shears' run ends at 8, twocats_unferth_bald
^ttc_patch_weeded = 3            // %twocats_chores_tidygarden: twocats_patch_weeded
^ttc_patch_planted = 4           // twocats_patch_potato1
^ttc_patch_grown = 8             // twocats_patch_potato5

// places. Unferth's house (the map's twocats locs, 2917-2920,3556-3559); its door faces east.
^ttc_unferth_door = 0_45_55_44_38
^ttc_bob_spawn = 0_45_55_44_45
// ours: "Come with me into the desert" - open sand north of Sophanem's wall
^ttc_desert_player = 0_51_44_30_22
^ttc_desert_sphinx = 0_51_44_30_25
^ttc_desert_bob = 0_51_44_28_23
^ttc_desert_neite = 0_51_44_32_23
// the dragonkin's castle (the 377 map square 29_70 holds the cache's dragonkin_city locs); ours:
// where everyone stands in its courtyard
^ttc_castle_player = 0_29_70_34_16
^ttc_castle_robert = 0_29_70_33_21
^ttc_castle_odysseus = 0_29_70_36_21
^ttc_castle_dragonkin = 0_29_70_34_30
// the holiday: Sophanem (map square 51_43), the King Black Dragon's lair (35_73) and a ship at sea
// (the trawler's deck, 1_29_75). Ours: where they stand.
^ttc_carpet_player = 0_51_43_20_34
^ttc_carpet_start = 0_51_43_26_40
^ttc_carpet_mid = 0_51_43_16_31
^ttc_carpet_end = 0_51_43_24_29
^ttc_kbd_player = 0_35_73_20_15
^ttc_kbd_dragon = 0_35_73_20_27
^ttc_kbd_bob = 0_35_73_19_22
^ttc_kbd_neite = 0_35_73_21_22
^ttc_kbd_noob_from = 0_35_73_12_14
^ttc_kbd_noob_to = 0_35_73_18_24
^ttc_ship_player = 1_29_75_33_25
^ttc_ship_cats = 1_29_75_41_25

// ours: how close counts as "very close to Bob" for the locator (Hild: the eyes and mouth animate
// whichever way the nose points)
^ttc_locator_close = 10
