[questhelper_step_mortton_13]
table=questhelper_step
data=id,47013
data=section,2
data=text,"Buy some olive oil from Razmire's general store, and 5 timber beams, 5 limestone bricks, and 25 swamp paste from their builders' store. Afterwards, use some serum 207 on Ulsquire."
