// EASCape: Swan Song (quest_swan), the update of 2 May 2006. %swansong is the cache's own quest
// varbit (swansong_quest bits 0-8); its NPCs change at 0, 5, 10 ... 200 (the cache's multinpcs), so
// those are the stages; what each one means is ours, read off which NPC the cache shows when.
^swan_not_started = 0
^swan_started = 5         // Herman sends you for the Wise Old Man
^swan_runes = 15          // the Wise Old Man wants runes
^swan_wom_outside = 30    // he's gone to wait outside the Colony
^swan_ready = 40          // he's ready to go through the tunnel
^swan_ambush = 50         // the trolls attack
^swan_ambush_won = 55     // the trolls are dead
^swan_inside = 60         // in the Colony
^swan_helping = 65        // help Franklin and Arnold
^swan_army = 80           // fetch an army from Wizard Frumscone
^swan_necro = 90          // he sends you to Malignius Mortifer
^swan_bones = 95          // Malignius wants seven bones
^swan_crafter = 100       // ask the master crafters about carrying bone seeds
^swan_pot = 110           // a pot with a lid
^swan_seeds = 120         // you have the bone seeds
^swan_queen = 150         // the battle: the Sea Troll Queen
^swan_queen_dead = 160    // she's dead: Herman has your reward
^swan_complete = 200
^swan_questpoints = 2
// the requirements of 2006 (the RuneScape wiki: 101 quest points until 19 Feb 2024; the skills as
// the OSRS wiki)
^swan_qp_needed = 101

// the Colony (the cache's map, m36_57)
^swan_outside = 0_36_57_41_3
^swan_hole_out = 0_36_57_40_3
^swan_hole_in = 0_36_57_40_6
^swan_herman_office = 0_36_57_50_35
^swan_kathy_colony = 0_36_56_53_56
^swan_kathy_stronghold = 0_37_54_0_30
// the battle (ours: in front of the Colony gate)
^swan_battle_spot = 0_36_57_41_7
^swan_queen_spot = 0_36_57_35_8
^swan_wom_spot = 0_36_57_44_7
