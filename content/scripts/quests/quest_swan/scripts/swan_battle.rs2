// EASCape: Swan Song (2 May 2006): the final battle and the reward. The cutscene (the skeleton magi
// against the trolls, the Wise Old Man against the general) is told in the chat (ours); then the Sea
// Troll Queen, who can't move, hits with her fists (16) and Water Wave (37) (the OSRS wiki).

[label,swan_herman_seeds]
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Hello, <displayname>.");
~chatplayer("<p,neutral>Hello, old man.");
~chatnpc("<p,neutral><displayname> - have you brought an army?");
if (inv_total(inv, swan_army) < 1) {
    ~chatplayer("<p,sad>Not with me."); // ours: you've left the pot behind
    return;
}
~chatplayer("<p,happy>Yes, I've got it here!");
~chatnpc("<p,confused>You've got what?");
~chatplayer("<p,neutral>The army's in this pot!");
~chatnpc("<p,confused>Have you been drinking?");
~chatplayer("<p,neutral>No, really, the wizard told me he'd put bone seeds in this pot, and when I opened it the army would come forth from the bone seeds.");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,confused>Frumscone gave you bone seeds?");
~chatplayer("<p,worried>Oh... um...");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,angry>Hmmmph. I don't much like the sound of this. I certainly won't be sending anyone to Frumscone for help again!");
~chatplayer("<p,worried>Well... it wasn't exactly...");
~chatnpc("<p,neutral>You can talk about that later! Now we've got an army we can get on with beating the trolls!");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Well, I suppose so. <displayname>, this could be VERY dangerous. Do you feel ready to fight?");
~chatplayer("<p,confused>Aren't you going to do the fighting?");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Yes, of course. But you, my trusty sidekick, are in this adventure with me, and if I'm going forth into battle, you should make sure you're ready too.");
if (~p_choice2("I'm ready. Let's fight!", 1, "I'd like to get some stuff together first.", 2) = 2) {
    ~chatplayer("<p,neutral>I'd like to get some stuff together first.");
    ~chatnpc("<p,neutral>Come back to us as soon as you're ready.");
    return;
}
~chatplayer("<p,angry>I'm ready. Let's fight!");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Good. May this, my final adventure, end well!");
if (inv_total(inv, swan_army) < 1) return;
inv_del(inv, swan_army, 1);
%swansong = ^swan_queen;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
@swan_battle;

[label,swan_battle_again]
if (~p_choice2_header("Yes, I missed it. Show me the battle again.", 1, "No, I'm ready to move on with the quest.", 2, "Do you need to see the battle again?") = 1) @swan_battle;
@swan_battle_queen;

[label,swan_battle]
~fade_out;
p_delay(2);
p_telejump(^swan_battle_spot);
p_delay(1);
~fade_in;
anim(swan_pot_open, 0);
spotanim_pl(swan_pot_spotanim, 0, 0);
~mesbox("You open the pot. An army of skeletal magi rises from the bone seeds and drives off the sea trolls coming out of the water.");
~chatplayer("<p,happy>The trolls are dead!");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>They weren't very tough.");
~mesbox("A sea troll general appears from the ocean.");
~chatplayer("<p,worried>Oh... dear...");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Leave this to me...");
~mesbox("The Wise Old Man does battle with the sea troll general, deftly avoiding its strikes before finishing it off with his powerful magic.");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,happy>Aahh, that was fun.");
~chatplayer("<p,confused>How did you do that?");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,happy>Talent, my dear.");
~mesbox("A spell flies in from nowhere, hitting the Wise Old Man and knocking him to the ground. The Sea Troll Queen appears.");
~chatnpc_specific("Wise Old Man", swan_wom_coma, "<p,sad>I... can't... move... <displayname>, you must fight this for me...");
@swan_battle_queen;

[label,swan_battle_queen]
if (distance(coord, ^swan_battle_spot) > 6) p_telejump(^swan_battle_spot);
npc_huntall(^swan_battle_spot, 10, 0);
while (.npc_findnext = true) {
    if (.npc_type = swan_seatroll_queen | .npc_type = swan_wom_coma) .npc_del;
}
.npc_add(^swan_wom_spot, swan_wom_coma, 500);
.npc_anim(wom_watchman_death, 0);
.npc_add(^swan_queen_spot, swan_seatroll_queen, 500);
.npc_anim(swan_seatroll_water_rise, 0);
.%npc_aggressive_player = uid;
.npc_setmode(applayer2);

// ---------------------------------------------------------------- the queen
[ai_applayer2,swan_seatroll_queen]
if (%npc_action_delay > map_clock) return;
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (npc_range(coord) <= 1 & random(2) = 0) {
    gosub(npc_default_attack);
    return;
}
%npc_action_delay = add(map_clock, npc_param(attackrate));
npc_anim(swan_queen_spellcast, 0);
def_int $duration = ~player_projectile(npc_coord, coord, uid, waterwave_travel, 80, 36, 30, 15, 0, 11, 5);
spotanim_pl(waterwave_impact, 92, $duration);
def_int $damage = 0;
if (randominc(~npc_magic_attack_roll) > randominc(~player_defence_roll_specific(^magic_style))) $damage = randominc(37);
if (~check_protect_prayer(^magic_style) = true) $damage = 0;
anim(%com_defendanim, $duration);
queue(combat_damage_player, calc($duration / 30), $damage);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;

[ai_opplayer2,swan_seatroll_queen] npc_setmode(applayer2);
[ai_queue1,swan_seatroll_queen] gosub(npc_default_retaliate_ap);

[ai_queue3,swan_seatroll_queen]
if (finduid(%npc_aggressive_player) = true) queue(swan_queen_killed, 0, 0);
npc_huntall(npc_coord, 10, 0);
while (.npc_findnext = true) {
    if (.npc_type = swan_wom_coma) .npc_del;
}
gosub(npc_default_death);

[queue,swan_queen_killed](int $unused)
if (%swansong ! ^swan_queen) return;
%swansong = ^swan_queen_dead;
~send_quest_progress(questlist:swansong, %swansong, ^swan_complete);
~chatplayer("<p,happy>Now I've killed that THING, Herman's sure to reward me!");

// ---------------------------------------------------------------- the reward
[label,swan_herman_reward]
~chatplayer("<p,happy>I've defeated the Sea Troll Queen!");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,happy>Your fight was truly magnificent, <displayname>! Congratulations!");
~chatnpc("<p,happy><displayname>, how can I ever thank you? You have saved my Fishing Colony from utter destruction!");
~chatplayer("<p,shifty>Well, you mentioned something about a reward?");
~chatnpc("<p,happy>Of course, of course!");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>I think you've earned a little something from me, too.");
~chatplayer("<p,happy>Ooh, goody! Thanks, old man! Um... can I have your hat?");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,sad>'Old man'... yes, I am old. That creature nearly killed me - I have never been so close to defeat.");
~chatplayer("<p,happy>Aww, cheer up - we won! But can I have your hat as my reward?");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,sad>Yes, we won... YOU won... It is definitely time I retired.");
~chatplayer("<p,shifty>So that's the end of your adventuring? Also, how about that hat of yours?");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,neutral>Well, I'm sure I'll find some way to keep myself busy. But yes, this has been my last quest. My swan song.");
~chatplayer("<p,shifty>It's been... nice working with you! It'd be even nicer if you'd give me that hat...");
~chatnpc_specific("Wise Old Man", wom_inactive, "<p,happy>It's been a pleasure working with you too. Do pop in to see me in Draynor soon! I leave you with my blessing...");
mes("The Wise Old Man teleports away.");
~chatnpc("<p,neutral>Oh, he's gone. I hope he enjoys his retirement.");
~chatplayer("<p,angry>HE DIDN'T GIVE ME HIS HAT!");
anim(emote_cry, 0);
~chatnpc("<p,confused>It's only a hat!");
~chatplayer("<p,angry>!!!");
anim(emote_dance_headbang, 0);
~chatplayer("<p,neutral>Anyway, you were going to reward me too?");
~chatnpc("<p,happy>Oh yes, of course! You are hereby welcome to visit the Piscatoris Fishing Colony at any time and make full use of our fishing spots!");
~chatplayer("<p,quiz>Why is it better to fish here than in Catherby or the Fishing Guild?");
~chatnpc("<p,happy>Ah, I'm glad you asked that! You see, this is the only known place where you can catch monkfish!");
~chatplayer("<p,confused>Ok, so I can catch monkfish. Um... thanks?!");
~chatnpc("<p,neutral>Yes - there's good eating on a monkfish. They heal more health than the swordfish and lobsters most adventurers carry around, but they're easier to catch than sharks.");
~chatplayer("<p,neutral>I suppose that could be useful.");
~chatnpc("<p,neutral>Indeed! I'm sure Arnold will help you send your monkfish to your bank account. Also, seaweed accumulates in the nets down by the shore, which you might find useful. Franklin says it's much quicker than trying to gather it on Entrana.");
~chatplayer("<p,neutral>Maybe if I ever want to do glassblowing again...");
~chatnpc("<p,happy>Finally, I'd like to give you a little token of my thanks.");
queue(swan_complete, 0, 0);
~chatplayer("<p,happy>Thank you very much!");
~chatnpc("<p,happy>No, thank YOU!");

// 2 quest points, 15,000 Magic, 10,000 Prayer, 10,000 Fishing (2006: the OSRS wiki's Fishing reward was
// 10,000 until 30 Nov 2022) and 25,000 coins
[queue,swan_complete]
if (%swansong >= ^swan_complete) return;
%swansong = ^swan_complete;
stat_advance(magic, 150000);
stat_advance(prayer, 100000);
stat_advance(fishing, 100000);
inv_add(inv, coins, 25000);
session_log(^log_adventure, "Quest complete: Swan Song");
~send_quest_complete(questlist:swansong, swan_army, 250, ^swan_questpoints, "You have completed Swan Song!", "2 Quest Points|15,000 Magic XP|10,000 Prayer XP|10,000 Fishing XP|25,000 coins|Access to the Piscatoris Fishing Colony");
