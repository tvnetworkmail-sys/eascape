// EASCape: the in-game Quest Helper was removed (8 Nov 2026); these two stay so old saves load,
// and login clears them.
// The quest you're following and the step you're on (step numbers are the guide's own;
// guide * 100 + step is the questhelper_step row). Sent to the client for the app's plugin.
[questhelper_guide]
scope=perm
transmit=yes

[questhelper_step]
scope=perm
transmit=yes
