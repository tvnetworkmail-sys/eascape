// EASCape's Quest Helper, server side. RuneLite's Quest Helper (BSD 2-Clause, Copyright (c)
// 2020, Zoinkwiz) knows where you are in a quest by reading the game's varps; here the server
// is the game, so each guide has a proc that looks at the quest's own varps, your items and
// where you are, and gives the step. While you follow a quest:
//   - each new step is said in the chat box ("Quest Helper: ...") and the game's yellow hint
//     arrow points at its NPC or place;
//   - the quest's journal shows the current step at the bottom;
//   - the app's Quest Helper plugin (which reads questhelper_guide / questhelper_step) adds
//     the highlights, the walking route and the dialogue options.
// You follow a quest by opening its journal (when it has a guide), with the app's Quest
// Helper panel, or with ::questhelper <quest>; ::questhelper off stops.

// the step you're on in a guide; 0 when the quest is done (one case per guide)
[proc,questhelper_current](int $guide)(int)
switch_int ($guide) {
    case ^qh_cook : return(~questhelper_cook);
    case ^qh_priestperil : return(~questhelper_priestperil);
    case ^qh_waterfall : return(~questhelper_waterfall);
    case ^qh_troll : return(~questhelper_troll);
    case ^qh_ikov : return(~questhelper_ikov);
    case ^qh_itexam : return(~questhelper_itexam);
    case ^qh_desertrescue : return(~questhelper_desertrescue);
    case ^qh_demon : return(~questhelper_demon);
    case ^qh_gobdip : return(~questhelper_gobdip);
    case ^qh_deserttreasure : return(~questhelper_deserttreasure);
    case ^qh_fairy1 : return(~questhelper_fairy1);
    case ^qh_fairy2 : return(~questhelper_fairy2);
    case ^qh_arena : return(~questhelper_arena); // converted
    case ^qh_arthur : return(~questhelper_arthur); // converted
    case ^qh_ball : return(~questhelper_ball); // converted
    case ^qh_biohazard : return(~questhelper_biohazard); // converted
    case ^qh_blackarmgang : return(~questhelper_blackarmgang); // converted
    case ^qh_chompybird : return(~questhelper_chompybird); // converted
    case ^qh_cog : return(~questhelper_cog); // converted
    case ^qh_crest : return(~questhelper_crest); // converted
    case ^qh_death : return(~questhelper_death); // converted
    case ^qh_doric : return(~questhelper_doric); // converted
    case ^qh_dragon : return(~questhelper_dragon); // converted
    case ^qh_druid : return(~questhelper_druid); // converted
    case ^qh_druidspirit : return(~questhelper_druidspirit); // converted
    case ^qh_drunkmonk : return(~questhelper_drunkmonk); // converted
    case ^qh_eadgar : return(~questhelper_eadgar); // converted
    case ^qh_elemental_workshop : return(~questhelper_elemental_workshop); // converted
    case ^qh_elena : return(~questhelper_elena); // converted
    case ^qh_fishingcompo : return(~questhelper_fishingcompo); // converted
    case ^qh_fluffs : return(~questhelper_fluffs); // converted
    case ^qh_fortress : return(~questhelper_fortress); // converted
    case ^qh_golem : return(~questhelper_golem); // converted
    case ^qh_grail : return(~questhelper_grail); // converted
    case ^qh_grandtree : return(~questhelper_grandtree); // converted
    case ^qh_haunted : return(~questhelper_haunted); // converted
    case ^qh_hauntedmine : return(~questhelper_hauntedmine); // converted
    case ^qh_hazeelcult : return(~questhelper_hazeelcult); // converted
    case ^qh_hero : return(~questhelper_hero); // converted
    case ^qh_hetty : return(~questhelper_hetty); // converted
    case ^qh_horror : return(~questhelper_horror); // converted
    case ^qh_hunt : return(~questhelper_hunt); // converted
    case ^qh_imp : return(~questhelper_imp); // converted
    case ^qh_itgronigen : return(~questhelper_itgronigen); // converted
    case ^qh_itwatchtower : return(~questhelper_itwatchtower); // converted
    case ^qh_junglepotion : return(~questhelper_junglepotion); // converted
    case ^qh_legends : return(~questhelper_legends); // converted
    case ^qh_mcannon : return(~questhelper_mcannon); // converted
    case ^qh_misc : return(~questhelper_misc); // converted
    case ^qh_mm : return(~questhelper_mm); // converted
    case ^qh_mortton : return(~questhelper_mortton); // converted
    case ^qh_murder : return(~questhelper_murder); // converted
    case ^qh_priest : return(~questhelper_priest); // converted
    case ^qh_prince : return(~questhelper_prince); // converted
    case ^qh_regicide : return(~questhelper_regicide); // converted
    case ^qh_romeojuliet : return(~questhelper_romeojuliet); // converted
    case ^qh_routequest : return(~questhelper_routequest); // converted
    case ^qh_runemysteries : return(~questhelper_runemysteries); // converted
    case ^qh_scorpcatcher : return(~questhelper_scorpcatcher); // converted
    case ^qh_seaslug : return(~questhelper_seaslug); // converted
    case ^qh_sheep : return(~questhelper_sheep); // converted
    case ^qh_sheepherder : return(~questhelper_sheepherder); // converted
    case ^qh_squire : return(~questhelper_squire); // converted
    case ^qh_tbwt : return(~questhelper_tbwt); // converted
    case ^qh_totem : return(~questhelper_totem); // converted
    case ^qh_tree : return(~questhelper_tree); // converted
    case ^qh_troll_love : return(~questhelper_troll_love); // converted
    case ^qh_upass : return(~questhelper_upass); // converted
    case ^qh_vampire : return(~questhelper_vampire); // converted
    case ^qh_viking : return(~questhelper_viking); // converted
    case ^qh_zanaris : return(~questhelper_zanaris); // converted
    case ^qh_zombiequeen : return(~questhelper_zombiequeen); // converted
}
return(0);

[proc,questhelper_guide_row](int $guide)(dbrow)
db_find(questhelper_guide:guide, $guide);
return(db_findnext);

[proc,questhelper_step_row](int $guide, int $step)(dbrow)
db_find(questhelper_step:id, add(multiply($guide, 1000), $step)); // step ids: guide * 1000 + step
return(db_findnext);

[proc,questhelper_follow](int $guide)
def_dbrow $row = ~questhelper_guide_row($guide);
if ($row = null) {
    return;
}
if (~questhelper_current($guide) = 0) {
    mes("Quest Helper: you've already completed <db_getfield($row, questhelper_guide:name, 0)>.");
    return;
}
if (%questhelper_guide ! $guide) {
    %questhelper_guide = $guide;
    %questhelper_step = 0;
    mes("Quest Helper: following <db_getfield($row, questhelper_guide:name, 0)>.");
}
settimer(questhelper, 2);
~questhelper_update;

[proc,questhelper_stop]
%questhelper_guide = 0;
%questhelper_step = 0;
cleartimer(questhelper);
hint_stop;

[timer,questhelper]
~questhelper_update;

[proc,questhelper_update]
if (%questhelper_guide <= 0) {
    cleartimer(questhelper);
    return;
}
def_int $step = ~questhelper_current(%questhelper_guide);
if ($step = 0) {
    def_dbrow $guide = ~questhelper_guide_row(%questhelper_guide);
    if ($guide ! null) {
        mes("Quest Helper: you've completed <db_getfield($guide, questhelper_guide:name, 0)>.");
    }
    ~questhelper_stop;
    return;
}
def_dbrow $row = ~questhelper_step_row(%questhelper_guide, $step);
if ($row = null) {
    return;
}
if ($step ! %questhelper_step) {
    %questhelper_step = $step;
    // the step's text is in the app's sidebar, so it isn't repeated in the chatbox
    ~questhelper_hint($row);
} else if (calc(map_clock % 10) = 0) {
    // keep the arrow on the NPC as you move about (it may not have been in sight before)
    ~questhelper_hint($row);
}

/** The game's hint arrow: on the nearest NPC the step wants, otherwise on its place. */
[proc,questhelper_hint](dbrow $row)
def_int $i = 0;
def_int $n = db_getfieldcount($row, questhelper_step:npc);
while ($i < $n) {
    if (npc_find(coord, db_getfield($row, questhelper_step:npc, $i), 15, 0) = true) {
        hint_npc;
        return;
    }
    $i = add($i, 1);
}
if (db_getfieldcount($row, questhelper_step:coord) > 0) {
    def_coord $at = db_getfield($row, questhelper_step:coord, 0);
    if (coordy($at) = coordy(coord) & distance($at, coord) < 64) {
        hint_coord(^hint_center, $at, 100);
        return;
    }
}
hint_stop;

/** Called by the quest journal: opening a quest's journal follows that quest in the sidebar. */
[proc,questhelper_journal](string $quest_name, string $journal_text)(string)
db_find(questhelper_guide:journal, $quest_name);
def_dbrow $guide = db_findnext;
if ($guide = null) {
    return($journal_text);
}
def_int $id = db_getfield($guide, questhelper_guide:guide, 0);
def_int $step = ~questhelper_current($id);
if ($step = 0) {
    return($journal_text);
}
if (%questhelper_guide ! $id) {
    ~questhelper_follow($id);
}
// the step itself is shown in the app's sidebar, not added to the journal
return($journal_text);

[proc,questhelper_login]
if (%questhelper_guide > 0) {
    %questhelper_step = 0; // put the hint arrow back
    settimer(questhelper, 2);
}

// ::questhelper <quest> (its guide key, e.g. cook), ::questhelper off, ::questhelper list.
// Works for every player (ClientCheatHandler); the app's panel uses it too.
[proc,questhelper_command](string $arg)
if (compare($arg, "off") = 0 | compare($arg, "") = 0) {
    if (%questhelper_guide > 0) {
        mes("Quest Helper: stopped.");
    }
    ~questhelper_stop;
    return;
}
def_int $guide = 1;
def_dbrow $row = ~questhelper_guide_row($guide);
def_string $names = "";
while ($row ! null) {
    if (compare($arg, db_getfield($row, questhelper_guide:key, 0)) = 0) {
        ~questhelper_follow($guide);
        return;
    }
    $names = append($names, append(" ", db_getfield($row, questhelper_guide:key, 0)));
    $guide = add($guide, 1);
    $row = ~questhelper_guide_row($guide);
}
mes("Quest Helper guides:<$names>. Use ::questhelper off to stop.");
