[oplocu,_sand_pit] // EASCape: by category, so the Rellekka sand pit (viking_sandpit) fills buckets too
if (last_useitem = bucket_empty) @sand_fill;
~displaymessage(^dm_default);

[opheldu,glassblowingpipe]
if (last_useitem = molten_glass) @craft_glass_interface;

[opheldu,molten_glass]
if (last_useitem = glassblowingpipe) @craft_glass_interface;
if (last_useitem = lens_mould) @craft_telescope_disc;

[label,sand_fill]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
anim(human_fillbucket_sandpit, 0);
inv_del(inv, bucket_empty, 1);
inv_add(inv, bucket_sand, 1);
mes("You fill the bucket with sand.");

[label,smelt_glass]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
// just a guess for now. level failure:
if (stat(crafting) < 1) {
    ~mesbox("You need at least 1 Crafting to make Glass.");
    return;
}
// check if enough soda ash
if (inv_total(inv, soda_ash) < 1) {
    ~mesbox("You need some Soda Ash to make Glass.");
    return;
}
// check if enough sand
if (inv_total(inv, bucket_sand) < 1) {
    ~mesbox("You need some Sand to make Glass.");
    return;
}
// delete and add items in this order
inv_del(inv, bucket_sand, 1);
inv_add(inv, bucket_empty, 1);
inv_del(inv, soda_ash, 1);
inv_add(inv, molten_glass, 1);
// play anim and sound
anim(human_furnace,0);
sound_synth(furnace,0,0);
// success message
mes("You heat the sand and soda ash in the furnace to make glass.");
// give xp
stat_advance(crafting, 200);


// EASCape: the glassblowing menu is the cache's own glass_crafting screen (beer glass, candle
// lantern, oil lamp, vial, fishbowl, orb, lantern lens; Make 1/5/10/X on each). The old
// three-item picture menu (multiobj3) isn't in our cache, so glassblowing did nothing before.
// One every 3 ticks (Void glassblowing.recipes.toml: ticks = 3, its glassblowing sound).
[label,craft_glass_interface]
if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
if_openmain(glass_crafting);

[if_button,glass_crafting:com_10] @crafting_glass_x(vial_empty);
[if_button,glass_crafting:com_11] @crafting_glass_count(vial_empty, 10);
[if_button,glass_crafting:com_12] @crafting_glass_count(vial_empty, 5);
[if_button,glass_crafting:com_13] @crafting_glass_count(vial_empty, 1);
[if_button,glass_crafting:com_14] @crafting_glass_x(stafforb);
[if_button,glass_crafting:com_15] @crafting_glass_count(stafforb, 10);
[if_button,glass_crafting:com_16] @crafting_glass_count(stafforb, 5);
[if_button,glass_crafting:com_17] @crafting_glass_count(stafforb, 1);
[if_button,glass_crafting:com_18] @crafting_glass_x(beer_glass);
[if_button,glass_crafting:com_19] @crafting_glass_count(beer_glass, 10);
[if_button,glass_crafting:com_20] @crafting_glass_count(beer_glass, 5);
[if_button,glass_crafting:com_21] @crafting_glass_count(beer_glass, 1);
[if_button,glass_crafting:com_22] @crafting_glass_x(candle_lantern_empty);
[if_button,glass_crafting:com_23] @crafting_glass_count(candle_lantern_empty, 10);
[if_button,glass_crafting:com_24] @crafting_glass_count(candle_lantern_empty, 5);
[if_button,glass_crafting:com_25] @crafting_glass_count(candle_lantern_empty, 1);
[if_button,glass_crafting:com_26] @crafting_glass_x(oil_lamp_empty);
[if_button,glass_crafting:com_27] @crafting_glass_count(oil_lamp_empty, 10);
[if_button,glass_crafting:com_28] @crafting_glass_count(oil_lamp_empty, 5);
[if_button,glass_crafting:com_29] @crafting_glass_count(oil_lamp_empty, 1);
[if_button,glass_crafting:com_30] @crafting_glass_x(bullseye_lantern_lens);
[if_button,glass_crafting:com_31] @crafting_glass_count(bullseye_lantern_lens, 10);
[if_button,glass_crafting:com_32] @crafting_glass_count(bullseye_lantern_lens, 5);
[if_button,glass_crafting:com_33] @crafting_glass_count(bullseye_lantern_lens, 1);
[if_button,glass_crafting:com_34] @crafting_glass_x(fishbowl_empty);
[if_button,glass_crafting:com_35] @crafting_glass_count(fishbowl_empty, 10);
[if_button,glass_crafting:com_36] @crafting_glass_count(fishbowl_empty, 5);
[if_button,glass_crafting:com_37] @crafting_glass_count(fishbowl_empty, 1);

[label,crafting_glass_x](namedobj $glass_item)
// the amount box goes over the glassblowing window (closing it first cancelled the box); crafting_glass_count closes it
p_countdialog;
if (last_int < 1) return;
@crafting_glass_count($glass_item, last_int);

[label,crafting_glass_count](namedobj $glass_item, int $count)
if_close;
if (~crafting_glass_one($glass_item) = false) return;
if ($count > 1) weakqueue*(crafting_glass_next, 3)($glass_item, calc($count - 1));

[queue,crafting_glass_next](namedobj $glass_item, int $count)
if ($count < 1) return;
if (~crafting_glass_one($glass_item) = false) return;
if ($count > 1) weakqueue*(crafting_glass_next, 3)($glass_item, calc($count - 1));

[proc,crafting_glass_one](namedobj $glass_item)(boolean)
def_struct $struct = oc_param($glass_item, crafting_glass_struct);
// check if high enough level
def_int $level = struct_param($struct, levelrequire);
def_string $name = struct_param($struct, productmessage);
if (stat(crafting) < $level) {
    mes("You need level <tostring($level)> Crafting to make <$name>.");
    return(false);
}
if (inv_total(inv, molten_glass) < 1 | inv_total(inv, glassblowingpipe) < 1) return(false);
// delete molten glass
inv_del(inv, molten_glass, 1);
// add item
inv_add(inv, $glass_item, 1);
// play anim
anim(human_glassblowing,0);
sound_synth(glassblowing, 1, 0);
// display game message
mes("You make <$name>.");
// give xp
stat_advance(crafting, struct_param($struct, productexp));
return(true);
