[if_button,leather_crafting:com_128] @craft_leather(coif);
[if_button,leather_crafting:com_131] @craft_leather(leather_cowl);
// EASCape: the window's Make 5 and Make 10 options (the cache's; "make five" and "make ten" on
// leather crafting since 27 Sep 2004, Update:Skills, Duels and the Kalphite) did nothing before
[if_button,leather_crafting:com_112] @craft_leather_n(leather_armour, 5);
[if_button,leather_crafting:com_111] @craft_leather_n(leather_armour, 10);
[if_button,leather_crafting:com_115] @craft_leather_n(leather_gloves, 5);
[if_button,leather_crafting:com_114] @craft_leather_n(leather_gloves, 10);
[if_button,leather_crafting:com_118] @craft_leather_n(leather_boots, 5);
[if_button,leather_crafting:com_117] @craft_leather_n(leather_boots, 10);
[if_button,leather_crafting:com_121] @craft_leather_n(leather_vambraces, 5);
[if_button,leather_crafting:com_120] @craft_leather_n(leather_vambraces, 10);
[if_button,leather_crafting:com_124] @craft_leather_n(leather_chaps, 5);
[if_button,leather_crafting:com_123] @craft_leather_n(leather_chaps, 10);
[if_button,leather_crafting:com_127] @craft_leather_n(coif, 5);
