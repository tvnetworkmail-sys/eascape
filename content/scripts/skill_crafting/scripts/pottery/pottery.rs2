[opheldu,clay]
switch_obj (last_useitem)
{
    case bowl_water, bucket_water, jug_water : @make_softclay(last_useitem);
    case default : ~displaymessage(^dm_default);
};

[oplocu,potterywheel] @use_potters_wheel(last_useitem);
[oplocu,viking_potterywheel] @use_potters_wheel(last_useitem);

[oplocu,potteryoven] @use_pottery_oven(last_useitem);
[oplocu,viking_potteryoven] @use_pottery_oven(last_useitem);
[oplocu,fai_barbarian_pottery_oven] @use_pottery_oven(last_useitem);

[label,use_pottery_oven](obj $item)
switch_obj ($item)
{
    case bowl_unfired, piedish_unfired, pot_unfired, plantpot_unfired, potlid_unfired : @fire_pottery(last_useslot);
    case default : ~displaymessage(^dm_default);
};

[label,use_potters_wheel](obj $item)
switch_obj ($item)
{
    case softclay : @craft_pottery_interface;
    case clay : ~objbox(clay, "This clay is too hard to craft|You'll need to soften it with some water.", 250, 0, divide(^objbox_height, 2));
    case default : ~displaymessage(^dm_default);
};

[label,make_softclay](obj $water_source)
// https://youtu.be/48JsDRNXWAc?list=PLn23LiLYLb1bQ7Hwp77KoNBjKvpZQTfJT&t=240
/// clay works the same as rsc
def_namedobj $empty_source = oc_param($water_source, next_obj_stage);
mes("You mix the clay and water.");
inv_del(inv, clay, 1);
//delete water source
inv_del(inv, oc_param($empty_source, next_obj_stage), 1);
//add empty water source BEFORE soft clay
inv_add(inv, $empty_source, 1);
//add soft clay
inv_add(inv, softclay, 1);
p_delay(1); // 2 ticks
mes("You now have some soft workable clay.");

[label,craft_pottery_interface]
// EASCape: the make menu (Make 1, 5, 10 and X), the cache's skillmulti4 (pot, pie dish, bowl, plant
// pot) or skillmulti5 once you can make pot lids. Pottery wheels have had make five, ten and X
// since 27 Sep 2004 (Update:Skills, Duels and the Kalphite); 2006Scape's wheel uses this five-item
// screen. Was a text list (the 2004 three-picture menu isn't in our cache). The plant pot (Crafting
// 19, for Farming's saplings) is on it too; pot lids once Tassie has shown you how (One Small
// Favour, quest_favour/osf_step3.rs2)
def_namedobj $choice;
def_int $amt;
if (%onesmallfavour >= 200) {
    $choice, $amt = ~skill_multi5_header("What would you like to make?",
        pot_unfired, 0, 0, 120, "\\n\\n\\n\\nPot",
        piedish_unfired, 0, 0, 150, "\\n\\n\\n\\nPie Dish",
        bowl_unfired, 0, 0, 150, "\\n\\n\\n\\nBowl",
        plantpot_unfired, 0, 0, 120, "\\n\\n\\n\\nPlant pot",
        potlid_unfired, 0, 0, 150, "\\n\\n\\n\\nPot lid"
    );
} else {
    $choice, $amt = ~skill_multi4_header("What would you like to make?",
        pot_unfired, 120, "\\n\\n\\n\\nPot",
        piedish_unfired, 150, "\\n\\n\\n\\nPie Dish",
        bowl_unfired, 150, "\\n\\n\\n\\nBowl",
        plantpot_unfired, 120, "\\n\\n\\n\\nPlant pot"
    );
}
if ($choice = null | $amt < 1) {
    return;
}
@craft_pottery($choice, $amt);

// one every 3 ticks while you have soft clay (Void's Pottery: weakQueue 3, its "You make the clay
// into a ..." message); was one a click with a 2-tick delay
[label,craft_pottery](namedobj $item, int $amt)
if_close;
def_struct $struct = oc_param($item, crafting_pottery_struct);
def_string $name = lowercase(oc_name($item));
// Check level
def_int $level = struct_param($struct, levelrequire);
if (stat(crafting) < $level)
{
    ~objbox($item, "You need a Crafting level of <tostring($level)> to make a <substring($name, 8, string_length($name))>.", 250, 0, divide(^objbox_height, 2));
    return;
}
if (inv_total(inv, softclay) < 1) {
    mes("You need some soft clay to make that."); // ours
    return;
}
sound_synth(pottery, 1, 0);
anim(human_potterywheel, 0);
weakqueue*(craft_pottery_next, 3)($item, $amt);

[queue,craft_pottery_next](namedobj $item, int $amt)
if (inv_total(inv, softclay) < 1) return;
def_struct $struct = oc_param($item, crafting_pottery_struct);
def_string $name = lowercase(oc_name($item));
inv_del(inv, softclay, 1);
inv_add(inv, $item, 1);
stat_advance(crafting, struct_param($struct, processexp));
mes("You make the clay into a <substring($name, 8, string_length($name))>.");
$amt = sub($amt, 1);
if ($amt < 1 | inv_total(inv, softclay) < 1) return;
sound_synth(pottery, 1, 0);
anim(human_potterywheel, 0);
weakqueue*(craft_pottery_next, 3)($item, $amt);

// No level req for some reason (does have a success chance though)
[label,fire_pottery](int $last)
def_obj $last_obj = inv_getobj(inv, $last);
def_struct $struct = oc_param($last_obj, crafting_pottery_struct);
mes("You put the <oc_name(struct_param($struct, product))> in the oven.");
sound_synth(furnace, 1, 0);
anim(human_furnace, 0);

p_delay(2);

mes("The <oc_name(struct_param($struct, product))> hardens in the oven.");

p_delay(2);

def_namedobj $product = struct_param($struct, product);
// delete unfired item
inv_del(inv, $last_obj, 1);
// add fired item. success rate is the same for all unfired items
if (stat_random(crafting, 180, 800) = true) {
    inv_add(inv, $product, 1);
    stat_advance(crafting, struct_param($struct, productexp));
    mes("You remove the <oc_name($product)> from the oven.");
} else {
    mes("The <oc_name($product)> cracks in the oven.");
}


