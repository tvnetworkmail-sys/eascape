[opheld4,bucket_milk]
inv_del(inv, bucket_milk, 1);
inv_add(inv, bucket_empty, 1);

// EASCape: Empty on the everyday containers that had no script (their cache option is there);
// the words are ours
[opheld4,bucket_water] ~empty_container(bucket_empty);
[opheld4,bucket_sand] ~empty_container(bucket_empty);
[opheld4,bucket_compost] ~empty_container(bucket_empty);
[opheld4,bucket_supercompost] ~empty_container(bucket_empty);
[opheld4,bucket_ectoplasm] ~empty_container(bucket_empty);
[opheld4,apple_mush] ~empty_container(bucket_empty);
[opheld4,jug_water] ~empty_container(jug_empty);
[opheld4,bowl_water] ~empty_container(bowl_empty);
[opheld4,bowl_hot_water] ~empty_container(bowl_empty);
[opheld3,bowl_nettlewater] ~empty_container(bowl_empty);
[opheld3,bowl_nettletea] ~empty_container(bowl_empty);
[opheld3,bowl_nettletea_milky] ~empty_container(bowl_empty);
[opheld4,pot_flour] ~empty_container(pot_empty);
[opheld4,cup_water] ~empty_container(cup_empty);
[opheld4,cup_hot_water] ~empty_container(cup_empty);
[opheld4,goldbowl_water] ~empty_container(goldbowl_empty);
[opheld4,goldbowl_pure] ~empty_container(goldbowl_empty);
[opheld4,goldbowlbless_water] ~empty_container(goldbowlbless_empty);
[opheld4,goldbowlbless_pure] ~empty_container(goldbowlbless_empty);
[opheld3,fishbowl_water] ~empty_container(fishbowl_empty);

[proc,empty_container](namedobj $empty)
inv_setslot(inv, last_slot, $empty, 1);
mes("You empty the <lowercase(oc_name($empty))>.");
