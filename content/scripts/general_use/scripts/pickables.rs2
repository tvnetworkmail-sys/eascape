// Pickable flax
// Could only pick one flax at a time until this update: https://oldschool.runescape.wiki/w/Update:Santa,_Flax_and_Castlewars
// (EASCape: now picked the later way, see below)
[oploc2,flax]
if(inv_freespace(inv) = 0) {
    mes("You can't carry any more flax.");
} else {
    if (afk_event = ^true) {
        ~macro_event_general_spawn(~macro_event_set_random);
        return;
    }
    anim(human_pickupfloor, 0);
    p_delay(0);
    sound_synth(pick, 1, 0);
    mes("You pick some flax.");
    inv_add(inv, flax, 1);
    // EASCape: the plant can be picked again; each pick has a 1 in 5 chance of using it up,
    // and it grows back after 5 seconds (Void picking.tables.toml flax: chance 5, respawn 5;
    // your call, 31 Oct 2026). It used to go after every pick.
    if (random(5) = 0) {
        loc_del(8);
    }
}
