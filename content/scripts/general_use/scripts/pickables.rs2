// Pickable Potatoes
[oploc2,potato]
p_arrivedelay;
if(inv_freespace(inv) = 0) {
    mes("You don't have room for this potato.");
    p_teleport(loc_coord);
    p_delay(0);
} else {
    ~pickup_loc_floor(loc_coord, potato, 50, true);
    mes("You pick a potato.");
}

// Pickable Wheat
[label,pick_wheat]
p_arrivedelay;
if(inv_freespace(inv) = 0) {
    mes("You can't carry any more grain.");
    p_teleport(loc_coord);
    p_delay(0);
} else {
    ~pickup_loc_floor(loc_coord, grain, 20, true);
    mes("You pick some grain.");
    // from Lost City 289: Throne of Miscellania
    if (inzone(^miscellania_lower_bound, ^miscellania_upper_bound, coord) = true) {
        if(npc_find(coord, misc_farmer, 15, 0) = true) {
            ~chatnpc("<p,angry>Oi! Leave my wheat alone!");
        }
    }
}

[oploc2,wheat]
@pick_wheat;

[oploc2,wheat_small]
@pick_wheat;

[oploc2,wheat_smallest]
@pick_wheat;

// Pickable Onion
[oploc2,onion]
