// EASCape: see eascape_links.dbrow
[eascape_links]
column=from,coord,INDEXED,REQUIRED
column=op,int,REQUIRED
column=to,coord,REQUIRED
column=up,boolean,REQUIRED
// 0 the matching counterpart (from the map); from Void: 1 move by dx/dz/dl, 2 exactly to, 3 the
// nearest square of the w x h area at to
column=kind,int
column=dx,int
column=dz,int
column=dl,int
column=w,int
column=h,int
default=kind,0
default=dx,0
default=dz,0
default=dl,0
default=w,1
default=h,1
