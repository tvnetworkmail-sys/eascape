// the tunnel between the Keldagrim entrance cave and the mines by the Dwarven Ferryman (2009scape's
// KeldagrimPlugin: 5973 -> 2838,10125, 5998 -> 2780,10161)
[oploc1,dwarf_cavewall_tunnel] p_telejump(0_44_158_22_13);
[oploc1,dwarf_cave_entrance] p_telejump(0_43_158_28_49);

// the Dwarven Boatman between the mines and Keldagrim (the OSRS wiki's transcript, its standard
// dialogue). Your first ride starts The Giant Dwarf (quest_giant_dwarf/gd_start.rs2). Ours: where
// you land (2843,10129 in the mines, 2892,10227 in the city)
[opnpc1,dwarf_city_boatman_mines_prequest]
if (%giantdwarf_quest = ^gd_not_started) @gd_boatman_start;
~chatnpc("<p,happy>Hello again, <displayname>! Want to go back to Keldagrim?");
if (~p_choice2("Yes, please take me.", 1, "What, on your ship? No way.", 2) = 2) {
    ~chatplayer("<p,neutral>What, on your ship? No way.");
    ~chatnpc("<p,neutral>Hey, it was only a little accident! Calm down!");
    return;
}
~chatplayer("<p,happy>Yes, please take me.");
@dwarf_boatman_trip(0_45_159_12_51);

[opnpc1,dwarf_city_boatman_city]
~chatnpc("<p,quiz>Want me to take you back to the mines?");
if (~p_choice2("Yes, please take me.", 1, "What, on your ship! No thanks!", 2) = 2) {
    @gd_boatman_city_refuse;
}
~chatplayer("<p,happy>Yes, please take me.");
@dwarf_boatman_trip(0_44_158_27_17);

[label,dwarf_boatman_trip](coord $dest)
mes("You board the boat."); // ours
p_delay(2);
p_telejump($dest);
mes("The boat arrives at its destination."); // ours

// ---------------------------------------------------------------- Keldagrim's carts
// The OSRS wiki's cart conductor transcript gives the Keldagrim station's words and fares (Ice
// Mountain 150, White Wolf Mountain 100 once Fishing Contest is done, half with the Ring of
// Charos); 2009scape's CartConductorDialogue gives the far conductors' words, and its
// KeldagrimCartMethods the ride: into Keldagrim the screen fades, you ride the cart from 2942,10175
// west to 2915,10175 as it fades back, and step off by a mine cart (npc 1544, ours
// hauntedmine_boss_cart, "Mine cart"); out of Keldagrim you ride from 2911,10171 east to 2936,10171,
// the screen fades and you arrive (White Wolf Mountain 2875,9871, Ice Mountain 2997,9837). The
// 2007 cache's ride animation (human_minecart_anim) is what you ride in. The far carts' "Ride"
// (2007's icemountain_train_cart and whitewolfmountain_train_cart) asks the fare too (ours). Ours:
// once paid you ride at once (OSRS has tickets and tracks), the Grand Exchange route is left out
// (2006 has none). The OSRS wiki: you must have started The Giant Dwarf to ride (2009scape's far
// conductors' words when you haven't); White Wolf Mountain needs only Fishing Contest, as in 2005.
[opnpc1,dwarf_city_train_conductor1] @keldagrim_cart_station;
[opnpc1,dwarf_city_train_conductor2] @keldagrim_cart_station;
[opnpc1,dwarf_city_train_conductor3] @keldagrim_cart_station;
[opnpc1,dwarf_city_train_conductor4] @keldagrim_cart_station;
[opnpc1,dwarf_city_train_conductor5] @keldagrim_cart_station;
[opnpc1,dwarf_city_train_conductor8] @keldagrim_cart_station;

[label,keldagrim_cart_station]
if (%giantdwarf_quest = ^gd_not_started) {
    ~chatplayer("<p,neutral>I'd like to use your cart, please.");
    ~chatnpc("<p,neutral>Sorry, but I can only take people who have been there before."); // 2009scape (ours: here too)
    return;
}
~chatnpc("<p,quiz>Yes <text_gender("sir", "m'am")>? Can I help you at all?");
@keldagrim_cart_menu;

[label,keldagrim_cart_menu]
switch_int (~p_choice4("What is this place?", 1, "Where can you take me?", 2, "I'd like to buy a ticket.", 3, "I have to go.", 4)) {
    case 1 :
        ~chatplayer("<p,quiz>What is this place?");
        ~chatnpc("<p,neutral>You're in the main waiting area of Keldagrim Carts- station.");
        ~chatplayer("<p,quiz>Cart-station? What goes on here then?");
        ~chatnpc("<p,neutral>Keldagrim is the hub of all the traffic of the dwarven realm. Almost every dwarven outpost has railtracks leading to Keldagrim, connecting them all for easy travel and transportation of goods.");
        ~chatplayer("<p,quiz>Amazing! And what powers the carts? Magic?");
        ~chatnpc("<p,neutral>Oh, no no, we dwarves don't use magic. No, all of this is powered by steam engines, developed during the past few centuries after the Consortium came to power.");
        ~chatplayer("<p,happy>Thanks for the info.");
        @keldagrim_cart_menu;
    case 2 :
        ~chatplayer("<p,quiz>Where can you take me?");
        ~chatnpc("<p,neutral>Let's see, we could let you travel to Ice Mountain."); // the wiki's words, without the Grand Exchange
        if (%fishingcompo >= ^fishingcompo_complete) {
            ~chatnpc("<p,neutral>I could also let you go to White Wolf Mountain, since you've befriended our brothers there.");
        }
        @keldagrim_cart_menu;
    case 3 :
        ~chatplayer("<p,neutral>I'd like to buy a ticket.");
        ~chatnpc("<p,quiz>And where would you like to go?");
        def_int $c;
        if (%fishingcompo >= ^fishingcompo_complete) {
            $c = ~p_choice3("To Ice Mountain.", 1, "To White Wolf Mountain.", 2, "Nowhere.", 3);
        } else {
            $c = ~p_choice2("To Ice Mountain.", 1, "Nowhere.", 3);
        }
        if ($c = 1) {
            ~chatplayer("<p,neutral>I'd like to buy a ticket to Ice Mountain.");
            @keldagrim_cart_buy(150, 0_46_153_53_45);
        }
        if ($c = 2) {
            ~chatplayer("<p,neutral>I'd like to buy a ticket to White Wolf Mountain.");
            @keldagrim_cart_buy(100, 0_44_154_59_15);
        }
    case 4 :
        ~chatplayer("<p,neutral>I have to go.");
        ~chatnpc("<p,neutral>Just remember, wherever you go, you go there faster through Keldagrim Carts.");
}

[label,keldagrim_cart_buy](int $fare, coord $dest)
~chatnpc("<p,neutral>That'll be <tostring($fare)> gold coins please.");
def_int $c;
if (inv_total(worn, ring_of_charos_unlocked) > 0) {
    $c = ~p_choice3("Buy.", 1, "Don't buy.", 2, "[Charm] Only pay half.", 3);
} else {
    $c = ~p_choice2("Buy.", 1, "Don't buy.", 2);
}
if ($c = 2) {
    ~chatplayer("<p,neutral>No thanks, I changed my mind.");
    @keldagrim_cart_menu;
}
if ($c = 3) $fare = divide($fare, 2);
if (inv_total(inv, coins) < $fare) {
    ~chatplayer("<p,sad>I'm sorry, I've run out of money.");
    @keldagrim_cart_menu;
}
inv_del(inv, coins, $fare);
@keldagrim_cart_leave($dest);

// the far ends: Ice Mountain (conductor7, 150 coins) and White Wolf Mountain (conductor6, 100)
[opnpc1,dwarf_city_train_conductor7] @keldagrim_cart_far(150);
[opnpc1,dwarf_city_train_conductor6] @keldagrim_cart_far(100);
[oploc1,icemountain_train_cart] @keldagrim_cart_far_ride(150);
[oploc1,whitewolfmountain_train_cart] @keldagrim_cart_far_ride(100);

[label,keldagrim_cart_far](int $fare)
~chatplayer("<p,neutral>I'd like to use your cart, please.");
if (%giantdwarf_quest = ^gd_not_started) {
    ~chatnpc("<p,neutral>Sorry, but I can only take people who have been there before."); // 2009scape
    return;
}
~chatnpc("<p,neutral>Alright, that'll cost ye <tostring($fare)>gp.");
@keldagrim_cart_far_pay($fare);

[label,keldagrim_cart_far_ride](int $fare)
if (%giantdwarf_quest = ^gd_not_started) {
    ~mesbox("You need to have visited Keldagrim before you can ride the cart there."); // ours
    return;
}
~mesbox("The ride to Keldagrim costs <tostring($fare)> coins."); // ours
@keldagrim_cart_far_pay($fare);

[label,keldagrim_cart_far_pay](int $fare)
if (~p_choice2("Okay, sure.", 1, "No, thanks.", 2) = 2) return;
if (inv_total(inv, coins) < $fare) {
    ~mesbox("You can not afford that.");
    return;
}
inv_del(inv, coins, $fare);
@keldagrim_cart_arrive;

[proc,keldagrim_cart_ride](boolean $on)
if ($on = true) {
    %keldagrim_cart_riding = 1;
} else {
    %keldagrim_cart_riding = 0;
}
~update_bas;

// into Keldagrim (2009scape's TravelToKeldagrimPulse)
[label,keldagrim_cart_arrive]
if_close;
~fade_out;
p_delay(2);
~keldagrim_cart_ride(true);
p_telejump(0_45_158_62_63);
p_delay(1);
~fade_in;
~forcemove(0_45_158_35_63); // a square a tick
~keldagrim_cart_ride(false);
npc_add(coord, hauntedmine_boss_cart, 14);
p_telejump(movecoord(coord, 0, 0, 1));
if_openoverlay(null);

// out of Keldagrim (2009scape's TravelFromKeldagrimPulse)
[label,keldagrim_cart_leave](coord $dest)
if_close;
~fade_out;
p_delay(3);
~keldagrim_cart_ride(true);
p_telejump(0_45_158_31_59);
p_delay(1);
~fade_in;
~forcemove(0_45_158_56_59);
~fade_out;
p_delay(6);
~keldagrim_cart_ride(false);
p_telejump($dest);
p_delay(1);
~fade_in;
p_delay(2);
if_openoverlay(null);
