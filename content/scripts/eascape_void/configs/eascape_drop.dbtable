// A Void drop table (GregHib/void drops.toml), generated into void_drops.dbrow by tools/void/slayer.py.
// kind: 0 = "all" (every entry is given), 1 = "first" (one roll; the first entry whose running
// chance total passes it is given). entry: obj (null for nothing or a sub-table), min, max,
// chance, sub-table, the sub-table's roll (0 = its own).
[eascape_drop]
column=kind,int,REQUIRED
column=roll,int,REQUIRED
column=entry,namedobj,int,int,int,dbrow,int,LIST
