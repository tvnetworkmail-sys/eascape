// EASCape: the 2005 Halloween event (Update:Halloween Update!!, 31 October 2005; RS wiki
// "2005 Halloween event"). Every NPC, item, animation, spot animation and sound is the 377
// cache's own: the zombies break_zomb_waist (Call-Over), break_zomb_neck (Insult) and
// break_zombie_middle (Scare), their pieces break_zomb_torso/legs, break_zomb_headless/head and
// break_zombie_half/half_2, the six trickortreater children, halloween_death (the Grim Reaper),
// trick_or_treat_head (the zombie head), the seven sweets (the cache's easter_egg_2005_* objs,
// renamed "Blue sweets" etc. in this cache), and the cache's emote_terrified varbit (the Scared
// emote, in emote_access, scope=perm).
//
// The event is left always on: in 2005 it ran for one week, but EASCape has no seasonal switch
// for any holiday (no earlier holiday event is built; Thessalia's bunny ears and scythe reclaim
// is the only older holiday reward, kept by the cache's perm varps) // ours
// Only the Grim Reaper's death visit has a switch, because it changes every player death // ours
^hw05_grim_reaper = 1           // ours: 1 Death comes for you when you die (normal deaths only), 0 never

^hw05_broken_time = 100         // ours: ticks a called-over or insulted zombie stays in pieces
^hw05_splice_time = 3           // ours: ticks a scared zombie stays in halves before it splices back
^hw05_treat_max = 100           // RS wiki: at most 100 coins at once

// ours: where the zombies roam (the map's swamp giant rat spawns, map square 50_49) and where the
// children trick or treat (the map's Lumbridge man spawns, map square 50_50); the RS wiki gives
// only "Lumbridge Swamp" and "Lumbridge"
^hw05_zombie_spot = 0_50_49_11_50
^hw05_child_spot = 0_50_50_23_39
// ours: the Lumbridge Swamp for digging up a lost head (map squares 49_49 and 50_49)
^hw05_swamp_sw = 0_49_49_0_0
^hw05_swamp_ne = 0_50_49_63_63
