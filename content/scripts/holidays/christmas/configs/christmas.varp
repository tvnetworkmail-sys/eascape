// EASCape: Christmas mode is on (staff ::christmas on|off; not authentic, a seasonal extra). Set by the
// engine at login and whenever staff change it (WorldSettings, ClientCheatHandler), never by scripts:
// read ~christmas_active instead. The client draws falling snow and snowy ground while it is 1
// (webclient Christmas.ts, which knows it by its id, 913)
[christmas_mode]
transmit=yes
