// EASCape: the 2005 Christmas event (Update:Christmas update for all players, 19 December 2005;
// RS wiki "2005 Christmas event"). Everything is the 377 cache's own: Diango
// (aprilfoolshorsesalesman), the seven pixies win05_pixie_*, the Hooded Stranger
// (win05_hooded_stranger), Diango's workshop (map square 31_69, with the pixies already spawned in
// it), its trapdoor (win05_trapdoor; the map had win05_trapdoor_closed, "Perhaps the pixies will be
// back next year."), the trapdoor steps, ladders, puppet part boxes, paintcans and decorations
// boxes, the Varrock tree (loc_10667) and its gifts (loc_10669), the marionette crate
// (win05_reclaim_puppets_multi), the baubles, boxes, marionettes, hats and scarves (win05_*), the
// marionettes' seqs and spotanims, the music (Diango's Little Helpers) and the cache's win05_var
// varp (now scope=perm) with its varbits.
//
// The event is left always on, as the 2005 Halloween event is (holidays/hw05): the trapdoor is open
// and the Varrock tree stands in the square for good. In 2005 it ran 19 December to 4 January; the
// hats, scarves and gift marionettes stayed, everything else went (the update) // ours

// win05_progress (ours: the cache names the varbit only)
^xmas05_none = 0
^xmas05_told = 1                // ours: Diango has told you where his workshop is
^xmas05_rosie = 2               // ours: Rosie has told you what needs doing

^xmas05_boxes_max = 8           // RS wiki: eight puppet boxes and eight bauble boxes
^xmas05_tree_boxes = 5          // the update: "if you take 5 boxes of decorations, you can decorate the tree"
^xmas05_puppets_each = 2        // RS wiki: two marionettes of each colour fill a puppet box

// win05_recv_pressie (the cache's gifts multiloc: 0 the bare tree, 1 the gifts with Unwrap presents, 2 bare again)
^xmas05_gift_none = 0
^xmas05_gift_waiting = 1
^xmas05_gift_taken = 2

// the bauble colours, in the cache's own order of the painted objs (yellow, red, blue, green, pink)
^xmas05_yellow = 0
^xmas05_red = 1
^xmas05_blue = 2
^xmas05_green = 3
^xmas05_pink = 4

// the marionette colours (2009scape ToyListeners: red, green, blue)
^xmas05_m_red = 0
^xmas05_m_green = 1
^xmas05_m_blue = 2

// where things are. The workshop's floors, ladders and steps are the cache map's (m31_69); the
// arrival squares beside them are ours
^xmas05_trapdoor = 0_48_51_18_11        // the map's trapdoor in the north-west house of Draynor market
^xmas05_draynor_out = 0_48_51_19_11     // Void: where the trapdoor steps lead (christmas.teles.toml)
^xmas05_workshop_in = 1_31_69_21_10     // ours: beside the trapdoor steps on Rosie's floor (Void has no trapdoor going down)
^xmas05_tree = 0_50_53_11_35            // ours: the tree in place of the Varrock square fountain (RS wiki: it "replaced the fountain")
^xmas05_tree_reach = 3                  // ours: the fountain's fence keeps you this far from the tree and gifts
^xmas05_stranger_spot = 0_45_53_58_58   // ours: by the Taverley members' gate, the free side

// ::xmastele (ours)
^xmas05_tele_diango = 0_48_50_10_46
^xmas05_tele_paint = 1_31_69_11_21
^xmas05_tele_decorations = 1_31_69_37_19
^xmas05_tele_puppets = 0_31_69_24_22
^xmas05_tele_tree = 0_50_53_13_33
