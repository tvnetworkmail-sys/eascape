{
  "name": "2006rs",
  "productName": "2006RS",
  "version": "0.16.0",
  "description": "The 2006RS game client",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/patcher.test.js && node test/drawdistance.test.js && node test/menu.test.js && node test/bank.test.js && node test/player.test.js && node test/grounditems.test.js && node test/npcindicators.test.js && node test/worldmap.test.js && node test/cluescroll.test.js && node test/dialoguekeys.test.js && node test/questhelper.test.js && node test/features.test.js && node test/infoboxes.test.js && node test/timers.test.js && node test/batch2.test.js && node test/hotkeys.test.js && node test/gamescreen.test.js",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.2006rs.client",
    "productName": "2006RS",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "2006RS",
      "artifactName": "2006RS-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://2006rs.com/download/"
      }
    ],
    "asarUnpack": [
      "src/main/routeWorker.js",
      "src/plugins/questhelper/route.js",
      "src/plugins/questhelper/collision.bin",
      "src/plugins/questhelper/transports.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
